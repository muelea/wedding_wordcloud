# Copy to .env and fill in for local dev. None of these are required to run
# the core word-cloud product — everything below is only for personalized-mug
# pricing/payment/fulfillment, which degrades gracefully when unset.

# Server
PORT=3000
# Override auto-detected base URL (LAN IP) — set this once you have a real
# domain/hosting. Leave unset for local dev; the app falls back to your
# machine's LAN IP so guest phones on the same WiFi can reach it.
PUBLIC_URL=

# Secret used to sign the admin PIN session token (see src/adminAuth.js).
# Any long random string; MUST be set to something real before any
# non-local deployment — the fallback here is intentionally insecure.
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-string

# SQLite db file location (defaults to ./data/weddingcloud.sqlite)
DB_PATH=

# ── Stripe test checkout ────────────────────────────────────────────────────
# Use test values only for this phase. No Publishable Key or Price ID is
# needed because the server creates a hosted Checkout Session dynamically.
STRIPE_SECRET_KEY=
# Local value printed by: ./run_stripe_webhook.sh
STRIPE_WEBHOOK_SECRET=
# Hard safety switch. Keep false: live keys/events are rejected and no real
# Printful order is created after a successful test payment.
STRIPE_ALLOW_LIVE_PAYMENTS=false

# Saved address/price quotes expire after this many minutes (5-120).
CHECKOUT_QUOTE_TTL_MINUTES=30

# ── Printful (print-on-demand fulfillment) ──────────────────────────────────
# Credentials for live catalog data and cost estimates. Successful Stripe test
# payments are always handled as local mocks and never call Printful's order
# endpoints, regardless of the switches below.
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
# mock: no order API writes (safe default)
# draft: create an unconfirmed Printful draft after a LIVE Stripe payment
# live: create and confirm the draft after a LIVE Stripe payment
PRINTFUL_FULFILLMENT_MODE=mock
# Second safety switch required by both draft and live modes.
PRINTFUL_ALLOW_ORDER_WRITES=false
# Third safety switch required only for live mode. Confirmation charges the
# Printful account and submits the order for fulfillment.
PRINTFUL_CONFIRM_LIVE_ORDERS=false
# Catalog-wide provisional test pricing. The retail product subtotal uses a
# 45% target gross margin, but never less than 5,00 € contribution per order.
# Shipping and the current Printful tax estimate are added separately. The
# final VAT treatment must be reviewed before live payments are enabled.
SHOP_TARGET_MARGIN_PERCENT=45
SHOP_MIN_PROFIT_PER_ORDER_CENTS=500
# Draft/live fulfillment builds the immutable print-file URL from PUBLIC_URL.
# It must be a public HTTPS URL; localhost is accepted only by mock mode.
