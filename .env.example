# Copy this file to .env for local development. This file contains no real
# credentials and must stay safe to commit. The real .env is gitignored.
#
# Hosted runtime secrets belong in Fly Secrets. MIGRATION_DATABASE_URL is the
# exception: it belongs only in local migration tooling and the CI/deployment
# secret store because the ordinary web Machine must not have schema privileges.

# ── HTTP server ──────────────────────────────────────────────────────────────
# TCP port on which Express and Socket.io listen. Local development uses 3000;
# Fly will set/use the port matching fly.toml (planned: 8080).
PORT=3000

# Canonical public HTTPS origin used to generate QR codes, event links and the
# immutable print-file URLs downloaded by Printful. Leave blank locally to use
# the detected LAN address. On Fly, set https://<fly-app-name>.fly.dev until the
# custom domain is connected. Do not add a trailing slash.
PUBLIC_URL=

# ── Transitional admin setting ──────────────────────────────────────────────
# Signs the current reusable admin PIN token. It prevents callers from forging
# reset authorization. Generate a long random value for any hosted test. This
# variable disappears when Package 4 changes reset to accept the PIN once per
# request and removes reusable admin tokens.
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-string

# ── Postgres and private Supabase Storage ───────────────────────────────────
# Connection used by the running application for ordinary queries. Its hosted
# user is a dedicated least-privileged role created in Package 1; do not use the
# Supabase postgres/admin user here. Local development uses local Supabase.
DATABASE_URL=

# Absolute path to Supabase's downloaded database CA certificate. Hosted
# connections use it for full certificate and hostname verification; local
# Supabase connections on 127.0.0.1 do not need it. DATABASE_CA_CERT can be
# used instead when a hosting platform supplies the PEM contents directly.
DATABASE_CA_CERT_PATH=
DATABASE_CA_CERT=

# Privileged hosted Postgres connection used to apply versioned migrations and
# create/alter schema objects before deployment. It is needed by local migration
# tooling and CI only. NEVER configure this value as a Fly application secret.
MIGRATION_DATABASE_URL=

# Base URL of the Supabase project API, for example
# https://abcdefghijklmnopqrst.supabase.co. The server uses it for private
# Storage operations; browsers never connect to Supabase directly.
SUPABASE_URL=

# Backend-only Supabase sb_secret_... API key. It authorizes the server to read,
# write and delete private photo/print objects and bypasses Storage RLS. Never
# expose it to HTML, browser JavaScript, URLs, responses or logs.
SUPABASE_SECRET_KEY=

# Name of the single private bucket containing normalized personal photos and
# temporary paid print artifacts. Project setup creates it; keep it non-public.
SUPABASE_STORAGE_BUCKET=wolkenworte-private

# Secret HMAC key used to turn normalized client IPs into non-reversible rate-
# limit identities before durable storage. It avoids retaining raw IP addresses.
RATE_LIMIT_HMAC_SECRET=

# Independent secret authenticating Supabase Cron calls to the bounded internal
# maintenance endpoint. It protects fulfillment retries and retention cleanup
# from public invocation. Never reuse RATE_LIMIT_HMAC_SECRET or another key.
MAINTENANCE_SECRET=

# ── Transactional email through Resend ──────────────────────────────────────
# Backend-only Resend API key used to send required order, shipment, refund and
# cancellation messages. Use Sending access restricted to the verified domain.
RESEND_API_KEY=

# Verified From identity shown to customers. Replace example.com with the
# verified Wolkenworte sending subdomain configured in Resend.
RESEND_FROM_EMAIL="Wolkenworte <bestellung@mail.example.com>"

# Signing secret for Resend delivery webhooks. It proves that sent/delivered/
# bounced/failed/complained events came from Resend. It becomes available only
# after the Package 6 webhook endpoint is deployed and registered.
RESEND_WEBHOOK_SECRET=

# mock: persist/simulate email outcomes without contacting Resend (safe default)
# live: allow approved real transactional sends. Stripe test payments remain
# mocked regardless of this value.
EMAIL_DELIVERY_MODE=mock

# Second irreversible guard for the one-time pre-live hosted-test cleanup tool.
# Keep false during development and live operation; enable only for the approved
# cleanup invocation and remove/disable it immediately afterward.
ALLOW_TEST_DATA_RESET=false

# ── Stripe-hosted Checkout ──────────────────────────────────────────────────
# Server-side Stripe secret key used to create Checkout Sessions and retrieve
# trusted payment data. Use sk_test_... until the explicit live cutover. No
# browser publishable key or fixed Stripe Price ID is required by this app.
STRIPE_SECRET_KEY=

# Signing secret used to verify the raw request body of Stripe webhooks. Locally
# it is printed by ./run_stripe_webhook.sh; hosted test gets a separate Dashboard
# webhook endpoint and whsec_... value. Never reuse the local signing secret.
STRIPE_WEBHOOK_SECRET=

# Master payment safety switch. false rejects live Stripe keys/events and makes
# it impossible for a successful test payment to trigger real fulfillment.
STRIPE_ALLOW_LIVE_PAYMENTS=false

# Minutes for which a server-calculated address, shipping and price quote may be
# used to start Checkout. Short expiry forces stale Printful prices to be quoted
# again. Accepted range: 5-120.
CHECKOUT_QUOTE_TTL_MINUTES=30

# ── Printful pricing and fulfillment ─────────────────────────────────────────
# Private Printful token used for countries, cost estimates and—only behind all
# safety gates—draft/order API calls. It is never sent to the browser.
PRINTFUL_API_KEY=

# Identifier of the Printful store that owns the catalog and eventual orders.
# This prevents requests from targeting the wrong store/account context.
PRINTFUL_STORE_ID=

# mock: never create a Printful order (safe default)
# draft: create an unconfirmed draft after an eligible LIVE Stripe payment
# live: create and confirm/submit the order after an eligible LIVE payment
PRINTFUL_FULFILLMENT_MODE=mock

# Independent write gate required for both draft and live modes. false prevents
# every Printful order-create request even if another setting is misconfigured.
PRINTFUL_ALLOW_ORDER_WRITES=false

# Final independent confirmation gate. false prevents charging/submitting a
# Printful draft for production. Enable only after all launch gates are approved.
PRINTFUL_CONFIRM_LIVE_ORDERS=false

# Percentage markup added to Printful's current product cost when calculating
# the customer-facing product subtotal. This is provisional until margin review.
SHOP_PRODUCT_MARKUP_PERCENT=50

# Estimated percentage component of Stripe processing cost, grossed into the
# product subtotal so expected payment fees do not consume the intended margin.
SHOP_PAYMENT_RESERVE_PERCENT=3.15

# Estimated fixed Stripe processing cost in euro cents, also folded into the
# product subtotal rather than displayed as a separate card surcharge.
SHOP_PAYMENT_RESERVE_FIXED_CENTS=25
