# Copy to .env and fill in for local dev. None of these are required to run
# the core word-cloud product — everything below is only for the mug-duo
# checkout flow, which degrades gracefully (returns a clear 501) when unset.

# Server
PORT=3000
# Override auto-detected base URL (LAN IP) — set this once you have a real
# domain/hosting. Leave unset for local dev; the app falls back to your
# machine's LAN IP so guest phones on the same WiFi can reach it.
PUBLIC_URL=

# Secret used to sign the admin PIN session token (see src/adminAuth.js).
# Any long random string; MUST be set to something real before any
# non-local deployment — the fallback here is intentionally insecure.
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-string

# SQLite db file location (defaults to ./data/weddingcloud.sqlite)
DB_PATH=

# ── Stripe (His & Hers mug-duo checkout, 34,90€) ────────────────────────────
# Not set up yet — requires a real, identity-verified Stripe account.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Printful (print-on-demand fulfillment) ──────────────────────────────────
# Not set up yet — requires a real Printful account + product setup.
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_MUG_VARIANT_ID_HIS=
PRINTFUL_MUG_VARIANT_ID_HERS=
# No env var needed for the print file URL itself anymore — the webhook
# handler builds a real one (GET /e/:slug/export.svg) from PUBLIC_URL/the
# request host. See src/routes/webhook.js and src/printful.js.
