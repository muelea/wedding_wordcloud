# Copy this file to .env for local development and operator tooling. This file
# contains no real credentials and must stay safe to commit. The real .env is
# gitignored.
#
# Scope labels used below:
#   LOCAL PROCESS  loaded from the ignored .env by your workstation process
#   OPERATOR       used from the workstation to configure/verify hosted systems
#   FLY RUNTIME    stored independently in Fly Secrets or fly.toml, never copied
#                  back from Fly into .env
#   FUTURE LIVE    intentionally empty until the reviewed production cutover
#   SHARED CONFIG  non-secret behavior setting present in each relevant runtime
#
# A variable name never silently changes Stripe meaning between environments.
# Test/live keys and local/hosted webhook secrets have distinct names.

# ── Application identity ────────────────────────────────────────────────────
# [LOCAL PROCESS] Identifies which deployment this process is. Keep `local` in
# .env. fly.toml explicitly sets `hosted-test`; the future production service
# will set `production`. Runtime validation rejects unsafe combinations.
APP_ENVIRONMENT=local

# [LOCAL PROCESS] Node behavior profile. `development` enables the normal local
# runtime. Tests set `test`; fly.toml sets `production`. This is not the product
# deployment identity—that is APP_ENVIRONMENT above.
NODE_ENV=development

# [OPERATOR] Fly app targeted by repository scripts. This does not configure a
# running server; it prevents operators from having to repeat the app name.
FLY_APP_NAME=wolkenworte

# ── HTTP server ──────────────────────────────────────────────────────────────
# [SHARED CONFIG] TCP port on which Express and Socket.io listen. Local uses 3000;
# Fly sets/uses 8080 to match the committed fly.toml.
PORT=3000

# [SHARED CONFIG] Canonical public HTTPS origin used to generate QR codes, event links and the
# immutable print-file URLs downloaded by Printful. Leave blank locally to use
# the detected LAN address. The hosted Fly app sets https://wolkenworte.io in
# fly.toml. Do not add a trailing slash.
PUBLIC_URL=

# ── Postgres and private Supabase Storage ───────────────────────────────────
# [LOCAL PROCESS / FLY RUNTIME] Connection used by that running application for
# ordinary queries. The value in .env and the independently stored Fly Secret
# are separate environment-specific values. Its hosted
# user is the dedicated least-privileged role created by
# `npm run db:provision-runtime`; do not use the Supabase postgres/admin user
# here. Local development uses local Supabase.
DATABASE_URL=

# [SHARED CONFIG] One path to the committed public Supabase trust certificate.
# Local processes, CI and the Fly container all use this same repository file
# for full hosted Postgres certificate/hostname verification. This is not a
# secret; replace the reviewed file in certs/ when Supabase rotates its CA.
DATABASE_CA_CERT_PATH=certs/supabase-prod-ca-2021.crt

# [OPERATOR ONLY] Privileged hosted Postgres connection used to apply versioned migrations and
# create/alter schema objects before deployment. It is needed by local migration
# tooling and CI only. NEVER configure this value as a Fly application secret.
MIGRATION_DATABASE_URL=

# [OPTIONAL TEST OPERATOR] Overrides the admin connection used by `npm test`.
# When empty, tests use MIGRATION_DATABASE_URL, then DATABASE_URL. Test helpers
# create and remove isolated schemas; this value is never a Fly runtime secret.
TEST_DATABASE_URL=

# [LOCAL PROCESS / OPERATOR / FLY RUNTIME] Base URL of the Supabase project API, for example
# https://abcdefghijklmnopqrst.supabase.co. The server uses it for private
# Storage operations; browsers never connect to Supabase directly.
SUPABASE_URL=

# [LOCAL PROCESS / OPERATOR / FLY RUNTIME SECRET] Backend-only Supabase sb_secret_... API key. It authorizes the server to read,
# write and delete private photo/print objects and bypasses Storage RLS. Never
# expose it to HTML, browser JavaScript, URLs, responses or logs.
SUPABASE_SECRET_KEY=

# [SHARED CONFIG] Name of the private bucket containing normalized personal
# photos and frozen paid print artifacts. Uploaded photos are accepted only as
# validated JPEG/PNG/WebP; the server also stores its generated SVG print
# artifacts in this same private bucket.
SUPABASE_STORAGE_BUCKET=wolkenworte-private

# [LOCAL PROCESS / FLY RUNTIME SECRET] Secret HMAC key used to turn normalized client IPs into non-reversible rate-
# limit identities before durable storage. It avoids retaining raw IP addresses.
RATE_LIMIT_HMAC_SECRET=

# [LOCAL PROCESS / FLY RUNTIME SECRET] Independent secret authenticating Supabase Cron calls to the bounded internal
# maintenance endpoint. It protects fulfillment retries and retention cleanup
# from public invocation. Never reuse RATE_LIMIT_HMAC_SECRET or another key.
MAINTENANCE_SECRET=

# [SHARED CONFIG] Stop-the-world switch used only by the guarded pre-live cleanup. When true,
# health checks stay reachable but public HTTP gets a 503 and new Socket.io
# connections are rejected. Keep false normally; enable it on Fly only for the
# short cleanup window and turn it off immediately afterward.
MAINTENANCE_MODE=false

# ── Transactional email through Resend ──────────────────────────────────────
# [LOCAL OPERATOR / FUTURE LIVE RUNTIME SECRET] Backend-only Resend API key used to send required order, shipment, refund and
# cancellation messages. Use Sending access restricted to the verified domain.
RESEND_API_KEY=

# [LOCAL OPERATOR / FUTURE LIVE SHARED CONFIG] Verified From identity shown to customers. Replace example.com with the
# verified Wolkenworte sending subdomain configured in Resend.
RESEND_FROM_EMAIL="Wolkenworte <bestellung@mail.example.com>"

# [FUTURE LIVE RUNTIME SECRET] Signing secret for Resend delivery webhooks. It proves that sent/delivered/
# bounced/failed/complained events came from Resend. It becomes available only
# after the `/webhook/resend` endpoint is registered with Resend.
RESEND_WEBHOOK_SECRET=

# [LOCAL OPERATOR / CONTROLLED FLY SMOKE] Comma-separated, explicit allowlist for the guarded operator-only live email
# smoke. Ordinary web requests cannot use it. Add only maintainer/test inboxes;
# every smoke invocation must also name one of them with --recipient.
RESEND_SMOKE_RECIPIENTS=

# [SHARED CONFIG] mock: persist/simulate email outcomes without contacting Resend (safe default)
# live: allow approved real transactional sends. Stripe test payments remain
# mocked regardless of this value.
EMAIL_DELIVERY_MODE=mock

# [LOCAL OPERATOR / TEMPORARY FLY CONFIG] Second irreversible guard for the one-time pre-live hosted-test cleanup tool.
# Keep false during development and live operation; enable only for the approved
# cleanup invocation and remove/disable it immediately afterward.
ALLOW_TEST_DATA_RESET=false

# ── Stripe-hosted Checkout ──────────────────────────────────────────────────
# [SHARED CONFIG] Chooses which explicitly named Stripe credential set the
# process may load. Keep `test` locally and on the hosted-test Fly app. Only the
# future production cutover may set `live`.
STRIPE_PAYMENT_MODE=test

# [LOCAL PROCESS / OPERATOR / FLY RUNTIME SECRET] Stripe sandbox server key.
# It creates/retrieves test Checkout Sessions and lets operator scripts manage
# the hosted sandbox destination. Fly stores the same account's key separately
# as a Fly Secret. No publishable browser key or fixed Price ID is needed.
STRIPE_TEST_SECRET_KEY=

# [LOCAL PROCESS ONLY] Stripe CLI listener signing secret printed by
# ./run_stripe_webhook.sh. It verifies callbacks forwarded to localhost. It is
# not valid for the Stripe Dashboard destination and must never be copied to Fly.
STRIPE_TEST_LOCAL_WEBHOOK_SECRET=

# [FLY RUNTIME ONLY — NOT AN .env VARIABLE] `STRIPE_TEST_HOSTED_WEBHOOK_SECRET`
# is the signing secret of https://wolkenworte.fly.dev/webhook/stripe. Do not add
# an assignment here or to local .env. `npm run stripe:configure-webhook`
# creates/rotates it and stages it directly as a Fly Secret.

# [FUTURE LIVE RUNTIME ONLY] Production Stripe server key. Keep empty throughout
# hosted sandbox development. At launch it belongs only in the production
# runtime's encrypted secret store, never in the hosted-test Fly app.
STRIPE_LIVE_SECRET_KEY=

# [FUTURE LIVE RUNTIME ONLY] Signing secret for the future production Stripe
# webhook destination. It is not the test Dashboard or local CLI secret.
STRIPE_LIVE_WEBHOOK_SECRET=

# [SHARED CONFIG] Independent live-payment safety gate. Keep false locally and
# on hosted-test. Live mode requires BOTH STRIPE_PAYMENT_MODE=live and this flag
# set to true, plus the remaining email/fulfillment launch gates.
STRIPE_LIVE_PAYMENTS_ENABLED=false

# [SHARED CONFIG] Minutes for which a server-calculated address, shipping and price quote may be
# used to start Checkout. Short expiry forces stale Printful prices to be quoted
# again. Accepted range: 5-120.
CHECKOUT_QUOTE_TTL_MINUTES=30

# ── Printful pricing and fulfillment ─────────────────────────────────────────
# [LOCAL PROCESS / OPERATOR / FLY RUNTIME SECRET] Private Printful token used for countries, estimates and—only behind all
# safety gates—draft/order API calls. The token needs both the `orders` and
# `webhooks` scopes for fulfillment and webhook tooling. It is never sent to
# the browser.
PRINTFUL_API_KEY=

# [LOCAL PROCESS / OPERATOR / FLY RUNTIME SECRET] Identifier of the Printful store that owns the catalog and eventual orders.
# This prevents requests from targeting the wrong store/account context.
PRINTFUL_STORE_ID=

# [FLY RUNTIME SECRET] Hex-encoded secret and base64 public key returned only when the signed
# Printful v2 webhook configuration is created/replaced. The server verifies
# the exact raw callback body with HMAC-SHA256 and optionally pins the public
# key before recording any order/shipment transition. Configure them with the
# guarded operator command; never expose either value to browser code.
PRINTFUL_WEBHOOK_SECRET=
PRINTFUL_WEBHOOK_PUBLIC_KEY=

# [SHARED CONFIG] mock: never create a Printful order (safe default)
# draft: create an unconfirmed draft after an eligible LIVE Stripe payment
# live: create and confirm/submit the order after an eligible LIVE payment
PRINTFUL_FULFILLMENT_MODE=mock

# [SHARED CONFIG] Independent write gate required for both draft and live modes. false prevents
# every Printful order-create request even if another setting is misconfigured.
PRINTFUL_ALLOW_ORDER_WRITES=false

# [SHARED CONFIG] Final independent confirmation gate. false prevents charging/submitting a
# Printful draft for production. Enable only after all launch gates are approved.
PRINTFUL_CONFIRM_LIVE_ORDERS=false

# [SHARED CONFIG] Percentage markup added to Printful's current product cost when calculating
# the customer-facing product subtotal. This is provisional until margin review.
SHOP_PRODUCT_MARKUP_PERCENT=50

# [SHARED CONFIG] Estimated percentage component of Stripe processing cost, grossed into the
# product subtotal so expected payment fees do not consume the intended margin.
SHOP_PAYMENT_RESERVE_PERCENT=3.15

# [SHARED CONFIG] Estimated fixed Stripe processing cost in euro cents, also folded into the
# product subtotal rather than displayed as a separate card surcharge.
SHOP_PAYMENT_RESERVE_FIXED_CENTS=25
