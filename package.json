{
  "name": "wolkenworte",
  "version": "0.1.0",
  "description": "Multi-tenant collaborative word cloud with safe print-on-demand checkout",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "local:prepare": "node scripts/prepare-local.js",
    "deploy:hosted": "node scripts/deploy-hosted.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:provision-runtime": "node scripts/provision-runtime-role.js",
    "maintenance:configure-cron": "node scripts/configure-maintenance-cron.js",
    "maintenance:verify-cron": "node scripts/verify-maintenance-cron.js",
    "smoke:printful-draft": "node scripts/printful-draft-smoke.js",
    "stripe:configure-webhook": "node scripts/configure-stripe-webhook.js",
    "stripe:verify-hosted-payment": "node scripts/verify-hosted-stripe-payment.js",
    "printful:configure-webhook": "node scripts/configure-printful-webhook.js",
    "resend:configure-webhook": "node scripts/configure-resend-webhook.js",
    "smoke:resend-email": "node scripts/resend-email-smoke.js",
    "fly:secrets": "node scripts/configure-fly-secrets.js",
    "smoke:hosted": "node scripts/hosted-smoke.js",
    "load:socket:capacity": "node scripts/socket-capacity.js",
    "ops:status": "node scripts/operations-status.js",
    "ops:retry-fulfillment": "node scripts/retry-blocked-fulfillment.js",
    "ops:prelive-cleanup": "node scripts/prelive-cleanup.js",
    "test": "node --test test/*.test.js",
    "test:emoji:browser": "node scripts/check-emoji-browser.js",
    "test:journey:browser": "node scripts/check-journey-browser.js",
    "test:configurator:browser": "node scripts/check-configurator-browser.js"
  },
  "dependencies": {
    "@fontsource/gelasio": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "canvas": "^3.2.3",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "fabric": "^7.4.0",
    "ipaddr.js": "^1.9.1",
    "parse5": "^7.3.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.3",
    "resend": "^6.24.0",
    "socket.io": "^4.7.5",
    "stripe": "^16.9.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.7.5"
  }
}
