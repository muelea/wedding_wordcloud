{
  "name": "weddingcloud-business",
  "version": "0.1.0",
  "description": "Multi-tenant wedding word cloud with personal photo designs and safe print-on-demand checkout",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:provision-runtime": "node scripts/provision-runtime-role.js",
    "maintenance:configure-cron": "node scripts/configure-maintenance-cron.js",
    "maintenance:verify-cron": "node scripts/verify-maintenance-cron.js",
    "smoke:printful-draft": "node scripts/printful-draft-smoke.js",
    "printful:configure-webhook": "node scripts/configure-printful-webhook.js",
    "fly:secrets": "node scripts/configure-fly-secrets.js",
    "smoke:hosted": "node scripts/hosted-smoke.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@fontsource/gelasio": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "canvas": "^3.2.3",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fabric": "^7.4.0",
    "ipaddr.js": "^1.9.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.3",
    "sharp": "^0.35.4",
    "socket.io": "^4.7.5",
    "stripe": "^16.9.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.7.5"
  }
}
