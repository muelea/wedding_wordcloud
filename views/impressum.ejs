        74080 Heilbronn<br />
        Deutschland
      </address>
    </section>

    <section class="legal-section">
      <h2>Vertretung und Kontakt</h2>
      <dl class="facts">
        <dt>Geschäftsführer</dt>
        <dd>Julian Sascha Wilken</dd>
        <dt>E-Mail</dt>
        <dd><a href="mailto:kontakt@jusa.io">kontakt@jusa.io</a></dd>
        <dt>Telefon</dt>
        <dd><a href="tel:+4915237286173">+49 1523 7286173</a></dd>
      </dl>
    </section>

    <section class="legal-section">
