      <dl class="facts">
        <dt>Registergericht</dt>
        <dd>Amtsgericht Stuttgart</dd>
        <dt>Registernummer</dt>
        <dd>HRB 804854</dd>
      </dl>
    </section>

    <section class="legal-section">
      <h2>Umsatzsteuer-Identifikationsnummer</h2>
      <p>Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz: <strong>DE461606807</strong></p>
