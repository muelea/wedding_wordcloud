  <script src="/js/site-header.js"></script>
  <script>
    (function () {
      var overlay = document.getElementById('intro-overlay');
      if (!overlay) return;

      var introVideo = document.getElementById('intro-video');
      var scrollCue = document.getElementById('intro-scroll-cue');

      function finishIntro() {
        if (overlay.classList.contains('fade-out')) return;
        overlay.classList.add('fade-out');
        document.documentElement.classList.remove('intro-fade');
        window.removeEventListener('wheel', finishIntro);
        window.removeEventListener('touchmove', finishIntro);
        window.removeEventListener('keydown', onIntroKeydown);
        window.setTimeout(function () {
          if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
          document.documentElement.classList.remove('intro-lock');
        }, 1250);
      }

      function onIntroKeydown(event) {
        if (['ArrowDown', 'PageDown', ' ', 'End'].indexOf(event.key) !== -1) {
          event.preventDefault();
          finishIntro();
        }
      }

      if (introVideo) {
        introVideo.addEventListener('ended', finishIntro);
        introVideo.addEventListener('error', finishIntro);
      }
      if (scrollCue) scrollCue.addEventListener('click', finishIntro);
      window.addEventListener('wheel', finishIntro, { passive: true });
      window.addEventListener('touchmove', finishIntro, { passive: true });
      window.addEventListener('keydown', onIntroKeydown);
    })();
  </script>
  <script>
    (function () {
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if ('IntersectionObserver' in window && !reduceMotion) {
        document.documentElement.classList.add('js-reveal-ready');
        var targets = document.querySelectorAll(
          '.section-top, .step, .phone, .feature-copy, .print-copy, .cup-stage, .cta-box'
        );
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        targets.forEach(function (el) { io.observe(el); });
      }
    })();
  </script>

  <script src="/vendor/three.min.js?v=0.160.1"></script>
  <script src="/js/wordcloud-core.js?v=20260819-2"></script>
  <script src="/js/mug-3d-viewer.js?v=20260821-1"></script>
  <script>
    // The homepage and configurator intentionally instantiate the same mug
    // renderer. Only the artwork supplied to its print texture differs.
    (function () {
      var canvas = document.getElementById('mug-canvas');
      if (!canvas || !window.WebGLRenderingContext) return;

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // The hero words plus complementary wedding terms, laid out through
      // the configurator's real print engine with the same color hierarchy.
      var WORDS = [
        { text: 'Liebe', count: 47, color: '#9c1c4c' },
        { text: 'unvergesslich', count: 41, color: '#d1607e' },
        { text: 'Freude', count: 29, color: '#c1922f' },
        { text: 'für immer', count: 32, color: '#d1607e' },
        { text: 'Zusammen', count: 41, color: '#c1922f' },
        { text: 'Herzklopfen', count: 32, color: '#d1607e' },
        { text: 'Sommerabend', count: 41, color: '#9c1c4c' },
        { text: 'Gänsehaut', count: 30, color: '#400f26' },
        { text: 'Vertrauen', count: 27, color: '#400f26' },
        { text: 'goldenes Licht', count: 41, color: '#d1607e' },
        { text: 'Lachen', count: 29, color: '#c1922f' },
        { text: 'Geborgenheit', count: 30, color: '#400f26' },
        { text: 'Hand in Hand', count: 41, color: '#c1922f' },
        { text: 'Lieblingsmensch', count: 38, color: '#9c1c4c' },
        { text: 'Verbundenheit', count: 35, color: '#400f26' },
        { text: 'Leichtigkeit', count: 34, color: '#d1607e' },
        { text: 'Herzenswärme', count: 37, color: '#c1922f' },
        { text: 'Lieblingsmoment', count: 32, color: '#d1607e' },
        { text: 'Seelenverwandt', count: 31, color: '#9c1c4c' },
        { text: 'Abenteuer', count: 30, color: '#c1922f' },
        { text: 'Dankbarkeit', count: 29, color: '#400f26' },
        { text: 'Ewigkeit', count: 36, color: '#d1607e' },
        { text: 'Zuhause', count: 39, color: '#9c1c4c' },
        { text: 'Zukunft', count: 33, color: '#c1922f' },
        { text: 'Gemeinsam', count: 40, color: '#400f26' },
        { text: 'Tanzen', count: 28, color: '#d1607e' },
        { text: 'Glück', count: 42, color: '#9c1c4c' },
        { text: 'Nähe', count: 30, color: '#400f26' },
        { text: 'Küsse', count: 29, color: '#d1607e' },
        { text: 'Wir', count: 44, color: '#9c1c4c' },
        { text: 'Ja-Wort', count: 34, color: '#c1922f' }
      ];

      // This is the configurator's "Fläche optimal nutzen" print geometry.
      var printArea = { x: 36, y: 36, width: 2628, height: 978 };
      var measurementCanvas = document.createElement('canvas');
      var measurementContext = measurementCanvas.getContext('2d');
      var colors = new Map(WORDS.map(function (item) { return [item.text, item.color]; }));
      var placed = WordCloudCore.layoutWordsInArea(
        WORDS.map(function (item) { return [item.text, item.count]; }),
        printArea.width,
        printArea.height,
        measurementContext,
        function (word) { return colors.get(word); }
      );

      function drawHomepageWords(ctx, metrics) {
        ctx.textAlign = 'center';
        ctx.textBaseline = 'alphabetic';
        placed.forEach(function (item) {
          var x = metrics.offsetX + printArea.x + item.x;
          var y = metrics.offsetY + printArea.y + item.y;
          ctx.font = item.fontPx + 'px ' + WordCloudCore.FONT_FAMILY;
          ctx.fillStyle = item.color;
          if (item.rotated) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(-Math.PI / 2);
            ctx.fillText(item.word, 0, item.fontPx * .34);
            ctx.restore();
          } else {
            ctx.fillText(item.word, x, y + item.fontPx * .34);
          }
        });
      }

      var mug = Mug3DViewer.create({
        THREE: window.THREE,
        host: canvas,
        canvas: canvas,
        interactionElement: canvas,
        product: Mug3DViewer.DEFAULT_PRODUCT,
        drawTexture: drawHomepageWords,
        autoRotate: !reduceMotion,
        autoRotateDurationMs: 9000
      });
      window.addEventListener('resize', mug.resize);
    })();
  </script>
