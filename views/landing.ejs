  <script src="<%= asset('/js/site-header.js') %>"></script>
  <script src="<%= asset('/js/landing-workflow.js') %>"></script>
  <script>
    (function () {
      var dialog = document.getElementById('start-dialog');
      var form = document.getElementById('start-dialog-form');
      var input = document.getElementById('start-cloud-name');
      var pinInput = document.getElementById('start-organizer-pin');
      var pinConfirmation = document.getElementById('start-organizer-pin-confirmation');
      var closeButton = document.getElementById('start-dialog-close');
      if (!dialog || !form || !input || !pinInput || !pinConfirmation || !closeButton) return;

      function openDialog() {
        var header = document.getElementById('site-header');
        if (header) header.classList.remove('landing-menu-open');
        if (!dialog.open) dialog.showModal();
        if (window.matchMedia('(pointer: fine)').matches) {
          window.requestAnimationFrame(function () { input.focus(); });
        }
      }

      document.querySelectorAll('[data-open-start-dialog]').forEach(function (button) {
        button.addEventListener('click', function (event) {
          event.preventDefault();
          openDialog();
        });
      });
      closeButton.addEventListener('click', function () { dialog.close(); });
      dialog.addEventListener('click', function (event) {
        if (event.target === dialog) dialog.close();
      });
      input.addEventListener('input', function () { input.setCustomValidity(''); });
      pinInput.addEventListener('input', function () {
        pinInput.setCustomValidity('');
        pinConfirmation.setCustomValidity('');
      });
      pinConfirmation.addEventListener('input', function () { pinConfirmation.setCustomValidity(''); });
      form.addEventListener('submit', function (event) {
        if (!input.value.trim()) {
          event.preventDefault();
          input.setCustomValidity(WolkenworteI18n.t('Bitte gebt eurer Wortwolke einen Namen.'));
          input.reportValidity();
          return;
        }
        if (!/^\d{4,6}$/.test(pinInput.value.trim())) {
          event.preventDefault();
          pinInput.setCustomValidity(WolkenworteI18n.t('Bitte wählt eine Organisator-PIN mit 4–6 Ziffern.'));
          pinInput.reportValidity();
          return;
        }
        if (pinInput.value.trim() !== pinConfirmation.value.trim()) {
          event.preventDefault();
          pinConfirmation.setCustomValidity(WolkenworteI18n.t('Die beiden PINs stimmen nicht überein.'));
          pinConfirmation.reportValidity();
        }
      });
      if (dialog.dataset.openOnLoad === 'true') {
        if (dialog.open) dialog.close();
        openDialog();
      }
    })();
  </script>
  <script>
    (function () {
      var overlay = document.getElementById('intro-overlay');
      if (!overlay) return;

      var introVideo = document.getElementById('intro-video');
      var scrollCue = document.getElementById('intro-scroll-cue');

      function finishIntro() {
        if (overlay.classList.contains('fade-out')) return;
        overlay.classList.add('fade-out');
        document.documentElement.classList.remove('intro-fade');
        var header = document.getElementById('site-header');
        if (header) header.classList.add('intro-finished');
        window.removeEventListener('wheel', finishIntro);
        window.removeEventListener('touchmove', finishIntro);
        window.removeEventListener('keydown', onIntroKeydown);
        window.setTimeout(function () {
          if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
          document.documentElement.classList.remove('intro-lock');
        }, 1250);
      }

      function onIntroKeydown(event) {
        if (['ArrowDown', 'PageDown', ' ', 'End'].indexOf(event.key) !== -1) {
          event.preventDefault();
          finishIntro();
        }
      }

      if (introVideo) {
        introVideo.addEventListener('ended', finishIntro);
        introVideo.addEventListener('error', finishIntro);
      }
      if (scrollCue) scrollCue.addEventListener('click', finishIntro);
      window.addEventListener('wheel', finishIntro, { passive: true });
      window.addEventListener('touchmove', finishIntro, { passive: true });
      window.addEventListener('keydown', onIntroKeydown);
    })();
  </script>
  <script>
    (function () {
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if ('IntersectionObserver' in window && !reduceMotion) {
        document.documentElement.classList.add('js-reveal-ready');
        var targets = document.querySelectorAll(
          '.section-top, .inspiration-card, .print-copy, .cup-stage, .quote blockquote, .quote cite, .cta-box'
        );
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        targets.forEach(function (el) { io.observe(el); });
      }
    })();
  </script>

  <script src="/vendor/three.min.js?v=0.160.1"></script>
  <script src="<%= asset('/js/wordcloud-core.js') %>"></script>
  <script src="<%= asset('/js/mug-3d-viewer.js') %>"></script>
  <script>
    // The homepage and configurator intentionally instantiate the same mug
    // renderer. Only the artwork supplied to its print texture differs.
    (function () {
      var canvas = document.getElementById('mug-canvas');
      if (!canvas || !window.WebGLRenderingContext) return;

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Landing-cup art direction. x/y are centres in the 2700 × 1050 print
      // file; angle is 0 (horizontal) or -90 (vertical). Edit these values to
      // refine an individual word without giving up the automatic layout as a
      // safe starting point.
      var WORDS = [
        { text: 'Liebe', count: 45, displayScale: 2.15, x: 200, y: 450, angle: -90, color: '#a40e4c' },
        { text: 'unvergesslich', count: 14, displayScale: 2.08, x: 655, y: 835, angle: 0, color: '#168f83' },
        { text: 'Freude', count: 22, displayScale: 2.2, x: 780, y: 435, angle: 0, color: '#d90368' },
        { text: 'für immer', count: 9, displayScale: 1.5, x: 2550, y: 530, angle: -90, color: '#6a4c93' },
        { text: 'Zusammen', count: 17, displayScale: 1.02, x: 800, y: 195, angle: 0, color: '#ff7f3f' },
        { text: 'Herzklopfen', count: 6, displayScale: 1.02, x: 1990, y: 570, angle: 0, color: '#d90368' },
        { text: 'Sommerabend', count: 38, displayScale: .78, x: 1995, y: 915, angle: 0, color: '#f45b69' },
        { text: 'Gänsehaut', count: 11, displayScale: 1.02, x: 2000, y: 750, angle: 0, color: '#168f83' },
        { text: 'Vertrauen', count: 27, displayScale: 1.5, x: 1295, y: 505, angle: -90, color: '#6a4c93' },
        { text: 'goldenes Licht', count: 20, displayScale: .72, x: 2000, y: 420, angle: 0, color: '#a40e4c' },
        { text: 'Lachen', count: 32, displayScale: 1.48, x: 1950, y: 220, angle: 0, color: '#f45b69' },
        { text: 'Geborgenheit', count: 4, displayScale: 1.5, x: 1475, y: 505, angle: -90, color: '#ff7f3f' },
        { text: 'Hand in Hand', count: 24, displayScale: .86, x: 780, y: 665, angle: 0, color: '#6a4c93' }
      ];

      // This is the configurator's "Fläche optimal nutzen" print geometry.
      // Keep the landing-page product preview on the exact same optimization
      // path, rather than merely using its rectangular bounds.
      var optimalLayout = [{ x: 36, y: 36, width: 2628, height: 978, optimize: true }];

      // The mug's word cloud is baked onto a canvas texture, so it's invisible
      // to i18n.js's DOM-text scan (unlike the hero's <span> cloud) — the
      // words must be re-translated and the texture redrawn by hand whenever
      // the locale changes.
      function buildDrawTexture() {
        var i18n = window.WolkenworteI18n;
        var translate = i18n && i18n.t ? i18n.t : function (source) { return source; };
        var placed = WORDS.map(function (configuration, index) {
          return {
            id: 'homepage-word-' + index,
            text: translate(configuration.text),
            x: configuration.x,
            y: configuration.y,
            // This is intentionally independent per word: changing one
            // displayScale cannot cause the other manual words to repack.
            fontSize: configuration.fontSize || Math.round(configuration.displayScale * 100),
            angle: configuration.angle,
            color: configuration.color
          };
        });

        return function drawHomepageWords(ctx, metrics) {
          ctx.textAlign = 'center';
          ctx.textBaseline = 'alphabetic';
          placed.forEach(function (item) {
            var x = metrics.offsetX + item.x;
            var y = metrics.offsetY + item.y;
            ctx.font = item.fontSize + 'px ' + WordCloudCore.FONT_FAMILY;
            ctx.fillStyle = item.color;
            if (item.angle === -90) {
              ctx.save();
              ctx.translate(x, y);
              ctx.rotate(-Math.PI / 2);
              ctx.fillText(item.text, 0, item.fontSize * .34);
              ctx.restore();
            } else {
              ctx.fillText(item.text, x, y + item.fontSize * .34);
            }
          });
        };
      }

      var mug = Mug3DViewer.create({
        THREE: window.THREE,
        host: canvas,
        canvas: canvas,
        interactionElement: canvas,
        product: Mug3DViewer.DEFAULT_PRODUCT,
        drawTexture: buildDrawTexture(),
        autoRotate: !reduceMotion,
        autoRotateDurationMs: 9000
      });
      window.addEventListener('resize', mug.resize);

      // Redraw once more after the initial locale's message catalog finishes
      // loading (the first draw above may have run before it arrived), and
      // again on every subsequent language switch.
      if (window.WolkenworteI18n && window.WolkenworteI18n.ready) {
        window.WolkenworteI18n.ready().then(function () { mug.updateTexture(buildDrawTexture()); });
      }
      window.addEventListener('wolkenworte:localechange', function () {
        mug.updateTexture(buildDrawTexture());
      });
    })();
  </script>
</body>
