<!DOCTYPE html>
<html lang="<%= locale %>" data-locale-source="<%= localeSource %>" data-locale-catalog-url="<%= localeCatalogUrl %>" data-locale-catalog-urls="<%= JSON.stringify(localeCatalogUrls) %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#fffdfa" />
  <meta name="description" content="<%= t('Informationen zur Bestellung personalisierter Produkte bei Wolkenworte.') %>" data-i18n-content-source="Informationen zur Bestellung personalisierter Produkte bei Wolkenworte." />
  <link rel="icon" type="image/svg+xml" href="<%= asset('/z_icons/icon.svg') %>" />
  <%- include('partials/site-fonts') %>
  <link rel="stylesheet" href="<%= asset('/i18n.css') %>" />
  <script src="<%= asset('/js/i18n.js') %>"></script>
  <%- include('partials/analytics-head') %>
  <title data-i18n-source="Bestellinformationen – Wolkenworte"><%= t('Bestellinformationen – Wolkenworte') %></title>
  <link rel="stylesheet" href="<%= asset('/legal.css') %>" />
  <link rel="stylesheet" href="<%= asset('/site-header.css') %>" />
  <link rel="stylesheet" href="<%= asset('/site-footer.css') %>" />
  <link rel="stylesheet" href="<%= asset('/mobile-foundation.css') %>" />
  <script src="<%= asset('/js/site-header.js') %>" defer></script>
  <script src="<%= asset('/js/mobile-ui.js') %>" defer></script>
</head>
<body>
  <%- include('partials/site-header') %>

  <main class="legal-main">
    <p class="eyebrow">Rechtliches</p>
    <h1>Bestellinformationen</h1>
    <div class="flourish" aria-hidden="true"><span></span></div>

    <section class="legal-section">
      <h2>Vertragspartner und Kontakt</h2>
      <address>
        <strong><%= pageData.seller.name %></strong><br />
        <% for (const line of pageData.seller.address) { %><%= line %><br /><% } %>
        <a href="mailto:<%= pageData.seller.email %>"><%= pageData.seller.email %></a><br />
        <a href="tel:<%= pageData.seller.phone.replace(/\s/g, '') %>"><%= pageData.seller.phone %></a>
      </address>
      <p><a href="/impressum">Impressum</a></p>
    </section>
    <% for (const section of pageData.purchaseTerms.SECTIONS) { %>
    <section class="legal-section" id="<%= section.id %>">
      <h2 data-i18n-source="<%= section.heading %>"><%= t(section.heading) %></h2>
      <p data-i18n-source="<%= section.text %>"><%= t(section.text) %></p>
    </section>
    <% } %>
  </main>

  <%- include('partials/site-footer', { footerCurrentPage: 'bestellinformationen' }) %>
  <%- include('partials/analytics-ui') %>
</body>
</html>
