<!DOCTYPE html>
<html lang="<%= locale %>" data-locale-source="<%= localeSource %>" data-locale-catalog-url="<%= localeCatalogUrl %>" data-locale-catalog-urls="<%= JSON.stringify(localeCatalogUrls) %>">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" />
  <link rel="icon" type="image/svg+xml" href="<%= asset('/z_icons/icon.svg') %>" />
  <%- include('partials/pwa-head') %>
  <%- include('partials/site-fonts') %>
  <%- include('partials/analytics-head') %>
  <link rel="stylesheet" href="<%= asset('/i18n.css') %>" /><link rel="stylesheet" href="<%= asset('/site-header.css') %>" />
  <link rel="stylesheet" href="<%= asset('/site-footer.css') %>" /><link rel="stylesheet" href="<%= asset('/mobile-foundation.css') %>" />
  <link rel="stylesheet" href="<%= asset('/account.css') %>" />
  <script src="<%= asset('/js/i18n.js') %>"></script><script src="<%= asset('/js/site-header.js') %>" defer></script>
  <title><%= t('Mein Konto – Wolkenworte') %></title>
  <link rel="stylesheet" href="<%= asset('/ui-controls.css') %>" />
</head>
<body class="ww-account-body">
  <% const accountUser = pageData.accountAvailable ? pageData.accountUser || null : null;
     const accountSignedIn = Boolean(accountUser && !accountUser.recovery); %>
  <%- include('partials/site-header') %>
  <main class="ww-account-main<%= accountSignedIn ? '' : ' is-signin' %>" id="account-page" data-page="<%= pageData.accountPage %>" data-return-to="<%= pageData.returnTo %>" data-available="<%= pageData.accountAvailable %>" data-account-user="<%= JSON.stringify(accountUser) %>">
    <div class="ww-account-heading">
      <div class="ww-account-heading-title"><h1>Mein Konto</h1><p class="ww-account-small" data-account-email data-i18n-ignore <%= accountSignedIn ? '' : 'hidden' %>><%= accountSignedIn ? accountUser.email : '' %></p></div>
      <button class="ww-account-signout" type="button" data-account-logout <%= accountSignedIn ? '' : 'hidden' %>>Abmelden</button>
    </div>
    <p id="account-page-status" role="status" aria-live="polite"></p>
    <% if (!pageData.accountAvailable) { %><p>Das Speichern im Konto ist gerade nicht verfügbar. Du kannst weiterhin ohne Konto gestalten und bestellen.</p><% } %>
    <div class="ww-account-signin" data-account-signin <%= accountSignedIn || !pageData.accountAvailable ? 'hidden' : '' %>>
      <%- include('partials/account-auth') %>
    </div>
    <nav class="ww-account-navigation" data-account-navigation role="tablist" aria-label="Mein Konto" <%= accountSignedIn ? '' : 'hidden' %>>
      <button type="button" id="account-designs-tab" data-account-tab="designs" role="tab" aria-selected="true" aria-controls="account-designs-panel">Meine Designs</button>
      <button type="button" id="account-settings-tab" data-account-tab="settings" role="tab" aria-selected="false" aria-controls="account-settings-panel" tabindex="-1">Einstellungen</button>
    </nav>
    <p class="ww-account-small" data-account-loading role="status" <%= accountSignedIn ? '' : 'hidden' %>>Deine Designs werden geladen…</p>
    <section class="ww-design-library" id="account-designs-panel" data-account-library role="tabpanel" aria-labelledby="account-designs-tab" hidden>
      <div class="ww-account-library-heading"><p class="ww-account-small" data-account-usage hidden><span data-account-count></span> · <span data-account-storage></span></p><div class="ww-account-library-toolbar" data-account-library-toolbar><%- include('partials/account-new-design') %></div></div>
      <div class="ww-account-grid" data-account-design-list></div>
      <div class="ww-account-empty" data-account-empty hidden>
        <img src="<%= asset('/z_icons/icon.svg') %>" alt="" aria-hidden="true" width="54" height="50" />
        <h2>Deine Ideen finden hier ihren Platz.</h2>
        <p>Gestalte dein erstes Erinnerungsstück und speichere es hier, um später weiterzumachen.</p>
        <%- include('partials/account-new-design') %>
      </div>
      <p class="ww-account-retention">Designs werden nach drei Monaten ohne Nutzung dauerhaft gelöscht. Öffnen, Speichern oder ein erfolgreicher Kauf verlängern die Frist.</p>
    </section>
    <section id="account-settings-panel" data-account-settings role="tabpanel" aria-labelledby="account-settings-tab" hidden>
      <div class="ww-account-card">
        <h2>E-Mail-Adresse ändern</h2>
        <form data-account-email-form><label>Neue E-Mail-Adresse<input type="email" name="email" autocomplete="email" required maxlength="254" /></label><button class="ww-account-primary" type="submit">Codes anfordern</button></form>
        <div data-account-email-codes hidden><p>Bestätige die bisherige und die neue E-Mail-Adresse mit den beiden Codes.</p>
          <form data-account-email-code="current"><label data-email-code-label>Bisherige E-Mail-Adresse<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /></label><button type="submit">Code bestätigen</button></form>
          <form data-account-email-code="new"><label data-email-code-label>Neue E-Mail-Adresse<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /></label><button type="submit">Code bestätigen</button></form>
        </div>
      </div>
      <div class="ww-account-card"><h2>Passwort ändern</h2>
        <form data-account-password-form><label>Neues Passwort<input type="password" name="password" autocomplete="new-password" minlength="12" maxlength="256" required /></label>
          <label>Passwort wiederholen<input type="password" name="repeat" autocomplete="new-password" minlength="12" maxlength="256" required /></label>
          <label data-account-password-code hidden>Sicherheitscode<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" /></label>
          <button class="ww-account-primary" type="submit">Passwort speichern</button><button type="button" class="ww-account-link" data-account-password-request hidden>Sicherheitscode anfordern</button></form>
      </div>
      <div class="ww-account-card"><h2>Deine Daten</h2><p>Du kannst deine Kontodaten und alle gespeicherten, bearbeitbaren Designs herunterladen.</p>
        <a href="/api/account/export" class="ww-account-link" download>Daten herunterladen</a></div>
      <div class="ww-account-card"><h2>Konto löschen</h2><p>Dein Konto und alle gespeicherten Designs werden dauerhaft gelöscht. Bestehende Warenkorbkopien und notwendige Bestelldaten bleiben davon unabhängig.</p>
        <button class="ww-account-danger" type="button" data-account-delete>Konto dauerhaft löschen</button></div>
    </section>
  </main>
  <dialog class="ww-account-dialog" id="account-confirm-dialog" aria-labelledby="account-confirm-title" aria-describedby="account-confirm-description"><form method="dialog"><div class="ww-account-dialog-head"><h2 id="account-confirm-title" data-confirm-title>Design löschen?</h2><button class="ww-icon-button ww-close-button" value="cancel" aria-label="Schließen"></button></div><p id="account-confirm-description" data-confirm-description></p><label data-confirm-name hidden>Designname<input name="name" maxlength="80" /></label><div class="ww-account-actions"><button value="cancel" data-confirm-cancel>Abbrechen</button><button class="ww-account-primary" value="confirm" data-confirm-action>Bestätigen</button></div></form></dialog>
  <dialog class="ww-account-dialog" id="account-reauth-dialog" aria-labelledby="account-reauth-title"><div class="ww-account-dialog-head"><h2 id="account-reauth-title" tabindex="-1" autofocus>Identität bestätigen</h2><button class="ww-icon-button ww-close-button" type="button" data-reauth-close aria-label="Schließen"></button></div>
    <p>Bestätige deine Identität, bevor du dein Konto dauerhaft löschst.</p><button class="ww-account-primary" type="button" data-reauth-google>Mit Google bestätigen</button>
    <form data-reauth-form><label>Passwort<input type="password" name="password" autocomplete="current-password" required maxlength="256" /></label><button class="ww-account-primary" type="submit">Bestätigen</button></form><p data-reauth-status role="status"></p></dialog>
  <%- include('partials/site-footer') %>
  <%- include('partials/analytics-ui') %>
  <script src="<%= asset('/js/configurator-session.js') %>"></script><script src="<%= asset('/js/design-image-data.js') %>"></script><script src="<%= asset('/js/account.js') %>"></script>
</body></html>
