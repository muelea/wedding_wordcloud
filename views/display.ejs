<dialog class="draft-settings ww-mobile-dialog" id="draft-settings" aria-labelledby="draft-settings-title">
  <form id="draft-settings-form">
    <div class="dialog-heading"><h2 id="draft-settings-title">Wortwolke verwalten</h2><button class="dialog-close" type="button" aria-label="Organisatorbereich schließen" data-i18n-aria-label-source="Organisatorbereich schließen" onclick="this.closest('dialog').close()">×</button></div>
