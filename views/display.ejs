        <span>Per E-Mail teilen</span>
      </a>
      <button class="share-option" id="share-dialog-copy-link" type="button">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 14.5 14.5 9"/><path d="m7.2 17.8-1 1a3.5 3.5 0 0 1-5-5l4-4a3.5 3.5 0 0 1 5 0" transform="translate(3)"/><path d="m16.8 6.2 1-1a3.5 3.5 0 0 1 5 5l-4 4a3.5 3.5 0 0 1-5 0" transform="translate(-3)"/></svg>
