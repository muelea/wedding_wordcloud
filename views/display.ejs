<!DOCTYPE html>
<html lang="<%= locale %>" data-theme="pastel">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="manifest" id="event-manifest" />
  <meta name="theme-color" content="#9c1c4c" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="icon" type="image/svg+xml" href="/z_icons/icon.svg?v=20260829-1" />
  <link rel="stylesheet" href="/site-header.css?v=20260829-2" />
  <link rel="stylesheet" href="/i18n.css?v=20260829-2" />
  <link rel="stylesheet" href="/site-fonts.css?v=20260829-1" />
  <link rel="stylesheet" href="/action-state.css?v=20260829-1" />
  <script src="/js/i18n.js?v=20260829-3"></script>
  <script src="/js/action-state.js?v=20260829-1"></script>
  <script src="/js/site-header.js" defer></script>
  <title data-i18n-source="Wortwolke – Anzeige"><%= t('Wortwolke – Anzeige') %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Pastel theme (default) — matches the landing/create/guest palette ── */
    :root {
      --bg:      #fffdfa;
      --bg2:     #fffdfa;
      --primary: #9c1c4c;
      --accent:  #c1922f;
      --text:    #400f26;
      --muted:   #8a7178;
      --border:  rgba(193,146,47,0.24);
      --rad1:    rgba(247,238,223,0.7);
      --rad2:    rgba(209,96,126,0.08);
      --orn:     rgba(193,146,47,0.55);
      --qr-bd:   rgba(193,146,47,0.35);
      --site-header-height: 85px;
    }

    /* ── Neon theme ── */
    [data-theme="neon"] {
      --bg:      #000000;
      --bg2:     #000000;
      --primary: #ff10f0;
      --accent:  #00fff2;
      --text:    #f5f0ff;
      --muted:   #b39ddb;
      --border:  rgba(255,16,240,0.30);
      --rad1:    rgba(0,255,242,0.22);
      --rad2:    rgba(191,0,255,0.22);
      --orn:     rgba(191,0,255,0.80);
      --qr-bd:   rgba(255,16,240,0.55);
    }

    [data-theme="neon"] body::before {
      background: var(--bg);
    }

    html, body {
      width: 100%; height: 100%;
      overflow: hidden;
      background: var(--bg);
      font-family: 'Jost', system-ui, -apple-system, sans-serif;
      color: var(--text);
      transition: background 0.6s, color 0.6s;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 55% at 15% 10%, var(--rad1) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 85% 90%, var(--rad2) 0%, transparent 60%),
        linear-gradient(160deg, var(--bg) 0%, var(--bg2) 100%);
      pointer-events: none;
      transition: background 0.6s;
    }

    .ww-site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
    }

    .cloud-status {
      position: fixed;
      top: calc(var(--site-header-height) + 26px);
      right: 40px;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 14px;
      pointer-events: none;
    }


    #cloud-container {
      position: fixed;
      top: var(--site-header-height);
      left: 0; right: 0; bottom: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .display-word-entry {
      position: fixed;
      z-index: 12;
      bottom: 116px;
      left: 50%;
      display: flex;
      width: min(560px, calc(100% - 32px));
      min-height: 52px;
      padding: 5px;
      transform: translateX(-50%);
      border: 1px solid var(--border);
      border-radius: 999px;
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      box-shadow: 0 10px 28px rgba(64,15,38,.1);
    }
    .display-word-entry[hidden] { display: none !important; }
    #display-word-input { flex: 1; min-width: 0; padding: 0 15px; border: 0; outline: 0; background: transparent; color: var(--text); font: 16px 'Jost', system-ui, sans-serif; }
    #display-word-submit { padding: 0 19px; border: 0; border-radius: 999px; background: var(--primary); color: #fff; font: 600 13px 'Jost', system-ui, sans-serif; cursor: pointer; }
    #display-word-close { width: 34px; border: 0; background: transparent; color: var(--muted); font: 300 25px/1 system-ui, sans-serif; cursor: pointer; }
    .display-own-words { position: fixed; z-index: 11; bottom: 176px; left: 50%; display: flex; flex-wrap: wrap; justify-content: center; gap: 7px; width: min(560px, calc(100% - 32px)); transform: translateX(-50%); }
    .display-own-words[hidden] { display: none !important; }
    .display-own-word { display: inline-flex; align-items: center; gap: 5px; min-height: 29px; padding: 3px 5px 3px 10px; border: 1px solid var(--border); border-radius: 999px; background: color-mix(in srgb, var(--bg) 94%, transparent); color: var(--text); font-size: 13px; box-shadow: 0 4px 14px rgba(64,15,38,.06); }
    .display-own-remove { width: 22px; height: 22px; border: 0; border-radius: 50%; background: transparent; color: var(--muted); font: 300 19px/1 system-ui, sans-serif; cursor: pointer; }
    .display-own-remove:hover { color: var(--primary); background: rgba(164,14,76,.1); }
    .palette-options { display: grid; gap: 9px; }
    .palette-option { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px; border: 1px solid var(--border); border-radius: 12px; background: transparent; color: var(--text); text-align: left; cursor: pointer; }
    .palette-swatches { display: flex; overflow: hidden; border-radius: 999px; }
    .palette-swatches i { width: 16px; height: 16px; }
    .word-manager { border-top: 1px solid var(--border); padding-top: 14px; }
    .word-manager summary { cursor: pointer; font: 600 15px 'Jost', sans-serif; color: var(--text); }
    .word-manager-list { display: grid; gap: 7px; max-height: 210px; margin: 11px 0 0; overflow: auto; }
    .word-manager-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 38px; padding: 4px 4px 4px 11px; border: 1px solid var(--border); border-radius: 10px; }
    .word-manager-count { color: var(--muted); font-size: 12px; }
    .word-manager-remove { width: 29px; height: 29px; border: 0; border-radius: 50%; background: transparent; color: var(--muted); font: 300 23px/1 system-ui, sans-serif; cursor: pointer; }
    .word-manager-remove:hover { background: rgba(164,14,76,.1); color: var(--primary); }
    .word-manager-empty { margin: 11px 0 0; color: var(--muted); font-size: 13px; }

    #cloud-canvas {
      display: block;
      opacity: 0;
      transition: opacity 0.7s ease;
    }
    #cloud-canvas.visible { opacity: 1; }

    #empty-state {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      transition: opacity 0.5s;
    }
    #empty-state.hidden { opacity: 0; }

    .empty-ornament {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(60px, 8vw, 100px);
      color: var(--rad1);
      line-height: 1;
      opacity: 0.5;
    }
    .empty-text {
      margin-top: 18px;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(18px, 2.5vw, 28px);
      font-style: italic;
      color: var(--muted);
      opacity: 0.7;
      transition: color 0.6s;
    }
    .empty-sub {
      margin-top: 10px;
      font-size: 13px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      opacity: 0.5;
      transition: color 0.6s;
    }

    .footer {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      height: 100px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 40px;
      border-top: 1px solid var(--border);
      transition: border-color 0.6s;
    }

    .footer-event-name {
      min-width: 0;
      max-width: 30vw;
      overflow: hidden;
      color: var(--primary);
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(18px, 2.1vw, 28px);
      font-weight: 400;
      line-height: 1.15;
      text-overflow: ellipsis;
      white-space: nowrap;
      transition: color 0.6s;
    }

    .qr-wrap { display: flex; align-items: center; gap: 14px; }
    .share-save-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 7px; }
    .share-save-actions button { padding: 0; border: 0; background: transparent; color: var(--muted); font: 600 11px/1 'Jost', system-ui, sans-serif; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; }
    .share-save-actions button:hover, .share-save-actions button:focus-visible { color: var(--primary); }

    .qr-label { text-align: right; }
    .qr-label .line1 {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      transition: color 0.6s;
    }
    .qr-label .line2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 14px;
      color: var(--primary);
      margin-top: 2px;
      transition: color 0.6s;
    }

    .qr-code {
      width: 84px; height: 84px;
      border-radius: 10px;
      border: 2px solid var(--qr-bd);
      padding: 3px;
      background: var(--bg);
      transition: border-color 0.6s, background 0.6s;
    }

    .footer-actions {
      display: flex;
      align-items: center;
      gap: 22px;
    }
    .footer-actions button {
      padding: 0;
      border: 0;
      background: transparent;
      font-family: inherit;
      font-size: 11px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--muted);
      opacity: 0.6;
      transition: opacity 0.3s, color 0.6s;
      cursor: pointer;
      user-select: none;
    }
    .footer-actions button:hover,
    .footer-actions button:focus-visible { opacity: 1; }

    /* ── Memory configurator CTA ── */
    #memory-cta {
      display: none;
      align-items: center;
      gap: 10px;
      background: var(--primary);
      color: #fff;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 14px;
      padding: 12px 20px;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      box-shadow: 0 6px 20px var(--border);
      transition: transform 0.15s, background 0.6s;
      pointer-events: auto;
    }
    #memory-cta.visible { display: inline-flex; }
    #memory-cta:hover { transform: translateY(-1px); }

    /* ── Toast ── */
    .toast-container {
      position: fixed;
      bottom: 90px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      pointer-events: none;
      z-index: 20;
    }

    .toast {
      background: var(--primary);
      color: #fff;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 16px;
      padding: 10px 24px;
      border-radius: 999px;
      animation: toastIn 0.3s ease both, toastOut 0.4s ease 1.8s both;
    }

    @keyframes toastIn {
      from { opacity: 0; transform: translateY(12px) scale(0.9); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes toastOut {
      to { opacity: 0; transform: translateY(-8px) scale(0.92); }
    }

    .reset-dialog {
      width: min(440px, calc(100% - 32px));
      margin: auto;
      padding: 0;
      border: 1px solid var(--border);
      border-radius: 24px;
      background: var(--bg);
      color: var(--text);
      box-shadow: 0 24px 70px rgba(64, 15, 38, .22);
    }
    .reset-dialog::backdrop { background: rgba(30, 7, 18, .42); backdrop-filter: blur(4px); }
    .reset-dialog-card { padding: 30px; }
    .reset-dialog h2 { margin: 0; font: 600 27px/1.15 'Playfair Display', Georgia, serif; }
    .reset-dialog-copy { margin: 10px 0 22px; color: var(--muted); font-size: 14px; line-height: 1.55; }
    .reset-dialog label { display: grid; gap: 7px; font-size: 13px; font-weight: 600; }
    .reset-dialog input {
      width: 100%;
      height: 50px;
      padding: 0 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      outline: none;
      background: color-mix(in srgb, var(--bg) 92%, var(--primary));
      color: var(--text);
      font: 18px/1 'Jost', system-ui, sans-serif;
    }
    .reset-dialog input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 13%, transparent); }
    .reset-dialog-error { min-height: 20px; margin: 9px 0 0; color: #b33a4d; font-size: 13px; }
    .reset-dialog-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 17px; }
    .reset-dialog-button {
      min-height: 44px;
      padding: 11px 17px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: transparent;
      color: var(--text);
      cursor: pointer;
      font: 600 13px/1 'Jost', system-ui, sans-serif;
    }
    .reset-dialog-button.primary { border-color: var(--primary); background: var(--primary); color: #fff; }
    .reset-dialog-button:disabled { cursor: wait; opacity: .58; }
    .draft-settings { width: min(420px, calc(100% - 32px)); border: 0; border-radius: 20px; padding: 0; color: var(--text); background: var(--bg); box-shadow: 0 24px 70px rgba(64,15,38,.22); }
    .draft-settings::backdrop { background: rgba(64,15,38,.3); }
    .draft-settings form { padding: 25px; display: grid; gap: 12px; }
    .draft-settings h2 { font: 500 25px 'Playfair Display', Georgia, serif; color: var(--primary); }
    .draft-settings p { color: var(--muted); font-size: 13px; line-height: 1.5; }
    .draft-settings label { display: grid; gap: 6px; color: var(--text); font-size: 14px; font-weight: 600; }
    .draft-settings input { height: 46px; padding: 0 13px; border: 1px solid var(--border); border-radius: 11px; background: var(--bg); color: var(--text); font: 15px 'Jost', sans-serif; }
    .dialog-heading { display: flex; align-items: start; justify-content: space-between; gap: 12px; }
    .dialog-heading h2 { margin: 0; }
    .dialog-close { width: 34px; height: 34px; flex: 0 0 auto; border: 0; border-radius: 50%; background: transparent; color: var(--muted); font: 300 26px/1 system-ui, sans-serif; cursor: pointer; }
    .dialog-close:hover { background: color-mix(in srgb, var(--primary) 8%, transparent); color: var(--primary); }

    @media (max-width: 620px) {
      :root {
        --site-header-height: 73px;
      }

      .cloud-status { top: calc(var(--site-header-height) + 18px); right: 16px; gap: 10px; }
      .word-counter .label { letter-spacing: 1.5px; }
      #memory-cta { padding: 10px 15px; font-size: 12px; }
      #cloud-container { bottom: 90px; }
      .footer { height: 90px; padding: 0 16px; }
      .footer-event-name { max-width: 36vw; font-size: 18px; }
      .footer-actions { display: none; }
      .qr-label .line2 { display: none; }
      .qr-code { width: 72px; height: 72px; }
      .share-save-actions { gap: 8px; }
    }
  </style>
</head>
<body>

<%- include('partials/site-header') %>

<aside class="cloud-status" aria-label="Live-Wortwolke">
  <button id="memory-cta" title="Wortwolke verewigen">
    Wortwolke verewigen
  </button>
</aside>

<div id="cloud-container">
  <canvas id="cloud-canvas"></canvas>
  <div id="empty-state">
    <div class="empty-ornament">♡</div>
    <p class="empty-text">Wir warten auf eure Wörter&hellip;</p>
    <p class="empty-sub">QR-Code scannen &amp; mitmachen</p>
  </div>
</div>

<form class="display-word-entry" id="display-word-entry">
  <input id="display-word-input" maxlength="30" autocomplete="off" placeholder="Gib dein Wort hier ein…" aria-label="Ein Wort eingeben" />
  <button id="display-word-submit" type="submit">Hinzufügen</button>
  <button id="display-word-close" type="button" aria-label="Eingabe schließen" onclick="this.closest('form').hidden = true">×</button>
</form>
<section class="display-own-words" id="display-own-words" aria-label="Deine eingegebenen Wörter" hidden></section>

<footer class="footer">
  <span class="footer-event-name" id="couple-name" data-i18n-ignore>♡</span>
  <div class="footer-actions">
    <button id="draft-settings-button" type="button" hidden>Einstellungen</button>
  </div>
  <div class="qr-wrap">
    <div class="share-save-actions">
      <button id="share-cloud" type="button">Teilen</button>
      <button id="save-cloud" type="button">Speichern</button>
    </div>
    <div class="qr-label">
      <div class="line1">Scannen &amp; mitmachen</div>
      <div class="line2" id="qr-url"></div>
    </div>
    <img class="qr-code" id="qr-img" src="" alt="QR-Code" />
  </div>
</footer>

<div class="toast-container" id="toast-container"></div>

<dialog class="reset-dialog" id="reset-dialog" aria-labelledby="reset-dialog-title">
  <form class="reset-dialog-card" id="reset-form">
    <h2 id="reset-dialog-title">Neue Runde starten?</h2>
    <p class="reset-dialog-copy">Die aktuellen Wörter werden archiviert. Anschließend beginnt eure Wortwolke wieder leer.</p>
    <label for="reset-pin">Admin-PIN
      <input id="reset-pin" type="tel" inputmode="numeric" pattern="[0-9]*" minlength="4" maxlength="6" autocomplete="off" required />
    </label>
    <p class="reset-dialog-error" id="reset-error" role="alert" aria-live="polite"></p>
    <div class="reset-dialog-actions">
      <button class="reset-dialog-button" id="reset-cancel" type="button">Abbrechen</button>
      <button class="reset-dialog-button primary" id="reset-submit" type="submit">Neue Runde starten</button>
    </div>
  </form>
</dialog>

<dialog class="draft-settings" id="save-cloud-dialog" aria-labelledby="save-cloud-title">
  <form method="dialog">
    <div class="dialog-heading"><h2 id="save-cloud-title">Wortwolke speichern</h2><button class="dialog-close" type="submit" aria-label="Hinweis schließen">×</button></div>
    <p>Ihr könnt diese Wortwolke als App auf eurem Gerät ablegen und später direkt wieder öffnen.</p>
    <p><strong>iPhone / iPad:</strong> Im Teilen-Menü auf „Zum Home-Bildschirm“ tippen.</p>
    <p><strong>Computer oder Android:</strong> Im Browser-Menü „Installieren“ oder „App installieren“ wählen.</p>
  </form>
</dialog>

<dialog class="draft-settings" id="draft-settings" aria-labelledby="draft-settings-title">
  <form id="draft-settings-form">
    <div class="dialog-heading"><h2 id="draft-settings-title">Einstellungen</h2><button class="dialog-close" type="button" aria-label="Einstellungen schließen" onclick="this.closest('dialog').close()">×</button></div>
    <p>Gebt eurer Wortwolke einen Namen, ergänzt euren Anlass und wählt eine Farbwelt.</p>
    <label for="draft-name">Für wen ist diese Wortwolke?
      <input id="draft-name" maxlength="80" placeholder="z. B. Lea &amp; Max" required />
    </label>
    <label for="draft-event-label">Für welches Event? <span style="font-weight:400">(optional)</span>
      <input id="draft-event-label" maxlength="80" placeholder="z. B. unsere Hochzeit" />
    </label>
    <div><h2 style="font-size:20px">Farbwelt</h2><div class="palette-options" id="palette-options"></div></div>
    <details class="word-manager" id="word-manager"><summary>Wörter verwalten</summary><div class="word-manager-list" id="word-manager-list"></div><p class="word-manager-empty" id="word-manager-empty" hidden>Noch keine Wörter vorhanden.</p></details>
    <button class="reset-dialog-button" id="show-word-entry" type="button">Eingabefeld anzeigen</button>
    <p class="reset-dialog-error" id="draft-settings-error" role="alert" aria-live="polite"></p>
    <button class="reset-dialog-button primary" type="submit">Speichern</button>
  </form>
</dialog>

<dialog class="draft-settings" id="pin-choice-dialog" aria-labelledby="pin-choice-title">
  <form method="dialog">
    <h2 id="pin-choice-title">Einstellungen schützen?</h2>
    <p>Möchtet ihr einen Admin-PIN festlegen? Damit können nur Personen mit dem PIN die Einstellungen ändern.</p>
    <div class="reset-dialog-actions">
      <button class="reset-dialog-button" id="pin-choice-no" value="cancel" type="button">Ohne PIN fortfahren</button>
      <button class="reset-dialog-button primary" id="pin-choice-yes" value="default" type="button">PIN festlegen</button>
    </div>
  </form>
</dialog>

<dialog class="draft-settings" id="pin-setup-dialog" aria-labelledby="pin-setup-title">
  <form id="pin-setup-form">
    <h2 id="pin-setup-title">Admin-PIN festlegen</h2>
    <p>Dieser PIN schützt spätere Änderungen an eurer Wortwolke.</p>
    <input id="pin-setup-input" type="tel" inputmode="numeric" pattern="[0-9]*" minlength="4" maxlength="6" autocomplete="off" placeholder="PIN mit 4–6 Ziffern" required />
    <p class="reset-dialog-error" id="pin-setup-error" role="alert" aria-live="polite"></p>
    <button class="reset-dialog-button primary" type="submit">Weiter zu Einstellungen</button>
  </form>
</dialog>

<dialog class="draft-settings" id="pin-unlock-dialog" aria-labelledby="pin-unlock-title">
  <form id="pin-unlock-form">
    <h2 id="pin-unlock-title">Admin-PIN eingeben</h2>
    <p>Gebt den Admin-PIN ein, um die Einstellungen zu ändern.</p>
    <input id="pin-unlock-input" type="tel" inputmode="numeric" pattern="[0-9]*" minlength="4" maxlength="6" autocomplete="off" placeholder="Admin-PIN" required />
    <p class="reset-dialog-error" id="pin-unlock-error" role="alert" aria-live="polite"></p>
    <button class="reset-dialog-button primary" type="submit">Weiter</button>
  </form>
</dialog>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/wordcloud-core.js?v=20260819-2"></script>
<script>
  // Slug comes from the canonical event URL: /e/<slug>
  const slug = location.pathname.split('/').filter(Boolean)[1];
  document.getElementById('event-manifest').href = `/e/${encodeURIComponent(slug)}/manifest.webmanifest`;

  const canvas         = document.getElementById('cloud-canvas');
  const ctx             = canvas.getContext('2d');
  const container       = document.getElementById('cloud-container');
  const emptyState      = document.getElementById('empty-state');
  const toastContainer  = document.getElementById('toast-container');
  const memoryCta       = document.getElementById('memory-cta');
  const resetDialog     = document.getElementById('reset-dialog');
  const resetForm       = document.getElementById('reset-form');
  const resetPin        = document.getElementById('reset-pin');
  const resetError      = document.getElementById('reset-error');
  const resetCancel     = document.getElementById('reset-cancel');
  const resetSubmit     = document.getElementById('reset-submit');
  const displayWordEntry = document.getElementById('display-word-entry');
  const displayWordInput = document.getElementById('display-word-input');
  const displayOwnWords = document.getElementById('display-own-words');
  const draftSettings = document.getElementById('draft-settings');
  const draftSettingsButton = document.getElementById('draft-settings-button');
  let eventHasAdminPin = false;
  let eventIsDraft = false;
  let unlockedAdminPin = '';
  let pendingAdminPin = '';
  let eventUrl = '';
  let cloudName = '';
  let cloudEventLabel = '';
  let deferredInstallPrompt = null;
  const ownDisplayWords = new Map();
  const t = (source, params) => WolkenworteI18n.t(source, params);
  const setText = (element, source, params) => WolkenworteI18n.setText(element, source, params);
  const clearText = (element) => WolkenworteI18n.clearText(element);

  let currentWords = [];
  let renderTimer  = null;
  let lastWords    = null;
  const PALETTES = {
    pastel: { label: 'Sorbet Pop', colors: ['#a40e4c', '#d90368', '#f45b69', '#ff7f3f', '#6a4c93', '#168f83'], background: ['#fffdfa', '#fff3f5', 'rgba(247,238,223,.7)', 'rgba(209,96,126,.08)'] },
    'sage-gold': { label: 'Smaragd & Gold', colors: ['#063e36', '#006d5b', '#14967f', '#8f6100', '#d0920f', '#654100'], background: ['#f7fbf5', '#edf6ef', 'rgba(20,150,127,.13)', 'rgba(208,146,15,.10)'] },
    ocean: { label: 'Ocean Electric', colors: ['#003049', '#00509d', '#0077b6', '#0096c7', '#00a6a6', '#136f63'], background: ['#f4f9fc', '#eaf4fa', 'rgba(0,119,182,.13)', 'rgba(0,166,166,.10)'] },
  };
  let getWordColor = WordCloudCore.makePaletteAssigner(PALETTES.pastel.colors);

  // ── Theme ─────────────────────────────────────────────────────────────────
  const urlTheme = new URLSearchParams(location.search).get('theme');
  let currentTheme = (urlTheme === 'neon' || urlTheme === 'pastel') ? urlTheme : 'pastel';

  function applyTheme(t) {
    currentTheme = t;
    document.documentElement.dataset.theme = t;
    if (currentWords.length > 0) scheduleRender(currentWords);
  }
  function applyPalette(key) {
    const palette = PALETTES[key] || PALETTES.pastel;
    const root = document.documentElement.style;
    getWordColor = WordCloudCore.makePaletteAssigner(palette.colors);
    root.setProperty('--primary', palette.colors[0]);
    root.setProperty('--accent', palette.colors[4]);
    root.setProperty('--bg', palette.background[0]); root.setProperty('--bg2', palette.background[1]);
    root.setProperty('--rad1', palette.background[2]); root.setProperty('--rad2', palette.background[3]);
    if (currentWords.length) scheduleRender(currentWords);
  }

  function renderCloud(words) {
    if (!words || words.length === 0) return;

    const rect = container.getBoundingClientRect();
    const side = Math.min(rect.width, rect.height) * 0.94;
    canvas.width = side;
    canvas.height = side;

    const placed = WordCloudCore.layoutWords(words, side, ctx, getWordColor);

    ctx.clearRect(0, 0, side, side);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    for (const p of placed) {
      ctx.font = `${p.fontPx}px ${WordCloudCore.FONT_FAMILY}`;
      ctx.fillStyle = p.color;
      if (p.rotated) {
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(-Math.PI / 2);
        ctx.fillText(p.word, 0, p.fontPx * 0.34);
        ctx.restore();
      } else {
        ctx.fillText(p.word, p.x, p.y + p.fontPx * 0.34);
      }
    }
    canvas.classList.add('visible');
  }

  function scheduleRender(words) {
    clearTimeout(renderTimer);
    renderTimer = setTimeout(() => renderCloud(words), 300);
  }

  function showToast(word) {
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = '✦  ' + word;
    toastContainer.appendChild(toast);
    setTimeout(() => toast.remove(), 2400);
  }

  // ── Config & QR ──────────────────────────────────────────────────────────
  fetch(`/api/events/${encodeURIComponent(slug)}`).then(r => r.json()).then(async ({ coupleName, eventLabel, theme, locale, isDraft, isDraftOwner, hasAdminPin }) => {
    await WolkenworteI18n.useEventLocale(locale);
    document.getElementById('couple-name').textContent = coupleName;
    cloudName = coupleName || '';
    cloudEventLabel = eventLabel || '';
    setText(document.querySelector('title'), '{{name}} – Wortwolke', { name: coupleName });
    if (!urlTheme && (theme === 'neon' || theme === 'pastel')) applyTheme(theme);
    draftSettingsButton.hidden = false;
    eventHasAdminPin = hasAdminPin === true;
    eventIsDraft = isDraft === true;
    document.getElementById('draft-name').value = coupleName || '';
    document.getElementById('draft-event-label').value = eventLabel || '';
    if (isDraftOwner) displayWordInput.focus();
  }).catch(() => {});

  fetch(`/api/events/${encodeURIComponent(slug)}/qr`).then(r => r.json()).then(({ dataUrl, url }) => {
    document.getElementById('qr-img').src = dataUrl;
    document.getElementById('qr-url').textContent = url.replace('http://', '').replace('https://', '');
    eventUrl = url;
  }).catch(() => {});

  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    deferredInstallPrompt = event;
  });
  window.addEventListener('appinstalled', () => {
    deferredInstallPrompt = null;
    document.getElementById('save-cloud').textContent = 'Gespeichert ✓';
  });
  document.getElementById('share-cloud').addEventListener('click', async () => {
    const url = eventUrl || `${location.origin}/e/${encodeURIComponent(slug)}`;
    const eventSuffix = cloudEventLabel ? ` zum ${cloudEventLabel}` : '';
    const message = `Hallo,\n\ndu bist herzlich eingeladen, dich an der Wortwolke für ${cloudName || 'uns'}${eventSuffix} zu beteiligen.\n\nWort eingeben & Wortwolke ansehen: ${url}`;
    try {
      if (navigator.share) {
        await navigator.share({ title: `Wortwolke für ${cloudName || 'uns'}`, text: message });
        return;
      }
      if (navigator.clipboard && window.isSecureContext) await navigator.clipboard.writeText(message);
      else {
        const temporaryInput = document.createElement('textarea');
        temporaryInput.value = message; temporaryInput.setAttribute('readonly', '');
        temporaryInput.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
        document.body.appendChild(temporaryInput); temporaryInput.select();
        const copied = document.execCommand('copy'); temporaryInput.remove();
        if (!copied) throw new Error('copy_failed');
      }
      document.getElementById('share-cloud').textContent = 'Link kopiert ✓';
      setTimeout(() => { document.getElementById('share-cloud').textContent = 'Teilen'; }, 1800);
    } catch (error) {
      if (error?.name !== 'AbortError') document.getElementById('share-cloud').textContent = 'Link kopieren';
    }
  });
  document.getElementById('save-cloud').addEventListener('click', async () => {
    if (deferredInstallPrompt) {
      deferredInstallPrompt.prompt();
      await deferredInstallPrompt.userChoice;
      deferredInstallPrompt = null;
      return;
    }
    document.getElementById('save-cloud-dialog').showModal();
  });

  applyTheme(currentTheme);

  // ── Socket (room-scoped to this event via ?slug=) ───────────────────────
  function getOrCreateGuestId() {
    const storageKey = `guest-session:${slug}`;
    try {
      const existing = sessionStorage.getItem(storageKey);
      if (/^[a-f0-9]{32}$/.test(existing || '')) return existing;
    } catch {}
    const bytes = new Uint8Array(16);
    if (window.crypto?.getRandomValues) window.crypto.getRandomValues(bytes);
    else for (let index = 0; index < bytes.length; index += 1) bytes[index] = Math.floor(Math.random() * 256);
    const guestId = [...bytes].map((byte) => byte.toString(16).padStart(2, '0')).join('');
    try { sessionStorage.setItem(storageKey, guestId); } catch {}
    return guestId;
  }
  const guestId = getOrCreateGuestId();
  const socket = io({
    query: { slug, guestId },
    transports: ['websocket', 'polling'],
    tryAllTransports: true,
    timeout: 7000,
  });
  displayWordEntry.addEventListener('submit', (event) => {
    event.preventDefault();
    const word = displayWordInput.value.trim();
    if (!word) return;
    socket.emit('submit-word', word);
    displayWordInput.value = '';
  });
  document.getElementById('display-word-close').addEventListener('click', () => { displayWordEntry.hidden = true; });
  function addOwnDisplayWord(word, receipt) {
    if (!word || !receipt || ownDisplayWords.has(receipt)) return;
    const tag = document.createElement('span'); tag.className = 'display-own-word';
    const label = document.createElement('span'); label.textContent = word;
    const remove = document.createElement('button'); remove.className = 'display-own-remove'; remove.type = 'button'; remove.textContent = '×';
    remove.setAttribute('aria-label', `„${word}“ entfernen`);
    remove.addEventListener('click', () => {
      remove.disabled = true;
      socket.emit('remove-word', { receipt }, (result) => {
        if (result?.ok || result?.error === 'not_found') {
          ownDisplayWords.delete(receipt); tag.remove();
          displayOwnWords.hidden = ownDisplayWords.size === 0;
        } else remove.disabled = false;
      });
    });
    tag.append(label, remove); displayOwnWords.appendChild(tag);
    ownDisplayWords.set(receipt, tag); displayOwnWords.hidden = false;
  }
  function renderOwnDisplayWords(contributions) {
    ownDisplayWords.clear(); displayOwnWords.replaceChildren();
    for (const contribution of Array.isArray(contributions) ? contributions : []) addOwnDisplayWord(contribution?.word, contribution?.receipt);
    displayOwnWords.hidden = ownDisplayWords.size === 0;
  }
  socket.on('own-word-update', renderOwnDisplayWords);
  socket.on('word-accepted', (word, receipt) => addOwnDisplayWord(word, receipt));
  for (const [key, palette] of Object.entries(PALETTES)) {
    const button = document.createElement('button'); button.className = 'palette-option'; button.type = 'button';
    button.innerHTML = `<strong>${palette.label}</strong><span class="palette-swatches">${palette.colors.map((color) => `<i style="background:${color}"></i>`).join('')}</span>`;
    button.addEventListener('click', () => applyPalette(key));
    document.getElementById('palette-options').appendChild(button);
  }
  applyPalette('pastel');
  function openSettings() {
    document.getElementById('draft-settings-error').textContent = '';
    renderWordManager();
    draftSettings.showModal();
    document.getElementById('draft-name').focus();
  }
  draftSettingsButton.addEventListener('click', () => {
    unlockedAdminPin = ''; pendingAdminPin = '';
    if (eventHasAdminPin) {
      document.getElementById('pin-unlock-input').value = '';
      document.getElementById('pin-unlock-error').textContent = '';
      document.getElementById('pin-unlock-dialog').showModal();
      document.getElementById('pin-unlock-input').focus();
    } else if (eventIsDraft) {
      document.getElementById('pin-choice-dialog').showModal();
    } else openSettings();
  });
  document.getElementById('pin-choice-no').addEventListener('click', () => {
    document.getElementById('pin-choice-dialog').close(); openSettings();
  });
  document.getElementById('pin-choice-yes').addEventListener('click', () => {
    document.getElementById('pin-choice-dialog').close();
    document.getElementById('pin-setup-input').value = '';
    document.getElementById('pin-setup-error').textContent = '';
    document.getElementById('pin-setup-dialog').showModal();
    document.getElementById('pin-setup-input').focus();
  });
  document.getElementById('pin-setup-form').addEventListener('submit', (event) => {
    event.preventDefault();
    const pin = document.getElementById('pin-setup-input').value.trim();
    if (!/^\d{4,6}$/.test(pin)) { document.getElementById('pin-setup-error').textContent = 'Bitte 4–6 Ziffern eingeben.'; return; }
    pendingAdminPin = pin;
    document.getElementById('pin-setup-dialog').close(); openSettings();
  });
  document.getElementById('pin-unlock-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const pin = document.getElementById('pin-unlock-input').value.trim();
    const response = await fetch(`/api/events/${encodeURIComponent(slug)}/verify-settings-pin`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin }) });
    if (!response.ok) { document.getElementById('pin-unlock-error').textContent = 'Der Admin-PIN ist nicht korrekt.'; return; }
    unlockedAdminPin = pin;
    document.getElementById('pin-unlock-dialog').close(); openSettings();
  });
  document.getElementById('show-word-entry').addEventListener('click', () => {
    displayWordEntry.hidden = false;
    draftSettings.close();
    displayWordInput.focus();
  });
  function renderWordManager() {
    const list = document.getElementById('word-manager-list');
    const empty = document.getElementById('word-manager-empty');
    list.replaceChildren();
    const words = [...currentWords].sort(([a], [b]) => a.localeCompare(b, 'de'));
    empty.hidden = words.length > 0;
    for (const [word, count] of words) {
      const item = document.createElement('div'); item.className = 'word-manager-item';
      const label = document.createElement('span'); label.textContent = word;
      const countLabel = document.createElement('span'); countLabel.className = 'word-manager-count'; countLabel.textContent = count > 1 ? `× ${count}` : '';
      const remove = document.createElement('button'); remove.className = 'word-manager-remove'; remove.type = 'button'; remove.textContent = '×'; remove.setAttribute('aria-label', `„${word}“ entfernen`);
      remove.addEventListener('click', async () => {
        remove.disabled = true;
        const response = await fetch(`/api/events/${encodeURIComponent(slug)}/remove-word`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ word, pin: unlockedAdminPin }) });
        if (!response.ok) { document.getElementById('draft-settings-error').textContent = 'Das Wort konnte nicht entfernt werden.'; remove.disabled = false; }
      });
      const left = document.createElement('span'); left.append(label, countLabel);
      item.append(left, remove); list.appendChild(item);
    }
  }
  document.getElementById('draft-settings-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const coupleName = document.getElementById('draft-name').value.trim();
    const eventLabel = document.getElementById('draft-event-label').value.trim();
    if (!coupleName) return;
    const response = await fetch(`/api/events/${encodeURIComponent(slug)}/settings`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ coupleName, eventLabel, pin: unlockedAdminPin, newPin: pendingAdminPin }) });
    if (!response.ok) {
      document.getElementById('draft-settings-error').textContent = response.status === 401
        ? 'Der Admin-PIN ist nicht korrekt.'
        : 'Die Einstellungen konnten nicht gespeichert werden.';
      return;
    }
    document.getElementById('couple-name').textContent = coupleName;
    cloudName = coupleName;
    cloudEventLabel = eventLabel;
    eventHasAdminPin = eventHasAdminPin || Boolean(pendingAdminPin);
    eventIsDraft = false;
    draftSettings.close();
  });
  let socketHasConnected = false;
  socket.on('connect_error', () => {
    if (!socketHasConnected) socket.io.opts.transports = ['polling', 'websocket'];
  });
  socket.on('connect', () => {
    socketHasConnected = true;
    socket.io.opts.transports = ['websocket', 'polling'];
  });

  socket.on('word-update', (words) => {
    currentWords = words;
    if (draftSettings.open) renderWordManager();
    memoryCta.classList.toggle('visible', words.length > 0);

    if (words.length === 0) {
      emptyState.classList.remove('hidden');
      canvas.classList.remove('visible');
      return;
    }
    emptyState.classList.add('hidden');

    if (lastWords) {
      const prev = new Map(lastWords);
      for (const [word, count] of words) {
        if (!prev.has(word) || prev.get(word) < count) { showToast(word); break; }
      }
    }
    lastWords = words;
    scheduleRender(words);
  });

  socket.on('theme-change', (t) => {
    if (t === 'neon' || t === 'pastel') applyTheme(t);
  });

  socket.on('fatal-error', () => {
    const errorState = document.createElement('p');
    errorState.style.cssText = 'padding:60px;font-family:Georgia,serif;';
    setText(errorState, 'Diese Wortwolke wurde nicht gefunden.');
    document.body.replaceChildren(errorState);
  });

  // ── New session (archive current words on the server, then clear) ───────
  function startNewSession() {
    if (!currentWords.length) return;
    clearText(resetError);
    resetDialog.showModal();
    resetPin.focus();
  }

  resetCancel.addEventListener('click', () => resetDialog.close());
  resetDialog.addEventListener('close', () => {
    resetForm.reset();
    clearText(resetError);
  });

  resetForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!resetForm.reportValidity()) return;
    clearText(resetError);
    WolkenworteActions.setBusy(resetSubmit, true);
    resetCancel.disabled = true;
    const pin = resetPin.value.trim();
    const res = await fetch(`/api/events/${encodeURIComponent(slug)}/reset`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pin }),
    }).catch(() => null);
    if (res?.ok) {
      resetDialog.close();
    } else if (res?.status === 401) {
      setText(resetError, 'Falscher PIN.');
      resetPin.select();
    } else if (res?.status === 429) {
      setText(resetError, 'Zu viele Versuche. Bitte wartet 15 Minuten.');
    } else {
      setText(resetError, 'Verbindung fehlgeschlagen. Bitte versucht es erneut.');
    }
    WolkenworteActions.setBusy(resetSubmit, false);
    resetCancel.disabled = false;
  });

  // ── Product configurator ──────────────────────────────────────────────────
  memoryCta.addEventListener('click', () => {
    location.href = `/e/${encodeURIComponent(slug)}/configure`;
  });

  (function handleCheckoutRedirect() {
    const params = new URLSearchParams(location.search);
    if (params.get('checkout') === 'success') {
      showToast(t('Bestellung erfolgreich! Danke euch. ♡'));
    } else if (params.get('checkout') === 'cancelled') {
      showToast(t('Bestellung abgebrochen.'));
    }
  })();

  // ── Resize ───────────────────────────────────────────────────────────────
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (currentWords.length > 0) renderCloud(currentWords);
    }, 200);
  });
</script>
</body>
</html>
