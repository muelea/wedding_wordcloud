      <input id="pin-change-confirmation" type="tel" inputmode="numeric" pattern="[0-9]*" minlength="4" maxlength="6" autocomplete="off" placeholder="PIN erneut eingeben" required />
    </label>
    <p class="reset-dialog-error" id="pin-change-error" role="alert" aria-live="polite"></p>
    <button class="reset-dialog-button primary" type="submit">PIN ändern</button>
