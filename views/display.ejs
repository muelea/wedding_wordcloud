<!DOCTYPE html>
<html lang="<%= locale %>" data-theme="pastel">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" id="theme-color" content="#fffdfa" />
  <link rel="icon" type="image/svg+xml" href="<%= asset('/z_icons/icon.svg') %>" />
  <link rel="stylesheet" href="<%= asset('/site-header.css') %>" />
  <link rel="stylesheet" href="<%= asset('/i18n.css') %>" />
  <link rel="stylesheet" href="<%= asset('/site-fonts.css') %>" />
  <link rel="stylesheet" href="<%= asset('/action-state.css') %>" />
  <script src="<%= asset('/js/i18n.js') %>"></script>
  <script src="<%= asset('/js/action-state.js') %>"></script>
  <script src="<%= asset('/js/site-header.js') %>" defer></script>
  <title data-i18n-ignore><%= t('{{name}} – Wortwolke', { name: pageData.cloudTitle }) %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Pastel theme (default) — matches the landing/create/guest palette ── */
    :root {
      --bg:      #fffdfa;
      --bg2:     #fffdfa;
      --primary: #9c1c4c;
      --accent:  #c1922f;
      --text:    #400f26;
      --muted:   #8a7178;
      --border:  rgba(193,146,47,0.24);
      --rad1:    rgba(247,238,223,0.7);
      --rad2:    rgba(209,96,126,0.08);
      --orn:     rgba(193,146,47,0.55);
      --qr-bd:   rgba(193,146,47,0.35);
      --site-header-height: calc(85px + env(safe-area-inset-top, 0px));
      --footer-height: 100px;
    }

    /* ── Neon theme ── */
    [data-theme="neon"] {
      --bg:      #000000;
      --bg2:     #000000;
      --primary: #ff10f0;
      --accent:  #00fff2;
      --text:    #f5f0ff;
      --muted:   #b39ddb;
      --border:  rgba(255,16,240,0.30);
      --rad1:    rgba(0,255,242,0.22);
      --rad2:    rgba(191,0,255,0.22);
      --orn:     rgba(191,0,255,0.80);
      --qr-bd:   rgba(255,16,240,0.55);
    }

    [data-theme="neon"] body::before {
      background: var(--bg);
    }

    html, body {
      width: 100%; height: 100%;
      overflow: hidden;
      background: var(--bg);
      font-family: 'Jost', system-ui, -apple-system, sans-serif;
      color: var(--text);
      transition: background 0.6s, color 0.6s;
    }

    @supports (height: 100dvh) {
      html, body { height: 100dvh; }
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 55% at 15% 10%, var(--rad1) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 85% 90%, var(--rad2) 0%, transparent 60%),
        linear-gradient(160deg, var(--bg) 0%, var(--bg2) 100%);
      pointer-events: none;
      transition: background 0.6s;
    }

    .ww-site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding-top: env(safe-area-inset-top, 0px);
    }

    #cloud-container {
      position: fixed;
      top: var(--site-header-height);
      left: 0; right: 0;
      bottom: calc(var(--footer-height) + env(safe-area-inset-bottom, 0px) + 80px);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .display-word-entry {
      position: fixed;
      z-index: 12;
      bottom: calc(var(--footer-height) + env(safe-area-inset-bottom, 0px) + 16px);
      left: 50%;
      display: flex;
      width: min(560px, calc(100% - 32px));
      min-height: 52px;
      padding: 5px;
      transform: translateX(-50%);
      border: 1px solid var(--border);
      border-radius: 999px;
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      box-shadow: 0 10px 28px rgba(64,15,38,.1);
    }
    #display-word-input { flex: 1; min-width: 0; padding: 0 15px; border: 0; outline: 0; background: transparent; color: var(--text); font: 16px 'Jost', system-ui, sans-serif; }
    #display-word-submit { padding: 0 19px; border: 0; border-radius: 999px; background: var(--primary); color: #fff; font: 600 13px 'Jost', system-ui, sans-serif; cursor: pointer; }
    .ww-display-header-actions { display: flex; align-items: center; gap: 10px; min-width: 0; margin-left: auto; }
    .ww-display-menu { position: relative; z-index: 10000; flex: 0 0 auto; }
    .ww-display-menu summary { list-style: none; }
    .ww-display-menu summary::-webkit-details-marker { display: none; }
    .ww-display-menu-trigger {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid color-mix(in srgb, var(--text) 13%, transparent);
      border-radius: 50%;
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      color: var(--text);
      box-shadow: 0 5px 18px rgba(64,15,38,.08);
      cursor: pointer;
    }
    .ww-display-menu-trigger:hover, .ww-display-menu-trigger:focus-visible, .ww-display-menu[open] .ww-display-menu-trigger { border-color: color-mix(in srgb, var(--primary) 45%, transparent); color: var(--primary); }
    .ww-display-menu-trigger:focus-visible { outline: 2px solid color-mix(in srgb, var(--primary) 55%, transparent); outline-offset: 3px; }
    .ww-display-menu-icon { display: flex; width: 18px; flex-direction: column; align-items: center; gap: 4px; }
    .ww-display-menu-icon i { display: block; width: 18px; min-width: 18px; max-width: 18px; height: 2px; flex: 0 0 2px; border-radius: 999px; background: currentColor; transition: transform .18s ease, opacity .18s ease; }
    .ww-display-menu[open] .ww-display-menu-icon i:first-child { transform: translateY(6px) rotate(45deg); }
    .ww-display-menu[open] .ww-display-menu-icon i:nth-child(2) { opacity: 0; }
    .ww-display-menu[open] .ww-display-menu-icon i:last-child { transform: translateY(-6px) rotate(-45deg); }
    .ww-display-menu-panel {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      width: min(330px, calc(100vw - 32px));
      padding: 14px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: color-mix(in srgb, var(--bg) 97%, transparent);
      color: var(--text);
      box-shadow: 0 22px 60px rgba(64,15,38,.18);
      backdrop-filter: blur(18px) saturate(1.25);
      -webkit-backdrop-filter: blur(18px) saturate(1.25);
    }
    .ww-display-menu-language-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 0 4px; }
    .ww-display-menu-palette-row { display: grid; gap: 8px; margin-top: 10px; padding: 12px 4px 0; border-top: 1px solid var(--border); }
    .ww-display-menu-palette-control { min-width: 0; }
    .ww-palette-picker { position: relative; width: 100%; }
    .ww-palette-picker[open] { z-index: 2; }
    .ww-palette-picker summary { list-style: none; }
    .ww-palette-picker summary::-webkit-details-marker { display: none; }
    .ww-palette-trigger,
    .ww-palette-option {
      appearance: none;
      -webkit-appearance: none;
      color: var(--text);
      font: 600 13px 'Jost', system-ui, sans-serif;
      cursor: pointer;
    }
    .ww-palette-trigger {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      height: 44px;
      padding: 0 11px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: color-mix(in srgb, var(--bg) 96%, transparent);
      box-shadow: 0 4px 14px rgba(64,15,38,.05);
      transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
    }
    .ww-palette-trigger:hover,
    .ww-palette-picker[open] .ww-palette-trigger { border-color: color-mix(in srgb, var(--primary) 38%, var(--border)); background: var(--bg); box-shadow: 0 6px 18px rgba(64,15,38,.09); }
    .ww-palette-trigger:focus-visible,
    .ww-palette-option:focus-visible { outline: 2px solid color-mix(in srgb, var(--primary) 50%, transparent); outline-offset: 2px; }
    .ww-palette-swatches { display: flex; width: 58px; height: 20px; flex: 0 0 58px; overflow: hidden; border-radius: 999px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent); }
    .ww-palette-swatches i { min-width: 0; flex: 1 1 0; }
    .ww-palette-current { min-width: 0; flex: 1 1 auto; overflow: hidden; text-align: left; text-overflow: ellipsis; white-space: nowrap; }
    .ww-palette-chevron { width: 7px; height: 7px; flex: 0 0 7px; margin: -3px 2px 0 3px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; opacity: .58; transform: rotate(45deg); transition: transform .18s ease, margin .18s ease; }
    .ww-palette-picker[open] .ww-palette-chevron { margin-top: 3px; transform: rotate(225deg); }
    .ww-palette-menu {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      left: 0;
      display: grid;
      gap: 3px;
      padding: 6px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: color-mix(in srgb, var(--bg) 98%, transparent);
      box-shadow: 0 18px 42px rgba(64,15,38,.16);
      backdrop-filter: blur(18px) saturate(1.25);
      -webkit-backdrop-filter: blur(18px) saturate(1.25);
    }
    .ww-palette-option { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 42px; padding: 7px 9px; border: 0; border-radius: 10px; background: transparent; text-align: left; transition: color .14s ease, background .14s ease; }
    .ww-palette-option:hover,
    .ww-palette-option:focus-visible { background: color-mix(in srgb, var(--primary) 7%, transparent); }
    .ww-palette-option.is-selected { background: color-mix(in srgb, var(--primary) 11%, transparent); color: var(--primary); }
    .ww-palette-option-name { min-width: 0; flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ww-palette-check { flex: 0 0 14px; color: var(--primary); opacity: 0; text-align: center; }
    .ww-palette-option.is-selected .ww-palette-check { opacity: 1; }
    .ww-display-menu-label { padding: 0 4px; color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; }
    .ww-display-menu-language { width: auto; flex: 0 0 auto; }
    .ww-display-menu-actions { display: grid; gap: 4px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); }
    .ww-display-menu-action {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      min-height: 44px;
      padding: 0 11px;
      border: 0;
      border-radius: 11px;
      background: transparent;
      color: var(--text);
      font: 600 14px 'Jost', system-ui, sans-serif;
      text-align: left;
      cursor: pointer;
    }
    .ww-display-menu-action:hover, .ww-display-menu-action:focus-visible { background: color-mix(in srgb, var(--primary) 8%, transparent); color: var(--primary); }
    .ww-display-menu-action:focus-visible { outline: 2px solid color-mix(in srgb, var(--primary) 45%, transparent); outline-offset: 1px; }
    .ww-display-menu-action[hidden] { display: none !important; }
    .ww-display-menu-action-label { display: inline-flex; align-items: center; gap: 10px; min-width: 0; }
    .ww-display-menu-action-label svg { width: 17px; height: 17px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .ww-display-menu-count { display: inline-grid; place-items: center; min-width: 24px; height: 24px; padding: 0 7px; border-radius: 999px; background: color-mix(in srgb, var(--primary) 11%, transparent); color: var(--primary); font-size: 12px; }
    .ww-display-menu-switch { position: relative; width: 38px; height: 22px; flex: 0 0 38px; border-radius: 999px; background: color-mix(in srgb, var(--muted) 24%, transparent); transition: background .18s ease; }
    .ww-display-menu-switch i { position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); box-shadow: 0 1px 4px rgba(64,15,38,.2); transition: transform .18s ease; }
    #presentation-mode-button[aria-checked="true"] .ww-display-menu-switch { background: var(--primary); }
    #presentation-mode-button[aria-checked="true"] .ww-display-menu-switch i { transform: translateX(16px); }
    .own-words-dialog { width: min(480px, calc(100% - 32px)); }
    .own-words-intro { margin: 0; }
    .own-words-list { display: grid; gap: 8px; max-height: min(50vh, 390px); overflow: auto; }
    .own-word-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 46px; padding: 5px 6px 5px 13px; border: 1px solid var(--border); border-radius: 12px; }
    .own-word-copy { display: inline-flex; align-items: baseline; gap: 7px; min-width: 0; }
    .own-word-label { overflow-wrap: anywhere; }
    .own-word-count { color: var(--muted); font-size: 13px; white-space: nowrap; }
    .own-word-remove { flex: 0 0 auto; width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; color: var(--muted); font: 300 23px/1 system-ui, sans-serif; cursor: pointer; }
    .own-word-remove:hover, .own-word-remove:focus-visible { background: rgba(164,14,76,.1); color: var(--primary); }
    .own-word-remove:disabled { cursor: wait; opacity: .45; }
    .own-words-empty, .own-words-error { color: var(--muted); font-size: 13px; }
    .own-words-error { color: var(--primary); }
    body.presentation-mode .display-word-entry,
    body.presentation-mode .footer-actions,
    body.presentation-mode #memory-cta { display: none !important; }
    body.presentation-mode #cloud-container { bottom: calc(var(--footer-height) + env(safe-area-inset-bottom, 0px)); }
    .organizer-settings-section { display: grid; gap: 9px; margin-top: 4px; padding-top: 16px; border-top: 1px solid var(--border); }
    .organizer-settings-section h3 { margin: 0; color: var(--text); font: 600 16px 'Jost', system-ui, sans-serif; }
    .organizer-danger-zone { padding: 15px; border: 1px solid color-mix(in srgb, #b33a4d 28%, var(--border)); border-radius: 14px; background: color-mix(in srgb, #b33a4d 5%, transparent); }
    .organizer-danger-zone .reset-dialog-button { border-color: color-mix(in srgb, #b33a4d 42%, var(--border)); color: #9d263e; }
    .word-manager-list { display: grid; gap: 7px; max-height: 210px; margin: 11px 0 0; overflow: auto; }
    .word-manager-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 46px; padding: 4px 4px 4px 11px; border: 1px solid var(--border); border-radius: 10px; }
    .word-manager-count { color: var(--muted); font-size: 12px; }
    .word-manager-remove { width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; color: var(--muted); font: 300 23px/1 system-ui, sans-serif; cursor: pointer; }
    .word-manager-remove:hover { background: rgba(164,14,76,.1); color: var(--primary); }
    .word-manager-empty { margin: 11px 0 0; color: var(--muted); font-size: 13px; }

    #cloud-canvas {
      display: block;
      opacity: 0;
      transition: opacity 0.7s ease;
    }
    #cloud-canvas.visible { opacity: 1; }

    #empty-state {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      transition: opacity 0.5s;
    }
    #empty-state.hidden { opacity: 0; }

    .empty-ornament {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(60px, 8vw, 100px);
      color: var(--rad1);
      line-height: 1;
      opacity: 0.5;
    }
    .empty-text {
      margin-top: 18px;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(18px, 2.5vw, 28px);
      font-style: italic;
      color: var(--muted);
      opacity: 0.7;
      transition: color 0.6s;
    }
    .empty-sub {
      margin-top: 10px;
      font-size: 13px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      opacity: 0.5;
      transition: color 0.6s;
    }

    .footer {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      min-height: calc(var(--footer-height) + env(safe-area-inset-bottom, 0px));
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      padding: 0 max(40px, env(safe-area-inset-right, 0px)) env(safe-area-inset-bottom, 0px) max(40px, env(safe-area-inset-left, 0px));
      border-top: 1px solid var(--border);
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      backdrop-filter: blur(18px) saturate(1.2);
      -webkit-backdrop-filter: blur(18px) saturate(1.2);
      transition: border-color 0.6s, background 0.6s;
      z-index: 11;
    }

    .footer-event-name {
      min-width: 0;
      max-width: min(34vw, 520px);
      overflow: hidden;
      color: var(--primary);
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(18px, 2.1vw, 28px);
      font-weight: 400;
      line-height: 1.15;
      text-overflow: ellipsis;
      white-space: nowrap;
      transition: color 0.6s;
    }

    .footer-tools { display: flex; align-items: center; gap: 28px; }
    .footer-actions { display: flex; align-items: center; gap: 9px; }
    .footer-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 46px;
      padding: 0 15px;
      border: 1px solid color-mix(in srgb, var(--text) 13%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      color: var(--text);
      font: 600 12px/1 'Jost', system-ui, sans-serif;
      cursor: pointer;
      transition: border-color .18s ease, background .18s ease, color .18s ease, transform .18s ease;
    }
    .footer-action svg { width: 18px; height: 18px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .footer-action:hover, .footer-action:focus-visible { border-color: color-mix(in srgb, var(--primary) 42%, transparent); background: color-mix(in srgb, var(--primary) 7%, var(--bg)); color: var(--primary); }
    .footer-action:hover { transform: translateY(-1px); }
    .footer-action:focus-visible { outline: 2px solid color-mix(in srgb, var(--primary) 45%, transparent); outline-offset: 2px; }

    .desktop-qr { display: flex; align-items: center; gap: 13px; }

    .qr-label { text-align: right; }
    .qr-label .line1 {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      transition: color 0.6s;
    }
    .qr-label .line2 { margin-top: 3px; color: var(--text); font-size: 12px; font-weight: 600; transition: color .6s; }

    .qr-code {
      width: 84px; height: 84px;
      border-radius: 10px;
      border: 2px solid var(--qr-bd);
      padding: 3px;
      overflow: hidden;
      background: var(--bg);
      transition: border-color 0.6s, background 0.6s;
    }
    .qr-code svg { display: block; width: 100%; height: 100%; }

    /* ── Keepsake configurator CTA ── */
    .ww-keepsake-cta {
      display: none;
      align-items: center;
      justify-content: center;
      gap: 10px;
      height: 44px;
      min-width: 44px;
      padding: 0 17px;
      border: 1px solid var(--primary);
      border-radius: 999px;
      background: var(--primary);
      color: #fff;
      font: 600 13px/1 'Jost', system-ui, sans-serif;
      white-space: nowrap;
      cursor: pointer;
      box-shadow: 0 6px 18px color-mix(in srgb, var(--primary) 22%, transparent);
      transition: transform .18s ease, background .6s, border-color .6s, box-shadow .18s ease;
    }
    .ww-keepsake-cta.visible { display: inline-flex; }
    .ww-keepsake-cta:hover { transform: translateY(-1px); box-shadow: 0 8px 22px color-mix(in srgb, var(--primary) 28%, transparent); }
    .ww-keepsake-cta:focus-visible { outline: 2px solid color-mix(in srgb, var(--primary) 55%, transparent); outline-offset: 3px; }
    .ww-keepsake-cta-icon { width: 14px; height: 14px; flex: 0 0 auto; fill: currentColor; }
    .ww-keepsake-cta-label-compact { display: none; }

    .word-submission-status {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ── Toast ── */
    .toast-container {
      position: fixed;
      bottom: calc(var(--footer-height) + env(safe-area-inset-bottom, 0px) + 18px);
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      pointer-events: none;
      z-index: 20;
    }

    .toast {
      background: var(--primary);
      color: #fff;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 16px;
      padding: 10px 24px;
      border-radius: 999px;
      animation: toastIn 0.3s ease both, toastOut 0.4s ease 1.8s both;
    }

    @keyframes toastIn {
      from { opacity: 0; transform: translateY(12px) scale(0.9); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes toastOut {
      to { opacity: 0; transform: translateY(-8px) scale(0.92); }
    }

    .reset-dialog {
      width: min(440px, calc(100% - 32px));
      margin: auto;
      padding: 0;
      border: 1px solid var(--border);
      border-radius: 24px;
      background: var(--bg);
      color: var(--text);
      box-shadow: 0 24px 70px rgba(64, 15, 38, .22);
    }
    .reset-dialog::backdrop { background: rgba(30, 7, 18, .42); backdrop-filter: blur(4px); }
    .reset-dialog-card { padding: 30px; }
    .reset-dialog h2 { margin: 0; font: 600 27px/1.15 'Playfair Display', Georgia, serif; }
    .reset-dialog-copy { margin: 10px 0 22px; color: var(--muted); font-size: 14px; line-height: 1.55; }
    .reset-dialog label { display: grid; gap: 7px; font-size: 13px; font-weight: 600; }
    .reset-dialog input {
      width: 100%;
      height: 50px;
      padding: 0 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      outline: none;
      background: color-mix(in srgb, var(--bg) 92%, var(--primary));
      color: var(--text);
      font: 18px/1 'Jost', system-ui, sans-serif;
    }
    .reset-dialog input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 13%, transparent); }
    .reset-dialog-error { min-height: 20px; margin: 9px 0 0; color: #b33a4d; font-size: 13px; }
    .reset-dialog-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 17px; }
    .reset-dialog-button {
      min-height: 44px;
      padding: 11px 17px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: transparent;
      color: var(--text);
      cursor: pointer;
      font: 600 13px/1 'Jost', system-ui, sans-serif;
    }
    .reset-dialog-button.primary { border-color: var(--primary); background: var(--primary); color: #fff; }
    .reset-dialog-button:disabled { cursor: wait; opacity: .58; }
    .draft-settings { width: min(420px, calc(100% - 32px)); margin: auto; border: 0; border-radius: 20px; padding: 0; color: var(--text); background: var(--bg); box-shadow: 0 24px 70px rgba(64,15,38,.22); }
    .draft-settings::backdrop { background: rgba(64,15,38,.3); backdrop-filter: blur(4px); }
    .draft-settings form { padding: 25px; display: grid; gap: 12px; }
    .draft-settings h2 { font: 500 25px 'Playfair Display', Georgia, serif; color: var(--primary); }
    .draft-settings p { color: var(--muted); font-size: 13px; line-height: 1.5; }
    .draft-settings label { display: grid; gap: 6px; color: var(--text); font-size: 14px; font-weight: 600; }
    .draft-settings input { height: 46px; padding: 0 13px; border: 1px solid var(--border); border-radius: 11px; background: var(--bg); color: var(--text); font: 16px 'Jost', sans-serif; }
    .dialog-heading { display: flex; align-items: start; justify-content: space-between; gap: 12px; }
    .dialog-heading h2 { margin: 0; }
    .dialog-close { width: 44px; height: 44px; flex: 0 0 auto; border: 0; border-radius: 50%; background: transparent; color: var(--muted); font: 300 26px/1 system-ui, sans-serif; cursor: pointer; }
    .dialog-close:hover { background: color-mix(in srgb, var(--primary) 8%, transparent); color: var(--primary); }
    .share-dialog { width: min(500px, calc(100% - 32px)); }
    .share-dialog-copy { margin-top: -4px; }
    .share-options { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .share-option {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 50px;
      padding: 0 14px;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: transparent;
      color: var(--text);
      font: 600 14px 'Jost', system-ui, sans-serif;
      text-decoration: none;
      cursor: pointer;
    }
    .share-option svg { width: 20px; height: 20px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .share-option:hover, .share-option:focus-visible { border-color: color-mix(in srgb, var(--primary) 45%, transparent); background: color-mix(in srgb, var(--primary) 7%, transparent); color: var(--primary); }
    #share-dialog-copy-link { grid-column: 1 / -1; }
    .share-dialog-qr { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 3px; padding: 14px; border-radius: 14px; background: color-mix(in srgb, var(--primary) 5%, transparent); }
    .share-dialog-qr-copy strong { display: block; margin-bottom: 3px; font: 500 16px 'Playfair Display', Georgia, serif; }
    .share-dialog-qr-copy span { color: var(--muted); font-size: 12px; line-height: 1.45; }
    .share-dialog .qr-code { width: 88px; height: 88px; flex: 0 0 auto; }
    .share-feedback { min-height: 18px; margin: -4px 0 0; color: var(--primary); font-size: 12px; }

    @media (max-width: 620px) {
      :root {
        --site-header-height: calc(73px + env(safe-area-inset-top, 0px));
        --footer-height: 122px;
      }

      .word-counter .label { letter-spacing: 1.5px; }
      .ww-display-header-actions { gap: 8px; }
      .ww-keepsake-cta { padding: 0 13px; }
      .ww-keepsake-cta-label-full { display: none; }
      .ww-keepsake-cta-label-compact { display: inline; }
      #cloud-container { bottom: calc(var(--footer-height) + env(safe-area-inset-bottom, 0px) + 68px); }
      .display-word-entry { min-height: 48px; bottom: calc(var(--footer-height) + env(safe-area-inset-bottom, 0px) + 12px); }
      #display-word-input { padding: 0 10px; }
      #display-word-submit { padding: 0 13px; }
      body.presentation-mode #cloud-container { bottom: calc(var(--footer-height) + env(safe-area-inset-bottom, 0px)); }
      .footer {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: center;
        gap: 10px;
        padding: 11px max(16px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
      }
      .footer-event-name { width: 100%; max-width: 100%; font-size: 18px; text-align: center; }
      .footer-tools { width: 100%; }
      .footer-actions { display: grid; grid-template-columns: 1fr 1fr; width: 100%; gap: 10px; }
      .footer-action { width: 100%; min-height: 48px; font-size: 13px; }
      .desktop-qr { display: none; }
      body.presentation-mode { --footer-height: 58px; }
      body.presentation-mode .footer-tools { display: none; }
      .share-options { grid-template-columns: 1fr; }
      .share-dialog-qr { padding: 12px; }
      .reset-dialog-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .reset-dialog-button { width: 100%; }
    }
    @media (max-width: 360px) {
      .ww-keepsake-cta { width: 44px; padding: 0; }
      .ww-keepsake-cta-label-compact { display: none; }
      .reset-dialog-actions { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ww-palette-trigger,
      .ww-palette-option,
      .ww-palette-chevron { transition: none; }
    }
  </style>
  <link rel="stylesheet" href="<%= asset('/mobile-foundation.css') %>" />
  <script src="<%= asset('/js/mobile-ui.js') %>" defer></script>
</head>
