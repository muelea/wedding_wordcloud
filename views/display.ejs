<script src="/socket.io/socket.io.js"></script>
<script src="<%= asset('/js/wordcloud-core.js') %>"></script>
<script src="<%= asset('/js/own-word-groups.js') %>"></script>
<script>
  // Slug comes from the canonical event URL: /e/<slug>
  const slug = location.pathname.split('/').filter(Boolean)[1];

  const canvas         = document.getElementById('cloud-canvas');
  const ctx             = canvas.getContext('2d');
  const container       = document.getElementById('cloud-container');
  const emptyState      = document.getElementById('empty-state');
  const toastContainer  = document.getElementById('toast-container');
  const memoryCta       = document.getElementById('memory-cta');
  const resetDialog     = document.getElementById('reset-dialog');
  const resetForm       = document.getElementById('reset-form');
  const resetError      = document.getElementById('reset-error');
  const resetCancel     = document.getElementById('reset-cancel');
  const resetSubmit     = document.getElementById('reset-submit');
  const displayWordEntry = document.getElementById('display-word-entry');
  const displayWordInput = document.getElementById('display-word-input');
  const wordSubmissionStatus = document.getElementById('word-submission-status');
  const displayPageMenu = document.getElementById('display-page-menu');
  const displayMenuTrigger = document.getElementById('display-menu-trigger');
  const displayOwnWordsButton = document.getElementById('display-own-words-button');
  const displayOwnWordsCount = document.getElementById('display-own-words-count');
  const displayOwnWordsDialog = document.getElementById('display-own-words-dialog');
  const displayOwnWordsList = document.getElementById('display-own-words-list');
  const displayOwnWordsEmpty = document.getElementById('display-own-words-empty');
  const displayOwnWordsError = document.getElementById('display-own-words-error');
  const presentationModeButton = document.getElementById('presentation-mode-button');
  const palettePicker = document.getElementById('display-palette-picker');
  const paletteTrigger = document.getElementById('display-palette-trigger');
  const paletteCurrent = document.getElementById('display-palette-current');
  const paletteSwatches = document.getElementById('display-palette-swatches');
  const paletteOptionButtons = Array.from(document.querySelectorAll('[data-palette-key]'));
  const displayLanguagePicker = displayPageMenu.querySelector('.ww-display-menu-language');
  const draftSettings = document.getElementById('draft-settings');
  const draftSettingsButton = document.getElementById('draft-settings-button');
  const pinUnlockDialog = document.getElementById('pin-unlock-dialog');
  const pinChangeDialog = document.getElementById('pin-change-dialog');
  const shareButton = document.getElementById('share-cloud');
  const copyLinkButton = document.getElementById('copy-cloud-link');
  const shareDialog = document.getElementById('share-dialog');
  const shareDialogCopyButton = document.getElementById('share-dialog-copy-link');
  const shareFeedback = document.getElementById('share-feedback');
  const themeColorMeta = document.getElementById('theme-color');
  let eventHasOrganizerPin = false;
  let unlockedOrganizerPin = '';
  const eventUrl = document.getElementById('event-qr').dataset.eventUrl;
  let cloudTitle = document.getElementById('cloud-title').textContent.trim();
  const ownContributions = new Map();
  const t = (source, params) => WolkenworteI18n.t(source, params);
  const setText = (element, source, params) => WolkenworteI18n.setText(element, source, params);
  const setI18nAttribute = (element, name, source, params) => WolkenworteI18n.setAttribute(element, name, source, params);
  const clearText = (element) => WolkenworteI18n.clearText(element);

  let currentWords = [];
  let renderTimer  = null;
  let renderRevision = 0;
  let wordSubmissionAnnouncementTimer = null;
  const MAX_CANVAS_PIXEL_RATIO = 3;
  const TEXT_BASELINE_OFFSET = Number.isFinite(WordCloudCore.TEXT_BASELINE_OFFSET)
    ? WordCloudCore.TEXT_BASELINE_OFFSET
    : 0.34;
  const cloudFontReady = document.fonts?.load
    ? document.fonts.load('16px "Wolkenworte Classic"', 'Wolkenworte').catch(() => [])
    : Promise.resolve();
  const PALETTE_OPTIONS = <%- JSON.stringify(pageData.paletteOptions || []).replace(/</g, '\\u003c') %>;
  const PALETTES = Object.fromEntries(PALETTE_OPTIONS.map((palette) => [palette.key, palette]));
  const defaultPaletteKey = PALETTE_OPTIONS[0]?.key || 'pastel';
  const paletteStorageKey = `wordcloud-palette:${slug}`;
  let getWordColor = WordCloudCore.makePaletteAssigner(PALETTES.pastel.colors);

  function storedPaletteKey() {
    try {
      const stored = localStorage.getItem(paletteStorageKey);
      return PALETTES[stored] ? stored : defaultPaletteKey;
    } catch {
      return defaultPaletteKey;
    }
  }

  function renderPaletteSwatches(colors) {
    if (!paletteSwatches) return;
    paletteSwatches.replaceChildren(...colors.map((color) => {
      const swatch = document.createElement('i');
      swatch.style.background = color;
      return swatch;
    }));
  }

  function syncPalettePicker(palette) {
    if (!palette) return;
    setText(paletteCurrent, palette.label);
    paletteTrigger?.setAttribute('aria-label', `${t('Farbwelt')}: ${t(palette.label)}`);
    for (const option of paletteOptionButtons) {
      const selected = option.dataset.paletteKey === palette.key;
      option.classList.toggle('is-selected', selected);
      option.setAttribute('aria-checked', String(selected));
    }
  }

  function applyPalette(key, { persist = false } = {}) {
    const resolvedKey = PALETTES[key] ? key : defaultPaletteKey;
    const palette = PALETTES[resolvedKey];
    const root = document.documentElement.style;
    getWordColor = WordCloudCore.makePaletteAssigner(palette.colors);
    root.setProperty('--primary', palette.colors[0]);
    root.setProperty('--accent', palette.colors[4]);
    root.setProperty('--bg', palette.background[0]); root.setProperty('--bg2', palette.background[1]);
    root.setProperty('--rad1', palette.background[2]); root.setProperty('--rad2', palette.background[3]);
    themeColorMeta.content = palette.background[0];
    document.documentElement.dataset.palette = resolvedKey;
    renderPaletteSwatches(palette.colors);
    syncPalettePicker(palette);
    if (persist) {
      try { localStorage.setItem(paletteStorageKey, resolvedKey); } catch {}
    }
    if (currentWords.length) scheduleRender(currentWords);
  }

  applyPalette(storedPaletteKey());

  function closePalettePicker({ focus = false } = {}) {
    if (!palettePicker?.open) return;
    palettePicker.open = false;
    if (focus) paletteTrigger?.focus();
  }

  paletteOptionButtons.forEach((option) => {
    option.addEventListener('click', () => {
      applyPalette(option.dataset.paletteKey, { persist: true });
      closePalettePicker({ focus: true });
    });
  });
  palettePicker?.addEventListener('toggle', () => {
    if (palettePicker.open && displayLanguagePicker) displayLanguagePicker.open = false;
  });
  displayLanguagePicker?.addEventListener('toggle', () => {
    if (displayLanguagePicker.open) closePalettePicker();
  });
  palettePicker?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && palettePicker.open) {
      event.preventDefault();
      event.stopPropagation();
      closePalettePicker({ focus: true });
      return;
    }
    if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    if (!palettePicker.open) palettePicker.open = true;
    const selectedIndex = Math.max(0, paletteOptionButtons.findIndex((option) => option.classList.contains('is-selected')));
    const focusedIndex = paletteOptionButtons.indexOf(document.activeElement);
    let nextIndex = focusedIndex < 0 ? selectedIndex : focusedIndex;
    if (event.key === 'Home') nextIndex = 0;
    else if (event.key === 'End') nextIndex = paletteOptionButtons.length - 1;
    else if (focusedIndex >= 0) {
      const direction = event.key === 'ArrowDown' ? 1 : -1;
      nextIndex = (focusedIndex + direction + paletteOptionButtons.length) % paletteOptionButtons.length;
    }
    paletteOptionButtons[nextIndex]?.focus();
  });
  document.addEventListener('pointerdown', (event) => {
    if (palettePicker?.open && !palettePicker.contains(event.target)) closePalettePicker();
  });

  function renderCloud(words) {
    if (!words || words.length === 0) return;

    const rect = container.getBoundingClientRect();
    const side = Math.min(rect.width, rect.height) * 0.94;
    if (side < 1) return;
    const pixelRatio = Math.min(Math.max(window.devicePixelRatio || 1, 1), MAX_CANVAS_PIXEL_RATIO);
    const backingSide = Math.max(1, Math.round(side * pixelRatio));
    canvas.style.width = `${side}px`;
    canvas.style.height = `${side}px`;
    if (canvas.width !== backingSide || canvas.height !== backingSide) {
      canvas.width = backingSide;
      canvas.height = backingSide;
    }
    const drawingScale = backingSide / side;
    ctx.setTransform(drawingScale, 0, 0, drawingScale, 0, 0);

    const placed = WordCloudCore.layoutWords(words, side, ctx, getWordColor);

    ctx.clearRect(0, 0, side, side);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    for (const p of placed) {
      ctx.font = `${p.fontPx}px ${WordCloudCore.FONT_FAMILY}`;
      ctx.fillStyle = p.color;
      if (p.rotated) {
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(-Math.PI / 2);
        ctx.fillText(p.word, 0, p.fontPx * TEXT_BASELINE_OFFSET);
        ctx.restore();
      } else {
        ctx.fillText(p.word, p.x, p.y + p.fontPx * TEXT_BASELINE_OFFSET);
      }
    }
    canvas.classList.add('visible');
  }

  function scheduleRender(words, delay = 300) {
    const revision = ++renderRevision;
    clearTimeout(renderTimer);
    renderTimer = setTimeout(() => {
      cloudFontReady.then(() => {
        if (revision === renderRevision) renderCloud(words);
      });
    }, delay);
  }

  function showToast(message) {
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = '✦  ' + message;
    toastContainer.appendChild(toast);
    setTimeout(() => toast.remove(), 2400);
  }

  function closeDisplayMenu({ focus = false } = {}) {
    if (!displayPageMenu.open) return;
    closePalettePicker();
    if (displayLanguagePicker) displayLanguagePicker.open = false;
    displayPageMenu.open = false;
    if (focus) displayMenuTrigger.focus();
  }

  function setPresentationMode(enabled) {
    const active = enabled === true;
    document.body.classList.toggle('presentation-mode', active);
    presentationModeButton.setAttribute('aria-checked', String(active));
    if (active && document.activeElement === displayWordInput) displayWordInput.blur();
    closeDisplayMenu();
    if (currentWords.length) scheduleRender(currentWords);
  }

  displayPageMenu.addEventListener('toggle', () => {
    setI18nAttribute(
      displayMenuTrigger,
      'aria-label',
      displayPageMenu.open ? 'Menü schließen' : 'Menü öffnen'
    );
  });
  displayPageMenu.querySelectorAll('[data-language-code]').forEach((option) => {
    option.addEventListener('click', () => closeDisplayMenu());
  });
  document.addEventListener('pointerdown', (event) => {
    if (displayPageMenu.open && !displayPageMenu.contains(event.target)) closeDisplayMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || document.querySelector('dialog[open]')) return;
    if (displayPageMenu.open) {
      closeDisplayMenu({ focus: true });
    } else if (document.body.classList.contains('presentation-mode')) {
      setPresentationMode(false);
      displayMenuTrigger.focus();
    }
  });
  presentationModeButton.addEventListener('click', () => {
    setPresentationMode(!document.body.classList.contains('presentation-mode'));
  });

  // ── Config & QR ──────────────────────────────────────────────────────────
  fetch(`/api/events/${encodeURIComponent(slug)}`).then(r => r.json()).then(async ({ title, locale, hasOrganizerPin }) => {
    await WolkenworteI18n.useEventLocale(locale);
    document.getElementById('cloud-title').textContent = title;
    cloudTitle = title || '';
    setText(document.querySelector('title'), '{{name}} – Wortwolke', { name: title });
    draftSettingsButton.hidden = false;
    eventHasOrganizerPin = hasOrganizerPin === true;
    document.getElementById('draft-name').value = title || '';
  }).catch(() => {});

  function eventShareData() {
    const name = cloudTitle || t('Eure Wortwolke');
    return {
      title: t('{{name}} – Wolkenworte', { name }),
      text: t('Ihr seid eingeladen, die Wortwolke „{{name}}“ mitzugestalten. Fügt ein Wort hinzu und erlebt live, wie sie gemeinsam wächst.', { name }),
      url: eventUrl || `${location.origin}/e/${encodeURIComponent(slug)}`,
    };
  }

  function prepareShareDialog() {
    const data = eventShareData();
    const messageWithUrl = `${data.text}\n\n${data.url}`;
    document.getElementById('share-whatsapp').href = `https://wa.me/?text=${encodeURIComponent(messageWithUrl)}`;
    document.getElementById('share-email').href = `mailto:?subject=${encodeURIComponent(data.title)}&body=${encodeURIComponent(messageWithUrl)}`;
    clearText(shareFeedback);
    if (!shareDialog.open) shareDialog.showModal();
  }

  async function copyText(text) {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const temporaryInput = document.createElement('textarea');
    temporaryInput.value = text;
    temporaryInput.readOnly = true;
    temporaryInput.style.cssText = 'position:fixed;inset:0 auto auto -9999px;opacity:0';
    document.body.appendChild(temporaryInput);
    temporaryInput.select();
    const copied = document.execCommand('copy');
    temporaryInput.remove();
    if (!copied) throw new Error('copy_failed');
  }

  let copyFeedbackTimer = null;
  async function copyEventLink() {
    try {
      await copyText(eventShareData().url);
      setText(copyLinkButton.querySelector('span'), 'Link kopiert ✓');
      setText(shareDialogCopyButton.querySelector('span'), 'Link kopiert ✓');
      setText(shareFeedback, 'Link kopiert ✓');
      clearTimeout(copyFeedbackTimer);
      copyFeedbackTimer = setTimeout(() => {
        setText(copyLinkButton.querySelector('span'), 'Link kopieren');
        setText(shareDialogCopyButton.querySelector('span'), 'Link kopieren');
        clearText(shareFeedback);
      }, 1800);
    } catch {
      prepareShareDialog();
      setText(shareFeedback, 'Der Link konnte nicht automatisch kopiert werden.');
    }
  }

  shareButton.addEventListener('click', async () => {
    const data = eventShareData();
    const canShare = typeof navigator.share === 'function' &&
      (typeof navigator.canShare !== 'function' || navigator.canShare(data));
    if (!canShare) {
      prepareShareDialog();
      return;
    }
    try {
      await navigator.share(data);
    } catch (error) {
      if (error?.name !== 'AbortError') prepareShareDialog();
    }
  });
  copyLinkButton.addEventListener('click', copyEventLink);
  shareDialogCopyButton.addEventListener('click', copyEventLink);
  shareDialog.addEventListener('click', (event) => {
    if (event.target === shareDialog) shareDialog.close();
  });

  // ── Socket (room-scoped to this event via ?slug=) ───────────────────────
  function getOrCreateGuestId() {
    const storageKey = `guest-session:${slug}`;
    try {
      const existing = sessionStorage.getItem(storageKey);
      if (/^[a-f0-9]{32}$/.test(existing || '')) return existing;
    } catch {}
    const bytes = new Uint8Array(16);
    if (window.crypto?.getRandomValues) window.crypto.getRandomValues(bytes);
    else for (let index = 0; index < bytes.length; index += 1) bytes[index] = Math.floor(Math.random() * 256);
    const guestId = [...bytes].map((byte) => byte.toString(16).padStart(2, '0')).join('');
    try { sessionStorage.setItem(storageKey, guestId); } catch {}
    return guestId;
  }
  const guestId = getOrCreateGuestId();
  const socket = io({
    query: { slug, guestId },
    transports: ['websocket', 'polling'],
    tryAllTransports: true,
    timeout: 7000,
  });
  displayWordEntry.addEventListener('submit', (event) => {
    event.preventDefault();
    const word = displayWordInput.value.trim();
    if (!word) return;
    socket.emit('submit-word', word);
    displayWordInput.value = '';
  });

  function groupedOwnContributions() {
    return WolkenworteOwnWords.groupContributions(
      [...ownContributions],
      document.documentElement.lang || 'de'
    );
  }

  function removeOwnContribution(receipt, removeButton) {
    clearText(displayOwnWordsError);
    removeButton.disabled = true;
    socket.emit('remove-word', { receipt }, (result) => {
      if (result?.ok || result?.error === 'not_found') {
        ownContributions.delete(receipt);
        renderOwnContributions();
      } else {
        removeButton.disabled = false;
        setText(displayOwnWordsError, 'Das Wort konnte nicht entfernt werden. Bitte versucht es erneut.');
      }
    });
  }

  function renderOwnContributions() {
    const total = ownContributions.size;
    displayOwnWordsButton.hidden = total === 0;
    displayOwnWordsCount.textContent = WolkenworteI18n.formatNumber(total);
    setI18nAttribute(displayOwnWordsButton, 'aria-label', 'Deine Wörter verwalten ({{count}})', { count: total });
    displayOwnWordsList.replaceChildren();
    const groups = groupedOwnContributions();
    displayOwnWordsEmpty.hidden = groups.length > 0;
    for (const [word, receipts] of groups) {
      const item = document.createElement('div'); item.className = 'own-word-item';
      const copy = document.createElement('span'); copy.className = 'own-word-copy';
      const label = document.createElement('span'); label.className = 'own-word-label'; label.textContent = word;
      const count = document.createElement('span'); count.className = 'own-word-count';
      count.textContent = receipts.length > 1 ? `× ${WolkenworteI18n.formatNumber(receipts.length)}` : '';
      const remove = document.createElement('button'); remove.className = 'own-word-remove'; remove.type = 'button'; remove.textContent = '×';
      setI18nAttribute(remove, 'aria-label', 'Eine Eingabe von „{{word}}“ entfernen', { word });
      remove.addEventListener('click', () => removeOwnContribution(receipts[receipts.length - 1], remove));
      copy.append(label, count); item.append(copy, remove); displayOwnWordsList.appendChild(item);
    }
  }

  function hydrateOwnContributions(contributions) {
    ownContributions.clear();
    for (const contribution of Array.isArray(contributions) ? contributions : []) {
      if (contribution?.word && contribution?.receipt) ownContributions.set(contribution.receipt, contribution.word);
    }
    renderOwnContributions();
  }

  function addOwnContribution(word, receipt) {
    if (!word || !receipt || ownContributions.has(receipt)) return;
    ownContributions.set(receipt, word);
    renderOwnContributions();
  }

  function announceWordAccepted() {
    clearTimeout(wordSubmissionAnnouncementTimer);
    clearText(wordSubmissionStatus);
    wordSubmissionAnnouncementTimer = setTimeout(() => {
      setText(wordSubmissionStatus, 'Neues Wort hinzugefügt');
    }, 50);
  }

  displayOwnWordsButton.addEventListener('click', () => {
    closeDisplayMenu();
    clearText(displayOwnWordsError);
    renderOwnContributions();
    displayOwnWordsDialog.showModal();
  });
  window.addEventListener('wolkenworte:localechange', () => {
    syncPalettePicker(PALETTES[document.documentElement.dataset.palette] || PALETTES[defaultPaletteKey]);
    renderOwnContributions();
    if (draftSettings.open) renderWordManager();
  });
  socket.on('own-word-update', hydrateOwnContributions);
  socket.on('word-accepted', (word, receipt) => {
    addOwnContribution(word, receipt);
    announceWordAccepted();
  });

  function openSettings() {
    clearText(document.getElementById('draft-settings-error'));
    renderWordManager();
    draftSettings.showModal();
    document.getElementById('draft-name').focus();
  }

  draftSettingsButton.addEventListener('click', () => {
    closeDisplayMenu();
    unlockedOrganizerPin = '';
    document.getElementById('pin-unlock-input').value = '';
    clearText(document.getElementById('pin-unlock-error'));
    pinUnlockDialog.showModal();
    if (eventHasOrganizerPin) document.getElementById('pin-unlock-input').focus();
    else setText(document.getElementById('pin-unlock-error'), 'Diese Wortwolke hat keine Organisator-PIN. Erstellt bitte eine neue Wortwolke.');
  });

  document.getElementById('pin-unlock-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!eventHasOrganizerPin) return;
    const pin = document.getElementById('pin-unlock-input').value.trim();
    const response = await fetch(`/api/events/${encodeURIComponent(slug)}/organizer/verify`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin }) });
    if (!response.ok) {
      setText(
        document.getElementById('pin-unlock-error'),
        response.status === 429 ? 'Zu viele Versuche. Bitte wartet 15 Minuten.' : 'Die Organisator-PIN ist nicht korrekt.'
      );
      return;
    }
    unlockedOrganizerPin = pin;
    pinUnlockDialog.close();
    openSettings();
  });

  draftSettings.addEventListener('close', () => {
    unlockedOrganizerPin = '';
    clearText(document.getElementById('draft-settings-error'));
  });

  function renderWordManager() {
    const list = document.getElementById('word-manager-list');
    const empty = document.getElementById('word-manager-empty');
    list.replaceChildren();
    const words = [...currentWords].sort(([a], [b]) => a.localeCompare(b, document.documentElement.lang || 'de'));
    empty.hidden = words.length > 0;
    for (const [word, count] of words) {
      const item = document.createElement('div'); item.className = 'word-manager-item';
      const label = document.createElement('span'); label.textContent = word;
      const countLabel = document.createElement('span'); countLabel.className = 'word-manager-count'; countLabel.textContent = count > 1 ? `× ${WolkenworteI18n.formatNumber(count)}` : '';
      const remove = document.createElement('button'); remove.className = 'word-manager-remove'; remove.type = 'button'; remove.textContent = '×';
      setI18nAttribute(remove, 'aria-label', '„{{word}}“ entfernen', { word });
      remove.addEventListener('click', async () => {
        remove.disabled = true;
        const response = await fetch(`/api/events/${encodeURIComponent(slug)}/remove-word`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ word, pin: unlockedOrganizerPin }) });
        if (!response.ok) { setText(document.getElementById('draft-settings-error'), 'Das Wort konnte nicht entfernt werden.'); remove.disabled = false; }
      });
      const left = document.createElement('span'); left.append(label, countLabel);
      item.append(left, remove); list.appendChild(item);
    }
  }
  document.getElementById('draft-settings-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const title = document.getElementById('draft-name').value.trim();
    if (!title) return;
    const response = await fetch(`/api/events/${encodeURIComponent(slug)}/settings`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title, pin: unlockedOrganizerPin }) });
    if (!response.ok) {
      setText(
        document.getElementById('draft-settings-error'),
        response.status === 401 ? 'Die Organisator-PIN ist nicht korrekt.' : 'Die Einstellungen konnten nicht gespeichert werden.'
      );
      return;
    }
    draftSettings.close();
  });

  document.getElementById('change-pin-button').addEventListener('click', () => {
    document.getElementById('pin-change-form').reset();
    clearText(document.getElementById('pin-change-error'));
    pinChangeDialog.showModal();
    document.getElementById('pin-change-input').focus();
  });

  document.getElementById('pin-change-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const newPin = document.getElementById('pin-change-input').value.trim();
    const confirmation = document.getElementById('pin-change-confirmation').value.trim();
    if (!/^\d{4,6}$/.test(newPin)) {
      setText(document.getElementById('pin-change-error'), 'Bitte 4–6 Ziffern eingeben.');
      return;
    }
    if (newPin !== confirmation) {
      setText(document.getElementById('pin-change-error'), 'Die beiden PINs stimmen nicht überein.');
      return;
    }
    const response = await fetch(`/api/events/${encodeURIComponent(slug)}/organizer-pin`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pin: unlockedOrganizerPin, newPin }),
    });
    if (!response.ok) {
      setText(document.getElementById('pin-change-error'), response.status === 401
        ? 'Die Organisator-PIN ist nicht korrekt.'
        : 'Die PIN konnte nicht geändert werden.');
      return;
    }
    unlockedOrganizerPin = '';
    pinChangeDialog.close();
    draftSettings.close();
    showToast(t('PIN geändert'));
  });

  document.getElementById('reset-cloud-button').addEventListener('click', () => {
    clearText(resetError);
    resetDialog.showModal();
  });
  let socketHasConnected = false;
  socket.on('connect_error', () => {
    if (!socketHasConnected) socket.io.opts.transports = ['polling', 'websocket'];
  });
  socket.on('connect', () => {
    socketHasConnected = true;
    socket.io.opts.transports = ['websocket', 'polling'];
  });

  socket.on('word-update', (words) => {
    currentWords = words;
    document.getElementById('reset-cloud-button').disabled = words.length === 0;
    const activeWords = new Set(words.map(([word]) => word));
    let ownContributionsChanged = false;
    for (const [receipt, word] of ownContributions) {
      if (activeWords.has(word)) continue;
      ownContributions.delete(receipt);
      ownContributionsChanged = true;
    }
    if (ownContributionsChanged) renderOwnContributions();
    if (draftSettings.open) renderWordManager();
    memoryCta.classList.toggle('visible', words.length > 0);

    if (words.length === 0) {
      emptyState.classList.remove('hidden');
      canvas.classList.remove('visible');
      return;
    }
    emptyState.classList.add('hidden');

    scheduleRender(words);
  });

  socket.on('event-settings-updated', ({ title } = {}) => {
    if (!title) return;
    cloudTitle = title;
    document.getElementById('cloud-title').textContent = title;
    document.getElementById('draft-name').value = title;
    setText(document.querySelector('title'), '{{name}} – Wortwolke', { name: title });
  });

  socket.on('fatal-error', () => {
    const errorState = document.createElement('p');
    errorState.style.cssText = 'padding:60px;font-family:Georgia,serif;';
    setText(errorState, 'Diese Wortwolke wurde nicht gefunden.');
    document.body.replaceChildren(errorState);
  });

  resetCancel.addEventListener('click', () => resetDialog.close());
  resetDialog.addEventListener('close', () => {
    resetForm.reset();
    clearText(resetError);
  });

  resetForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearText(resetError);
    WolkenworteActions.setBusy(resetSubmit, true);
    resetCancel.disabled = true;
    const res = await fetch(`/api/events/${encodeURIComponent(slug)}/reset`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pin: unlockedOrganizerPin }),
    }).catch(() => null);
    if (res?.ok) {
      resetDialog.close();
      draftSettings.close();
      showToast(t('Wortwolke zurückgesetzt'));
    } else if (res?.status === 401) {
      setText(resetError, 'Die Organisator-PIN ist nicht korrekt.');
    } else if (res?.status === 429) {
      setText(resetError, 'Zu viele Versuche. Bitte wartet 15 Minuten.');
    } else {
      setText(resetError, 'Verbindung fehlgeschlagen. Bitte versucht es erneut.');
    }
    WolkenworteActions.setBusy(resetSubmit, false);
    resetCancel.disabled = false;
  });

  // ── Product configurator ──────────────────────────────────────────────────
  memoryCta.addEventListener('click', () => {
    location.href = `/e/${encodeURIComponent(slug)}/configure`;
  });

  (function handleCheckoutRedirect() {
    const params = new URLSearchParams(location.search);
    if (params.get('checkout') === 'success') {
      showToast(t('Bestellung erfolgreich! Danke euch. ♡'));
    } else if (params.get('checkout') === 'cancelled') {
      showToast(t('Bestellung abgebrochen.'));
    }
  })();

  // ── Resize ───────────────────────────────────────────────────────────────
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (currentWords.length > 0) scheduleRender(currentWords, 0);
    }, 200);
  });
</script>
</body>
</html>
