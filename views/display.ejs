<!DOCTYPE html>
<html lang="<%= locale %>" data-theme="pastel">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/z_icons/icon.svg?v=20260829-1" />
  <link rel="stylesheet" href="/site-header.css?v=20260829-2" />
  <link rel="stylesheet" href="/i18n.css?v=20260829-2" />
  <link rel="stylesheet" href="/site-fonts.css?v=20260829-1" />
  <link rel="stylesheet" href="/action-state.css?v=20260829-1" />
  <script src="/js/i18n.js?v=20260829-3"></script>
  <script src="/js/action-state.js?v=20260829-1"></script>
  <script src="/js/site-header.js" defer></script>
  <title data-i18n-source="Wortwolke – Anzeige"><%= t('Wortwolke – Anzeige') %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Pastel theme (default) — matches the landing/create/guest palette ── */
    :root {
      --bg:      #fffdfa;
      --bg2:     #fffdfa;
      --primary: #9c1c4c;
      --accent:  #c1922f;
      --text:    #400f26;
      --muted:   #8a7178;
      --border:  rgba(193,146,47,0.24);
      --rad1:    rgba(247,238,223,0.7);
      --rad2:    rgba(209,96,126,0.08);
      --orn:     rgba(193,146,47,0.55);
      --qr-bd:   rgba(193,146,47,0.35);
      --site-header-height: 85px;
    }

    /* ── Neon theme ── */
    [data-theme="neon"] {
      --bg:      #000000;
      --bg2:     #000000;
      --primary: #ff10f0;
      --accent:  #00fff2;
      --text:    #f5f0ff;
      --muted:   #b39ddb;
      --border:  rgba(255,16,240,0.30);
      --rad1:    rgba(0,255,242,0.22);
      --rad2:    rgba(191,0,255,0.22);
      --orn:     rgba(191,0,255,0.80);
      --qr-bd:   rgba(255,16,240,0.55);
    }

    [data-theme="neon"] body::before {
      background: var(--bg);
    }

    html, body {
      width: 100%; height: 100%;
      overflow: hidden;
      background: var(--bg);
      font-family: 'Jost', system-ui, -apple-system, sans-serif;
      color: var(--text);
      transition: background 0.6s, color 0.6s;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 55% at 15% 10%, var(--rad1) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 85% 90%, var(--rad2) 0%, transparent 60%),
        linear-gradient(160deg, var(--bg) 0%, var(--bg2) 100%);
      pointer-events: none;
      transition: background 0.6s;
    }

    .ww-site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
    }

    .cloud-status {
      position: fixed;
      top: calc(var(--site-header-height) + 26px);
      right: 40px;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 14px;
      pointer-events: none;
    }

    .word-counter { text-align: right; }

    .word-counter .count {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(28px, 3.5vw, 48px);
      color: var(--primary);
      line-height: 1;
      transition: color 0.6s;
    }

    .word-counter .label {
      font-size: 10px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--muted);
      margin-top: 2px;
      transition: color 0.6s;
    }

    #cloud-container {
      position: fixed;
      top: var(--site-header-height);
      left: 0; right: 0; bottom: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #cloud-canvas {
      display: block;
      opacity: 0;
      transition: opacity 0.7s ease;
    }
    #cloud-canvas.visible { opacity: 1; }

    #empty-state {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      transition: opacity 0.5s;
    }
    #empty-state.hidden { opacity: 0; }

    .empty-ornament {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(60px, 8vw, 100px);
      color: var(--rad1);
      line-height: 1;
      opacity: 0.5;
    }
    .empty-text {
      margin-top: 18px;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(18px, 2.5vw, 28px);
      font-style: italic;
      color: var(--muted);
      opacity: 0.7;
      transition: color 0.6s;
    }
    .empty-sub {
      margin-top: 10px;
      font-size: 13px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      opacity: 0.5;
      transition: color 0.6s;
    }

    .footer {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      height: 100px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 40px;
      border-top: 1px solid var(--border);
      transition: border-color 0.6s;
    }

    .footer-event-name {
      min-width: 0;
      max-width: 30vw;
      overflow: hidden;
      color: var(--primary);
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(18px, 2.1vw, 28px);
      font-weight: 400;
      line-height: 1.15;
      text-overflow: ellipsis;
      white-space: nowrap;
      transition: color 0.6s;
    }

    .qr-wrap { display: flex; align-items: center; gap: 14px; }

    .qr-label { text-align: right; }
    .qr-label .line1 {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      transition: color 0.6s;
    }
    .qr-label .line2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 14px;
      color: var(--primary);
      margin-top: 2px;
      transition: color 0.6s;
    }

    .qr-code {
      width: 84px; height: 84px;
      border-radius: 10px;
      border: 2px solid var(--qr-bd);
      padding: 3px;
      background: var(--bg);
      transition: border-color 0.6s, background 0.6s;
    }

    .footer-actions {
      display: flex;
      align-items: center;
      gap: 22px;
    }
    .footer-actions button {
      padding: 0;
      border: 0;
      background: transparent;
      font-family: inherit;
      font-size: 11px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--muted);
      opacity: 0.6;
      transition: opacity 0.3s, color 0.6s;
      cursor: pointer;
      user-select: none;
    }
    .footer-actions button:hover,
    .footer-actions button:focus-visible { opacity: 1; }

    /* ── Memory configurator CTA ── */
    #memory-cta {
      display: none;
      align-items: center;
      gap: 10px;
      background: var(--primary);
      color: #fff;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 14px;
      padding: 12px 20px;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      box-shadow: 0 6px 20px var(--border);
      transition: transform 0.15s, background 0.6s;
      pointer-events: auto;
    }
    #memory-cta.visible { display: inline-flex; }
    #memory-cta:hover { transform: translateY(-1px); }

    /* ── Toast ── */
    .toast-container {
      position: fixed;
      bottom: 90px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      pointer-events: none;
      z-index: 20;
    }

    .toast {
      background: var(--primary);
      color: #fff;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 16px;
      padding: 10px 24px;
      border-radius: 999px;
      animation: toastIn 0.3s ease both, toastOut 0.4s ease 1.8s both;
    }

    @keyframes toastIn {
      from { opacity: 0; transform: translateY(12px) scale(0.9); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes toastOut {
      to { opacity: 0; transform: translateY(-8px) scale(0.92); }
    }

    .reset-dialog {
      width: min(440px, calc(100% - 32px));
      margin: auto;
      padding: 0;
      border: 1px solid var(--border);
      border-radius: 24px;
      background: var(--bg);
      color: var(--text);
      box-shadow: 0 24px 70px rgba(64, 15, 38, .22);
    }
    .reset-dialog::backdrop { background: rgba(30, 7, 18, .42); backdrop-filter: blur(4px); }
    .reset-dialog-card { padding: 30px; }
    .reset-dialog h2 { margin: 0; font: 600 27px/1.15 'Playfair Display', Georgia, serif; }
    .reset-dialog-copy { margin: 10px 0 22px; color: var(--muted); font-size: 14px; line-height: 1.55; }
    .reset-dialog label { display: grid; gap: 7px; font-size: 13px; font-weight: 600; }
    .reset-dialog input {
      width: 100%;
      height: 50px;
      padding: 0 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      outline: none;
      background: color-mix(in srgb, var(--bg) 92%, var(--primary));
      color: var(--text);
      font: 18px/1 'Jost', system-ui, sans-serif;
    }
    .reset-dialog input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 13%, transparent); }
    .reset-dialog-error { min-height: 20px; margin: 9px 0 0; color: #b33a4d; font-size: 13px; }
    .reset-dialog-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 17px; }
    .reset-dialog-button {
      min-height: 44px;
      padding: 11px 17px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: transparent;
      color: var(--text);
      cursor: pointer;
      font: 600 13px/1 'Jost', system-ui, sans-serif;
    }
    .reset-dialog-button.primary { border-color: var(--primary); background: var(--primary); color: #fff; }
    .reset-dialog-button:disabled { cursor: wait; opacity: .58; }

    @media (max-width: 620px) {
      :root {
        --site-header-height: 73px;
      }

      .cloud-status { top: calc(var(--site-header-height) + 18px); right: 16px; gap: 10px; }
      .word-counter .label { letter-spacing: 1.5px; }
      #memory-cta { padding: 10px 15px; font-size: 12px; }
      #cloud-container { bottom: 90px; }
      .footer { height: 90px; padding: 0 16px; }
      .footer-event-name { max-width: 36vw; font-size: 18px; }
      .footer-actions { display: none; }
      .qr-label .line2 { display: none; }
      .qr-code { width: 72px; height: 72px; }
    }
  </style>
</head>
<body>

<%- include('partials/site-header') %>

<aside class="cloud-status" aria-label="Live-Wortwolke">
  <div class="word-counter">
    <div class="count" id="word-total">0</div>
    <div class="label">Wörter geteilt</div>
  </div>
  <button id="memory-cta" title="Wortwolke verewigen">
    Wortwolke verewigen
  </button>
</aside>

<div id="cloud-container">
  <canvas id="cloud-canvas"></canvas>
  <div id="empty-state">
    <div class="empty-ornament">♡</div>
    <p class="empty-text">Wir warten auf eure Wörter&hellip;</p>
    <p class="empty-sub">QR-Code scannen &amp; mitmachen</p>
  </div>
</div>

<footer class="footer">
  <span class="footer-event-name" id="couple-name" data-i18n-ignore>♡</span>
  <div class="footer-actions">
    <button id="theme-hint" type="button" title="Farbwelt wechseln">Farbwelt</button>
    <button id="export-hint" type="button" title="Wortwolke herunterladen">Download</button>
    <button id="clear-hint" type="button" title="Wörter archivieren &amp; neue Runde starten">Neue Runde</button>
  </div>
  <div class="qr-wrap">
    <div class="qr-label">
      <div class="line1">Scannen &amp; mitmachen</div>
      <div class="line2" id="qr-url"></div>
    </div>
    <img class="qr-code" id="qr-img" src="" alt="QR-Code" />
  </div>
</footer>

<div class="toast-container" id="toast-container"></div>

<dialog class="reset-dialog" id="reset-dialog" aria-labelledby="reset-dialog-title">
  <form class="reset-dialog-card" id="reset-form">
    <h2 id="reset-dialog-title">Neue Runde starten?</h2>
    <p class="reset-dialog-copy">Die aktuellen Wörter werden archiviert. Anschließend beginnt eure Wortwolke wieder leer.</p>
    <label for="reset-pin">Admin-PIN
      <input id="reset-pin" type="tel" inputmode="numeric" pattern="[0-9]*" minlength="4" maxlength="6" autocomplete="off" required />
    </label>
    <p class="reset-dialog-error" id="reset-error" role="alert" aria-live="polite"></p>
    <div class="reset-dialog-actions">
      <button class="reset-dialog-button" id="reset-cancel" type="button">Abbrechen</button>
      <button class="reset-dialog-button primary" id="reset-submit" type="submit">Neue Runde starten</button>
    </div>
  </form>
</dialog>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/wordcloud-core.js?v=20260819-2"></script>
<script>
  // Slug comes from the URL: /e/<slug>/display
  const slug = location.pathname.split('/').filter(Boolean)[1];

  const canvas         = document.getElementById('cloud-canvas');
  const ctx             = canvas.getContext('2d');
  const container       = document.getElementById('cloud-container');
  const emptyState      = document.getElementById('empty-state');
  const wordTotalEl     = document.getElementById('word-total');
  const toastContainer  = document.getElementById('toast-container');
  const memoryCta       = document.getElementById('memory-cta');
  const resetDialog     = document.getElementById('reset-dialog');
  const resetForm       = document.getElementById('reset-form');
  const resetPin        = document.getElementById('reset-pin');
  const resetError      = document.getElementById('reset-error');
  const resetCancel     = document.getElementById('reset-cancel');
  const resetSubmit     = document.getElementById('reset-submit');
  const t = (source, params) => WolkenworteI18n.t(source, params);
  const setText = (element, source, params) => WolkenworteI18n.setText(element, source, params);
  const clearText = (element) => WolkenworteI18n.clearText(element);

  let currentWords = [];
  let renderTimer  = null;
  let lastWords    = null;
  let getWordColor = WordCloudCore.makeColorAssigner('pastel');

  // ── Theme ─────────────────────────────────────────────────────────────────
  const urlTheme = new URLSearchParams(location.search).get('theme');
  let currentTheme = (urlTheme === 'neon' || urlTheme === 'pastel') ? urlTheme : 'pastel';

  function applyTheme(t) {
    currentTheme = t;
    getWordColor = WordCloudCore.makeColorAssigner(t); // re-assign colors from new palette
    document.documentElement.dataset.theme = t;
    if (currentWords.length > 0) scheduleRender(currentWords);
  }

  function renderCloud(words) {
    if (!words || words.length === 0) return;

    const rect = container.getBoundingClientRect();
    const side = Math.min(rect.width, rect.height) * 0.94;
    canvas.width = side;
    canvas.height = side;

    const placed = WordCloudCore.layoutWords(words, side, ctx, getWordColor);

    ctx.clearRect(0, 0, side, side);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    for (const p of placed) {
      ctx.font = `${p.fontPx}px ${WordCloudCore.FONT_FAMILY}`;
      ctx.fillStyle = p.color;
      if (p.rotated) {
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(-Math.PI / 2);
        ctx.fillText(p.word, 0, p.fontPx * 0.34);
        ctx.restore();
      } else {
        ctx.fillText(p.word, p.x, p.y + p.fontPx * 0.34);
      }
    }
    canvas.classList.add('visible');
  }

  function scheduleRender(words) {
    clearTimeout(renderTimer);
    renderTimer = setTimeout(() => renderCloud(words), 300);
  }

  function showToast(word) {
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = '✦  ' + word;
    toastContainer.appendChild(toast);
    setTimeout(() => toast.remove(), 2400);
  }

  // ── Config & QR ──────────────────────────────────────────────────────────
  fetch(`/api/events/${encodeURIComponent(slug)}`).then(r => r.json()).then(async ({ coupleName, theme, locale }) => {
    await WolkenworteI18n.useEventLocale(locale);
    document.getElementById('couple-name').textContent = coupleName;
    setText(document.querySelector('title'), '{{name}} – Wortwolke', { name: coupleName });
    if (!urlTheme && (theme === 'neon' || theme === 'pastel')) applyTheme(theme);
  }).catch(() => {});

  fetch(`/api/events/${encodeURIComponent(slug)}/qr`).then(r => r.json()).then(({ dataUrl, url }) => {
    document.getElementById('qr-img').src = dataUrl;
    document.getElementById('qr-url').textContent = url.replace('http://', '').replace('https://', '');
  }).catch(() => {});

  applyTheme(currentTheme);

  // ── Socket (room-scoped to this event via ?slug=) ───────────────────────
  const socket = io({
    query: { slug },
    transports: ['websocket', 'polling'],
    tryAllTransports: true,
    timeout: 7000,
  });
  let socketHasConnected = false;
  socket.on('connect_error', () => {
    if (!socketHasConnected) socket.io.opts.transports = ['polling', 'websocket'];
  });
  socket.on('connect', () => {
    socketHasConnected = true;
    socket.io.opts.transports = ['websocket', 'polling'];
  });

  socket.on('word-update', (words) => {
    currentWords = words;
    const total = words.reduce((s, [, c]) => s + c, 0);
    wordTotalEl.textContent = total;

    memoryCta.classList.toggle('visible', words.length > 0);

    if (words.length === 0) {
      emptyState.classList.remove('hidden');
      canvas.classList.remove('visible');
      return;
    }
    emptyState.classList.add('hidden');

    if (lastWords) {
      const prev = new Map(lastWords);
      for (const [word, count] of words) {
        if (!prev.has(word) || prev.get(word) < count) { showToast(word); break; }
      }
    }
    lastWords = words;
    scheduleRender(words);
  });

  socket.on('theme-change', (t) => {
    if (t === 'neon' || t === 'pastel') applyTheme(t);
  });

  socket.on('fatal-error', () => {
    const errorState = document.createElement('p');
    errorState.style.cssText = 'padding:60px;font-family:Georgia,serif;';
    setText(errorState, 'Diese Wortwolke wurde nicht gefunden.');
    document.body.replaceChildren(errorState);
  });

  // ── Theme toggle ──────────────────────────────────────────────────────────
  function toggleTheme() {
    const next = currentTheme === 'neon' ? 'pastel' : 'neon';
    applyTheme(next);
    socket.emit('theme-change', next);
  }

  document.getElementById('theme-hint').addEventListener('click', toggleTheme);

  // ── SVG export (for print) ───────────────────────────────────────────────
  function exportSVG() {
    if (!currentWords.length) return;
    const side = 2000; // fixed high-resolution square so print output stays crisp
    const measureCtx = document.createElement('canvas').getContext('2d');
    const exportColorFn = WordCloudCore.makeColorAssigner(currentTheme);
    const placed = WordCloudCore.layoutWords(currentWords, side, measureCtx, exportColorFn);
    const svg = WordCloudCore.buildSVG(placed, side, currentTheme);
    const blob = new Blob([svg], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `wortwolke-${currentTheme}-${new Date().toISOString().slice(0, 10)}.svg`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  document.getElementById('export-hint').addEventListener('click', exportSVG);

  // ── New session (archive current words on the server, then clear) ───────
  function startNewSession() {
    if (!currentWords.length) return;
    clearText(resetError);
    resetDialog.showModal();
    resetPin.focus();
  }

  resetCancel.addEventListener('click', () => resetDialog.close());
  resetDialog.addEventListener('close', () => {
    resetForm.reset();
    clearText(resetError);
  });

  resetForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!resetForm.reportValidity()) return;
    clearText(resetError);
    WolkenworteActions.setBusy(resetSubmit, true);
    resetCancel.disabled = true;
    const pin = resetPin.value.trim();
    const res = await fetch(`/api/events/${encodeURIComponent(slug)}/reset`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pin }),
    }).catch(() => null);
    if (res?.ok) {
      resetDialog.close();
    } else if (res?.status === 401) {
      setText(resetError, 'Falscher PIN.');
      resetPin.select();
    } else if (res?.status === 429) {
      setText(resetError, 'Zu viele Versuche. Bitte wartet 15 Minuten.');
    } else {
      setText(resetError, 'Verbindung fehlgeschlagen. Bitte versucht es erneut.');
    }
    WolkenworteActions.setBusy(resetSubmit, false);
    resetCancel.disabled = false;
  });

  document.getElementById('clear-hint').addEventListener('click', startNewSession);

  // ── Product configurator ──────────────────────────────────────────────────
  memoryCta.addEventListener('click', () => {
    location.href = `/e/${encodeURIComponent(slug)}/configure`;
  });

  (function handleCheckoutRedirect() {
    const params = new URLSearchParams(location.search);
    if (params.get('checkout') === 'success') {
      showToast(t('Bestellung erfolgreich! Danke euch. ♡'));
    } else if (params.get('checkout') === 'cancelled') {
      showToast(t('Bestellung abgebrochen.'));
    }
  })();

  // ── Resize ───────────────────────────────────────────────────────────────
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (currentWords.length > 0) renderCloud(currentWords);
    }, 200);
  });
</script>
</body>
</html>
