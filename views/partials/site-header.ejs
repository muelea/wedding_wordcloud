<%
  const config = header || {};
  const variant = config.variant || 'brand-only';
  const headerClass = config.headerClass || 'site-header';
  const navClass = config.navClass || '';
  const brandId = config.brandId || '';
  const backId = config.backId || '';
  const backHref = config.backHref || '/';
  const backLabel = config.backLabel || 'Zurück zur Startseite';
  const backAria = config.backAria || backLabel;
  const paletteOptions = Array.isArray(config.paletteOptions) ? config.paletteOptions : [];
  const navLinks = config.navLinks || [
    { href: '#so-gehts', label: "So geht's" },
    { href: '#erleben', label: 'Erleben' },
    { href: '#erinnerungsstuecke', label: 'Erinnerungsstücke' },
    { href: '#erinnerung', label: 'Eure Erinnerung' },
  ];
%>
<header class="<%= headerClass %> ww-site-header"<% if (config.id) { %> id="<%= config.id %>"<% } %>>
  <div class="<%= navClass ? `${navClass} ` : '' %>ww-nav ww-language-mounted">
    <a class="brand ww-brand"<% if (brandId) { %> id="<%= brandId %>"<% } %> href="/" aria-label="Wolkenworte">
      <img class="brand-icon ww-brand-icon" src="/z_icons/icon.svg?v=20260829-1" alt="" aria-hidden="true" />
      <%- include('brand-wordmark') %>
    </a>

    <% if (variant === 'landing') { %>
      <nav id="landing-section-links" class="landing-section-links" aria-label="Seitennavigation">
        <button class="landing-menu-start" type="button" data-open-start-dialog data-i18n-source="Hier starten"><%= t('Hier starten') %></button>
        <% for (const link of navLinks) { %>
          <a class="landing-section-link" href="<%= link.href %>" data-i18n-source="<%= link.label %>"><%= t(link.label) %></a>
        <% } %>
        <%- include('language-picker', { languagePickerClass: 'landing-menu-language' }) %>
      </nav>
      <div class="landing-header-actions">
        <button class="button primary landing-start-button" type="submit" form="start-dialog-form" data-open-start-dialog data-i18n-source="Hier starten"><%= t('Hier starten') %></button>
        <button class="landing-menu-toggle" type="button" aria-label="Seitennavigation öffnen" aria-expanded="false" aria-controls="landing-section-links">
          <span class="landing-menu-toggle-icon" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
      </div>
    <% } else if (variant === 'back') { %>
      <a class="back-link ww-back-link"<% if (backId) { %> id="<%= backId %>"<% } %> href="<%= backHref %>" aria-label="<%= t(backAria) %>" data-i18n-aria-label-source="<%= backAria %>"><span aria-hidden="true">←</span><span data-i18n-source="<%= backLabel %>"><%= t(backLabel) %></span></a>
    <% } %>

    <% if (variant === 'display') { %>
    <details class="ww-display-menu" id="display-page-menu">
      <summary id="display-menu-trigger" class="ww-display-menu-trigger" aria-label="Menü öffnen">
        <span class="ww-display-menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>
      <div class="ww-display-menu-panel">
        <section class="ww-display-menu-language-row" aria-labelledby="display-menu-language-label">
          <span class="ww-display-menu-label" id="display-menu-language-label">Sprache</span>
          <%- include('language-picker', { languagePickerClass: 'ww-display-menu-language' }) %>
        </section>
        <% if (paletteOptions.length) { %>
        <section class="ww-display-menu-palette-row" aria-labelledby="display-menu-palette-label">
          <label class="ww-display-menu-label" id="display-menu-palette-label" for="display-palette-select">Farbwelt</label>
          <div class="ww-display-menu-palette-control">
            <span class="ww-display-menu-palette-swatches" id="display-palette-swatches" aria-hidden="true">
              <% for (const color of paletteOptions[0].colors) { %><i style="background:<%= color %>"></i><% } %>
            </span>
            <select id="display-palette-select" aria-label="Farbwelt">
              <% for (const palette of paletteOptions) { %>
                <option value="<%= palette.key %>" data-i18n-source="<%= palette.label %>"><%= t(palette.label) %></option>
              <% } %>
            </select>
          </div>
        </section>
        <% } %>
        <div class="ww-display-menu-actions">
          <button class="ww-display-menu-action" id="display-own-words-button" type="button" aria-haspopup="dialog" aria-controls="display-own-words-dialog" hidden>
            <span>Deine Wörter</span>
            <span class="ww-display-menu-count" id="display-own-words-count" aria-live="polite">0</span>
          </button>
          <button class="ww-display-menu-action" id="draft-settings-button" type="button" hidden>Einstellungen</button>
          <button class="ww-display-menu-action" id="presentation-mode-button" type="button" role="switch" aria-checked="false">
            <span>Präsentationsmodus</span>
            <span class="ww-display-menu-switch" aria-hidden="true"><i></i></span>
          </button>
        </div>
      </div>
    </details>
    <% } else if (variant !== 'landing') { %>
    <%- include('language-picker', { languagePickerClass: 'ww-language-inline' }) %>
    <% } %>
  </div>
</header>
