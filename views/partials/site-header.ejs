<%
  const config = header || {};
  const variant = config.variant || 'brand-only';
  const headerClass = config.headerClass || 'site-header';
  const navClass = config.navClass || '';
  const brandId = config.brandId || '';
  const backId = config.backId || '';
  const backHref = config.backHref || '/';
  const backLabel = config.backLabel || 'Zurück zur Startseite';
  const backAria = config.backAria || backLabel;
  const mobileBackId = config.mobileBackId || '';
  const cartButton = config.cartButton === true;
  const accountsEnabled = typeof designAccountsEnabled !== 'undefined' && designAccountsEnabled;
  const cartButtonId = config.cartButtonId || 'header-cart';
  const cartBadgeId = config.cartBadgeId || 'header-cart-count';
  const paletteOptions = Array.isArray(config.paletteOptions) ? config.paletteOptions : [];
  const navLinks = config.navLinks || [
    { href: '#so-gehts', label: "So geht's" },
    { href: '#erleben', label: 'Erleben' },
    { href: '#erinnerungsstuecke', label: 'Erinnerungsstücke' },
    { href: '#erinnerung', label: 'Eure Erinnerung' },
  ];
%>
<script src="<%= asset('/js/overlay-scroll.js') %>" defer></script>
<script src="<%= asset('/js/basket-navigation.js') %>" defer></script>
<header class="<%= headerClass %> ww-site-header<%= accountsEnabled ? ' ww-accounts-enabled' : '' %>"<% if (config.id) { %> id="<%= config.id %>"<% } %>>
  <div class="<%= navClass ? `${navClass} ` : '' %>ww-nav ww-language-mounted">
    <a class="brand ww-brand"<% if (brandId) { %> id="<%= brandId %>"<% } %> href="/" aria-label="Wolkenworte">
      <img class="brand-icon ww-brand-icon" src="<%= asset('/z_icons/icon.svg') %>" alt="" aria-hidden="true" />
      <%- include('brand-wordmark') %>
    </a>

    <% if (variant === 'landing') { %>
      <nav id="landing-section-links" class="landing-section-links" aria-label="Seitennavigation">
        <% for (const link of navLinks) { %>
        <a class="landing-section-link" href="<%= link.href %>" data-i18n-source="<%= link.label %>"><%= t(link.label) %></a>
        <% } %>
      </nav>
    <% } else if (variant === 'back') { %>
      <a class="back-link ww-back-link ww-back-link-desktop"<% if (backId) { %> id="<%= backId %>"<% } %> href="<%= backHref %>" aria-label="<%= t(backAria) %>" data-i18n-aria-label-source="<%= backAria %>"><span aria-hidden="true">←</span><span data-i18n-source="<%= backLabel %>"><%= t(backLabel) %></span></a>
    <% } %>
    <div class="<%= variant === 'landing' ? 'landing-header-actions' : variant === 'display' ? 'ww-display-header-actions' : 'ww-back-header-actions' %>">
      <% if (variant === 'landing') { %>
      <button class="button primary landing-start-button" type="button" data-open-start-dialog data-i18n-source="Hier starten"><%= t('Hier starten') %></button>
      <% } else if (variant === 'display') { %>
      <button
        class="ww-keepsake-cta"
        id="memory-cta"
        type="button"
        <% if (!config.hasWords) { %>disabled<% } %>
        aria-label="<%= t('Erinnerung gestalten') %>"
        data-i18n-aria-label-source="Erinnerung gestalten"
      >
        <svg class="ww-keepsake-cta-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2c.8 5.2 4.8 9.2 10 10-5.2.8-9.2 4.8-10 10-.8-5.2-4.8-9.2-10-10 5.2-.8 9.2-4.8 10-10Z" />
        </svg>
        <span class="ww-keepsake-cta-label ww-keepsake-cta-label-full" data-i18n-source="Erinnerung gestalten"><%= t('Erinnerung gestalten') %></span>
        <span class="ww-keepsake-cta-label ww-keepsake-cta-label-compact" data-i18n-source="Andenken"><%= t('Andenken') %></span>
      </button>
      <% } %>
      <% if (cartButton) { %>
      <button
        class="ww-header-cart ww-menu-trigger"
        id="<%= cartButtonId %>"
        type="button"
        aria-label="<%= t('Warenkorb öffnen') %>"
        data-i18n-aria-label-source="Warenkorb öffnen"
        aria-controls="order-box"
        hidden
      >
        <svg class="ww-header-cart-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3.5 4.5h2l1.7 9.1a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 1.9-1.4l1.5-5.6H6.4" />
          <circle cx="9.4" cy="19" r="1.25" />
          <circle cx="17.2" cy="19" r="1.25" />
        </svg>
        <span class="ww-header-cart-badge" id="<%= cartBadgeId %>" aria-hidden="true"></span>
      </button>
      <% } %>
      <%- include('site-menu', { accountsEnabled, variant, paletteOptions }) %>
    </div>
  </div>
</header>
<% if (variant === 'back') { %>
  <a class="ww-back-link ww-back-link-mobile"<% if (mobileBackId) { %> id="<%= mobileBackId %>"<% } %> href="<%= backHref %>" aria-label="<%= t(backAria) %>" data-i18n-aria-label-source="<%= backAria %>"><span aria-hidden="true">←</span><span data-i18n-source="<%= backLabel %>"><%= t(backLabel) %></span></a>
<% } %>
