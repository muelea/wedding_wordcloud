<dialog id="print-preview" class="print-preview ww-mobile-dialog" aria-labelledby="print-preview-title">
  <div class="print-preview-shell">
    <header class="print-preview-head">
      <div>
        <h2 id="print-preview-title" data-preview-title tabindex="-1"></h2>
        <p class="print-preview-detail" data-preview-detail data-i18n-ignore></p>
      </div>
      <button type="button" class="ww-icon-button ww-close-button print-preview-close" data-preview-close aria-label="Vorschau schließen"></button>
    </header>
    <div class="print-preview-content" data-preview-content>
      <div class="print-preview-grid">
        <div class="print-preview-media">
          <div class="print-preview-toolbar">
            <div class="print-preview-views" data-preview-views role="tablist" aria-label="Ansicht wählen">
              <button type="button" role="tab" id="preview-tab-model" data-preview-view="model" aria-controls="preview-panel-model" aria-selected="false" tabindex="-1">3D-Ansicht</button>
              <button type="button" role="tab" id="preview-tab-photo" data-preview-view="photo" aria-controls="preview-panel-photo" aria-selected="false" tabindex="-1">Produktfotos</button>
              <button type="button" role="tab" id="preview-tab-print" data-preview-view="print" aria-controls="preview-panel-print" aria-selected="false" tabindex="-1">Dein Design</button>
            </div>
            <button type="button" class="print-preview-expand" data-preview-expand aria-pressed="false" aria-label="Ansicht vergrößern"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg></button>
          </div>
          <div class="print-preview-stage">
            <section id="preview-panel-photo" class="print-preview-card print-preview-photo" data-preview-photo-card role="tabpanel" aria-labelledby="preview-tab-photo" hidden>
              <div class="print-preview-viewport" data-preview-photo>
                <div class="print-preview-artwork" data-preview-photo-artwork hidden></div>
                <div class="print-preview-feedback" data-preview-photo-feedback>
                  <p data-preview-photo-status role="status" aria-live="polite">Produktvorschau wird geladen…</p>
                  <button type="button" data-preview-photo-retry hidden>Erneut versuchen</button>
                </div>
              </div>
            </section>
            <section id="preview-panel-print" class="print-preview-card print-preview-design" data-preview-print-card role="tabpanel" aria-labelledby="preview-tab-print" hidden>
              <div class="print-preview-viewport" data-preview-viewport tabindex="0" aria-label="Designvorschau">
                <div class="print-preview-artwork" data-preview-artwork hidden></div>
                <div class="print-preview-feedback" data-preview-feedback>
                  <p data-preview-status role="status" aria-live="polite">Druckvorschau wird geladen…</p>
                  <button type="button" data-preview-retry hidden>Erneut versuchen</button>
                </div>
              </div>
              <div class="print-preview-design-controls">
                <div class="print-preview-surfaces" data-preview-surfaces role="group" aria-label="Ansicht wählen" hidden></div>
                <button type="button" data-preview-print-fit aria-pressed="false">Gesamte Druckfläche</button>
              </div>
            </section>
            <section id="preview-panel-model" class="print-preview-card print-preview-model-card" data-preview-model-card role="tabpanel" aria-labelledby="preview-tab-model" hidden>
              <div class="print-preview-viewport">
                <div class="print-preview-model" data-preview-model></div>
                <div class="print-preview-feedback" data-preview-model-feedback>
                  <p data-preview-model-status role="status" aria-live="polite">3D-Vorschau wird geladen…</p>
                  <button type="button" data-preview-model-retry hidden>Erneut versuchen</button>
                </div>
              </div>
            </section>
          </div>
          <div class="print-preview-photo-navigation" data-preview-photo-navigation hidden>
            <div class="print-preview-photo-thumbnails" data-preview-photo-thumbnails role="group" aria-label="Produktfotos"></div>
          </div>
          <p class="print-preview-caption" data-preview-caption role="status" aria-live="polite"></p>
        </div>
        <section class="print-preview-description-card" aria-labelledby="preview-description-label">
          <h3 id="preview-description-label">Produktbeschreibung</h3>
          <div class="print-preview-description" data-preview-description tabindex="0" aria-labelledby="preview-description-label" data-i18n-ignore></div>
        </section>
      </div>
      <section class="print-preview-card print-preview-generated" data-preview-mockup-card aria-labelledby="preview-mockup-label" hidden>
        <div class="print-preview-card-head">
          <h3 id="preview-mockup-label">Produktvorschau</h3>
          <div class="print-preview-surfaces" data-preview-mockup-surfaces role="group" aria-label="Ansicht wählen" hidden></div>
        </div>
        <div class="print-preview-viewport" data-preview-mockup-viewport>
          <div class="print-preview-artwork" data-preview-mockup-artwork hidden></div>
          <div class="print-preview-feedback" data-preview-generated-feedback>
            <p data-preview-generated-status role="status" aria-live="polite">Produktvorschau wird geladen…</p>
          </div>
        </div>
      </section>
    </div>
    <div class="print-preview-mockup-actions" data-preview-mockup-actions hidden>
      <p data-preview-mockup-status role="status" aria-live="polite" hidden></p>
      <button type="button" data-preview-mockup>Produktvorschau erstellen</button>
    </div>
  </div>
</dialog>
