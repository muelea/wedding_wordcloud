<section class="ww-account-auth" data-account-auth>
  <p>Speichere deine Designs und arbeite später weiter. Gestalten und bestellen geht auch ohne Konto.</p>
  <button class="ww-account-primary ww-account-google" type="button" data-auth-google>Mit Google fortfahren</button>
  <p class="ww-account-divider">oder mit E-Mail</p>
  <div class="ww-account-tabs" aria-label="Anmeldung wählen">
    <button type="button" data-auth-mode="login" aria-pressed="true">Anmelden</button>
    <button type="button" data-auth-mode="signup" aria-pressed="false">Konto erstellen</button>
  </div>
  <form data-auth-form>
    <label>E-Mail-Adresse<input type="email" name="email" autocomplete="email" inputmode="email" maxlength="254" required /></label>
    <label data-auth-password-label>Passwort<input type="password" name="password" autocomplete="current-password" maxlength="256" required /></label>
    <p data-auth-password-help hidden>Mindestens 12 Zeichen.</p>
    <div class="ww-account-auth-actions">
      <button class="ww-account-primary" type="submit" data-auth-submit>Anmelden</button>
      <button class="ww-account-link" type="button" data-auth-forgot>Passwort vergessen?</button>
    </div>
  </form>
  <form data-auth-code-form hidden>
    <p>Gib den sechsstelligen Code aus deiner E-Mail ein.</p><p data-auth-code-email></p>
    <label>Bestätigungscode<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /></label>
    <button class="ww-account-primary" type="submit">Code bestätigen</button>
    <button class="ww-account-link" type="button" data-auth-resend>Neuen Code anfordern</button>
  </form>
  <form data-auth-reset-form hidden>
    <label>Neues Passwort<input type="password" name="password" autocomplete="new-password" minlength="12" maxlength="256" required /></label>
    <label>Passwort wiederholen<input type="password" name="repeat" autocomplete="new-password" minlength="12" maxlength="256" required /></label>
    <button class="ww-account-primary" type="submit">Passwort speichern</button>
  </form>
  <p class="ww-account-status" data-auth-status role="status" aria-live="polite"></p>
  <p class="ww-account-small">Informationen zur Verarbeitung deiner Daten findest du im <a href="/datenschutz">Datenschutz</a>.</p>
</section>
