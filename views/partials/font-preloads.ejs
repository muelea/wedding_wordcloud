<link rel="preload" href="<%= asset('/assets/site-fonts/jost/jost-latin.woff2') %>" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="<%= asset('/assets/site-fonts/playfair-display/playfair-display-latin.woff2') %>" as="font" type="font/woff2" crossorigin />
<% if (locale === 'tr') { %>
  <link rel="preload" href="<%= asset('/assets/site-fonts/jost/jost-latin-ext.woff2') %>" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="<%= asset('/assets/site-fonts/playfair-display/playfair-display-latin-ext.woff2') %>" as="font" type="font/woff2" crossorigin />
<% } %>
<% if (typeof preloadPlayfairItalic !== 'undefined' && preloadPlayfairItalic) { %>
  <link rel="preload" href="<%= asset('/assets/site-fonts/playfair-display/playfair-display-italic-latin.woff2') %>" as="font" type="font/woff2" crossorigin />
  <% if (locale === 'tr') { %>
    <link rel="preload" href="<%= asset('/assets/site-fonts/playfair-display/playfair-display-italic-latin-ext.woff2') %>" as="font" type="font/woff2" crossorigin />
  <% } %>
<% } %>
