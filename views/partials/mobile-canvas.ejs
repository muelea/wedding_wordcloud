<dialog class="mobile-canvas-dialog" id="mobile-canvas-dialog" aria-labelledby="mobile-canvas-title">
  <header class="mobile-canvas-header">
    <strong id="mobile-canvas-title">Design bearbeiten</strong>
    <nav aria-label="Ansicht wählen">
      <button type="button" data-canvas-view="canvas" aria-pressed="true">Canvas</button>
      <button type="button" data-canvas-view="product" aria-pressed="false">Produkt</button>
    </nav>
    <div class="mobile-canvas-controls" aria-label="Ansicht und Verlauf">
      <div id="mobile-canvas-selection" hidden>
        <button type="button" id="mobile-canvas-deselect">Auswahl aufheben</button>
        <button type="button" id="mobile-canvas-multi-done" hidden>Fertig</button>
      </div>
      <div id="mobile-canvas-history"></div>
      <div id="mobile-canvas-overlaps"></div>
      <div id="mobile-canvas-zoom"></div>
      <button type="button" id="mobile-canvas-fit" aria-label="Einpassen" aria-describedby="editor-zoom-label">100 %</button>
    </div>
    <div class="mobile-canvas-header-actions">
    <button type="button" id="mobile-canvas-fullscreen" aria-label="Vollbild öffnen" aria-pressed="false" hidden>
      <svg class="editor-icon" aria-hidden="true" viewBox="0 0 24 24"><use href="#editor-icon-expand"></use></svg>
    </button>
    <button type="button" id="mobile-canvas-settings-toggle" aria-label="Produkt und Farben" aria-controls="mobile-canvas-drawer" aria-expanded="false">
      <svg class="editor-icon" aria-hidden="true" viewBox="0 0 24 24"><use href="#editor-icon-palette"></use></svg>
    </button>
    <button type="button" id="mobile-canvas-close" aria-label="Zur Vorschau">Zur Vorschau</button>
    </div>
    <div id="mobile-canvas-surfaces"></div>
    <p class="configurator-progress" data-configurator-progress role="status" aria-live="polite" hidden></p>
  </header>
  <div class="mobile-canvas-body">
    <nav class="mobile-canvas-rail" aria-label="Canvas-Werkzeuge">
      <div id="mobile-canvas-overlap-rail"></div>
      <% for (const tool of [{ key:'move', label:'Bewegen', icon:'arrow-right' },
        { key:'view', label:'Zoom & Ansicht', icon:'zoom-in' }, { key:'properties', label:'Anpassen', icon:'sliders-horizontal' },
        { key:'add', label:'Neu', icon:'plus' }, { key:'more', label:'Mehr', icon:'ellipsis' }]) { %>
      <button type="button" data-canvas-tool="<%= tool.key %>" aria-pressed="<%= tool.key === 'move' %>">
        <svg class="editor-icon" aria-hidden="true" viewBox="0 0 24 24"><use href="#editor-icon-<%= tool.icon %>"></use></svg>
        <span><%= tool.label %></span>
      </button>
      <% } %>
    </nav>
    <div class="mobile-canvas-stage" id="mobile-canvas-stage"></div>
    <div class="mobile-canvas-product" id="mobile-canvas-product" hidden></div>
    <aside class="mobile-canvas-drawer" id="mobile-canvas-drawer" aria-labelledby="mobile-canvas-panel-title" hidden>
      <div class="mobile-canvas-drawer-head">
        <button type="button" id="mobile-canvas-panel-back" aria-label="Zurück" hidden>←</button>
        <strong id="mobile-canvas-panel-title">Anpassen</strong>
        <button type="button" id="mobile-canvas-panel-close" aria-label="Werkzeuge schließen">×</button></div>
      <div class="mobile-canvas-drawer-content">
        <div id="mobile-canvas-properties" hidden></div>
        <div id="mobile-canvas-settings" hidden></div>
        <div id="mobile-canvas-picker" hidden></div>
        <div id="mobile-canvas-add" hidden></div>
        <div id="mobile-canvas-more" hidden>
          <button type="button" id="mobile-canvas-multi-select">Mehrere auswählen</button>
          <button type="button" data-canvas-tool="elements">Element suchen</button>
          <div id="mobile-canvas-design-actions"></div>
        </div>
        <div id="mobile-canvas-emoji" hidden></div>
        <div id="mobile-canvas-elements" hidden>
          <label for="mobile-canvas-search">Element suchen</label>
          <input id="mobile-canvas-search" type="search" autocomplete="off" />
          <div id="mobile-canvas-element-list"></div>
        </div>
      </div>
    </aside>
  </div>
  <form id="mobile-canvas-text-editor" aria-label="Wort bearbeiten" hidden>
    <label class="editor-field-label-text" for="mobile-canvas-text">Wort bearbeiten</label>
    <input id="mobile-canvas-text" type="text" maxlength="1024" autocomplete="off" enterkeyhint="done" />
    <button type="button" id="mobile-canvas-text-cancel">Abbrechen</button>
    <button type="submit" id="mobile-canvas-text-done">Fertig</button>
  </form>
</dialog>
