<%
  const preloadOptions = {
    locale,
    playfairItalic: typeof preloadPlayfairItalic !== 'undefined' && preloadPlayfairItalic,
    cormorantItalic: typeof preloadCormorantItalic !== 'undefined' && preloadCormorantItalic,
  };
  const preloadPaths = siteFontPreloads(preloadOptions);
%>
<% for (const fontPath of preloadPaths) { %>
<link rel="preload" href="<%= asset(fontPath) %>" as="font" type="font/woff2" crossorigin />
<% } %>
<style data-ww-site-fonts>
  /* Full, identical print font in every browser and the Linux renderer.
     A Latin-ext subset alone silently falls back for ordinary Latin words. */
  @font-face {
    font-family: "Wolkenworte Classic";
    src: url("<%= asset('/assets/design-fonts/gelasio/Gelasio.ttf') %>") format("truetype");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  /* Local metric fallbacks keep line boxes stable while the preloaded faces decode. */
  @font-face {
    font-family: "Wolkenworte Jost Fallback";
    src: local("Arial");
    font-style: normal;
    font-weight: 300 600;
    size-adjust: 88.72%;
    ascent-override: 107%;
    descent-override: 37.5%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: "Wolkenworte Playfair Fallback";
    src: local("Georgia");
    font-style: normal;
    font-weight: 500 700;
    size-adjust: 106.76%;
    ascent-override: 108.2%;
    descent-override: 25.1%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: "Wolkenworte Playfair Fallback";
    src: local("Georgia Italic"), local("Georgia");
    font-style: italic;
    font-weight: 500 600;
    size-adjust: 106.76%;
    ascent-override: 108.2%;
    descent-override: 25.1%;
    line-gap-override: 0%;
  }

  /* Jost variable font: 300–600 */
  @font-face {
    font-family: "Jost";
    font-style: normal;
    font-weight: 300 600;
    font-display: swap;
    src: url("<%= asset(siteFontAssets.jostLatinExtended) %>") format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
      U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
      U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
      U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: "Jost";
    font-style: normal;
    font-weight: 300 600;
    font-display: swap;
    src: url("<%= asset(siteFontAssets.jostLatin) %>") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC,
      U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
      U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* Playfair Display variable font: 500–700 */
  @font-face {
    font-family: "Playfair Display";
    font-style: normal;
    font-weight: 500 700;
    font-display: swap;
    src: url("<%= asset(siteFontAssets.playfairLatinExtended) %>") format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
      U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
      U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
      U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: "Playfair Display";
    font-style: normal;
    font-weight: 500 700;
    font-display: swap;
    src: url("<%= asset(siteFontAssets.playfairLatin) %>") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC,
      U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
      U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: "Playfair Display";
    font-style: italic;
    font-weight: 500 600;
    font-display: swap;
    src: url("<%= asset(siteFontAssets.playfairItalicLatinExtended) %>") format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
      U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
      U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
      U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: "Playfair Display";
    font-style: italic;
    font-weight: 500 600;
    font-display: swap;
    src: url("<%= asset(siteFontAssets.playfairItalicLatin) %>") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC,
      U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
      U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* Cormorant Garamond variable italic font: 500–600 */
  @font-face {
    font-family: "Cormorant Garamond";
    font-style: italic;
    font-weight: 500 600;
    font-display: swap;
    src: url("<%= asset(siteFontAssets.cormorantItalicLatinExtended) %>") format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
      U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
      U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
      U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: "Cormorant Garamond";
    font-style: italic;
    font-weight: 500 600;
    font-display: swap;
    src: url("<%= asset(siteFontAssets.cormorantItalicLatin) %>") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC,
      U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
      U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* Shadows Into Light: 400 */
  @font-face {
    font-family: "Shadows Into Light";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("<%= asset(siteFontAssets.shadowsLatinExtended) %>") format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
      U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
      U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
      U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: "Shadows Into Light";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("<%= asset(siteFontAssets.shadowsLatin) %>") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC,
      U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
      U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
</style>
