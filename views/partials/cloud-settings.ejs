<section class="ww-site-menu-cloud" aria-label="Wolken-Einstellungen">
  <% if (paletteOptions.length) { %>
  <section class="ww-site-menu-language-row" aria-labelledby="display-menu-palette-label">
    <span class="ww-site-menu-label" id="display-menu-palette-label">Farbe</span>
    <div class="ww-display-menu-palette-control">
      <details class="ww-palette-picker ww-language-picker ww-site-menu-language" id="display-palette-picker" data-ww-menu-picker>
        <summary
          class="ww-palette-trigger ww-language-trigger"
          id="display-palette-trigger"
          aria-label="<%= t('Farbwelt') %>: <%= t(paletteOptions[0].label) %>"
        >
          <span class="ww-palette-swatches" id="display-palette-swatches" aria-hidden="true">
            <% for (const color of paletteOptions[0].colors) { %><i style="background:<%= color %>"></i><% } %>
          </span>
          <span class="ww-palette-current" id="display-palette-current" data-i18n-source="<%= paletteOptions[0].label %>"><%= t(paletteOptions[0].label) %></span>
          <span class="ww-language-chevron" aria-hidden="true"></span>
        </summary>
        <div class="ww-palette-menu ww-language-menu" data-ww-menu-popup data-popup-width="224" role="radiogroup" aria-labelledby="display-menu-palette-label">
        <% for (const palette of paletteOptions) { %>
          <button
            class="ww-palette-option ww-language-option<%= palette.key === paletteOptions[0].key ? ' is-selected' : '' %>"
            type="button"
            role="radio"
            aria-checked="<%= palette.key === paletteOptions[0].key ? 'true' : 'false' %>"
            data-palette-key="<%= palette.key %>"
          >
            <span class="ww-palette-swatches" aria-hidden="true">
              <% for (const color of palette.colors) { %><i style="background:<%= color %>"></i><% } %>
            </span>
            <span class="ww-palette-option-name" data-i18n-source="<%= palette.label %>"><%= t(palette.label) %></span>
            <span class="ww-language-check" aria-hidden="true">✓</span>
          </button>
        <% } %>
        </div>
      </details>
    </div>
  </section>
  <% } %>
  <div class="ww-display-menu-actions">
    <button class="ww-header-menu-item ww-display-menu-action" type="button" data-cloud-tour-start aria-haspopup="dialog" aria-controls="cloud-tour-tip">So geht’s</button>
    <button class="ww-header-menu-item ww-display-menu-action" id="display-own-words-button" type="button" aria-haspopup="dialog" aria-controls="display-own-words-dialog" hidden>
      <span>Deine Wörter</span>
      <span class="ww-display-menu-count" id="display-own-words-count" aria-live="polite">0</span>
    </button>
    <div class="ww-display-organizer-tools">
    <button class="ww-header-menu-item ww-display-menu-action" id="draft-settings-button" type="button" hidden>
      <span class="ww-display-menu-action-label">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        <span data-i18n-source="Organisatorbereich"><%= t('Organisatorbereich') %></span>
      </span>
    </button>
    <button class="ww-header-menu-item ww-display-menu-action" id="presentation-mode-button" type="button" role="switch" aria-checked="false">
      <span>Präsentationsmodus</span>
      <span class="ww-display-menu-switch" aria-hidden="true"><i></i></span>
    </button>
    </div>
  </div>
</section>
