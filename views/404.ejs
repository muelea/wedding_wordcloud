<%
  const statusKind = pageData.statusKind || 'not-found';
  const statusCopy = statusKind === 'maintenance'
    ? {
        title: 'Wartungsarbeiten – Wolkenworte',
        eyebrow: 'Wartungsarbeiten',
        heading: 'Wir sind gleich wieder da.',
        detail: 'Wolkenworte ist wegen Wartungsarbeiten vorübergehend nicht verfügbar.',
      }
    : statusKind === 'error'
      ? {
          title: 'Fehler – Wolkenworte',
          eyebrow: 'Fehler',
          heading: 'Da ist etwas schiefgegangen.',
          detail: 'Bitte ladet die Seite neu oder kehrt zur Startseite zurück.',
        }
      : {
          title: 'Nicht gefunden – Wolkenworte',
          eyebrow: 'Nicht gefunden',
          heading: 'Diese Wortwolke gibt es nicht.',
          detail: 'Prüft den Link oder kehrt zur Startseite zurück.',
        };
%>
<!DOCTYPE html>
<html lang="<%= locale %>" data-locale-source="<%= localeSource %>" data-locale-catalog-url="<%= localeCatalogUrl %>" data-locale-catalog-urls="<%= JSON.stringify(localeCatalogUrls) %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#fffdfa" />
  <link rel="icon" type="image/svg+xml" href="<%= asset('/z_icons/icon.svg') %>" />
  <%- include('partials/font-preloads') %>
  <link rel="stylesheet" href="<%= asset('/i18n.css') %>" />
  <link rel="stylesheet" href="<%= asset('/site-fonts.css') %>" />
  <script src="<%= asset('/js/i18n.js') %>"></script>
  <title data-i18n-source="<%= statusCopy.title %>"><%= t(statusCopy.title) %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    :root { --paper: #fffdfa; --ink: #400f26; --muted: #8a7178; --berry: #9c1c4c; --line: rgba(64,15,38,.1); }
    html { min-height: 100%; background: var(--paper); }
    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      grid-template-rows: auto 1fr;
      background: var(--paper);
      color: var(--ink);
      font-family: 'Jost', 'Wolkenworte Jost Fallback', system-ui, -apple-system, sans-serif;
    }
    .topbar { border-bottom: 1px solid var(--line); background: rgba(255,253,250,.88); }
    .topbar-inner {
      width: min(1120px, calc(100% - 48px)); height: 84px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
    }
    .brand {
      display: inline-flex; align-items: center; gap: 9px; color: var(--ink); text-decoration: none;
      font-family: 'Playfair Display', 'Wolkenworte Playfair Fallback', Georgia, 'Times New Roman', serif; font-size: 1.4rem; font-weight: 600;
    }
    .brand-icon { width: 32px; height: 30px; object-fit: contain; }
    main { display: grid; place-items: center; padding: 48px max(24px, var(--ww-safe-right)) max(80px, calc(64px + var(--ww-safe-bottom))) max(24px, var(--ww-safe-left)); }
    .box { text-align: center; max-width: 470px; }
    .eyebrow { margin: 0 0 12px; color: var(--berry); font-size: 11px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
    h1 { margin: 0; overflow-wrap: anywhere; font-family: 'Playfair Display', 'Wolkenworte Playfair Fallback', Georgia, 'Times New Roman', serif; font-size: clamp(34px, 7vw, 52px); font-weight: 500; line-height: 1.08; }
    p { margin: 18px auto 0; color: var(--muted); font-size: 15px; line-height: 1.7; }
    .button {
      display: inline-flex; min-height: 44px; margin-top: 28px; padding: 13px 23px; align-items: center; border-radius: 999px;
      background: var(--ink); color: #fff; text-decoration: none; font-size: 14px; font-weight: 600;
      transition: transform .2s, box-shadow .2s;
    }
    .button:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(64,15,38,.14); }
    @media (max-width: 620px) {
      .topbar-inner { width: min(100% - 32px, 560px); height: 72px; }
      .brand { font-size: 1.18rem; }
      .brand-icon { width: 28px; height: 26px; }
    }
  </style>
  <link rel="stylesheet" href="<%= asset('/site-header.css') %>" />
  <link rel="stylesheet" href="<%= asset('/mobile-foundation.css') %>" />
  <script src="<%= asset('/js/site-header.js') %>" defer></script>
  <script src="<%= asset('/js/mobile-ui.js') %>" defer></script>
</head>
<body>
  <%- include('partials/site-header') %>
  <main>
    <div class="box">
    <p class="eyebrow" data-i18n-source="<%= statusCopy.eyebrow %>"><%= t(statusCopy.eyebrow) %></p>
    <h1 data-i18n-source="<%= statusCopy.heading %>"><%= t(statusCopy.heading) %></h1>
    <p data-i18n-source="<%= statusCopy.detail %>"><%= t(statusCopy.detail) %></p>
    <a class="button" href="/">Zurück zur Startseite</a>
    </div>
  </main>
</body>
</html>
