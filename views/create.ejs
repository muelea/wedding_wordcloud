<!DOCTYPE html>
<html lang="<%= locale %>" data-theme="pastel">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/z_icons/icon.svg?v=20260829-1" />
  <link rel="stylesheet" href="/i18n.css?v=20260829-2" />
  <link rel="stylesheet" href="/site-fonts.css?v=20260829-1" />
  <link rel="stylesheet" href="/action-state.css?v=20260829-1" />
  <script src="/js/i18n.js?v=20260829-3"></script>
  <script src="/js/action-state.js?v=20260829-1"></script>
  <title data-i18n-source="Wortwolke erstellen – Wolkenworte"><%= t('Wortwolke erstellen – Wolkenworte') %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:       #fffdfa;
      --primary:  #400f26;
      --primary2: #9c1c4c;
      --accent:   #9c1c4c;
      --text:     #400f26;
      --muted:    #8a7178;
      --border:   rgba(64,15,38,0.14);
      --shadow:   rgba(64,15,38,0.07);
      --ph:       #b99aa3;
      --header-bd:   rgba(64,15,38,0.1);
      --orn:      rgba(193,146,47,0.55);
      --ok:       #4a9478;
      --err:      #c1594a;
    }

    html, body {
      min-height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: 'Jost', system-ui, -apple-system, sans-serif;
      font-weight: 400;
    }

    body {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 0 0 60px;
    }

    .topbar {
      width: 100%;
      border-bottom: 1px solid var(--header-bd);
      background: rgba(255,253,250,.88);
      backdrop-filter: blur(14px) saturate(1.4);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
    }

    .topbar-inner {
      width: min(1120px, calc(100% - 48px));
      height: 84px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--text);
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.4rem;
      font-weight: 600;
      text-decoration: none;
    }

    .brand-icon { width: 32px; height: 30px; object-fit: contain; }

    .back-link {
      color: var(--muted);
      font-size: .86rem;
      text-decoration: none;
      transition: color .2s;
    }
    .back-link:hover { color: var(--primary2); }

    .page-intro {
      width: 100%;
      text-align: center;
      padding: 54px 24px 22px;
    }

    .page-intro .eyebrow {
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 10px;
    }

    .page-intro h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(28px, 6vw, 40px);
      font-weight: 500;
      font-style: italic;
      color: var(--primary2);
    }

    .page-intro .subtitle {
      margin-top: 10px;
      font-size: 14px;
      color: var(--muted);
      max-width: 440px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.5;
    }

    .card {
      width: 100%;
      max-width: 480px;
      padding: 28px 24px 0;
    }

    form { display: flex; flex-direction: column; gap: 22px; }

    label {
      display: block;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 8px;
    }

    .field-hint {
      font-size: 12px;
      color: var(--muted);
      margin-top: 6px;
    }

    input[type="text"], input[type="date"], input[type="password"], input[type="tel"] {
      width: 100%;
      border: 1.5px solid var(--border);
      border-radius: 12px;
      background: #fffefc;
      font-family: 'Jost', system-ui, sans-serif;
      font-size: 17px;
      color: var(--text);
      padding: 14px 16px;
      outline: none;
      box-shadow: 0 10px 28px var(--shadow);
      transition: border-color 0.2s, box-shadow .2s;
    }
    input:focus { border-color: rgba(156,28,76,.55); box-shadow: 0 0 0 3px rgba(156,28,76,.06); }
    input::placeholder { color: var(--ph); font-style: italic; }
    #pin, #pin-confirm { -webkit-text-security: disc; text-security: disc; letter-spacing: 4px; }

    .slug-row {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Jost', system-ui, sans-serif;
      font-size: 15px;
      color: var(--muted);
      flex-wrap: wrap;
    }
    .slug-row .slug-prefix { opacity: 0.7; }
    .slug-row input { flex: 1; min-width: 160px; font-size: 16px; padding: 12px 14px; }

    .slug-status {
      font-size: 12px;
      margin-top: 8px;
      min-height: 16px;
    }
    .slug-status.ok  { color: var(--ok); }
    .slug-status.err { color: var(--err); }

    .pin-row { display: flex; gap: 12px; }
    .pin-row > div { flex: 1; }

    button[type="submit"] {
      margin-top: 6px;
      padding: 16px;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 999px;
      font-family: 'Jost', system-ui, sans-serif;
      font-weight: 500;
      letter-spacing: 0.015em;
      font-size: 17px;
      cursor: pointer;
      box-shadow: 0 8px 22px var(--shadow);
      transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.15s;
    }
    button[type="submit"]:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 10px 26px var(--shadow); }
    button[type="submit"]:active { transform: scale(0.98); }
    button[type="submit"]:disabled { opacity: 0.5; cursor: default; }

    .privacy-note {
      margin: -10px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.55;
      text-align: center;
    }
    .privacy-note a { color: var(--primary2); text-underline-offset: 2px; }

    .error-banner {
      background: rgba(193,89,74,0.10);
      border: 1px solid rgba(193,89,74,0.30);
      color: var(--err);
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 13px;
      display: none;
    }
    .error-banner.show { display: block; }

    .ornament {
      text-align: center;
      color: var(--orn);
      font-size: 18px;
      margin: 36px 0 0;
      letter-spacing: 8px;
    }

    @media (max-width: 620px) {
      .topbar-inner { width: min(100% - 32px, 560px); height: 72px; }
      .brand { font-size: 1.18rem; }
      .brand-icon { width: 28px; height: 26px; }
      .back-link { font-size: .8rem; }
      .page-intro { padding: 40px 20px 18px; }
      .card { padding-top: 24px; }
    }
  </style>
  <link rel="stylesheet" href="/site-header.css?v=20260829-2" />
  <script src="/js/site-header.js" defer></script>
</head>
<body>

<%- include('partials/site-header') %>

<section class="page-intro" aria-labelledby="page-title">
  <p class="eyebrow">Kostenlos starten</p>
  <h1 id="page-title">Eure Wortwolke</h1>
  <p class="subtitle">Gäste teilen live ein Wort für euch – auf dem Bildschirm wächst daraus eure Hochzeits-Wortwolke. Kostenlos, in 30 Sekunden eingerichtet.</p>
</section>

<main class="card">
  <div class="error-banner" id="error-banner"></div>

  <form id="create-form" autocomplete="off">
    <div>
      <label for="couple-name">Vornamen des Brautpaars</label>
      <input id="couple-name" type="text" placeholder="Lea &amp; Julian" maxlength="80" required />
    </div>

    <div>
      <label for="slug">Eure Adresse</label>
      <div class="slug-row">
        <span class="slug-prefix" id="slug-origin">…/e/</span>
        <input id="slug" type="text" placeholder="lea-und-julian" maxlength="80" required />
      </div>
      <div class="slug-status" id="slug-status"></div>
      <p class="field-hint">Wir ergänzen automatisch einen kurzen Code, damit eure Wortwolke eine eindeutige, schwer erratbare Adresse erhält.</p>
    </div>

    <div class="pin-row">
      <div>
        <label for="pin">Admin-PIN (4-6 Ziffern)</label>
        <input id="pin" type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="••••" autocomplete="off" required />
        <p class="field-hint">Schützt „Neue Runde" auf dem Anzeige-Bildschirm.</p>
      </div>
      <div>
        <label for="pin-confirm">PIN bestätigen</label>
        <input id="pin-confirm" type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="••••" autocomplete="off" required />
      </div>
    </div>

    <button type="submit" id="submit-btn">Wortwolke starten</button>
    <p class="privacy-note">Wie wir eure Angaben verarbeiten, erfahrt ihr im <a href="/datenschutz">Datenschutz</a>.</p>
  </form>

  <p class="ornament">· · ·</p>
</main>

<script>
  // Starting is intentionally frictionless: create an owner-bound draft, then
  // let the couple add its first word before deciding on names and a PIN.
  (async () => {
    try {
      const response = await fetch('/api/events/draft', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ locale: WolkenworteI18n.getLocale() }),
      });
      const draft = await response.json();
      if (response.ok) location.replace(`${draft.guestUrl}/display`);
    } catch {}
  })();
  const setText = (element, source, params) => WolkenworteI18n.setText(element, source, params);
  const coupleNameInput = document.getElementById('couple-name');
  const slugInput        = document.getElementById('slug');
  const slugStatus       = document.getElementById('slug-status');
  const slugOrigin       = document.getElementById('slug-origin');
  const form              = document.getElementById('create-form');
  const submitBtn         = document.getElementById('submit-btn');
  const errorBanner       = document.getElementById('error-banner');
  const creationErrorMessages = Object.freeze({
    invalid_locale: 'Bitte wählt eine unterstützte Sprache.',
    invalid_couple_name: 'Bitte gebt die Vornamen des Brautpaars ein.',
    couple_name_too_long: 'Die Vornamen dürfen höchstens 80 Zeichen lang sein.',
    invalid_pin: 'Der PIN muss aus 4-6 Ziffern bestehen.',
    invalid_slug: 'Bitte andere Zeichen für die Adresse verwenden.',
    slug_generation_failed: 'Die Adresse konnte nicht erstellt werden. Bitte versucht es erneut.',
  });

  slugOrigin.textContent = `${location.origin}/e/`;

  let slugTouchedByUser = false;
  let slugCheckTimer = null;

  slugInput.addEventListener('input', () => { slugTouchedByUser = true; scheduleSlugCheck(); });

  coupleNameInput.addEventListener('input', () => {
    if (slugTouchedByUser) return;
    slugInput.value = slugify(coupleNameInput.value);
    scheduleSlugCheck();
  });

  // Client-side mirror of src/slug.js's slugify() — good enough for live
  // preview; the server re-derives and re-validates the authoritative slug
  // on submit regardless, so a mismatch here is just a UX nit, not a bug.
  function slugify(input) {
    const umlauts = { 'ä':'ae','ö':'oe','ü':'ue','ß':'ss','Ä':'Ae','Ö':'Oe','Ü':'Ue' };
    let s = String(input || '').replace(/[äöüßÄÖÜ]/g, (c) => umlauts[c] || c);
    s = s.replace(/&/g, ' und ');
    s = s.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    s = s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').replace(/-{2,}/g, '-');
    return s;
  }

  // This only previews the name-derived *prefix* — the final slug always
  // gets a random unique code appended at creation time (see the field-hint
  // in the HTML above), so there's nothing meaningful to check "available"
  // here anymore. We still round-trip through the server so the preview
  // matches the server's own slugify() exactly (umlaut edge cases etc.)
  // rather than trusting the client-side mirror above.
  function scheduleSlugCheck() {
    clearTimeout(slugCheckTimer);
    const slug = slugInput.value.trim();
    if (!slug) { slugStatus.textContent = ''; return; }
    slugStatus.textContent = '';
    slugStatus.className = 'slug-status';
    slugCheckTimer = setTimeout(async () => {
      try {
        const res = await fetch(`/api/slug-availability?slug=${encodeURIComponent(slug)}`);
        const data = await res.json();
        if (data.valid) {
          const explanation = document.createElement('span');
          setText(explanation, 'der Code wird beim Erstellen ergänzt');
          slugStatus.replaceChildren(
            document.createTextNode(`…/e/${data.slug}-••••• (`),
            explanation,
            document.createTextNode(')')
          );
          slugStatus.className = 'slug-status ok';
        } else {
          setText(slugStatus, 'Bitte andere Zeichen für die Adresse verwenden.');
          slugStatus.className = 'slug-status err';
        }
      } catch {
        slugStatus.textContent = '';
      }
    }, 350);
  }

  function showError(msg) {
    setText(errorBanner, msg);
    errorBanner.classList.add('show');
  }
  function clearError() {
    errorBanner.classList.remove('show');
    WolkenworteI18n.clearText(errorBanner);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();

    const coupleName = coupleNameInput.value.trim();
    const slug = slugInput.value.trim();
    const pin = document.getElementById('pin').value.trim();
    const pinConfirm = document.getElementById('pin-confirm').value.trim();

    if (!coupleName) return showError('Bitte gebt die Vornamen des Brautpaars ein.');
    if (!slug) return showError('Bitte wählt eine Adresse.');
    if (!/^\d{4,6}$/.test(pin)) return showError('Der PIN muss aus 4-6 Ziffern bestehen.');
    if (pin !== pinConfirm) return showError('Die beiden PINs stimmen nicht überein.');

    WolkenworteActions.setBusy(submitBtn, true);

    try {
      const res = await fetch('/api/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ coupleName, slug, pin, locale: WolkenworteI18n.getLocale() }),
      });
      const data = await res.json();
      if (!res.ok) {
        // Note: a duplicate-slug conflict no longer happens here — every
        // event gets a random unique code appended server-side, so the
        // remaining failure modes are validation errors or (extremely
        // rare) a server-side generation failure, both surfaced as-is.
        showError(creationErrorMessages[data.error] || 'Etwas ist schiefgelaufen.');
        WolkenworteActions.setBusy(submitBtn, false);
        return;
      }
      try {
        sessionStorage.setItem(`creation-notice:${data.slug}`, '1');
      } catch {
        // Storage can be unavailable in strict privacy modes. The event is
        // still valid, so continue to its guest page without the setup notice.
      }
      location.assign(data.guestUrl);
    } catch {
      showError('Verbindung fehlgeschlagen. Bitte erneut versuchen.');
      WolkenworteActions.setBusy(submitBtn, false);
    }
  });
</script>
</body>
</html>
