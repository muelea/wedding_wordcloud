  <script>
    'use strict';

    const slug = location.pathname.split('/').filter(Boolean)[1];
    const paletteStorageKey = `wordcloud-palette:${slug}`;
    const configuratorEmojiPickerMedia = window.matchMedia('(min-width: 621px) and (hover: hover) and (pointer: fine)');
    const EMOJI_SEARCH_INDEX_URLS = Object.freeze({
      de: <%- JSON.stringify(asset('/emoji-search/48.2/de.json')) %>,
      en: <%- JSON.stringify(asset('/emoji-search/48.2/en.json')) %>,
      es: <%- JSON.stringify(asset('/emoji-search/48.2/es.json')) %>,
      fr: <%- JSON.stringify(asset('/emoji-search/48.2/fr.json')) %>,
      it: <%- JSON.stringify(asset('/emoji-search/48.2/it.json')) %>,
      tr: <%- JSON.stringify(asset('/emoji-search/48.2/tr.json')) %>,
    });
    const EMOJI_CATALOG_URL = <%- JSON.stringify(asset('/emoji-search/48.2/catalog.json')) %>;
    const guestId = getOrCreateGuestId();
    const t = (source, params) => WolkenworteI18n.t(source, params);
    const TEXT_BASELINE_OFFSET = Number.isFinite(WordCloudCore.TEXT_BASELINE_OFFSET)
      ? WordCloudCore.TEXT_BASELINE_OFFSET
      : 0.34;
    const setText = (element, source, params) => WolkenworteI18n.setText(element, source, params);
    const clearText = (element) => WolkenworteI18n.clearText(element);
    const setTranslatedAttribute = (element, name, source, params) =>
      WolkenworteI18n.setAttribute(element, name, source, params);

    function getOrCreateGuestId() {
      const storageKey = `guest-session:${slug}`;
      try {
        const existing = sessionStorage.getItem(storageKey);
        if (/^[a-f0-9]{32}$/.test(existing || '')) return existing;
      } catch {}
      const bytes = new Uint8Array(16);
      if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
        window.crypto.getRandomValues(bytes);
      } else {
        for (let index = 0; index < bytes.length; index += 1) {
          bytes[index] = Math.floor(Math.random() * 256);
        }
      }
      const created = [...bytes].map((byte) => byte.toString(16).padStart(2, '0')).join('');
      try { sessionStorage.setItem(storageKey, created); } catch {}
      return created;
    }
    const loading = document.getElementById('loading');
    const content = document.getElementById('config-content');
    const errorText = document.getElementById('error-text');
    const mugViewer = document.getElementById('mug-3d');
    const mugPreviewState = document.getElementById('mug-preview-state');
    const mugPreviewMessage = document.getElementById('mug-preview-message');
    const retryMugPreview = document.getElementById('retry-mug-preview');
    const retryConfigurator = document.getElementById('retry-configurator');
    const productStage = document.getElementById('product-stage');
    const workbench = document.querySelector('.workbench');
    const editorScroll = document.getElementById('editor-scroll');
    const flatPreview = document.getElementById('flat-product-preview');
    const flatCanvas = document.getElementById('flat-preview');
    const flatMockup = document.getElementById('flat-product-mockup');
    const wrapCanvas = document.getElementById('wrap-canvas');
    const selectedProductThumb = document.getElementById('selected-product-thumb');
    const selectedProductName = document.getElementById('selected-product-name');
    const selectedProductDetail = document.getElementById('selected-product-detail');
    const designToolbarControls = document.querySelector('.design-toolbar-controls');
    const selectedOrientationName = document.getElementById('selected-orientation-name');
    const selectedOrientationDetail = document.getElementById('selected-orientation-detail');
    const selectedThemeName = document.getElementById('selected-theme-name');
    const selectedThemeSwatches = document.getElementById('selected-theme-swatches');
    const changeProductButton = document.getElementById('change-product');
    const orientationStep = document.getElementById('orientation-step');
    const themeStep = document.getElementById('theme-step');
    const productDialog = document.getElementById('product-dialog');
    const productDialogClose = document.getElementById('product-dialog-close');
    const productDialogDone = document.getElementById('product-dialog-done');
    const themeOptions = document.getElementById('theme-options');
    const orientationOptions = document.getElementById('orientation-options');
    const productOptions = document.getElementById('product-options');
    const variantPanel = document.getElementById('variant-panel');
    const variantOptions = document.getElementById('variant-options');
    const surfaceEditor = document.getElementById('surface-editor');
    const surfaceTabs = document.getElementById('surface-tabs');
    const surfaceCopy = document.getElementById('surface-copy');
    const customPalettePanel = document.getElementById('custom-palette-panel');
    const customColorList = document.getElementById('custom-color-list');
    const customColorAdd = document.getElementById('custom-color-add');
    const orderBox = document.getElementById('order-box');
    const orderList = document.getElementById('order-list');
    const orderCount = document.getElementById('order-count');
    const checkoutPanel = document.getElementById('checkout-panel');
    const designAnotherButton = document.getElementById('design-another');
    const continueOrderButton = document.getElementById('continue-order');
    const saveDesignButton = document.getElementById('save-design');
    const leaveDialog = document.getElementById('leave-design-dialog');
    const leaveTitle = document.getElementById('leave-design-title');
    const leaveDescription = document.getElementById('leave-design-description');
    const leaveSaveButton = document.getElementById('leave-design-save');
    const leaveDiscardButton = document.getElementById('leave-design-discard');
    const leaveCancelButton = document.getElementById('leave-design-cancel');
    const cart = WolkenworteConfiguratorSession.createCart(slug);
    const workspace = new WolkenworteWorkspace(document, {
      commitText: () => mugEditor?.commitTextInput(),
      setFontPickerInline: inline => mugEditor?.setFontPickerInline(inline),
    });
    const toolbar = new WolkenworteToolbar(document);

    let words = [];
    let liveWords = [];
    let products = [];
    let productFamilies = [];
    let product = null;
    let selectedFamilyKey = null;
    let pendingProductKey = null;
    let pendingFamilyKey = null;
    let productDialogCloseReason = 'cancel';
    // Resolved from the shared catalog (or a saved choice) when the product loads.
    let selectedTheme = null;
    let selectedOrientation = 'default';
    let customColors = [];
    let renderFrame = null;
    let mug3D = null;
    let mug3DLoadPromise = null;
    let mug3DGeneration = 0;
    let previewState = 'loading';
    let restorationFailed = false;
    let mugEditor = null;
    let configuratorEmojiPicker = null;
    let activeSurface = 'default';
    let surfaceStates = new Map();
    let editingOrderItemId = null;
    let suppressDirty = false;
    let orderActionPending = false;
    let currentDesignNeedsSave = true;
    let currentDesignEdited = false;
    let workspaceReady = false;
    let designRevision = 0;
    let pendingConfiguration = null;
    let leavingPage = false;
    let allowNavigation = false;
    let startingAnotherProduct = false;

    const brandLink = document.getElementById('brand-link');
    const backLink = document.getElementById('back-link');
    backLink.href = `/e/${encodeURIComponent(slug)}`;

    function loadOrderItems() {
      try { return cart.read(); }
      catch {
        setText(errorText, 'Der Warenkorb konnte in diesem Browser nicht geladen werden. Bitte erlaubt das Speichern von Websitedaten.');
        return [];
      }
    }

    function updateCartActions() {
      saveDesignButton.disabled = orderActionPending || !workspaceReady || restorationFailed || !currentDesignNeedsSave;
      setText(saveDesignButton, editingOrderItemId ? 'Änderungen übernehmen' : 'In den Warenkorb');
      continueOrderButton.disabled = orderActionPending || !workspaceReady || restorationFailed;
      designAnotherButton.disabled = orderActionPending || !workspaceReady || restorationFailed;
    }

    function hasUnsavedDesign() {
      return workspaceReady && !restorationFailed &&
        (currentDesignNeedsSave || Boolean(mugEditor?.hasPendingTextChange()));
    }

    function askBeforeLeaving({ shipping = false } = {}) {
      const emptyCart = shipping && !loadOrderItems().length;
      setText(leaveDescription, emptyCart
        ? 'Euer Warenkorb ist noch leer. Möchtet ihr mit dem aktuellen Design fortfahren? Wir übernehmen es in den Warenkorb und öffnen die Lieferadresse.'
        : 'Möchtet ihr das aktuelle Design in den Warenkorb übernehmen? Ohne Übernahme gehen eure ungesicherten Änderungen verloren.');
      setText(leaveSaveButton, editingOrderItemId
        ? 'Änderungen übernehmen und weiter' : 'In den Warenkorb und weiter');
      leaveDiscardButton.hidden = emptyCart;
      leaveDialog.returnValue = 'cancel';
      return new Promise((resolve) => {
        leaveDialog.addEventListener('close', () => resolve(leaveDialog.returnValue), { once: true });
        leaveDialog.showModal();
        leaveTitle.focus({ preventScroll: true });
      });
    }

    leaveSaveButton.addEventListener('click', () => leaveDialog.close('save'));
    leaveDiscardButton.addEventListener('click', () => leaveDialog.close('discard'));
    leaveCancelButton.addEventListener('click', () => leaveDialog.close('cancel'));

    // All app navigation goes through one decision, never an implicit save.
    async function confirmLeaving(options = {}) {
      if (options.onlyIfEdited) {
        try { await finalizeCurrentText(); }
        catch {
          setText(errorText, 'Das Design konnte nicht gespeichert werden. Bitte versucht es erneut.');
          return false;
        }
        if (!currentDesignEdited) return true;
      }
      if (!hasUnsavedDesign() && !(options.shipping && !loadOrderItems().length)) return true;
      const choice = await askBeforeLeaving(options);
      if (choice === 'cancel') return false;
      if (choice === 'save') return saveCurrentDesign(saveDesignButton);
      return choice === 'discard';
    }

    async function runNavigation(action, options = {}) {
      if (leavingPage || orderActionPending) return;
      leavingPage = true;
      try {
        if (await confirmLeaving(options)) await action();
      } finally { leavingPage = false; }
    }

    async function finalizeCurrentText() {
      mugEditor.flushPendingChange();
      const before = JSON.stringify(mugEditor.getDesign());
      const wasSuppressed = suppressDirty;
      suppressDirty = true;
      try {
        await WolkenworteConfiguratorSession.withTimeout(mugEditor.pendingFontChange);
        await WolkenworteConfiguratorSession.withTimeout(mugEditor.commitTextInput());
        mugEditor.flushPendingChange();
      } finally { suppressDirty = wasSuppressed; }
      if (before !== JSON.stringify(mugEditor.getDesign())) markDirty();
    }

    function productView(candidate = product, orientation = null, surfaceKey = activeSurface) {
      if (!candidate) return null;
      const options = Array.isArray(candidate.orientations) ? candidate.orientations : [];
      const key = orientation || (candidate === product ? selectedOrientation : null) ||
        candidate.defaultOrientation || candidate.orientation || options[0]?.key;
      const selected = options.find((option) => option.key === key) ||
        options.find((option) => option.key === candidate.defaultOrientation) || options[0];
      const view = selected ? { ...candidate, orientation: selected.key,
        size: selected.size, printFile: selected.printFile,
        designSafeAreas: selected.designSafeAreas, layoutGeometry: selected.layoutGeometry,
        previewMockup: selected.previewMockup } :
        { ...candidate, orientation: 'default' };
      const areas = view.designSafeAreas || {};
      const safeArea = areas[surfaceKey] || Object.values(areas)[0];
      return {
        ...view,
        safeArea,
        layoutGeometry: safeArea && Object.keys(areas).length > 1
          ? { ...view.layoutGeometry, 'fit-area': [{ ...safeArea, optimize: true }] }
          : view.layoutGeometry,
        previewMockup: view.previewMockup ? {
          ...view.previewMockup,
          canvas: view.previewMockup.canvases?.[surfaceKey] || view.previewMockup.canvas,
        } : null,
      };
    }

    function selectedOrientationOption(candidate = product, orientation = selectedOrientation) {
      const options = Array.isArray(candidate?.orientations) ? candidate.orientations : [];
      return options.find((option) => option.key === orientation) ||
        options.find((option) => option.key === candidate?.defaultOrientation) || options[0] || null;
    }

    function productSizeText(candidate, orientation = null) {
      const size = productView(candidate, orientation)?.size || {};
      const label = t(size.label || '');
      if (size.volumeMl) return `${label} · ${WolkenworteI18n.formatNumber(size.volumeMl)} ml`;
      if (size.detail) return `${label} · ${t(size.detail)}`;
      return label;
    }

    function orderItemFromConfiguration(configuration) {
      return {
        id: configuration.id,
        productKey: configuration.productKey,
        orientation: configuration.orientation || 'default',
        printFileUrl: configuration.printFileUrl,
        createdAt: configuration.createdAt || new Date().toISOString(),
      };
    }

    function addOrderItem(configuration, { replaceId = null } = {}) {
      return cart.replace(orderItemFromConfiguration(configuration), replaceId);
    }

    function setOrderActionsBusy(isBusy, activeButton = null) {
      for (const button of [designAnotherButton, continueOrderButton, saveDesignButton]) {
        WolkenworteActions.setBusy(button, isBusy && button === activeButton);
        button.disabled = isBusy;
      }
      checkoutPanel.setAttribute('aria-busy', String(isBusy));
      content.querySelectorAll('.design-toolbar, .workspace-tools, .workbench').forEach((section) => {
        section.inert = isBusy;
      });
      orderList.querySelectorAll('button').forEach((button) => {
        button.disabled = isBusy || button.getAttribute('aria-current') === 'true';
      });
      if (!isBusy) updateCartActions();
    }

    async function loadOrderItem(configurationId) {
      if (!WolkenworteConfiguratorSession.validId(configurationId)) throw new Error('invalid_design_link');
      orderActionPending = true;
      setOrderActionsBusy(true);
      clearText(errorText);
      try {
        const response = await fetch(
          `/api/events/${encodeURIComponent(slug)}/configurations/${encodeURIComponent(configurationId)}/edit`,
          { cache: 'no-store', signal: AbortSignal.timeout(10000) }
        );
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'load_failed');
        const adjusted = await applySavedConfiguration(data);
        editingOrderItemId = loadOrderItems().some((item) => item.id === data.id) ? data.id : null;
        currentDesignNeedsSave = !editingOrderItemId || Boolean(adjusted);
        currentDesignEdited = Boolean(adjusted);
        pendingConfiguration = null;
        renderOrderBox();
      } finally {
        orderActionPending = false;
        setOrderActionsBusy(false);
      }
    }

    function openOrderItem(configurationId) {
      return runNavigation(async () => {
        try {
          await loadOrderItem(configurationId);
          history.replaceState(null, '', `/e/${encodeURIComponent(slug)}/configure?edit=${encodeURIComponent(configurationId)}`);
        } catch (error) { showRestorationError(error); }
      });
    }

    function createOrderItemThumbnail(item, itemProduct) {
      const fallback = document.createElement('img');
      fallback.alt = '';
      const fallbackUrl = itemProduct?.thumbnail || product?.thumbnail || '';
      if (fallbackUrl) fallback.src = fallbackUrl;
      else fallback.hidden = true;

      if (!item.printFileUrl) return fallback;
      const preview = new Image();
      preview.alt = '';
      preview.decoding = 'async';

      let ready;
      if (typeof preview.decode === 'function') {
        preview.src = item.printFileUrl;
        ready = preview.decode();
      } else {
        ready = new Promise((resolve, reject) => {
          preview.onload = resolve;
          preview.onerror = reject;
          preview.src = item.printFileUrl;
        });
      }

      ready.then(() => {
        if (!fallback.isConnected) return;
        fallback.replaceWith(preview);
      }).catch(() => {
        // The stable product thumbnail remains visible if the custom preview
        // cannot be decoded. Never expose the browser's broken-image icon.
      });
      return fallback;
    }

    function renderOrderBox() {
      const items = loadOrderItems();
      const hasItems = items.length > 0;
      orderBox.hidden = !hasItems;
      orderList.replaceChildren();
      setText(orderCount, items.length === 1 ? '{{count}} Design' : '{{count}} Designs', {
        count: items.length,
      });
      items.forEach((item) => {
        const itemProduct = products.find((candidate) => candidate.key === item.productKey);
        const orientation = selectedOrientationOption(itemProduct, item.orientation);
        const productName = t(itemProduct?.displayName || 'Wolkenworte Design');
        const itemSize = itemProduct
          ? `${productSizeText(itemProduct, item.orientation)}${orientation ? ` · ${t(orientation.label)}` : ''}`
          : t('Wolkenworte Design');
        const isEditing = item.id === editingOrderItemId;
        const row = document.createElement('div');
        row.className = 'order-item';
        row.classList.toggle('is-editing', isEditing);
        const image = createOrderItemThumbnail(item, itemProduct);
        const copy = document.createElement('div');
        copy.className = 'order-copy';
        const title = document.createElement('strong');
        title.textContent = productName;
        const size = document.createElement('span');
        size.textContent = itemSize;
        copy.append(title, size);
        const actions = document.createElement('div');
        actions.className = 'order-item-actions';
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'order-edit';
        setText(edit, isEditing ? 'Geöffnet' : 'Öffnen');
        edit.disabled = isEditing;
        setTranslatedAttribute(edit, 'aria-label', isEditing
          ? '{{item}} ist zur Bearbeitung geöffnet'
          : '{{item}} öffnen und bearbeiten', { item: productName });
        if (isEditing) {
          edit.setAttribute('aria-current', 'true');
        } else {
          edit.addEventListener('click', () => openOrderItem(item.id));
        }
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'order-remove';
        setTranslatedAttribute(remove, 'aria-label', '{{item}} aus dem Warenkorb entfernen', { item: productName });
        remove.textContent = '×';
        remove.addEventListener('click', () => removeOrderItem(item.id));
        actions.append(edit, remove);
        row.append(image, copy, actions);
        orderList.appendChild(row);
      });
      updateCartActions();
    }

    function removeOrderItem(configurationId) {
      if (orderActionPending || leavingPage) return;
      try {
        cart.write(cart.read().filter((candidate) => candidate.id !== configurationId));
        if (editingOrderItemId === configurationId) {
          editingOrderItemId = null;
          currentDesignNeedsSave = true;
          pendingConfiguration = null;
          history.replaceState(null, '', `/e/${encodeURIComponent(slug)}/configure`);
        }
        renderOrderBox();
      } catch {
        setText(errorText, 'Der Warenkorb konnte nicht aktualisiert werden. Bitte versucht es erneut.');
      }
    }

    function navigateToShipping() {
      const ids = loadOrderItems().map((item) => item.id);
      if (!ids.length) {
        setText(errorText, 'Übernehmt bitte zuerst ein Design in den Warenkorb.');
        return;
      }
      const query = ids.length === 1
        ? `configuration=${encodeURIComponent(ids[0])}`
        : `configurations=${encodeURIComponent(ids.join(','))}`;
      allowNavigation = true;
      location.assign(`/e/${encodeURIComponent(slug)}/shipping?${query}&edit=${encodeURIComponent(editingOrderItemId || ids[0])}`);
    }

    function setupCanvas(canvas) {
      const rect = canvas.getBoundingClientRect();
      // Supersample at the displayed mockup size for crisp text, including
      // Retina screens. Match the editor's 1536px limit to bound redraw costs.
      const ratio = Math.min(
        2 * Math.max(window.devicePixelRatio || 1, 1),
        1536 / Math.max(rect.width, rect.height, 1)
      );
      const width = Math.max(1, Math.round(rect.width * ratio));
      const height = Math.max(1, Math.round(rect.height * ratio));
      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width;
        canvas.height = height;
      }
      return canvas.getContext('2d');
    }

    function getPalette(themeKey) {
      const palette = product.themes.find((option) => option.key === themeKey) || product.themes[0];
      return palette.key === 'custom' && customColors.length
        ? { ...palette, colors: customColors }
        : palette;
    }

    function selectedThemeOption() {
      return product?.themes.find((option) => option.key === selectedTheme) || product?.themes[0] || null;
    }

    function updateToolbarSummaries() {
      const orientation = selectedOrientationOption();
      if (orientation) {
        setText(selectedOrientationName, orientation.label);
        setText(selectedOrientationDetail, orientation.description);
      }
      const palette = selectedThemeOption();
      if (palette) {
        setText(selectedThemeName, palette.label);
        renderPaletteStrip(selectedThemeSwatches, getPalette(palette.key).colors);
      }
    }

    function closeToolbarMenus() { workspace.closeChooser(); }

    function colorWithAlpha(hex, alpha) {
      const value = hex.replace('#', '');
      const red = Number.parseInt(value.slice(0, 2), 16);
      const green = Number.parseInt(value.slice(2, 4), 16);
      const blue = Number.parseInt(value.slice(4, 6), 16);
      return `rgba(${red}, ${green}, ${blue}, ${alpha})`;
    }

    function renderPaletteStrip(swatches, colors) {
      swatches.replaceChildren();
      swatches.style.setProperty('--swatch-count', String(colors.length));
      for (const color of colors) {
        const swatch = document.createElement('i');
        swatch.style.backgroundColor = color;
        swatches.appendChild(swatch);
      }
    }

    function updateCustomThemeCard() {
      const card = themeOptions.querySelector('[data-theme-card="custom"]');
      if (!card || !customColors.length) return;
      card.style.setProperty('--theme-accent', customColors[0]);
      card.style.setProperty('--theme-soft', colorWithAlpha(customColors[1] || customColors[0], .12));
      card.style.setProperty('--theme-shadow', colorWithAlpha(customColors[0], .16));
      renderPaletteStrip(card.querySelector('.swatches'), customColors);
    }

    function applyCustomPalette() {
      updateCustomThemeCard();
      updateToolbarSummaries();
      markDirty();
      if (mugEditor) applyPaletteAcrossSurfaces(customColors);
      renderAll();
    }

    function renderCustomColorControls() {
      customPalettePanel.hidden = selectedTheme !== 'custom';
      customColorList.replaceChildren();
      customColors.forEach((color, index) => {
        const item = document.createElement('div');
        item.className = 'custom-color-item';

        const input = document.createElement('input');
        input.type = 'color';
        input.className = 'custom-color-input';
        input.value = color;
        setTranslatedAttribute(input, 'aria-label', 'Farbe {{count}} wählen', { count: index + 1 });

        const value = document.createElement('span');
        value.className = 'custom-color-value';
        value.textContent = color;

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'custom-color-remove';
        remove.textContent = '×';
        remove.disabled = customColors.length === 1;
        setTranslatedAttribute(remove, 'aria-label', 'Farbe {{count}} entfernen', { count: index + 1 });

        input.addEventListener('input', () => {
          customColors[index] = input.value.toLowerCase();
          value.textContent = customColors[index];
          applyCustomPalette();
        });
        remove.addEventListener('click', () => {
          if (customColors.length === 1) return;
          customColors.splice(index, 1);
          renderCustomColorControls();
          applyCustomPalette();
        });

        item.append(input, value, remove);
        customColorList.appendChild(item);
      });
      updateToolbarSummaries();
    }

    customColorAdd.addEventListener('click', () => {
      const suggestions = ['#e6007e', '#ff6b00', '#f2b705', '#00a896', '#246bfd', '#7b2cbf', '#d7263d'];
      customColors.push(suggestions[customColors.length % suggestions.length]);
      renderCustomColorControls();
      applyCustomPalette();
    });

    // Keep drawing if an already-open tab still holds a pre-palette runtime.
    // New page loads use content-addressed asset URLs, while this compatibility
    // path protects a tab that was open across a deployment.
    function makePaletteAssigner(colors) {
      if (typeof WordCloudCore.makePaletteAssigner === 'function') {
        return WordCloudCore.makePaletteAssigner(colors);
      }
      const palette = Array.isArray(colors) && colors.length
        ? colors
        : product.themes[0].colors;
      const assigned = new Map();
      return (word) => {
        if (!assigned.has(word)) {
          assigned.set(word, palette[assigned.size % palette.length]);
        }
        return assigned.get(word);
      };
    }

    async function ensureDesignFonts(fontKeys) {
      const keys = [...new Set(fontKeys.map((key) => DesignFonts.normalizeKey(key)))];
      await Promise.all(keys.map(key => DesignFonts.loadFont(key, document.fonts)));
    }

    function drawCloud(ctx, x, y, width, height = width, showOnlyFullyVisible = false) {
      const colors = makePaletteAssigner(getPalette(selectedTheme).colors);
      const placed = WordCloudCore.layoutWords(words, height, ctx, colors);
      const xScale = width / height;
      for (const item of placed) {
        const itemX = x + item.x * xScale;
        const itemY = y + item.y;
        if (showOnlyFullyVisible) {
          const left = x + item.x1 * xScale;
          const right = x + item.x2 * xScale;
          const top = y + item.y1;
          const bottom = y + item.y2;
          if (left < 0 || right > ctx.canvas.width || top < 0 || bottom > ctx.canvas.height) continue;
        }
        WordCloudCore.drawPlacedWord(ctx, { ...item, x: itemX, y: itemY }, {
          emojiImage: (run) => WolkenworteEmoji.getLoadedImage(run),
        });
      }
    }

    function buildAutomaticDesign(surfaceKey = activeSurface) {
      const view = productView(product, null, surfaceKey);
      const measurementCanvas = document.createElement('canvas');
      const measurementContext = measurementCanvas.getContext('2d');
      const design = [];
      const slots = view.layoutGeometry['fit-area'];
      slots.forEach((slot, slotIndex) => {
        const slotHeight = slot.height || slot.side;
        const slotWidth = slot.width || slot.side;
        const colors = makePaletteAssigner(getPalette(selectedTheme).colors);
        const placed = WordCloudCore.layoutWordsInArea(words, slotWidth, slotHeight, measurementContext, colors);
        placed.forEach((item, itemIndex) => {
          design.push({
            id: `fit-area-${slotIndex + 1}-${itemIndex + 1}`,
            text: item.word,
            x: Math.round((slot.x + item.x) * 10) / 10,
            y: Math.round((slot.y + item.y) * 10) / 10,
            fontSize: Math.max(CloudLimits.MIN_PRINT_FONT_SIZE, Math.floor(item.fontPx * 10) / 10),
            angle: item.rotated ? -90 : 0,
            color: item.color,
            fontFamily: DesignFonts.DEFAULT_FONT_KEY,
            fontWeight: 400,
            fontStyle: 'normal',
            underline: false,
            linethrough: false,
          });
        });
      });
      return DesignLayout.optimizeDesign(design, slots, measurementContext, {
        fontFamily: (item) => DesignFonts.cssFamily(item.fontFamily),
      });
    }

    function cloneDesign(design) {
      return design.map((item) => ({ ...item }));
    }

    function cloneEditorState(state, includeHistory = true) {
      return {
        design: cloneDesign(state?.design || []),
        history: includeHistory && Array.isArray(state?.history) ? [...state.history] : [],
        historyIndex: includeHistory && Number.isSafeInteger(state?.historyIndex)
          ? state.historyIndex
          : -1,
      };
    }

    function productSurfaces() {
      return Array.isArray(product?.printSurfaces) && product.printSurfaces.length
        ? product.printSurfaces
        : [{ key: product?.printFile?.placement || 'default', label: 'Druckfläche' }];
    }

    function storeActiveSurfaceState() {
      if (mugEditor && activeSurface) surfaceStates.set(activeSurface, mugEditor.getState());
    }

    function resetSurfaceStates(initialState) {
      const surfaces = productSurfaces();
      activeSurface = surfaces[0].key;
      surfaceStates = new Map(surfaces.map((surface, index) => [
        surface.key,
        index === 0 ? cloneEditorState(initialState) :
          cloneEditorState({ design: buildAutomaticDesign(surface.key) }, false),
      ]));
      buildSurfaceControls();
    }

    function getAllSurfaceDesigns() {
      storeActiveSurfaceState();
      return Object.fromEntries(productSurfaces().map((surface) => [
        surface.key,
        cloneDesign(surfaceStates.get(surface.key)?.design || []),
      ]));
    }

    function designsForProductSurfaces(rawDesigns) {
      const surfaces = productSurfaces();
      if (rawDesigns && typeof rawDesigns === 'object' && !Array.isArray(rawDesigns)) {
        return Object.fromEntries(surfaces.map((surface) => [
          surface.key,
          Array.isArray(rawDesigns[surface.key]) ? cloneDesign(rawDesigns[surface.key]) : [],
        ]));
      }
      return Object.fromEntries(surfaces.map((surface) => [surface.key, buildAutomaticDesign(surface.key)]));
    }

    async function applySavedConfiguration(configurationData) {
      const nextProduct = products.find((candidate) => candidate.key === configurationData.productKey);
      if (!nextProduct) throw new Error('invalid_product');

      let adjusted = false;
      suppressDirty = true;
      try {
        product = nextProduct;
        activeSurface = productSurfaces()[0].key;
        selectedFamilyKey = product.familyKey;
        const savedOrientation = selectedOrientationOption(product, configurationData.orientation);
        selectedOrientation = savedOrientation?.key || product.defaultOrientation || 'default';
        selectedTheme = product.themes.some((option) => option.key === configurationData.theme)
          ? configurationData.theme
          : product.themes[0].key;
        if (Array.isArray(configurationData.customColors)) {
          customColors = configurationData.customColors.filter((color) => /^#[0-9a-f]{6}$/i.test(color)).slice(0, 8);
        }
        words = Array.isArray(configurationData.words) ? configurationData.words : words;

        buildProductOptions();
        buildOrientationOptions();
        buildThemeOptions();
        renderCustomColorControls();

        const defaultSlot = selectedProductSlot();
        const view = productView();
        mugEditor.resizePrintArea({
          printWidth: view.printFile.width,
          printHeight: view.printFile.height,
          printFileDpi: view.printFile.dpi,
          safeMargin: product.designSafeMargin,
          safeArea: view.safeArea,
          defaultX: defaultSlot.x + (defaultSlot.width || defaultSlot.side) / 2,
          defaultY: defaultSlot.y + (defaultSlot.height || defaultSlot.side) / 2,
        });

        const loadedDesigns = designsForProductSurfaces(configurationData.designs);
        await WolkenworteConfiguratorSession.withTimeout(ensureDesignFonts(Object.values(loadedDesigns).flat()
          .filter((item) => item.type !== 'icon' && item.type !== 'image')
          .map((item) => item.fontFamily)));
        await WolkenworteConfiguratorSession.withTimeout(mugEditor.preloadImages(Object.values(loadedDesigns).flat()));
        const surfaces = productSurfaces();
        for (const surface of surfaces) {
          const fitted = DesignLayout.fitDesignToSafeArea(loadedDesigns[surface.key],
            productView(product, null, surface.key).safeArea, mugEditor.measureContext,
            { fontFamily: item => DesignFonts.cssFamily(item.fontFamily) });
          loadedDesigns[surface.key] = fitted.design;
          adjusted = adjusted || fitted.adjusted;
        }
        activeSurface = surfaces[0].key;
        surfaceStates = new Map(surfaces.map((surface, index) => [
          surface.key,
          cloneEditorState({ design: loadedDesigns[surface.key] || [] }, index === 0),
        ]));
        buildSurfaceControls();
        mugEditor.setState(surfaceStates.get(activeSurface));
        updateSurfaceControlSelection();
        updateProductOptionSelection();
        updateProductPresentation();
        if (mug3D?.productKey !== product.key) destroyMug3D();
        renderAll();
        await initMug3D();
      } finally {
        mugEditor.flushPendingChange();
        suppressDirty = false;
      }
      if (adjusted) mugEditor.setFeedback('Dein Entwurf wurde an die aktuellen Druckränder angepasst. Bitte prüfen und erneut übernehmen.');
      return adjusted;
    }

    function updateSurfaceControlSelection() {
      surfaceTabs.querySelectorAll('.surface-tab').forEach((tab) => {
        const selected = tab.dataset.surfaceKey === activeSurface;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      surfaceCopy.hidden = productSurfaces().length < 2 || activeSurface !== 'back';
    }

    function selectSurface(surfaceKey, { announce = true } = {}) {
      if (!mugEditor || surfaceKey === activeSurface ||
          !productSurfaces().some((surface) => surface.key === surfaceKey)) return;
      mugEditor.flushPendingChange();
      storeActiveSurfaceState();
      activeSurface = surfaceKey;
      const wasSuppressed = suppressDirty;
      suppressDirty = true;
      try {
        mugEditor.setSafeArea(productView().safeArea);
        mugEditor.setState(surfaceStates.get(surfaceKey));
        mugEditor.flushPendingChange();
      } finally { suppressDirty = wasSuppressed; }
      updateSurfaceControlSelection();
      updateProductPresentation();
      if (announce) {
        const surface = productSurfaces().find((candidate) => candidate.key === surfaceKey);
        mugEditor.setFeedback('{{item}} wird bearbeitet', { item: t(surface.label) });
      }
      renderAll();
    }

    function buildSurfaceControls() {
      const surfaces = productSurfaces();
      surfaceEditor.hidden = surfaces.length < 2;
      surfaceTabs.replaceChildren();
      surfaces.forEach((surface, surfaceIndex) => {
        const tab = document.createElement('button');
        tab.type = 'button';
        tab.className = 'surface-tab';
        tab.dataset.surfaceKey = surface.key;
        tab.setAttribute('role', 'tab');
        setText(tab, surface.label);
        tab.addEventListener('click', () => selectSurface(surface.key));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          const direction = event.key === 'ArrowLeft' ? -1 : 1;
          const nextIndex = (surfaceIndex + direction + surfaces.length) % surfaces.length;
          selectSurface(surfaces[nextIndex].key);
          surfaceTabs.querySelectorAll('.surface-tab')[nextIndex]?.focus();
          event.preventDefault();
        });
        surfaceTabs.appendChild(tab);
      });
      updateSurfaceControlSelection();
    }

    function applyPaletteAcrossSurfaces(colors) {
      if (!mugEditor) return;
      mugEditor.applyPalette(colors);
      surfaceStates.set(activeSurface, mugEditor.getState());
      for (const surface of productSurfaces()) {
        if (surface.key === activeSurface) continue;
        const state = surfaceStates.get(surface.key);
        let colorIndex = 0;
        const design = (state?.design || []).map((item) => {
          if (item.type === 'image') return { ...item };
          const colored = { ...item, color: colors[colorIndex % colors.length] };
          colorIndex += 1;
          return colored;
        });
        surfaceStates.set(surface.key, cloneEditorState({ design }, false));
      }
    }

    surfaceCopy.addEventListener('click', () => {
      storeActiveSurfaceState();
      const front = surfaceStates.get('front');
      if (!front) return;
      const copied = cloneEditorState(front, false);
      const sourceArea = productView(product, null, 'front').safeArea;
      const targetArea = productView(product, null, 'back').safeArea;
      copied.design = copied.design.map(item => ({ ...item,
        x: item.x + targetArea.x - sourceArea.x,
        y: item.y + targetArea.y - sourceArea.y,
      }));
      surfaceStates.set('back', copied);
      if (activeSurface === 'back') mugEditor.setState(copied);
      mugEditor.setFeedback('Vorderseite auf die Rückseite übernommen');
      markDirty();
      renderAll();
    });

    function getCurrentDesign() {
      return mugEditor ? mugEditor.getDesign() : buildAutomaticDesign();
    }

    function drawDesign(ctx, offsetX = 0, offsetY = 0, scale = 1) {
      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';
      for (const item of getCurrentDesign()) {
        ctx.save();
        ctx.translate(offsetX + item.x * scale, offsetY + item.y * scale);
        ctx.rotate((item.angle || 0) * Math.PI / 180);
        if (item.type === 'image') {
          const image = mugEditor?.getImageElement(item.src);
          if (image) {
            ctx.drawImage(
              image,
              -item.width * scale / 2,
              -item.height * scale / 2,
              item.width * scale,
              item.height * scale
            );
          }
        } else if (item.type === 'icon') {
          const icon = MugIcons.get(item.icon);
          if (icon) {
            const iconScale = item.size * scale / MugIcons.VIEWBOX_SIZE;
            ctx.scale(iconScale, iconScale);
            ctx.translate(-MugIcons.VIEWBOX_SIZE / 2, -MugIcons.VIEWBOX_SIZE / 2);
            ctx.strokeStyle = item.color;
            ctx.lineWidth = MugIcons.STROKE_WIDTH;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.stroke(new Path2D(icon.path));
          }
        } else {
          WordCloudCore.drawRichText(ctx, item.text, 0, 0, item.fontSize * scale, {
            fontFamily: DesignFonts.cssFamily(item.fontFamily),
            color: item.color,
            fontWeight: item.fontWeight,
            fontStyle: item.fontStyle,
            underline: item.underline,
            linethrough: item.linethrough,
            emojiImage: (run) => WolkenworteEmoji.getLoadedImage(run),
          });
        }
        ctx.restore();
      }
    }

    function resizeMug3D() {
      if (!mug3D) return;
      mug3D.resize();
    }

    function refreshFlatProductPreviewFit() {
      if (!product || product.previewType !== 'flat') return;
      const view = productView();
      const hasProductMockup = Boolean(currentProductMockupAsset());
      const previewInsets = hasProductMockup ? { x: 8, y: 8 } : ({
        coaster: { x: 20, y: 20 },
        poster: { x: 8, y: 8 },
        'framed-poster': { x: 34, y: 34 },
        tote: { x: 18, y: 76 },
        blanket: { x: 12, y: 12 },
        notebook: { x: 30, y: 24 },
        pillow: { x: 18, y: 18 },
      }[product.previewShape] || { x: 12, y: 12 });
      const availableWidth = Math.max(1, mugViewer.clientWidth - previewInsets.x);
      const availableHeight = Math.max(1, mugViewer.clientHeight - previewInsets.y);
      const aspect = hasProductMockup
        ? view.previewMockup.width / view.previewMockup.height
        : view.printFile.width / view.printFile.height;
      const previewWidth = Math.min(availableWidth, availableHeight * aspect);
      const previewHeight = previewWidth / aspect;
      flatPreview.style.setProperty('--flat-preview-width', `${Math.floor(previewWidth)}px`);
      flatPreview.style.setProperty('--flat-preview-height', `${Math.floor(previewHeight)}px`);
    }

    function refreshWorkspaceLayout() {
      // Font/emoji loading can schedule this while the workspace is hidden.
      // Do not turn a temporary zero width into a persistent tiny print area.
      if (!product || !editorScroll.clientWidth) return;
      const view = productView();
      const scrollStyles = getComputedStyle(editorScroll);
      const horizontalPadding = parseFloat(scrollStyles.paddingLeft) + parseFloat(scrollStyles.paddingRight);
      const verticalPadding = parseFloat(scrollStyles.paddingTop) + parseFloat(scrollStyles.paddingBottom);
      const availableWidth = Math.max(1, editorScroll.clientWidth - horizontalPadding);
      const printAspect = view.printFile.width / view.printFile.height;
      const previewAspect = view.previewMockup
        ? view.previewMockup.width / view.previewMockup.height
        : printAspect;
      const isMobile = window.innerWidth <= 620;
      const minimumHeight = isMobile ? 280 : 320;
      const maximumHeight = isMobile
        ? Math.min(470, window.innerHeight * .72)
        : Math.min(620, window.innerHeight * .72);
      const desiredHeight = Math.max(
        availableWidth / printAspect,
        availableWidth / previewAspect
      ) + 24;
      const stageHeight = Math.round(Math.min(maximumHeight, Math.max(minimumHeight, desiredHeight)));
      workbench.style.setProperty('--workspace-stage-height', `${stageHeight}px`);
      // Stacked cards have independent heights. A wide mug wrap needs only
      // its aspect-ratio height and padding; the 3D preview still needs depth.
      const editorHeight = window.innerWidth <= 940
        ? Math.min(maximumHeight, availableWidth / printAspect + verticalPadding)
        : stageHeight;
      workbench.style.setProperty('--editor-stage-height', `${Math.ceil(editorHeight)}px`);
      mugEditor?.refreshViewport();
      refreshFlatProductPreviewFit();
      resizeMug3D();
    }

    function updateMug3DTexture() {
      if (!mug3D || !product) return;
      try {
        mug3D.updateTexture((ctx, { offsetX, offsetY }) => {
          drawDesign(ctx, offsetX, offsetY);
        });
      } catch { setMugPreviewState('error'); }
    }

    function setMugPreviewState(state) {
      previewState = state;
      const isMug = product?.previewType === 'mug';
      mugViewer.classList.toggle('is-ready', isMug && state === 'ready');
      mugViewer.tabIndex = isMug && state === 'ready' ? 0 : -1;
      mugViewer.setAttribute('aria-busy', String(isMug && state === 'loading'));
      mugPreviewState.hidden = !isMug || state === 'ready';
      retryMugPreview.hidden = state !== 'error';
      document.getElementById('mug-viewer-hint').hidden = isMug && state !== 'ready';
      setText(mugPreviewMessage, state === 'error'
        ? 'Die 3D-Vorschau ist gerade nicht verfügbar. Euer Design bleibt erhalten.'
        : '3D-Vorschau wird geladen…');
    }

    function initMug3D() {
      if (product?.previewType !== 'mug') return Promise.resolve();
      if (mug3D) { updateMug3DTexture(); return Promise.resolve(); }
      if (mug3DLoadPromise) return mug3DLoadPromise;
      const generation = mug3DGeneration;
      setMugPreviewState('loading');
      mug3DLoadPromise = Promise.resolve().then(() => {
        if (generation !== mug3DGeneration) return;
        mug3D = Mug3DViewer.create({
          THREE: window.THREE,
          host: mugViewer,
          interactionElement: mugViewer,
          product,
          onStatus: (state) => { if (generation === mug3DGeneration) setMugPreviewState(state); },
          drawTexture: (ctx, { offsetX, offsetY }) => {
            drawDesign(ctx, offsetX, offsetY);
          },
        });
        mug3D.productKey = product.key;
        setMugPreviewState('ready');
      }).catch((error) => {
        if (generation !== mug3DGeneration) return;
        console.warn('3D mug preview unavailable.', error);
        destroyMug3D();
        setMugPreviewState('error');
      }).finally(() => {
        if (generation === mug3DGeneration) mug3DLoadPromise = null;
      });
      return mug3DLoadPromise;
    }

    function renderProductPreview() {
      if (!product) return;
      if (product.previewType === 'mug') { updateMug3DTexture(); return; }
      const view = productView();
      const canvas = flatCanvas;
      const ctx = setupCanvas(canvas);
      const width = canvas.width;
      const height = canvas.height;
      ctx.clearRect(0, 0, width, height);
      const hasProductMockup = product.previewType === 'flat' && Boolean(currentProductMockupAsset());
      if (product.previewType === 'flat' && !hasProductMockup) {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, width, height);
      }
      const widthScale = width / view.printFile.width;
      const heightScale = height / view.printFile.height;
      const scale = (hasProductMockup && view.previewMockup.canvas.fit === 'cover'
        ? Math.max(widthScale, heightScale)
        : Math.min(widthScale, heightScale)) * (hasProductMockup ? 1 : .9);
      drawDesign(
        ctx,
        (width - view.printFile.width * scale) / 2,
        (height - view.printFile.height * scale) / 2,
        scale
      );
      if (product.previewType === 'mug') updateMug3DTexture();
    }

    function updatePrintReadability() {
      const notice = document.getElementById('print-readability');
      if (!mugEditor || !product) { notice.hidden = true; return; }
      const design = productSurfaces().flatMap(surface => surface.key === activeSurface
        ? mugEditor.getDesign() : (surfaceStates.get(surface.key)?.design || []));
      const quality = TextPrintQuality.evaluate(design, Number(productView().printFile.dpi));
      notice.hidden = !quality || quality.level === 'good';
      if (notice.hidden) { clearText(notice); return; }
      notice.dataset.level = quality.level;
      setText(notice, quality.level === 'low'
        ? 'Auf euren Druckflächen sind {{count}} Texte sehr klein (kleinste Schrift: {{size}} pt). Vergrößert die Schrift, wählt ein größeres Produkt oder reduziert die Texte im Druckdesign. Die Live-Wortwolke bleibt vollständig.'
        : 'Auf euren Druckflächen sind {{count}} Texte klein (kleinste Schrift: {{size}} pt). Prüft die Lesbarkeit; ein größeres Produkt bietet mehr Platz.',
      { count: quality.level === 'low' ? quality.tiny : quality.small,
        size: WolkenworteI18n.formatNumber(quality.minPt, { maximumFractionDigits: 1 }) });
    }

    function renderAll() {
      cancelAnimationFrame(renderFrame);
      renderFrame = requestAnimationFrame(() => {
        renderProductPreview();
        updatePrintReadability();
      });
    }

    function markDirty() {
      if (suppressDirty) return;
      clearText(errorText);
      currentDesignNeedsSave = true;
      currentDesignEdited = true;
      designRevision += 1;
      pendingConfiguration = null;
      if (workspaceReady) updateCartActions();
    }

    function currentProductMockupAsset() {
      const assets = productView()?.previewMockup?.assets;
      return assets?.[activeSurface] || assets?.default || '';
    }

    function updateProductMockup() {
      const view = productView();
      const asset = currentProductMockupAsset();
      const canvas = view?.previewMockup?.canvas;
      flatPreview.classList.toggle('has-product-mockup', Boolean(asset));
      flatPreview.style.setProperty(
        '--product-mockup-scale',
        String(view?.previewMockup?.scale || 1)
      );
      flatPreview.style.setProperty(
        '--product-mockup-blend',
        view?.previewMockup?.blendMode || 'normal'
      );
      flatPreview.style.setProperty(
        '--product-mockup-rotation',
        `${view?.previewMockup?.rotation || 0}deg`
      );
      flatPreview.style.setProperty('--product-mockup-canvas-left', `${canvas?.left ?? 0}%`);
      flatPreview.style.setProperty('--product-mockup-canvas-top', `${canvas?.top ?? 0}%`);
      flatPreview.style.setProperty('--product-mockup-canvas-width', `${canvas?.width ?? 100}%`);
      flatPreview.style.setProperty('--product-mockup-canvas-height', `${canvas?.height ?? 100}%`);
      flatPreview.style.setProperty(
        '--product-mockup-canvas-clip',
        canvas?.clipPath || 'none'
      );
      if (asset) {
        if (flatMockup.getAttribute('src') !== asset) flatMockup.src = asset;
      } else {
        flatMockup.removeAttribute('src');
      }
    }

    function localizedNumber(value) {
      return WolkenworteI18n.formatNumber(value);
    }

    function updateProductPresentation() {
      if (!product) return;
      const view = productView();
      const isMug = product.previewType === 'mug';
      mugViewer.classList.toggle('is-flat', !isMug);
      productStage.classList.toggle('is-flat-product', !isMug);
      flatPreview.classList.toggle('is-coaster', product.previewShape === 'coaster');
      flatPreview.classList.toggle('is-framed', product.previewShape === 'framed-poster');
      flatPreview.classList.toggle('is-tote', product.previewShape === 'tote');
      flatPreview.classList.toggle('is-blanket', product.previewShape === 'blanket');
      flatPreview.classList.toggle('is-notebook', product.previewShape === 'notebook');
      flatPreview.classList.toggle('is-pillow', product.previewShape === 'pillow');
      updateProductMockup();
      flatPreview.style.setProperty(
        '--flat-preview-aspect',
        view.previewMockup
          ? `${view.previewMockup.width} / ${view.previewMockup.height}`
          : `${view.printFile.width} / ${view.printFile.height}`
      );
      requestAnimationFrame(refreshWorkspaceLayout);
      mugViewer.tabIndex = isMug ? 0 : -1;
      mugViewer.setAttribute('aria-label', isMug
        ? t('Interaktive 3D-Tasse. Zum Drehen ziehen oder die Pfeiltasten verwenden.')
        : t('Vorschau: {{product}}, {{size}}', {
          product: t(product.displayName),
          size: t(view.size.label),
        }));
      const activeSurfaceLabel = productSurfaces().length > 1
        ? ` · ${t(productSurfaces().find((surface) => surface.key === activeSurface)?.label || '')}`
        : '';
      document.getElementById('mug-viewer-hint').textContent = isMug
        ? t('↔ ↕ Ziehen zum Drehen · {{height}} cm × Ø {{diameter}} cm', {
          height: localizedNumber(product.size.heightCm),
          diameter: localizedNumber(product.size.diameterCm),
        })
        : `${t(product.displayName)} · ${t(view.size.label)}${activeSurfaceLabel}`;
      productStage.setAttribute(
        'aria-label',
        t('Vorschau: {{product}}, {{size}}', {
          product: t(product.displayName),
          size: t(view.size.label),
        })
      );
      setMugPreviewState(previewState);
    }

    function destroyMug3D() {
      mug3DGeneration += 1;
      if (mug3D) mug3D.destroy?.();
      mug3D = null;
      mug3DLoadPromise = null;
      mugViewer.classList.remove('is-ready');
      mugViewer.querySelectorAll(':scope > canvas').forEach((canvas) => canvas.remove());
    }

    retryMugPreview.addEventListener('click', () => { destroyMug3D(); void initMug3D(); });
    retryConfigurator.addEventListener('click', () => {
      allowNavigation = true;
      location.reload();
    });

    function dialogSelectedProduct() {
      return products.find((candidate) => candidate.key === pendingProductKey) || product;
    }

    function dialogSelectedFamilyKey() {
      return pendingFamilyKey || dialogSelectedProduct()?.familyKey || selectedFamilyKey;
    }

    function updateProductOptionSelection() {
      renderSelectedProduct();
      const dialogProduct = dialogSelectedProduct();
      const dialogFamilyKey = dialogSelectedFamilyKey();
      productOptions.querySelectorAll('.product-option').forEach((option) => {
        const selected = option.dataset.familyKey === dialogFamilyKey;
        option.setAttribute('aria-checked', String(selected));
        option.tabIndex = selected ? 0 : -1;
      });
      variantOptions.querySelectorAll('.variant-option').forEach((option) => {
        const selected = option.dataset.productKey === dialogProduct?.key;
        option.setAttribute('aria-checked', String(selected));
        option.tabIndex = selected ? 0 : -1;
      });
    }

    function productsInFamily(familyKey) {
      return products.filter((candidate) => candidate.familyKey === familyKey);
    }

    function productDetail(candidate) {
      return candidate.size.volumeMl
        ? t('{{volume}} ml · {{height}} cm hoch', {
          volume: WolkenworteI18n.formatNumber(candidate.size.volumeMl),
          height: localizedNumber(candidate.size.heightCm),
        })
        : t(candidate.size.detail);
    }

    function selectedProductSummary(candidate = product) {
      if (!candidate) return '';
      return productSizeText(candidate, candidate === product ? selectedOrientation : null);
    }

    function renderSelectedProduct() {
      if (!product) return;
      selectedProductThumb.src = product.thumbnail;
      selectedProductThumb.alt = '';
      setText(selectedProductName, product.displayName);
      selectedProductDetail.textContent = selectedProductSummary(product);
      updateToolbarSummaries();
    }

    function closeProductDialog() {
      if (productDialog.open) productDialog.close();
    }

    function openProductDialog() {
      pendingProductKey = product?.key || null;
      pendingFamilyKey = selectedFamilyKey;
      productDialogCloseReason = 'cancel';
      buildProductOptions();
      if (!productDialog.open) productDialog.showModal();
      updateProductOptionSelection();
      requestAnimationFrame(() => {
        productDialog.focus({ preventScroll: true });
      });
    }

    function resetProductDialogSelection() {
      pendingProductKey = null;
      pendingFamilyKey = null;
    }

    async function confirmProductDialog() {
      if (leavingPage || orderActionPending) return;
      const nextProduct = dialogSelectedProduct();
      const another = startingAnotherProduct;
      productDialogCloseReason = 'confirm';
      resetProductDialogSelection();
      closeProductDialog();
      if (another) {
        // The existing leave dialog already approved this new-design action.
        await startProductDesign(nextProduct);
      } else if (nextProduct?.key !== product?.key) {
        await runNavigation(() => startProductDesign(nextProduct), { onlyIfEdited: true });
      }
      updateProductOptionSelection();
    }

    changeProductButton.addEventListener('click', () => {
      startingAnotherProduct = false;
      openProductDialog();
    });
    productDialogClose.addEventListener('click', closeProductDialog);
    productDialogDone.addEventListener('click', confirmProductDialog);
    productDialog.addEventListener('click', (event) => {
      if (event.target === productDialog) closeProductDialog();
    });
    productDialog.addEventListener('close', () => {
      if (productDialogCloseReason !== 'confirm') {
        resetProductDialogSelection();
        buildProductOptions();
        updateProductOptionSelection();
      }
      productDialogCloseReason = 'cancel';
      startingAnotherProduct = false;
      changeProductButton.focus();
    });

    function selectedProductSlot() {
      const view = productView();
      return view.layoutGeometry['fit-area'][0];
    }

    async function startProductDesign(nextProduct, orientation) {
      if (!nextProduct || orderActionPending || !workspaceReady || restorationFailed) return false;
      orderActionPending = true;
      setOrderActionsBusy(true);
      try {
        // Fetch and preload before replacing any edited surface. A failed
        // refresh leaves the current design available to retry or save.
        const response = await fetch(`/api/events/${encodeURIComponent(slug)}/configurator`,
          { cache: 'no-store', signal: AbortSignal.timeout(15000) });
        if (!response.ok) throw new Error('load_failed');
        const nextWords = (await response.json()).words;
        if (!Array.isArray(nextWords) || !nextWords.length) throw new Error('no_words');
        await WolkenworteConfiguratorSession.withTimeout(ensureDesignFonts([DesignFonts.DEFAULT_FONT_KEY]));
        await WolkenworteConfiguratorSession.withTimeout(WolkenworteEmoji.preloadTexts(nextWords.map(([word]) => word)));
        suppressDirty = true;
        try {
          words = liveWords = nextWords;
          selectProduct(nextProduct, orientation);
          editingOrderItemId = null;
          mugEditor.flushPendingChange();
        } finally { suppressDirty = false; }
        markDirty();
        currentDesignEdited = false;
        renderOrderBox();
        history.replaceState(null, '', `/e/${encodeURIComponent(slug)}/configure`);
        return true;
      } catch {
        setText(errorText, 'Die aktuelle Wortwolke konnte nicht geladen werden. Bitte versucht es erneut.');
        return false;
      } finally {
        orderActionPending = false;
        setOrderActionsBusy(false);
      }
    }

    function selectProduct(nextProduct, orientation) {
      product = nextProduct;
      activeSurface = productSurfaces()[0].key;
      selectedFamilyKey = product.familyKey;
      selectedOrientation = orientation || product.defaultOrientation || 'default';
      buildOrientationOptions();
      if (mugEditor) {
        const defaultSlot = selectedProductSlot();
        const view = productView();
        mugEditor.resizePrintArea({
          printWidth: view.printFile.width,
          printHeight: view.printFile.height,
          printFileDpi: view.printFile.dpi,
          safeMargin: product.designSafeMargin,
          safeArea: view.safeArea,
          defaultX: defaultSlot.x + (defaultSlot.width || defaultSlot.side) / 2,
          defaultY: defaultSlot.y + (defaultSlot.height || defaultSlot.side) / 2,
        });
        mugEditor.setDesign(buildAutomaticDesign(), { resetHistory: true });
        resetSurfaceStates(mugEditor.getState());
        mugEditor.setFeedback('Druckfläche für {{size}} angepasst', { size: t(view.size.label) });
      } else {
        activeSurface = productSurfaces()[0].key;
        buildSurfaceControls();
      }
      buildVariantOptions();
      updateProductOptionSelection();
      updateProductPresentation();
      destroyMug3D();
      renderAll();
      initMug3D();
    }

    function selectDialogProduct(candidate) {
      if (!candidate) return;
      pendingProductKey = candidate.key;
      pendingFamilyKey = candidate.familyKey;
      updateProductOptionSelection();
    }

    function selectDialogFamily(family) {
      if (!family) return;
      pendingFamilyKey = family.key;
      const candidates = productsInFamily(family.key);
      const currentProduct = dialogSelectedProduct();
      const nextProduct = candidates.find((candidate) => candidate.key === currentProduct?.key) || candidates[0];
      if (nextProduct) pendingProductKey = nextProduct.key;
      buildVariantOptions();
      updateProductOptionSelection();
    }

    function buildVariantOptions() {
      const activeFamilyKey = dialogSelectedFamilyKey();
      const family = productFamilies.find((candidate) => candidate.key === activeFamilyKey);
      const candidates = productsInFamily(activeFamilyKey);
      variantPanel.hidden = candidates.length < 2;
      variantOptions.replaceChildren();
      if (candidates.length < 2) return;
      setText(document.getElementById('variant-title'), '{{item}} wählen', {
        item: t(family?.label || 'Ausführung'),
      });
      candidates.forEach((candidate, candidateIndex) => {
        const option = document.createElement('button');
        option.type = 'button';
        option.className = 'variant-option';
        option.dataset.productKey = candidate.key;
        option.setAttribute('role', 'radio');
        option.setAttribute('aria-label', `${t(candidate.displayName)}, ${t(candidate.size.label)}`);
        option.addEventListener('click', () => selectDialogProduct(candidate));
        option.addEventListener('keydown', (event) => {
          if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          const direction = event.key === 'ArrowUp' || event.key === 'ArrowLeft' ? -1 : 1;
          const nextIndex = (candidateIndex + direction + candidates.length) % candidates.length;
          selectDialogProduct(candidates[nextIndex]);
          variantOptions.querySelectorAll('.variant-option')[nextIndex]?.focus();
          event.preventDefault();
        });
        const thumbnail = document.createElement('img');
        thumbnail.src = candidate.thumbnail;
        thumbnail.alt = '';
        thumbnail.loading = 'lazy';
        const copy = document.createElement('span');
        const name = document.createElement('strong');
        name.textContent = `${t(candidate.displayName)} · ${t(candidate.size.label)}`;
        const detail = document.createElement('span');
        detail.textContent = productDetail(candidate);
        copy.append(name, detail);
        option.append(thumbnail, copy);
        variantOptions.appendChild(option);
      });
      updateProductOptionSelection();
    }

    function buildProductOptions() {
      productOptions.replaceChildren();
      productFamilies.forEach((family, familyIndex) => {
        const option = document.createElement('button');
        option.type = 'button';
        option.className = 'product-option';
        option.dataset.familyKey = family.key;
        option.setAttribute('role', 'radio');
        setTranslatedAttribute(option, 'aria-label', family.label);
        option.addEventListener('click', () => selectDialogFamily(family));
        option.addEventListener('keydown', (event) => {
          if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          const direction = event.key === 'ArrowUp' || event.key === 'ArrowLeft' ? -1 : 1;
          const nextIndex = (familyIndex + direction + productFamilies.length) % productFamilies.length;
          const nextOption = productOptions.querySelectorAll('.product-option')[nextIndex];
          selectDialogFamily(productFamilies[nextIndex]);
          nextOption?.focus();
          event.preventDefault();
        });

        const card = document.createElement('span');
        card.className = 'product-choice';
        const thumbnail = document.createElement('img');
        thumbnail.className = 'product-thumbnail';
        thumbnail.src = family.thumbnail;
        thumbnail.alt = '';
        thumbnail.loading = 'lazy';
        const copy = document.createElement('span');
        copy.className = 'product-copy';
        const name = document.createElement('strong');
        setText(name, family.label);
        const description = document.createElement('span');
        setText(description, family.description);
        const checkmark = document.createElement('span');
        checkmark.className = 'checkmark';
        checkmark.setAttribute('aria-hidden', 'true');
        checkmark.textContent = '✓';
        copy.append(name, description);
        card.append(thumbnail, copy, checkmark);
        option.append(card);
        productOptions.appendChild(option);
      });
      buildVariantOptions();
      updateProductOptionSelection();
    }

    async function activateOrientation(orientation) {
      if (!orientation || orientation.key === selectedOrientation) return;
      closeToolbarMenus();
      // A radio changes before its handler runs. Restore the actual choice
      // while the shared confirmation dialog protects the current design.
      buildOrientationOptions();
      await runNavigation(() => startProductDesign(product, orientation.key), { onlyIfEdited: true });
    }

    function buildOrientationOptions() {
      orientationOptions.replaceChildren();
      const options = Array.isArray(product?.orientations) ? product.orientations : [];
      const hasOrientationChoice = options.length > 1;
      orientationStep.hidden = !hasOrientationChoice;
      designToolbarControls.classList.toggle('has-orientation', hasOrientationChoice);
      if (!hasOrientationChoice) {
        selectedOrientation = 'default';
        updateToolbarSummaries();
        return;
      }
      if (!options.some((option) => option.key === selectedOrientation)) {
        selectedOrientation = product.defaultOrientation || options[0].key;
      }
      for (const orientation of options) {
        const label = document.createElement('label');
        label.className = 'option';
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'orientation';
        input.value = orientation.key;
        input.checked = orientation.key === selectedOrientation;
        input.addEventListener('change', () => activateOrientation(orientation));
        const card = document.createElement('span');
        card.className = 'option-card';
        const name = document.createElement('strong');
        setText(name, orientation.label);
        const description = document.createElement('small');
        description.textContent = `${t(orientation.size.label)} · ${t(orientation.description)}`;
        card.append(name, description);
        label.append(input, card);
        orientationOptions.appendChild(label);
      }
      updateToolbarSummaries();
    }

    function buildThemeOptions() {
      themeOptions.replaceChildren();
      for (const palette of product.themes) {
        const paletteColors = palette.key === 'custom' ? customColors : palette.colors;
        const label = document.createElement('label');
        label.className = 'option';

        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'theme';
        input.value = palette.key;
        input.checked = palette.key === selectedTheme;
        input.addEventListener('change', () => {
          selectedTheme = palette.key;
          updateToolbarSummaries();
          markDirty();
          renderCustomColorControls();
          if (palette.key !== 'custom') closeToolbarMenus();
          if (mugEditor) applyPaletteAcrossSurfaces(getPalette(selectedTheme).colors);
          renderAll();
        });

        const card = document.createElement('span');
        card.className = 'option-card theme-option-card';
        card.dataset.themeCard = palette.key;
        card.style.setProperty('--theme-accent', paletteColors[0]);
        card.style.setProperty('--theme-soft', colorWithAlpha(paletteColors[1] || paletteColors[0], .12));
        card.style.setProperty('--theme-shadow', colorWithAlpha(paletteColors[0], .16));
        const swatches = document.createElement('span');
        swatches.className = 'swatches';
        renderPaletteStrip(swatches, paletteColors);
        const name = document.createElement('strong');
        setText(name, palette.label);
        const description = document.createElement('small');
        setText(description, palette.description);
        card.append(swatches, name, description);
        label.append(input, card);
        themeOptions.appendChild(label);
      }
      updateToolbarSummaries();
    }

