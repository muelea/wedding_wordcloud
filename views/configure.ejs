    function orderStorageKey() {
      return `wolkenworte-order:${slug}`;
    }

    function normalizeOrderItems(items) {
      if (!Array.isArray(items)) return [];
      const seen = new Set();
      return items
        .filter((item) => item && /^[A-Za-z0-9_-]{16}$/.test(String(item.id || '')))
        .filter((item) => {
          if (seen.has(item.id)) return false;
          seen.add(item.id);
          return true;
        })
        .map((item) => ({
          id: String(item.id),
          productKey: String(item.productKey || ''),
          orientation: String(item.orientation || 'default'),
          printFileUrl: String(item.printFileUrl || ''),
          createdAt: String(item.createdAt || ''),
        }))
        .slice(-20);
    }

    function loadOrderItems() {
      try {
        const stored = localStorage.getItem(orderStorageKey());
        return stored ? normalizeOrderItems(JSON.parse(stored)) : [];
      } catch {
        return fallbackOrderItems;
      }
    }

    function saveOrderItems(items) {
      fallbackOrderItems = items.slice(-20);
      try {
        localStorage.setItem(orderStorageKey(), JSON.stringify(fallbackOrderItems));
      } catch {
        // A private browsing storage failure should not block the current save.
      }
    }

    function productView(candidate = product, orientation = null) {
      if (!candidate) return null;
      const options = Array.isArray(candidate.orientations) ? candidate.orientations : [];
      if (!options.length) return { ...candidate, orientation: 'default' };
      const key = orientation || (candidate === product ? selectedOrientation : null) ||
        candidate.defaultOrientation || candidate.orientation || options[0].key;
      const selected = options.find((option) => option.key === key) ||
        options.find((option) => option.key === candidate.defaultOrientation) || options[0];
      return {
        ...candidate,
        orientation: selected.key,
        size: selected.size,
        printFile: selected.printFile,
        layoutGeometry: selected.layoutGeometry,
        previewMockup: selected.previewMockup,
      };
    }

    function selectedOrientationOption(candidate = product, orientation = selectedOrientation) {
      const options = Array.isArray(candidate?.orientations) ? candidate.orientations : [];
      return options.find((option) => option.key === orientation) ||
        options.find((option) => option.key === candidate?.defaultOrientation) || options[0] || null;
    }

    function productSizeText(candidate, orientation = null) {
      const size = productView(candidate, orientation)?.size || {};
      const label = t(size.label || '');
      if (size.volumeMl) return `${label} · ${WolkenworteI18n.formatNumber(size.volumeMl)} ml`;
      if (size.detail) return `${label} · ${t(size.detail)}`;
      return label;
    }

    function orderItemFromConfiguration(configuration) {
      return {
        id: configuration.id,
        productKey: configuration.productKey,
        orientation: configuration.orientation || 'default',
        printFileUrl: configuration.printFileUrl,
        createdAt: configuration.createdAt || new Date().toISOString(),
      };
    }

    function addOrderItem(configuration, { replaceId = null } = {}) {
      const nextItem = orderItemFromConfiguration(configuration);
      const existing = loadOrderItems();
      const replaceIndex = replaceId
        ? existing.findIndex((item) => item.id === replaceId)
        : -1;
      const items = existing.filter((item) => item.id !== nextItem.id && item.id !== replaceId);
      if (replaceIndex >= 0) {
        items.splice(Math.min(replaceIndex, items.length), 0, nextItem);
      } else {
        items.push(nextItem);
      }
      saveOrderItems(items);
      return items;
    }

    function setOrderActionsBusy(isBusy, activeButton = null) {
      for (const button of [designAnotherButton, continueOrderButton]) {
        WolkenworteActions.setBusy(button, isBusy && button === activeButton);
        button.disabled = isBusy;
      }
      checkoutPanel.setAttribute('aria-busy', String(isBusy));
    }

    async function loadOrderItem(configurationId) {
      if (orderActionPending) return;
      const item = loadOrderItems().find((candidate) => candidate.id === configurationId);
      if (!item) {
        errorText.textContent = 'Dieses Design ist nicht mehr in eurer Bestellung.';
        renderOrderBox();
        return;
      }
      orderActionPending = true;
      setOrderActionsBusy(true);
      clearText(errorText);
      try {
        const response = await fetch(
          `/api/events/${encodeURIComponent(slug)}/configurations/${encodeURIComponent(configurationId)}/edit`,
          { cache: 'no-store' }
        );
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'load_failed');
        await applySavedConfiguration(data);
        editingOrderItemId = data.id;
        currentDesignNeedsSave = false;
        renderOrderBox();
        document.getElementById('preview-title').scrollIntoView({ behavior: 'smooth', block: 'start' });
        mugEditor?.setFeedback('Design aus eurer Bestellung geöffnet');
      } catch {
        errorText.textContent = 'Dieses Design konnte nicht geöffnet werden. Bitte versucht es noch einmal.';
      } finally {
        orderActionPending = false;
        setOrderActionsBusy(false);
      }
    }

    async function openOrderItem(configurationId) {
      if (orderActionPending) return;
      const item = loadOrderItems().find((candidate) => candidate.id === configurationId);
      if (!item) {
        errorText.textContent = 'Dieses Design ist nicht mehr in eurer Bestellung.';
        renderOrderBox();
        return;
      }
      const openingCurrentItem = editingOrderItemId === configurationId;
      if (!await saveCurrentDesign(null, { allowEmptyDraft: true })) return;
      await loadOrderItem(openingCurrentItem ? editingOrderItemId : configurationId);
    }

