    function colorWithAlpha(hex, alpha) {
      const value = hex.replace('#', '');
      const red = Number.parseInt(value.slice(0, 2), 16);
      const green = Number.parseInt(value.slice(2, 4), 16);
      const blue = Number.parseInt(value.slice(4, 6), 16);
      return `rgba(${red}, ${green}, ${blue}, ${alpha})`;
    }

    function renderPaletteStrip(swatches, colors) {
      swatches.replaceChildren();
      swatches.style.setProperty('--swatch-count', String(colors.length));
      for (const color of colors) {
        const swatch = document.createElement('i');
        swatch.style.backgroundColor = color;
        swatches.appendChild(swatch);
      }
    }

    function updateCustomThemeCard() {
      const card = themeOptions.querySelector('[data-theme-card="custom"]');
      if (!card || !customColors.length) return;
      card.style.setProperty('--theme-accent', customColors[0]);
      card.style.setProperty('--theme-soft', colorWithAlpha(customColors[1] || customColors[0], .12));
      card.style.setProperty('--theme-shadow', colorWithAlpha(customColors[0], .16));
      renderPaletteStrip(card.querySelector('.swatches'), customColors);
    }

    function applyCustomPalette() {
      updateCustomThemeCard();
      updateToolbarSummaries();
      markDirty();
      if (mugEditor) applyPaletteAcrossSurfaces(customColors);
