        const itemSize = itemProduct
          ? `${productSizeText(itemProduct, item.orientation)}${orientation ? ` · ${t(orientation.label)}` : ''}`
          : t('Wolkenworte Design');
        const isEditing = item.id === editingOrderItemId;
        const row = document.createElement('div');
