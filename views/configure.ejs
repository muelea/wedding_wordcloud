    .custom-color-input::-webkit-color-swatch-wrapper { padding: 0; }
    .custom-color-input::-webkit-color-swatch { border: 0; border-radius: 6px; }
    .custom-color-input::-moz-color-swatch { border: 0; border-radius: 6px; }
    .custom-color-value {
      overflow: hidden;
      color: var(--ink);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 10px;
      text-overflow: ellipsis;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .custom-color-remove {
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: 17px;
      line-height: 1;
    }
    .custom-color-remove:hover { background: rgba(156,28,76,.08); color: var(--berry); }
    .custom-color-remove:disabled { cursor: not-allowed; opacity: .25; }
    .custom-palette-note { margin: 11px 0 0; color: var(--muted); font-size: 10px; line-height: 1.45; }

    .primary-button {
      width: auto;
      min-height: 44px;
      margin-top: 0;
      padding: 12px 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border: 1px solid transparent;
      border-radius: 12px;
      background: var(--ink);
      color: #fff;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      box-shadow: 0 7px 16px rgba(64, 15, 38, .12);
      transition: transform .2s, border-color .2s, background .2s, box-shadow .2s, opacity .2s;
    }
    .primary-button:hover { transform: translateY(-1px); box-shadow: 0 10px 20px rgba(64,15,38,.17); }
    .primary-button:disabled { cursor: default; opacity: .6; transform: none; }
    .primary-button.ww-is-busy:disabled { cursor: wait; }
    .order-box {
      margin-top: 0;
      padding: 16px 18px;
      border: 1px solid rgba(123, 70, 82, .12);
      border-radius: 18px;
      background: rgba(255, 254, 252, .88);
    }
    .order-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }
    .order-head strong { font-size: 13px; }
    .order-head span { color: var(--muted); font-size: 11px; }
    .order-list { display: grid; }
    .order-item {
      min-width: 0;
      position: relative;
      display: grid;
      grid-template-columns: 46px minmax(0, 1fr) auto;
      align-items: center;
      gap: 9px;
      padding: 10px 0;
      border: 0;
      background: transparent;
    }
    .order-item + .order-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 55px;
      right: 38px;
      height: 1px;
      background: linear-gradient(
        90deg,
        rgba(123, 70, 82, 0),
        rgba(123, 70, 82, .12) 8%,
        rgba(123, 70, 82, .12) 92%,
        rgba(123, 70, 82, 0)
      );
      pointer-events: none;
    }
    .order-item.is-editing {
      border-radius: 10px;
      background: rgba(156, 28, 76, .045);
    }
    .order-item img {
      width: 46px;
      height: 38px;
      object-fit: contain;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: #fff;
    }
    .order-copy { min-width: 0; }
    .order-copy strong {
      display: block;
      overflow: hidden;
      font-size: 12px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .order-copy span {
      display: block;
      margin-top: 2px;
      overflow: hidden;
      color: var(--muted);
      font-size: 10px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .order-item-actions { display: flex; align-items: center; gap: 6px; }
    .order-edit,
    .order-remove {
      min-height: 32px;
      padding: 0;
      border: 0;
      border-radius: 9px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
    }
    .order-edit {
      padding: 0 9px;
      border: 1px solid rgba(156, 28, 76, .18);
      color: var(--berry);
      font-size: 11px;
      font-weight: 600;
    }
    .order-edit:hover { background: rgba(156, 28, 76, .06); border-color: rgba(156, 28, 76, .36); }
    .order-edit:disabled {
      border-color: transparent;
      background: rgba(156, 28, 76, .07);
      color: var(--muted);
      cursor: default;
    }
    .order-remove { width: 32px; }
    .order-remove:hover { background: rgba(156, 28, 76, .08); color: var(--berry); }
    .order-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      flex-wrap: wrap;
    }

    .order-actions button[hidden] { display: none; }
    #leave-design-discard[hidden] { display: none; }
    #leave-design-dialog .config-panel-foot { display: flex; gap: 10px; flex-wrap: wrap; }
    #leave-design-dialog .config-panel-foot button { min-width: 0; flex: 1 1 160px; }
    .secondary-button {
      width: auto;
      min-width: 210px;
      min-height: 44px;
      padding: 10px 14px;
      border: 1px solid transparent;
      border-radius: 12px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      transition: border-color .2s, background .2s, color .2s;
    }
    .secondary-button:hover:not(:disabled) { background: rgba(123, 70, 82, .055); color: var(--ink); }
    .secondary-button:focus { outline: none; }
    .secondary-button:focus-visible { background: rgba(123, 70, 82, .055); color: var(--ink); }
    .secondary-button:disabled { cursor: wait; opacity: .6; }
    .order-actions .continue-button {
      min-width: 190px;
      background: linear-gradient(135deg, var(--berry), var(--berry-dark));
    }
    .error-text { margin: 0; color: #a12c43; text-align: center; font-size: 12px; }
    .error-text:empty { display: none; }

    .loading {
      min-height: 58vh;
      display: grid;
      place-items: center;
      color: var(--muted);
      font-family: 'Playfair Display', 'Wolkenworte Playfair Fallback', Georgia, serif;
      font-style: italic;
    }
    .config-content[hidden], .loading[hidden] { display: none; }

    .config-footer {
      padding: 0 24px 28px;
      display: flex;
      justify-content: center;
      gap: 12px;
      color: var(--muted);
      font-size: 11px;
    }
    .config-footer a:hover { color: var(--berry); }

    @media (max-width: 1180px) {
      .design-toolbar { grid-template-columns: 1fr; align-items: stretch; }
      .design-toolbar-copy {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
      }
      .controls-sub { max-width: 520px; text-align: right; }
      .design-toolbar-controls { grid-template-columns: minmax(300px, 1fr) minmax(210px, .7fr); }
      .design-toolbar-controls.has-orientation {
        grid-template-columns: minmax(280px, 1.1fr) repeat(2, minmax(170px, .72fr));
      }
      .editor-properties { grid-template-columns: minmax(0, 1fr); }
      .editor-actions { justify-content: flex-end; }
    }

    @media (max-width: 940px) {
      .design-toolbar-copy { display: block; }
      .controls-sub { max-width: none; text-align: left; }
      .design-toolbar-controls { grid-template-columns: 1fr; }
      .design-toolbar-controls.has-orientation { grid-template-columns: 1fr; }
      .workbench {
        --workspace-stage-height: clamp(400px, 66vh, 560px);
        grid-template-columns: 1fr;
      }
      .editor-card { order: 1; }
      .preview-card { order: 2; position: static; min-height: 0; }
    }

    @media (max-width: 780px) {
      .editor-selection-row { grid-template-columns: 1fr; }
      .editor-field-label-color { min-width: 0; }
    }

    @media (min-width: 621px) and (hover: hover) and (pointer: fine) {
      .editor-emoji-picker { display: block; }
    }

    @media (max-width: 620px) {
      .topbar, .page { width: min(100% - 28px, 560px); }
      .topbar { height: 72px; }
      .back-link span:last-child { display: none; }
      .page {
        width: auto;
        max-width: 560px;
        margin-left: max(14px, var(--ww-safe-left));
        margin-right: max(14px, var(--ww-safe-right));
        padding: 38px 0 max(50px, calc(34px + var(--ww-safe-bottom)));
      }
      .intro { margin-bottom: 25px; }
      .intro-copy { font-size: 15px; }
      .workspace-tools { padding: 12px; border-radius: 16px; }
      .workbench { --workspace-stage-height: clamp(340px, 92vw, 470px); }
      .preview-card, .editor-card { padding: 20px; border-radius: 21px; }
      .order-actions .primary-button,
      .secondary-button {
        width: 100%;
        min-width: 0;
      }
      .order-actions {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        justify-content: stretch;
        gap: 8px;
      }
      .order-actions .continue-button { grid-column: 1 / -1; }
      .order-actions button { padding-inline: 10px; overflow-wrap: anywhere; }
      .design-toolbar { padding: 14px 0 16px; }
      .preview-head { align-items: center; }
      .mug-stage { height: var(--workspace-stage-height); min-height: 0; margin: 16px -20px 0; padding: 6px 14px 18px; gap: 22px; }
      .mug-viewer { height: min(270px, calc(var(--workspace-stage-height) - 44px)); }
      .mug-name { margin-top: 0; font-size: 11px; }
      .preview-disclaimer { max-width: 300px; margin-top: 7px; font-size: 10.5px; }
      .surface-editor { align-items: center; flex-direction: row; }
      .surface-tabs { width: auto; }
      .surface-tab { flex: 0 0 auto; }
      .surface-copy { width: auto; }
      .editor-toolbar { align-items: flex-start; }
      .editor-tools { flex-wrap: wrap; }
      .editor-actions { justify-content: flex-start; }
      .editor-button { min-height: var(--ww-touch-target); }
      .editor-icon-button { width: var(--ww-touch-target); }
      .editor-motif-menu { width: min(350px, calc(100vw - 70px)); }
      .editor-motif-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 5px; }
      .editor-selection-row { grid-template-columns: 1fr; }
      .editor-field-label-color { min-width: 0; }
      .editor-text-input,
      .editor-font-toggle { height: var(--ww-touch-target); font-size: 16px; }
      .editor-style-button { width: var(--ww-touch-target); height: var(--ww-touch-target); }
      .editor-font-controls { align-items: stretch; flex-wrap: wrap; }
      .editor-font-picker { flex-basis: 100%; }
      .editor-actions .editor-button { flex: 1 1 calc(33.333% - 6px); }
      .selected-product { grid-template-columns: 52px minmax(0, 1fr); }
      .selected-product-thumb { width: 52px; height: 52px; }
      .product-change { grid-column: 1 / -1; width: 100%; }
      .product-change,
      .surface-tab,
      .surface-copy,
      .product-dialog-close,
      .custom-color-add { min-height: var(--ww-touch-target); }
      .product-dialog-close { min-width: var(--ww-touch-target); }
      .custom-color-item { grid-template-columns: var(--ww-touch-target) minmax(0, 1fr) var(--ww-touch-target); }
      .custom-color-input,
      .custom-color-remove { width: var(--ww-touch-target); height: var(--ww-touch-target); }
      .order-edit,
      .order-remove { min-width: var(--ww-touch-target); min-height: var(--ww-touch-target); }
      .product-dialog { width: min(100% - 20px, 560px); max-height: calc(100vh - 20px); border-radius: 20px; }
      .product-dialog-head,
      .product-dialog-body,
      .product-dialog-footer { padding-inline: 18px; }
      .product-options, .variant-options { grid-template-columns: 1fr; }
      .option-grid { grid-template-columns: 1fr; }
      .option-card { min-height: 76px; }
    }
  </style>
  <link rel="stylesheet" href="<%= asset('/site-header.css') %>" />
  <link rel="stylesheet" href="<%= asset('/mobile-foundation.css') %>" />
  <link rel="stylesheet" href="<%= asset('/configurator-workspace.css') %>" />
  <script src="<%= asset('/js/site-header.js') %>" defer></script>
  <script src="<%= asset('/js/mobile-ui.js') %>" defer></script>
</head>
<body>
  <%- include('partials/site-header') %>

  <main class="page">
    <div class="loading" id="loading">Eure Wortwolke wird vorbereitet&hellip;</div>

    <div class="config-content" id="config-content" hidden>
      <section class="intro">
        <p class="eyebrow" id="config-eyebrow">Eure Worte. Eure Erinnerung.</p>
        <h1 id="config-title">Gestaltet eure Erinnerung.</h1>
        <p class="intro-copy" id="config-intro">Wählt Produkt und Farbwelt. Menge und Lieferadresse entscheidet ihr im nächsten Schritt.</p>
      </section>

      <div class="config-studio">
        <section class="design-toolbar" aria-labelledby="controls-title">
          <div class="design-toolbar-copy">
            <h2 id="controls-title">Euer Design</h2>
          </div>

          <div class="design-toolbar-controls">
            <div class="selected-product toolbar-product" id="selected-product">
              <img class="selected-product-thumb" id="selected-product-thumb" alt="" />
              <span class="selected-product-copy">
                <strong id="selected-product-name">Weiße Tasse</strong>
                <span id="selected-product-detail">11 oz · 325 ml</span>
              </span>
              <button class="product-change" id="change-product" type="button">Produkt ändern</button>
            </div>

            <div class="toolbar-menu" id="orientation-step" hidden>
              <button class="toolbar-summary" type="button" data-panel-trigger="orientation-panel" aria-haspopup="dialog" aria-expanded="false" aria-controls="orientation-panel">
                <span>
                  <span class="toolbar-kicker">Ausrichtung</span>
                  <strong id="selected-orientation-name">Hochformat</strong>
                </span>
                <span class="toolbar-summary-detail" id="selected-orientation-detail">Vertikal</span>
              </button>
              <dialog class="config-panel" id="orientation-panel" aria-labelledby="orientation-panel-title">
                <div class="config-panel-head"><h2 id="orientation-panel-title" tabindex="-1">Ausrichtung</h2><button type="button" class="config-panel-close" data-panel-close aria-label="Schließen">×</button></div>
                <div class="config-panel-body">
                <div class="option-grid orientation-grid" id="orientation-options"></div>
                </div>
              </dialog>
            </div>

            <div class="toolbar-menu" id="theme-step">
              <button class="toolbar-summary" type="button" data-panel-trigger="theme-panel" aria-haspopup="dialog" aria-expanded="false" aria-controls="theme-panel">
                <span>
                  <span class="toolbar-kicker">Farbwelt</span>
                  <strong id="selected-theme-name">Farbwelt wählen</strong>
                </span>
                <span class="swatches toolbar-theme-swatches" id="selected-theme-swatches" aria-hidden="true"></span>
              </button>
              <dialog class="config-panel" id="theme-panel" aria-labelledby="theme-panel-title">
                <div class="config-panel-head"><h2 id="theme-panel-title" tabindex="-1">Farbwelt</h2><button type="button" class="config-panel-close" data-panel-close aria-label="Schließen">×</button></div>
                <div class="config-panel-body">
                <div class="option-grid" id="theme-options"></div>
                <div class="custom-palette-panel" id="custom-palette-panel" hidden>
                  <div class="custom-palette-head">
                    <div class="custom-palette-copy">
                      <strong>Eure Farben</strong>
                      <span>So viele oder wenige, wie ihr möchtet.</span>
                    </div>
                    <button class="custom-color-add" id="custom-color-add" type="button">＋ Farbe</button>
                  </div>
                  <div class="custom-color-list" id="custom-color-list"></div>
                  <p class="custom-palette-note">Die Farben werden gleichmäßig auf eure Wörter verteilt. Einzelne Wörter könnt ihr unten auf der Druckfläche weiterhin separat ändern.</p>
                </div>
                </div>
              </dialog>
            </div>


          </div>
        </section>

        <section class="workspace-tools" aria-label="Werkzeuge für die Gestaltung">
              <%- include('partials/editor-symbols') %>
              <div class="editor-toolbar" aria-label="Werkzeuge für die Druckfläche">
                  <div class="surface-editor" id="surface-editor" hidden>
                    <div class="surface-tabs" id="surface-tabs" role="tablist" aria-label="Druckseite wählen"></div>
                    <button class="surface-copy" id="surface-copy" type="button" hidden>Vorderseite übernehmen</button>
                  </div>
                <div class="editor-tools editor-tools-primary" role="group" aria-label="Element hinzufügen">
                  <%- include('partials/editor-action', { action: { id: 'editor-add', icon: 'type', label: 'Wort hinzufügen', primary: true } }) %>
                  <div class="editor-emoji-picker" id="editor-emoji-picker">
                    <%- include('partials/editor-action', { action: { id: 'editor-emoji-toggle', icon: 'face-slightly-smiling', label: 'Emoji hinzufügen', primary: true } }) %>
                  </div>
                  <div class="editor-motif-picker" hidden>
                    <%- include('partials/editor-action', { action: { id: 'editor-icon-toggle', icon: 'sparkles', label: 'Motiv hinzufügen', primary: true, controls: 'editor-icon-menu' } }) %>
                    <div class="editor-motif-menu" id="editor-icon-menu" role="dialog" aria-label="Motiv auswählen" hidden>
                      <strong class="editor-motif-title">Welches Motiv möchtet ihr hinzufügen?</strong>
                      <div class="editor-motif-grid" id="editor-icon-grid"></div>
                    </div>
                  </div>
                  <%- include('partials/editor-action', { action: { id: 'editor-image', icon: 'image-plus', label: 'Bild hinzufügen', primary: true } }) %>
                  <input id="editor-image-input" type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" aria-label="Bild auswählen" hidden />
                </div>
                <div class="editor-tools editor-tools-separated editor-tools-selection" role="group" aria-label="Auswahl">
                  <%- include('partials/editor-action', { action: { id: 'editor-select-all', icon: 'scan', label: 'Alles auswählen' } }) %>
                </div>
                <div class="editor-tools editor-tools-separated editor-tools-history" role="group" aria-label="Verlauf">
                  <%- include('partials/editor-action', { action: { id: 'editor-undo', icon: 'undo-2', label: 'Rückgängig', disabled: true } }) %>
                  <%- include('partials/editor-action', { action: { id: 'editor-redo', icon: 'redo-2', label: 'Wiederholen', disabled: true } }) %>
                </div>
                <div class="editor-tools editor-tools-view" role="group" aria-label="Ansicht">
                  <%- include('partials/editor-action', { action: { id: 'editor-zoom-out', icon: 'zoom-out', label: 'Ansicht verkleinern' } }) %>
                  <span class="editor-zoom-label" id="editor-zoom-label">100 %</span>
                  <%- include('partials/editor-action', { action: { id: 'editor-zoom-in', icon: 'zoom-in', label: 'Ansicht vergrößern' } }) %>
                </div>
                <div class="editor-tools editor-tools-separated editor-tools-reset" role="group" aria-label="Design zurücksetzen">
                  <%- include('partials/editor-action', { action: { id: 'editor-reset', icon: 'refresh-cw', label: 'Design zurücksetzen', controls: 'editor-reset-panel' } }) %>
                </div>
              </div>
              <div id="editor-desktop-inspector">
              <div class="editor-selection" id="editor-selection" aria-label="Werkzeuge für das ausgewählte Element" tabindex="-1">
                <div class="editor-selection-head">
                  <strong class="editor-selection-status" id="editor-selection-status" aria-live="polite" aria-atomic="true">Element auswählen</strong>
                  <span class="editor-selection-hint" id="editor-selection-hint">Element anklicken oder Auswahlrahmen ziehen · ⌘/Strg-Klick wählt mehrere</span>
                </div>
                <div class="editor-dock" aria-label="Werkzeuge für das ausgewählte Element">
                  <% for (const [tool, icon, label] of [['text', 'type', 'Text'], ['font', 'case-sensitive', 'Schrift'], ['color', 'palette', 'Farbe'], ['transform', 'sliders-horizontal', 'Anpassen']]) { %>
                  <button type="button" class="editor-button" data-editor-tool="<%= tool %>" aria-haspopup="dialog" aria-controls="editor-tool-panel" disabled>
                    <svg class="editor-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><use href="#editor-icon-<%= icon %>"></use></svg>
                    <span data-editor-tool-label><%= label %></span>
                  </button>
                  <% } %>
                </div>
                <div class="editor-properties" id="editor-properties">
                <div class="editor-selection-row">
                  <label class="editor-field-label" data-editor-section="text"><span class="editor-field-label-text" id="editor-text-label">Ausgewähltes Element</span>
                    <input class="editor-text-input" id="editor-text" type="text" maxlength="1024" autocomplete="off" placeholder="Wort auswählen" disabled />
                  </label>
                  <div class="editor-field-label editor-field-label-font" data-editor-section="font">
                    <span class="editor-field-label-text">Schriftart</span>
                    <div class="editor-font-controls">
                      <div class="editor-font-picker" id="editor-font-picker">
                        <button class="editor-font-toggle" id="editor-font-toggle" type="button" aria-label="Schriftart wählen" aria-haspopup="listbox" aria-expanded="false" aria-controls="editor-font-menu" disabled>
                          <span class="editor-font-current" id="editor-font-current">Schrift wählen</span>
                          <span class="editor-font-caret" aria-hidden="true">⌄</span>
                        </button>
                        <div class="editor-font-menu" id="editor-font-menu" role="listbox" aria-label="Schriftart" hidden></div>
                      </div>
                      <div class="editor-style-group" role="group" aria-label="Text formatieren">
                        <button class="editor-style-button" id="editor-bold" type="button" aria-label="Fett" aria-pressed="false" data-editor-tooltip disabled><strong aria-hidden="true">B</strong></button>
                        <button class="editor-style-button editor-style-italic" id="editor-italic" type="button" aria-label="Kursiv" aria-pressed="false" data-editor-tooltip disabled><span aria-hidden="true">I</span></button>
                        <button class="editor-style-button editor-style-underline" id="editor-underline" type="button" aria-label="Unterstrichen" aria-pressed="false" data-editor-tooltip disabled><span aria-hidden="true">U</span></button>
                        <button class="editor-style-button editor-style-linethrough" id="editor-linethrough" type="button" aria-label="Durchgestrichen" aria-pressed="false" data-editor-tooltip disabled><span aria-hidden="true">S</span></button>
                      </div>
                    </div>
                  </div>
                  <div class="editor-field-label editor-field-label-color" data-editor-section="color" role="group" aria-label="Farbe auswählen">
                    <div class="editor-colors">
                      <div class="editor-swatches" id="editor-swatches"></div>
                      <input class="editor-color-input" id="editor-color" type="color" aria-label="Eigene Farbe wählen" disabled />
                    </div>
                  </div>
                </div>
                <div class="editor-actions" data-editor-section="transform">
                  <%- include('partials/editor-action', { action: { id: 'editor-smaller', icon: 'shrink', label: 'Element verkleinern', disabled: true } }) %>
                  <%- include('partials/editor-action', { action: { id: 'editor-larger', icon: 'expand', label: 'Element vergrößern', disabled: true } }) %>
                  <%- include('partials/editor-action', { action: { id: 'editor-rotate-left', icon: 'rotate-ccw-square', label: 'Nach links drehen', disabled: true } }) %>
