        iconButton: document.getElementById('editor-icon-toggle'),
        iconMenu: document.getElementById('editor-icon-menu'),
        iconGrid: document.getElementById('editor-icon-grid'),
        resetButton: document.getElementById('editor-reset'),
        selectAllButton: document.getElementById('editor-select-all'),
        undoButton: document.getElementById('editor-undo'),
        redoButton: document.getElementById('editor-redo'),
        zoomOutButton: document.getElementById('editor-zoom-out'),
        zoomInButton: document.getElementById('editor-zoom-in'),
        smallerButton: document.getElementById('editor-smaller'),
        largerButton: document.getElementById('editor-larger'),
        rotateLeftButton: document.getElementById('editor-rotate-left'),
        rotateRightButton: document.getElementById('editor-rotate-right'),
        duplicateButton: document.getElementById('editor-duplicate'),
        bringFrontButton: document.getElementById('editor-bring-front'),
        deleteButton: document.getElementById('editor-delete'),
        printWidth: view.printFile.width,
        printHeight: view.printFile.height,
        printFileDpi: view.printFile.dpi,
        safeMargin: product.designSafeMargin,
        safeArea: view.safeArea,
        defaultX: defaultSlot.x + (defaultSlot.width || defaultSlot.side) / 2,
        defaultY: defaultSlot.y + (defaultSlot.height || defaultSlot.side) / 2,
        palette: getPalette(selectedTheme).colors,
        onSelectionChange: (capabilities) => workspace.updateSelection(capabilities),
        openTextEditor: () => workspace.openTextEditor(),
        onChange: () => {
          markDirty();
          renderAll();
        },
        onReset: () => workspace.requestReset(() => {
          // Capture the current canvas before replacing it. Reset adds just one
          // history step and leaves the other print side and palette intact.
          mugEditor.recordHistory();
          mugEditor.setDesign(buildAutomaticDesign(), { record: true });
          mugEditor.setFeedback('Automatische Wortwolke wiederhergestellt');
          markDirty();
        }),
      });
      mugEditor.setDesign(buildAutomaticDesign(), { resetHistory: true });
      resetSurfaceStates(mugEditor.getState());
      if (!configuratorEmojiPicker) {
        configuratorEmojiPicker = WolkenworteEmojiPicker.create({
          trigger: document.getElementById('editor-emoji-toggle'),
          mount: document.getElementById('editor-emoji-picker'),
          idPrefix: 'editor-emoji',
          placement: 'below-left',
          mediaQuery: configuratorEmojiPickerMedia,
          catalogUrl: EMOJI_CATALOG_URL,
          searchIndexUrls: EMOJI_SEARCH_INDEX_URLS,
          onOpen: () => {
            mugEditor.closeIconPicker();
            mugEditor.closeFontPicker();
          },
          onSelect: (emoji) => mugEditor.addEmoji(emoji),
          onError: () => mugEditor.setFeedback('Das Emoji konnte nicht geladen werden.'),
        });
      }
    }

    window.addEventListener('resize', () => {
      refreshWorkspaceLayout();
      renderAll();
    });

    async function saveCurrentDesign(activeButton) {
      if (restorationFailed || !workspaceReady || orderActionPending) return false;
      orderActionPending = true;
      setOrderActionsBusy(true, activeButton);
      try {
        await finalizeCurrentText();
        return await approveCurrentDesign();
      } catch (error) {
        console.warn('Configurator save preparation failed.', error);
        setText(errorText, 'Das Design konnte nicht gespeichert werden. Bitte versucht es erneut.');
        return false;
      } finally {
        orderActionPending = false;
        setOrderActionsBusy(false);
      }
    }

    async function approveCurrentDesign() {
      if (!currentDesignNeedsSave) return true;
      // Check tab storage before creating a server snapshot.
      try { cart.write(cart.read()); }
      catch {
        setText(errorText, 'Der Warenkorb konnte in diesem Browser nicht gesichert werden. Bitte erlaubt das Speichern von Websitedaten.');
        return false;
      }
      if (!editingOrderItemId && loadOrderItems().length >= WolkenworteConfiguratorSession.MAX_CART_ITEMS) {
        setText(errorText, 'Euer Warenkorb enthält bereits 20 Designs. Entfernt zuerst ein Design.');
        return false;
      }
      const designs = getAllSurfaceDesigns();
      if (Object.values(designs).some(design => design.length > CloudLimits.MAX_DESIGN_ELEMENTS)) {
        setText(errorText, 'Pro Druckfläche sind höchstens {{count}} Elemente möglich. Entfernt zuerst einige Elemente.',
          { count: CloudLimits.MAX_DESIGN_ELEMENTS });
        return false;
      }
      const missingSurface = productSurfaces().find((surface) => !designs[surface.key]?.length);
      if (missingSurface) {
        setText(errorText, productSurfaces().length > 1
          ? 'Gestaltet bitte auch die {{item}}.' : 'Fügt mindestens ein Wort, Motiv oder Bild zu eurem Design hinzu.',
          { item: t(missingSurface.label) });
        return false;
      }
      const uploadedImages = new Set(Object.values(designs).flat()
        .filter((item) => item.type === 'image').map((item) => item.src));
      if (uploadedImages.size > 4) {
        setText(errorText, 'Verwendet bitte höchstens vier verschiedene Bilder pro Design.');
        return false;
      }
      clearText(errorText);
      try {
        const previousId = editingOrderItemId;
        const revision = designRevision;
        let data = pendingConfiguration?.revision === revision ? pendingConfiguration.data : null;
        if (!data) {
          const response = await fetch(`/api/events/${encodeURIComponent(slug)}/configurations`, {
            method: 'POST', signal: AbortSignal.timeout(15000),
            headers: { 'Content-Type': 'application/json', 'X-Wolkenworte-Guest-Id': guestId },
            body: JSON.stringify({ productKey: product.key, orientation: selectedOrientation,
              theme: selectedTheme, words, designs }),
          });
          data = await response.json();
          if (!response.ok) throw new Error(data.error || 'save_failed');
          pendingConfiguration = { revision, data };
        }
        addOrderItem(data, { replaceId: previousId });
        try {
          WolkenworteConfiguratorSession.createShippingDraft(slug, sessionStorage)
            .replaceConfiguration(previousId, data.id);
        } catch { /* Quantity drafts do not authorize checkout. */ }
        editingOrderItemId = data.id;
        currentDesignNeedsSave = revision !== designRevision;
        currentDesignEdited = currentDesignNeedsSave;
        pendingConfiguration = null;
        history.replaceState(null, '', `/e/${encodeURIComponent(slug)}/configure?edit=${encodeURIComponent(data.id)}`);
        renderOrderBox();
        return !currentDesignNeedsSave;
      } catch (error) {
        console.warn('Configurator save failed.', error);
        setText(errorText, 'Das Design konnte nicht gespeichert werden. Bitte versucht es erneut.');
        return false;
      }
    }

    function saveBeforeLeaving(event) {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (event.currentTarget.target && event.currentTarget.target !== '_self') return;
      if (!mugEditor || !product) return;
      const destination = event.currentTarget.href;
      event.preventDefault();
      return runNavigation(() => {
        allowNavigation = true;
        location.assign(destination);
      });
    }

    [brandLink, backLink].forEach((link) => link.addEventListener('click', saveBeforeLeaving));
    document.querySelectorAll('a[href="/datenschutz"], a[href="/impressum"]').forEach((link) => {
      link.addEventListener('click', saveBeforeLeaving);
    });
    saveDesignButton.addEventListener('click', () => {
      if (!leavingPage) void saveCurrentDesign(saveDesignButton);
    });
    designAnotherButton.addEventListener('click', () => runNavigation(() => {
      startingAnotherProduct = true;
      openProductDialog();
    }, { onlyIfEdited: true }));
    continueOrderButton.addEventListener('click', () =>
      runNavigation(navigateToShipping, { shipping: true }));

    window.addEventListener('pagehide', destroyMug3D);
    window.addEventListener('beforeunload', (event) => {
      if (!hasUnsavedDesign() || allowNavigation) return;
      event.preventDefault();
      event.returnValue = '';
    });
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      allowNavigation = false;
      leavingPage = false;
      orderActionPending = false;
      content.inert = false;
      if (leaveDialog.open) leaveDialog.close('cancel');
      // A history entry reloads its exact approved snapshot; a fresh entry
      // reloads current cloud words. Never resurrect a discarded in-memory draft.
      if (workspaceReady) { allowNavigation = true; location.reload(); return; }
      setOrderActionsBusy(false);
      void initMug3D();
    });

    function refreshLocalizedConfigurator() {
      if (!product || !products.length) return;
      buildProductOptions();
      buildOrientationOptions();
      buildThemeOptions();
      renderCustomColorControls();
      renderOrderBox();
      updateProductPresentation();
    }

    window.addEventListener('wolkenworte:localechange', refreshLocalizedConfigurator);

    fetch(`/api/events/${encodeURIComponent(slug)}/configurator`, { signal: AbortSignal.timeout(15000) })
      .then(async (response) => {
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'load_failed');
        return data;
      })
      .then(async (data) => {
        await WolkenworteI18n.useEventLocale(data.event.locale);
        WolkenworteJourney.remember(slug, data.event.title, true);
        words = data.words;
        liveWords = data.words;
        products = Array.isArray(data.products) && data.products.length ? data.products : [data.product];
        product = products.find((candidate) => candidate.key === data.product?.key) || products[0];
        selectedOrientation = product.defaultOrientation || 'default';
        productFamilies = Array.isArray(data.productFamilies) && data.productFamilies.length
          ? data.productFamilies.filter((family) => products.some((candidate) => candidate.familyKey === family.key))
          : [...new Set(products.map((candidate) => candidate.familyKey))].map((familyKey) => {
              const candidate = products.find((item) => item.familyKey === familyKey);
              return {
                key: familyKey,
                label: candidate.displayName,
                description: candidate.description,
                thumbnail: candidate.thumbnail,
              };
            });
        selectedFamilyKey = product.familyKey;
        const customPalette = product.themes.find((option) => option.key === 'custom');
        customColors = customPalette ? [...customPalette.colors] : ['#c2185b'];
        let preferredPalette = '';
        try { preferredPalette = localStorage.getItem(paletteStorageKey) || ''; } catch {}
        selectedTheme = product.themes.some((option) => option.key === preferredPalette && option.key !== 'custom')
          ? preferredPalette
          : product.themes[0].key;
        buildProductOptions();
        buildOrientationOptions();
        buildThemeOptions();
        renderCustomColorControls();

        setText(document.querySelector('title'), 'Erinnerung für {{name}} gestalten – Wolkenworte', {
          name: data.event.title,
        });
        updateProductPresentation();

        await WolkenworteConfiguratorSession.withTimeout(ensureDesignFonts([DesignFonts.DEFAULT_FONT_KEY]));
        await WolkenworteConfiguratorSession.withTimeout(WolkenworteEmoji.preloadTexts(words.map(([word]) => word)));
        loading.hidden = true;
        content.hidden = false;
        await initializeWorkspace();
      })
      .catch((error) => {
        content.inert = false;
        loading.hidden = false;
        setText(loading, error.message === 'no_words'
          ? 'Für diese Wortwolke wurden noch keine Wörter gesammelt.'
          : 'Der Konfigurator konnte nicht geladen werden.');
      });

    function showRestorationError(error) {
      console.warn('Configurator restoration failed.', error);
      restorationFailed = true;
      retryConfigurator.hidden = false;
      setText(errorText, 'Das gespeicherte Design konnte nicht geladen werden. Bitte versucht es erneut.');
      updateCartActions();
    }

    async function initializeWorkspace() {
      content.inert = true;
      suppressDirty = true;
      try {
        cart.read();
        initEditor();
        mugEditor.flushPendingChange();
        void initMug3D();
        const query = new URLSearchParams(location.search);
        const requestedEdit = query.get('edit');
        if (requestedEdit) await loadOrderItem(requestedEdit);
        else if (query.has('cart')) {
          const basket = cart.read();
          if (basket.length) {
            const id = basket[basket.length - 1].id;
            await loadOrderItem(id);
            history.replaceState(null, '', `/e/${encodeURIComponent(slug)}/configure?edit=${encodeURIComponent(id)}`);
          }
        }
        // No edit parameter always means the current live cloud, never a draft.
        workspaceReady = true;
        if (query.has('cart')) {
          orderBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } catch (error) {
        showRestorationError(error);
      } finally {
        suppressDirty = false;
        orderActionPending = false;
        content.inert = false;
        setOrderActionsBusy(false);
        renderOrderBox();
        refreshWorkspaceLayout();
        renderAll();
      }
    }
  </script>
</body>
</html>
