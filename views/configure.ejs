<!DOCTYPE html>
<html lang="<%= locale %>" data-theme="pastel" data-locale-source="<%= localeSource %>" data-locale-catalog-url="<%= localeCatalogUrl %>" data-locale-catalog-urls="<%= JSON.stringify(localeCatalogUrls) %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#fffdfa" />
  <meta name="description" content="<%= t('Eure Worte. Eure Erinnerung.') %>" data-i18n-content-source="Eure Worte. Eure Erinnerung." />
  <link rel="icon" type="image/svg+xml" href="<%= asset('/z_icons/icon.svg') %>" />
  <%- include('partials/site-fonts') %>
  <link rel="stylesheet" href="<%= asset('/i18n.css') %>" />
  <link rel="stylesheet" href="<%= asset('/action-state.css') %>" />
  <link rel="stylesheet" href="<%= asset('/emoji-picker.css') %>" />
  <script src="<%= asset('/js/i18n.js') %>"></script>
  <script src="<%= asset('/js/action-state.js') %>"></script>
  <title data-i18n-source="Erinnerung gestalten – Wolkenworte"><%= t('Erinnerung gestalten – Wolkenworte') %></title>
  <style>

    @font-face {
      font-family: 'Wolkenworte Classic';
      src: url('<%= asset('/assets/design-fonts/gelasio/Gelasio-Bold.ttf') %>') format('truetype');
      font-style: normal;
      font-weight: 700;
      font-display: swap;
    }
    @font-face {
      font-family: 'Wolkenworte Lora';
      src: url('<%= asset('/assets/design-fonts/lora/Lora.ttf') %>') format('truetype');
      font-style: normal;
      font-weight: 400;
      font-display: swap;
    }
    @font-face {
      font-family: 'Wolkenworte Lora';
      src: url('<%= asset('/assets/design-fonts/lora/Lora-Bold.ttf') %>') format('truetype');
      font-style: normal;
      font-weight: 700;
      font-display: swap;
    }
    @font-face {
      font-family: 'Wolkenworte Montserrat';
      src: url('<%= asset('/assets/design-fonts/montserrat/Montserrat.ttf') %>') format('truetype');
      font-style: normal;
      font-weight: 400;
      font-display: swap;
    }
    @font-face {
      font-family: 'Wolkenworte Montserrat';
      src: url('<%= asset('/assets/design-fonts/montserrat/Montserrat-Bold.ttf') %>') format('truetype');
      font-style: normal;
      font-weight: 700;
      font-display: swap;
    }
    @font-face {
      font-family: 'Wolkenworte Caveat';
      src: url('<%= asset('/assets/design-fonts/caveat/Caveat.ttf') %>') format('truetype');
      font-style: normal;
      font-weight: 400;
      font-display: swap;
    }
    @font-face {
      font-family: 'Wolkenworte Caveat';
      src: url('<%= asset('/assets/design-fonts/caveat/Caveat-Bold.ttf') %>') format('truetype');
      font-style: normal;
      font-weight: 700;
      font-display: swap;
    }
    @font-face {
      font-family: 'Wolkenworte Baloo 2';
      src: url('<%= asset('/assets/design-fonts/baloo-2/Baloo2.ttf') %>') format('truetype');
      font-style: normal;
      font-weight: 400;
      font-display: swap;
    }
    @font-face {
      font-family: 'Wolkenworte Baloo 2';
      src: url('<%= asset('/assets/design-fonts/baloo-2/Baloo2-Bold.ttf') %>') format('truetype');
      font-style: normal;
      font-weight: 700;
      font-display: swap;
    }

    :root {
      --ink: #400f26;
      --berry: #9c1c4c;
      --berry-dark: #731437;
      --rose: #d1607e;
      --gold: #c1922f;
      --muted: #8a7178;
      --paper: #fffdfa;
      --cream: #f8f0e5;
      --line: rgba(64, 15, 38, .1);
      --shadow: 0 24px 60px rgba(64, 15, 38, .08);
      --success: #39735f;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { min-height: 100%; background: var(--paper); }
    body {
      min-height: 100vh;
      margin: 0;
      color: var(--ink);
      background: var(--paper);
      font-family: 'Jost', 'Wolkenworte Jost Fallback', system-ui, sans-serif;
    }

    button, input { font: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }
    a { color: inherit; text-decoration: none; }

    .topbar {
      width: min(1120px, calc(100% - 48px));
      height: 84px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      font-family: 'Playfair Display', 'Wolkenworte Playfair Fallback', Georgia, serif;
      font-size: 21px;
      font-weight: 600;
    }
    .brand-icon { width: 32px; height: 30px; object-fit: contain; }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 14px;
      transition: color .2s;
    }
    .back-link:hover { color: var(--berry); }

    .page {
      width: min(1280px, calc(100% - 48px));
      margin: 0 auto;
      padding: 54px 0 80px;
    }

    .intro { margin-bottom: 38px; }
    .eyebrow {
      margin: 0 0 12px;
      color: var(--gold);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .2em;
      text-transform: uppercase;
    }
    h1 {
      margin: 0;
      font-family: 'Playfair Display', 'Wolkenworte Playfair Fallback', Georgia, serif;
      font-size: clamp(38px, 5vw, 62px);
      font-weight: 500;
      line-height: 1.06;
      letter-spacing: -.045em;
    }
    .intro h1 { max-width: 720px; }
    .intro-copy {
      margin: 18px 0 0;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.7;
    }

    .config-studio {
      display: grid;
      gap: 24px;
    }

    .workspace-tools {
      position: relative;
      z-index: 20;
      padding: 13px 15px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(255, 254, 252, .88);
      box-shadow: 0 14px 36px rgba(64, 15, 38, .055);
      backdrop-filter: blur(12px);
    }

    .workbench {
      --workspace-stage-height: clamp(440px, 58vh, 600px);
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
      align-items: stretch;
    }

    .preview-card,
    .editor-card {
      min-width: 0;
      padding: 30px;
      display: flex;
      flex-direction: column;
      background: rgba(255, 254, 252, .88);
      border: 1px solid var(--line);
      border-radius: 28px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(12px);
    }

    .preview-card {
      overflow: hidden;
      position: relative;
    }

    .editor-card {
      overflow: visible;
    }

    .checkout-panel {
      display: grid;
      gap: 12px;
    }

    .preview-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
    }
    .preview-head h2,
    .editor-title,
    .design-toolbar h2 {
      margin: 0;
      font-family: 'Playfair Display', 'Wolkenworte Playfair Fallback', Georgia, serif;
      font-size: 25px;
      font-weight: 500;
    }
    .editor-title { margin-bottom: 16px; }
    .mug-stage {
      height: var(--workspace-stage-height);
      min-height: 0;
      margin: 16px -30px 0;
      padding: 8px 38px 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: clamp(20px, 4vw, 54px);
      position: relative;
    }
    .mug-stage.is-flat-product {
      padding: 4px 8px 12px;
    }

    .mug-wrap {
      width: min(100%, 560px);
      position: relative;
      z-index: 1;
      text-align: center;
    }
    .mug-stage.is-flat-product .mug-wrap {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 0;
    }
    .mug-viewer {
      width: 100%;
      height: min(350px, calc(var(--workspace-stage-height) - 48px));
      position: relative;
      cursor: grab;
      touch-action: none;
      user-select: none;
    }
    .mug-viewer:active { cursor: grabbing; }
    .mug-viewer:focus-visible { outline: 3px solid rgba(156, 28, 76, .2); outline-offset: 3px; border-radius: 24px; }
    .mug-viewer > canvas {
      width: 100%;
      height: 100%;
      display: block;
      position: relative;
      z-index: 1;
    }
    .mug-preview-state {
      position: absolute;
      inset: 0;
      display: grid;
      place-content: center;
      justify-items: center;
      gap: 14px;
      padding: 20px;
      color: var(--muted);
      cursor: default;
    }
    .mug-preview-state[hidden], .mug-preview-state button[hidden], .mug-name[hidden], #retry-configurator[hidden] { display: none; }
    .mug-viewer:not(.is-ready) > canvas { visibility: hidden; }
    .flat-product-preview {
      display: none;
      position: relative;
      width: var(--flat-preview-width, 292px);
      height: var(--flat-preview-height, 292px);
      aspect-ratio: var(--flat-preview-aspect, 1);
      overflow: hidden;
      border: 1px solid rgba(77, 51, 54, .16);
      border-radius: 5px;
      background: #fff;
      box-shadow: 0 24px 42px rgba(74, 34, 43, .16), 0 5px 12px rgba(74, 34, 43, .08);
    }
    .mug-viewer.is-flat {
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: default;
      touch-action: auto;
    }
    .mug-stage.is-flat-product .mug-viewer {
      width: 100%;
      height: auto;
      min-height: 0;
      flex: 1;
    }
    .mug-stage.is-flat-product .mug-name {
      flex: 0 0 auto;
      margin-top: 7px;
      line-height: 1.35;
    }
    .mug-viewer.is-flat .mug-preview-state { display: none; }
    .mug-viewer.is-flat .flat-product-preview { display: block; }
    .flat-product-preview.is-coaster {
      border-radius: 18px;
      box-shadow: 0 18px 34px rgba(74, 34, 43, .15), 7px 9px 0 #b99064;
    }
    .flat-product-preview.is-framed {
      border-radius: 2px;
      box-shadow:
        0 0 0 12px #201d1d,
        0 25px 45px rgba(36, 24, 27, .22),
        0 5px 12px rgba(36, 24, 27, .14);
    }
    .flat-product-preview.is-tote {
      margin-top: 28px;
      overflow: visible;
      border-radius: 5px 5px 22px 22px;
      box-shadow: 0 22px 38px rgba(74, 34, 43, .17);
    }
    .flat-product-preview.is-tote::before {
      content: '';
      position: absolute;
      z-index: 0;
      width: 38%;
      height: 30%;
      left: 31%;
      top: -22%;
      box-sizing: border-box;
      border: 9px solid #2b2725;
      border-bottom: 0;
      border-radius: 48% 48% 0 0;
    }
    .flat-product-preview.is-blanket {
      border-radius: 14px;
      background: #f8f5f0;
      box-shadow: 0 22px 38px rgba(74, 34, 43, .17), inset 0 0 18px rgba(87, 63, 58, .08);
    }
    .flat-product-preview.is-blanket::after {
      content: '';
      position: absolute;
      z-index: 2;
      right: -1px;
      bottom: -1px;
      width: 17%;
      aspect-ratio: 1;
      border-radius: 100% 0 12px 0;
      background: linear-gradient(135deg, rgba(226, 218, 207, .2), #e6ded3 64%, #f8f5f0 65%);
      box-shadow: -4px -4px 9px rgba(80, 58, 55, .08);
    }
    .flat-product-preview.is-notebook {
      overflow: visible;
      border-radius: 3px 10px 10px 3px;
      box-shadow: 9px 12px 0 #e7e2db, 0 24px 38px rgba(74, 34, 43, .17);
    }
    .flat-product-preview.is-notebook::before {
      content: '';
      position: absolute;
      z-index: 2;
      left: -8px;
      top: 5%;
      width: 15px;
      height: 90%;
      background: repeating-linear-gradient(
        to bottom,
        transparent 0 7px,
        #575450 7px 10px,
        transparent 10px 16px
      );
      filter: drop-shadow(1px 1px 1px rgba(49, 42, 39, .18));
    }
    .flat-product-preview.is-pillow {
      border-radius: 22%;
      background: radial-gradient(circle, #fff 0 58%, #eee7df 100%);
      box-shadow: inset 0 0 20px rgba(88, 62, 57, .12), 0 23px 39px rgba(74, 34, 43, .2);
    }
    .flat-product-preview.is-pillow::after {
      content: '';
      position: absolute;
      z-index: 2;
      inset: 5px;
      border: 1px solid rgba(91, 66, 61, .14);
      border-radius: 21%;
      pointer-events: none;
    }
    .flat-product-preview.has-product-mockup {
      margin-top: 0;
      overflow: hidden;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    .flat-product-preview.has-product-mockup::before,
    .flat-product-preview.has-product-mockup::after { display: none; }
    .flat-product-composite {
      display: block;
      position: relative;
      width: 100%;
      height: 100%;
    }
    .flat-product-preview.has-product-mockup .flat-product-composite {
      position: absolute;
      inset: 0;
      transform: scale(var(--product-mockup-scale, 1));
      transform-origin: center;
    }
    .flat-product-preview.has-product-mockup canvas {
      position: absolute;
      z-index: 1;
      top: var(--product-mockup-canvas-top, 0%);
      left: var(--product-mockup-canvas-left, 0%);
      width: var(--product-mockup-canvas-width, 100%);
      height: var(--product-mockup-canvas-height, 100%);
      border-radius: 0;
      clip-path: var(--product-mockup-canvas-clip, none);
    }
    .flat-product-mockup {
      display: none;
      width: 100%;
      height: 100%;
      position: absolute;
      z-index: 2;
      inset: 0;
      object-fit: contain;
      pointer-events: none;
      mix-blend-mode: var(--product-mockup-blend, normal);
      transform: rotate(var(--product-mockup-rotation, 0deg));
      user-select: none;
    }
    .flat-product-preview.has-product-mockup .flat-product-mockup { display: block; }
    .flat-product-preview canvas { width: 100%; height: 100%; display: block; position: relative; z-index: 1; border-radius: inherit; }
    .mug-name {
      display: inline-block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 12px;
      letter-spacing: .02em;
    }
    .preview-disclaimer {
      max-width: 440px;
      margin: 8px auto 0;
      color: rgba(105, 78, 84, .78);
      font-size: 11px;
      line-height: 1.45;
      letter-spacing: .01em;
    }

    .wrap-preview {
      min-height: 0;
      flex: 1;
      padding: 0;
      display: flex;
      flex-direction: column;
      border: 0;
      border-radius: 0;
      background: transparent;
    }
    .surface-editor {
      margin: 0;
      padding: 3px;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 4px;
      border: 1px solid rgba(123, 70, 82, .14);
      border-radius: 11px;
      background: #fbf6f1;
    }
    .surface-editor[hidden] { display: none; }
    .surface-tabs { display: inline-flex; gap: 4px; }
    .surface-tab {
      min-height: 35px;
      padding: 7px 13px;
      border: 0;
      border-radius: 9px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font: inherit;
      font-size: 11px;
      font-weight: 600;
    }
    .surface-tab[aria-selected="true"] { background: #fff; color: var(--berry); box-shadow: 0 3px 10px rgba(64, 15, 38, .09); }
    .surface-tab:focus-visible { outline: 3px solid rgba(156, 28, 76, .18); outline-offset: 1px; }
    .surface-copy {
      min-height: 35px;
      padding: 7px 11px;
      border: 1px solid rgba(156, 28, 76, .24);
      border-radius: 9px;
      background: #fff;
      color: var(--berry);
      cursor: pointer;
      font: inherit;
      font-size: 10px;
      font-weight: 600;
    }
    .surface-copy[hidden] { display: none; }
    .editor-toolbar {
      position: relative;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }
    .editor-tools { display: flex; align-items: center; gap: 6px; }
    .editor-tools-primary { flex-wrap: wrap; }
    .editor-emoji-picker { position: relative; display: none; }
    .editor-motif-picker { position: static; }
    .editor-motif-menu {
      position: absolute;
      z-index: 30;
      top: calc(100% + 7px);
      left: 0;
      width: min(380px, calc(100vw - 64px));
      padding: 12px;
      border: 1px solid rgba(123, 70, 82, .18);
      border-radius: 15px;
      background: rgba(255, 255, 255, .98);
      box-shadow: 0 18px 46px rgba(64, 15, 38, .15);
      backdrop-filter: blur(12px);
    }
    .editor-motif-menu[hidden] { display: none; }
    .editor-motif-title {
      display: block;
      margin: 0 2px 9px;
      color: var(--ink);
      font-size: 11px;
      font-weight: 600;
    }
    .editor-motif-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 7px;
    }
    .editor-motif-option {
      min-width: 0;
      padding: 8px 4px 7px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      border: 1px solid rgba(123, 70, 82, .13);
      border-radius: 11px;
      background: #fffaf8;
      color: var(--berry);
      cursor: pointer;
      transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    }
    .editor-motif-option:hover {
      transform: translateY(-1px);
      border-color: rgba(156, 28, 76, .38);
      box-shadow: 0 7px 16px rgba(64, 15, 38, .08);
    }
    .editor-motif-option:focus-visible { outline: 3px solid rgba(156, 28, 76, .18); outline-offset: 2px; }
    .editor-motif-option svg {
      width: 31px;
      height: 31px;
      overflow: visible;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .editor-motif-option span {
      width: 100%;
      overflow: hidden;
      color: var(--muted);
      font-size: 8px;
      text-align: center;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .editor-button {
      min-height: 36px;
      padding: 8px 11px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border: 1px solid rgba(123, 70, 82, .18);
      border-radius: 10px;
      background: #fff;
      color: var(--ink);
      cursor: pointer;
      font-size: 11px;
      font-weight: 500;
      transition: border-color .2s, background .2s, opacity .2s;
    }
    .editor-button:hover { border-color: rgba(156, 28, 76, .45); background: #fff9f7; }
    .editor-button:focus-visible { outline: 3px solid rgba(156, 28, 76, .18); outline-offset: 2px; }
    .editor-button:disabled { cursor: not-allowed; opacity: .34; }
    .editor-button-primary { border-color: rgba(156, 28, 76, .28); color: var(--berry); }
    .editor-zoom-label { min-width: 44px; color: var(--muted); text-align: center; font-size: 10px; }
    .editor-scroll {
      width: 100%;
      height: var(--editor-stage-height, var(--workspace-stage-height));
      padding: 12px;
      overflow: auto;
      overscroll-behavior: contain;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      scrollbar-color: rgba(123,70,82,.28) transparent;
    }
    .editor-scroll.is-fit {
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .editor-canvas-shell {
      width: 100%;
      min-width: 0;
      position: relative;
      aspect-ratio: var(--print-aspect, 2700 / 1050);
      flex: 0 0 auto;
      overflow: hidden;
      border: 1px solid rgba(64, 15, 38, .08);
      border-radius: 10px;
      background: #fff;
      box-shadow: none;
      transition: width .2s ease, height .2s ease;
    }
    .editor-canvas-shell .canvas-container {
      width: 100% !important;
      height: 100% !important;
      position: absolute !important;
      inset: 0;
    }
    .editor-canvas-shell canvas {
      width: 100% !important;
      height: 100% !important;
      touch-action: none;
    }
    .print-safe-guide {
      position: absolute;
      z-index: 4;
      inset: var(--print-safe-top) var(--print-safe-right) var(--print-safe-bottom) var(--print-safe-left);
      border: 1px dashed transparent;
      border-radius: 6px;
      pointer-events: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .editor-canvas-shell.has-selection .print-safe-guide {
      border-color: rgba(156, 28, 76, .22);
    }
    .editor-canvas-shell.boundary-hit .print-safe-guide {
      border-color: rgba(156, 28, 76, .74);
      box-shadow: inset 0 0 0 1px rgba(156, 28, 76, .08);
    }
    .print-readability {
      margin: 16px 0; padding: 12px 16px; border-radius: 12px;
      background: #fff5df; color: #73500c; font-size: 14px; line-height: 1.5;
    }
    .print-readability[data-level="low"] { background: #fff0eb; color: #923c27; }
    .print-readability[hidden] { display: none; }
    .editor-image-quality {
      position: absolute;
      z-index: 6;
      max-width: calc(100% - 16px);
      display: flex;
      align-items: stretch;
      overflow: hidden;
      border-radius: 5px;
      box-shadow: 0 4px 14px rgba(25, 20, 22, .2);
      color: #fff;
      font-family: 'Jost', 'Wolkenworte Jost Fallback', system-ui, sans-serif;
      font-size: 10px;
      line-height: 1;
      pointer-events: none;
      transform: translate(-100%, 5px);
      white-space: nowrap;
    }
    .editor-image-quality[hidden] { display: none; }
    .editor-image-quality.is-above { transform: translate(-100%, calc(-100% - 5px)); }
    .editor-image-quality-detail {
      min-width: 0;
      padding: 6px 7px;
      overflow: hidden;
      background: rgba(24, 23, 24, .94);
      text-overflow: ellipsis;
    }
    .editor-image-quality-label {
