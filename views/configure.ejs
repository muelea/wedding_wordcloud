<body>
  <%- include('partials/site-header') %>

  <main class="page">
    <div class="loading" id="loading">Eure Wortwolke wird vorbereitet&hellip;</div>

    <div class="config-content" id="config-content" hidden>
      <section class="intro">
        <p class="eyebrow" id="config-eyebrow">Eure Worte. Eure Erinnerung.</p>
        <h1 id="config-title">Gestaltet eure Erinnerung.</h1>
        <p class="intro-copy" id="config-intro">Wählt Produkt, Farbwelt und Platzierung. Menge und Lieferadressen entscheidet ihr im nächsten Schritt.</p>
      </section>

      <div class="config-studio">
        <section class="design-toolbar" aria-labelledby="controls-title">
          <div class="design-toolbar-copy">
            <h2 id="controls-title">Euer Design</h2>
          </div>

          <div class="design-toolbar-controls">
            <div class="selected-product toolbar-product" id="selected-product">
              <img class="selected-product-thumb" id="selected-product-thumb" alt="" />
              <span class="selected-product-copy">
                <strong id="selected-product-name">Weiße Tasse</strong>
                <span id="selected-product-detail">11 oz · 325 ml</span>
              </span>
              <button class="product-change" id="change-product" type="button">Produkt ändern</button>
            </div>

            <details class="toolbar-menu" id="orientation-step" hidden>
              <summary class="toolbar-summary">
                <span>
                  <span class="toolbar-kicker">Ausrichtung</span>
                  <strong id="selected-orientation-name">Hochformat</strong>
                </span>
                <span class="toolbar-summary-detail" id="selected-orientation-detail">Vertikal</span>
              </summary>
              <div class="toolbar-panel">
                <div class="option-grid orientation-grid" id="orientation-options"></div>
              </div>
            </details>

            <details class="toolbar-menu" id="theme-step">
              <summary class="toolbar-summary">
                <span>
                  <span class="toolbar-kicker">Farbwelt</span>
                  <strong id="selected-theme-name">Farbwelt wählen</strong>
                </span>
                <span class="swatches toolbar-theme-swatches" id="selected-theme-swatches" aria-hidden="true"></span>
              </summary>
              <div class="toolbar-panel">
                <div class="option-grid" id="theme-options"></div>
                <div class="custom-palette-panel" id="custom-palette-panel" hidden>
                  <div class="custom-palette-head">
                    <div class="custom-palette-copy">
                      <strong>Eure Farben</strong>
                      <span>So viele oder wenige, wie ihr möchtet.</span>
                    </div>
                    <button class="custom-color-add" id="custom-color-add" type="button">＋ Farbe</button>
                  </div>
                  <div class="custom-color-list" id="custom-color-list"></div>
                  <p class="custom-palette-note">Die Farben werden gleichmäßig auf eure Wörter verteilt. Einzelne Wörter könnt ihr unten auf der Druckfläche weiterhin separat ändern.</p>
                </div>
              </div>
            </details>

            <details class="toolbar-menu" id="placement-step">
              <summary class="toolbar-summary">
                <span>
                  <span class="toolbar-kicker">Platzierung</span>
                  <strong id="placement-summary-name">Design anordnen</strong>
                </span>
                <span class="toolbar-summary-detail" id="placement-summary-detail">Wählt eine Anordnung für euer aktuelles Design.</span>
              </summary>
              <div class="toolbar-panel">
                <div class="option-grid placement-grid" id="placement-options"></div>
              </div>
            </details>
          </div>
        </section>

        <section class="workspace-tools" aria-label="Werkzeuge für die Gestaltung">
              <div class="editor-toolbar" aria-label="Werkzeuge für die Druckfläche">
                <div class="editor-tools editor-tools-primary">
                  <div class="surface-editor" id="surface-editor" hidden>
                    <div class="surface-tabs" id="surface-tabs" role="tablist" aria-label="Druckseite wählen"></div>
                    <button class="surface-copy" id="surface-copy" type="button" hidden>Vorderseite übernehmen</button>
                  </div>
                  <button class="editor-button editor-button-primary" id="editor-add" type="button"><span aria-hidden="true">＋</span> Wort</button>
                  <div class="editor-motif-picker">
                    <button class="editor-button editor-button-primary" id="editor-icon-toggle" type="button" aria-expanded="false" aria-controls="editor-icon-menu" aria-haspopup="dialog"><span aria-hidden="true">＋</span> Motiv</button>
                    <div class="editor-motif-menu" id="editor-icon-menu" role="dialog" aria-label="Motiv auswählen" hidden>
                      <strong class="editor-motif-title">Welches Motiv möchtet ihr hinzufügen?</strong>
                      <div class="editor-motif-grid" id="editor-icon-grid"></div>
                    </div>
                  </div>
                  <button class="editor-button" id="editor-reset" type="button" title="Automatische Wortwolke wiederherstellen">Zurücksetzen</button>
                  <button class="editor-button" id="editor-select-all" type="button" title="Alles auswählen (⌘/Strg + A)">Alles auswählen</button>
                </div>
                <div class="editor-tools">
                  <button class="editor-button editor-icon-button" id="editor-undo" type="button" aria-label="Rückgängig" title="Rückgängig">↶</button>
                  <button class="editor-button editor-icon-button" id="editor-redo" type="button" aria-label="Wiederholen" title="Wiederholen">↷</button>
                  <button class="editor-button editor-icon-button" id="editor-zoom-out" type="button" aria-label="Ansicht verkleinern" title="Ansicht verkleinern">−</button>
                  <span class="editor-zoom-label" id="editor-zoom-label">100 %</span>
                  <button class="editor-button editor-icon-button" id="editor-zoom-in" type="button" aria-label="Ansicht vergrößern" title="Ansicht vergrößern">＋</button>
                </div>
              </div>
              <div class="editor-selection" id="editor-selection" aria-label="Werkzeuge für das ausgewählte Element">
                <div class="editor-selection-head">
                  <strong class="editor-selection-status" id="editor-selection-status">Element auswählen</strong>
                  <span class="editor-selection-hint" id="editor-selection-hint">Wort oder Motiv anklicken, um die Werkzeuge zu aktivieren</span>
                </div>
                <div class="editor-selection-row">
                  <label class="editor-field-label"><span class="editor-field-label-text" id="editor-text-label">Ausgewähltes Element</span>
                    <input class="editor-text-input" id="editor-text" type="text" maxlength="30" autocomplete="off" placeholder="Wort auswählen" disabled />
                  </label>
                  <div class="editor-field-label editor-field-label-font">
                    <span class="editor-field-label-text">Schriftart</span>
                    <div class="editor-font-picker" id="editor-font-picker">
                      <button class="editor-font-toggle" id="editor-font-toggle" type="button" aria-label="Schriftart wählen" aria-haspopup="listbox" aria-expanded="false" aria-controls="editor-font-menu" disabled>
                        <span class="editor-font-current" id="editor-font-current">Schrift wählen</span>
                        <span class="editor-font-caret" aria-hidden="true">⌄</span>
                      </button>
                      <div class="editor-font-menu" id="editor-font-menu" role="listbox" aria-label="Schriftart" hidden></div>
                    </div>
                    <select class="editor-font-select" id="editor-font" aria-label="Schriftart" hidden disabled></select>
                  </div>
                  <div class="editor-field-label editor-field-label-color" role="group" aria-label="Farbe auswählen">
                    <div class="editor-colors">
                      <div class="editor-swatches" id="editor-swatches"></div>
                      <input class="editor-color-input" id="editor-color" type="color" aria-label="Eigene Farbe wählen" disabled />
                    </div>
                  </div>
                </div>
                <div class="editor-actions">
                  <button class="editor-button" id="editor-smaller" type="button" disabled>− Kleiner</button>
                  <button class="editor-button" id="editor-larger" type="button" disabled>＋ Größer</button>
                  <button class="editor-button" id="editor-rotate-left" type="button" aria-label="Nach links drehen" title="Nach links drehen" disabled><span class="editor-rotate-symbol" aria-hidden="true">↺</span> Drehen</button>
                  <button class="editor-button" id="editor-rotate-right" type="button" aria-label="Nach rechts drehen" title="Nach rechts drehen" disabled><span class="editor-rotate-symbol" aria-hidden="true">↻</span> Drehen</button>
                  <button class="editor-button" id="editor-duplicate" type="button" title="Duplizieren (⌘/Strg + C und V)" disabled>Duplizieren</button>
                  <button class="editor-button" id="editor-bring-front" type="button" aria-label="Ganz nach vorn" title="Ganz nach vorn" disabled><span aria-hidden="true">↥</span> Nach vorn</button>
                  <button class="editor-button editor-delete" id="editor-delete" type="button" disabled>Löschen</button>
                </div>
              </div>
        </section>

        <div class="workbench">
          <section class="editor-card" aria-labelledby="editor-title">
            <h2 class="editor-title" id="editor-title">Druckfläche bearbeiten</h2>
            <div class="wrap-preview">
              <div class="editor-scroll is-fit" id="editor-scroll">
                <div class="editor-canvas-shell" id="editor-canvas-shell">
                  <canvas id="wrap-canvas" width="1350" height="525" aria-label="Interaktive Druckfläche. Wörter und Motive können ausgewählt, verschoben, gedreht und vergrößert werden."></canvas>
                  <span class="print-safe-guide" aria-hidden="true"></span>
                </div>
              </div>
              <p class="editor-status" id="editor-feedback" aria-live="polite"></p>
            </div>
          </section>

          <section class="preview-card" aria-labelledby="preview-title">
            <div class="preview-head">
              <h2 id="preview-title">Eure Vorschau</h2>
            </div>

            <div class="mug-stage" id="product-stage" aria-label="Vorschau des gestalteten Produkts">
              <div class="mug-wrap">
                <div class="mug-viewer" id="mug-3d" tabindex="0" aria-label="Interaktive 3D-Tasse. Zum Drehen horizontal oder vertikal ziehen. Alternativ die Pfeiltasten verwenden.">
                  <div class="mug-fallback">
                    <div class="mug"><canvas class="mug-art" id="mug-preview"></canvas></div>
                  </div>
                  <div class="flat-product-preview" id="flat-product-preview" aria-hidden="true">
                    <span class="flat-product-composite">
                      <canvas id="flat-preview"></canvas>
                      <img class="flat-product-mockup" id="flat-product-mockup" alt="" draggable="false">
                    </span>
                  </div>
                </div>
                <span class="mug-name" id="mug-viewer-hint">↔ ↕ Ziehen zum Drehen</span>
                <p class="preview-disclaimer">Die Vorschau dient zur Orientierung – Farben, Position und Beschnitt können auf dem fertigen Produkt leicht abweichen.</p>
              </div>
            </div>
          </section>
        </div>

        <section class="checkout-panel" id="checkout-panel" aria-label="Bestellung fortsetzen">
          <div class="order-box" id="order-box" hidden>
            <div class="order-head">
              <strong>Eure Bestellung</strong>
              <span id="order-count"></span>
            </div>
            <div class="order-list" id="order-list"></div>
          </div>
          <div class="order-actions">
            <button class="secondary-button" id="design-another" type="button">Weiteres Produkt gestalten</button>
            <button class="primary-button continue-button" id="continue-order" type="button">Zur Lieferadresse <span aria-hidden="true">→</span></button>
          </div>
          <p class="error-text" id="error-text" aria-live="polite"></p>
        </section>
      </div>
    </div>
  </main>

  <dialog class="product-dialog ww-mobile-dialog" id="product-dialog" aria-labelledby="product-dialog-title" tabindex="-1">
    <div class="product-dialog-shell">
      <div class="product-dialog-head">
        <div>
          <h2 id="product-dialog-title">Produkt wählen</h2>
        </div>
        <button class="product-dialog-close" id="product-dialog-close" type="button" aria-label="Produktwahl schließen">×</button>
      </div>
      <div class="product-dialog-body">
        <div class="product-options" id="product-options" role="radiogroup" aria-label="Produktgruppe wählen"></div>
        <div class="variant-panel" id="variant-panel" hidden>
          <p class="variant-head" id="variant-title">Ausführung wählen</p>
          <div class="variant-options" id="variant-options" role="radiogroup" aria-labelledby="variant-title"></div>
        </div>
      </div>
      <div class="product-dialog-footer">
        <button class="product-dialog-done" id="product-dialog-done" type="button">Produkt übernehmen</button>
      </div>
    </div>
  </dialog>

  <footer class="config-footer" aria-label="Rechtliche Hinweise">
    <a href="/datenschutz" target="_blank" rel="noopener">Datenschutz</a><span aria-hidden="true">·</span><a href="/impressum" target="_blank" rel="noopener">Impressum</a>
  </footer>

  <script src="/vendor/three.min.js?v=0.160.1"></script>
  <script src="/vendor/fabric.min.js?v=7.4.0"></script>
