<!DOCTYPE html>
<html lang="<%= locale %>" data-locale-source="<%= localeSource %>" data-locale-catalog-url="<%= localeCatalogUrl %>" data-locale-catalog-urls="<%= JSON.stringify(localeCatalogUrls) %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#fffdfa" />
  <link rel="icon" type="image/svg+xml" href="<%= asset('/z_icons/icon.svg') %>" />
  <%- include('partials/site-fonts') %>
  <link rel="stylesheet" href="<%= asset('/i18n.css') %>" />
  <link rel="stylesheet" href="<%= asset('/action-state.css') %>" />
  <script src="<%= asset('/js/i18n.js') %>"></script>
  <script src="<%= asset('/js/action-state.js') %>"></script>
  <title data-i18n-source="Lieferadresse – Wolkenworte"><%= t('Lieferadresse – Wolkenworte') %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    :root {
      --bg: #fffdfa;
      --surface: #fffefc;
      --surface-soft: #f7eee0;
      --ink: #400f26;
      --berry: #9c1c4c;
      --muted: #8a7178;
      --line: rgba(64, 15, 38, .1);
      --line-strong: rgba(156, 28, 76, .38);
      --success: #287a64;
      --danger: #b33a4d;
      --shadow: 0 20px 60px rgba(64, 15, 38, .08);
    }
    html { background: var(--bg); color: var(--ink); font-family: 'Jost', 'Wolkenworte Jost Fallback', system-ui, sans-serif; }
    body { margin: 0; min-height: 100vh; background: var(--bg); }
    button, input, select { font: inherit; }
    .topbar {
      width: min(1120px, calc(100% - 48px));
      min-height: 84px;
      margin: 0 auto;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      border-bottom: 1px solid var(--line);
      background: rgba(255, 253, 250, .88);
      backdrop-filter: blur(14px);
    }
    .brand { display: inline-flex; align-items: center; gap: 9px; color: var(--ink); text-decoration: none; font-family: 'Playfair Display', 'Wolkenworte Playfair Fallback', Georgia, serif; font-size: 20px; font-weight: 600; }
    .brand-icon { width: 32px; height: 30px; object-fit: contain; }
    .back-link { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 500; }
    .back-link:hover { color: var(--berry); }
    main { width: min(820px, calc(100% - 28px)); margin: 0 auto; padding: 34px 0 72px; }
    .intro { max-width: 680px; margin-bottom: 28px; }
    .eyebrow { margin: 0 0 10px; color: var(--berry); font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
    h1 { margin: 0; font-family: 'Playfair Display', 'Wolkenworte Playfair Fallback', Georgia, serif; font-size: clamp(34px, 7vw, 54px); font-weight: 500; line-height: 1.04; }
    .intro-copy { margin: 13px 0 0; color: var(--muted); font-size: 16px; line-height: 1.6; }
    .steps { display: flex; align-items: center; gap: 8px; margin: 24px 0 30px; overflow: hidden; }
    .step { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 12px; white-space: nowrap; }
    .step-dot { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-soft); color: var(--berry); font-weight: 600; }
    .step.done { color: var(--success); }
    .step.done .step-dot { background: rgba(40, 122, 100, .11); color: var(--success); }
    .step.active { color: var(--ink); font-weight: 600; }
    .step.active .step-dot { background: var(--berry); color: #fff; }
    .step-line { width: clamp(14px, 4vw, 48px); height: 1px; flex: 0 1 auto; background: var(--line); }
    .card { background: rgba(255, 254, 253, .94); border: 1px solid var(--line); border-radius: 24px; box-shadow: var(--shadow); }
    .address-card { padding: clamp(22px, 5vw, 38px); }
    .card-title { margin: 0; font-family: 'Playfair Display', 'Wolkenworte Playfair Fallback', Georgia, serif; font-size: 25px; font-weight: 600; }
    .card-copy { margin: 7px 0 25px; color: var(--muted); font-size: 14px; line-height: 1.55; }
    form { display: grid; gap: 17px; }
    .shipment-list { display: grid; gap: 16px; }
    .shipment-card {
      padding: 17px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(255, 253, 250, .72);
    }
    .shipment-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 15px;
    }
    .shipment-title { margin: 0; font-size: 14px; font-weight: 600; }
    .shipment-products {
      display: grid;
      gap: 10px;
      margin-bottom: 15px;
    }
    .shipment-products-title {
      display: block;
      font-size: 13px;
      font-weight: 600;
    }
    .shipment-product {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fff;
    }
    .shipment-product img {
      width: 48px;
      height: 42px;
      object-fit: contain;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: #fff;
    }
    .shipment-product-copy { min-width: 0; }
    .shipment-product-copy strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
    .shipment-product-copy span { display: block; margin-top: 2px; color: var(--muted); font-size: 11px; }
    .quantity-control {
      flex: 0 0 auto;
      display: grid;
      grid-template-columns: 38px 56px 38px;
      height: 46px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #fff;
    }
    .quantity-control button {
      border: 0;
      background: var(--surface-soft);
      color: var(--ink);
      cursor: pointer;
      font-size: 20px;
      line-height: 1;
    }
    .quantity-control input {
      height: 44px;
      padding: 0;
      border: 0;
      border-inline: 1px solid var(--line);
      border-radius: 0;
      text-align: center;
      font-weight: 600;
      appearance: textfield;
    }
    .quantity-control input::-webkit-inner-spin-button,
    .quantity-control input::-webkit-outer-spin-button { margin: 0; appearance: none; }
    .address-fields { display: grid; gap: 13px; }
    .field-row { display: grid; grid-template-columns: minmax(105px, .72fr) minmax(0, 1.28fr); gap: 13px; align-items: start; }
    label, .field-control { display: grid; gap: 5px; color: var(--ink); font-size: 13px; font-weight: 500; line-height: 1.2; }
    .field-label { display: inline-flex; align-items: baseline; gap: 4px; }
    .optional { color: var(--muted); font-weight: 400; }
    input, select {
      width: 100%; min-width: 0; height: 50px; padding: 0 14px;
      border: 1px solid var(--line); border-radius: 12px; outline: none;
      background: #fff; color: var(--ink); font-size: 16px;
      transition: border-color .18s, box-shadow .18s;
    }
    input::placeholder { color: #b9a8ad; }
    input:focus, select:focus { border-color: var(--line-strong); box-shadow: 0 0 0 3px rgba(164, 14, 76, .08); }
    input[aria-invalid="true"], select[aria-invalid="true"] { border-color: var(--danger); }
    .search-picker { position: relative; }
    .search-trigger {
      width: 100%; min-height: 50px; padding: 0 42px 0 14px;
      position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px;
      border: 1px solid var(--line); border-radius: 12px; outline: none;
      background: #fff; color: var(--ink); cursor: pointer; text-align: left; font-size: 16px;
      transition: border-color .18s, box-shadow .18s;
    }
    .search-trigger::after {
      content: "⌄";
      position: absolute;
      right: 14px;
      top: 50%;
      color: var(--muted);
      font-size: 19px;
      line-height: 1;
      transform: translateY(-54%);
    }
    .search-picker.is-open .search-trigger::after { transform: translateY(-44%) rotate(180deg); }
    .search-trigger:focus-visible,
    .search-picker.is-open .search-trigger { border-color: var(--line-strong); box-shadow: 0 0 0 3px rgba(164, 14, 76, .08); }
    .search-trigger[aria-invalid="true"] { border-color: var(--danger); }
    .search-trigger-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .search-trigger-meta { color: var(--muted); font-size: 12px; font-weight: 600; letter-spacing: .04em; }
    .search-menu {
      position: absolute;
      z-index: 40;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 16px 40px rgba(64, 15, 38, .14);
    }
    .search-input-wrap { position: relative; }
    .search-input {
      height: 44px;
      padding: 0 48px 0 36px;
      font-size: 16px;
    }
    .search-input-icon {
      position: absolute;
      left: 13px;
      top: 50%;
      color: var(--muted);
      font-size: 18px;
      transform: translateY(-50%);
      pointer-events: none;
    }
    .search-input-clear {
      width: 44px;
      height: 44px;
      position: absolute;
      right: 0;
      top: 0;
      border: 0;
      border-radius: 9px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: 24px;
      line-height: 1;
    }
    .search-input-clear:hover { background: rgba(64, 15, 38, .06); color: var(--ink); }
    .search-results {
      max-height: 238px;
      margin-top: 8px;
      display: grid;
      gap: 3px;
      overflow: auto;
    }
    .search-option {
      width: 100%;
      min-height: 44px;
      padding: 8px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
      font-size: 15px;
      text-align: left;
    }
    .search-option:hover,
    .search-option.is-active { background: rgba(156, 28, 76, .07); }
    .search-option.is-selected { background: rgba(40, 122, 100, .09); }
    .search-option small { color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .04em; }
    .search-empty { padding: 12px 10px; color: var(--muted); font-size: 13px; font-weight: 400; }
    .state-field[hidden] { display: none; }
    .submit-button {
      width: 100%; min-height: 54px; margin-top: 5px; padding: 14px 20px;
      border: 0; border-radius: 999px; cursor: pointer;
      background: var(--ink); color: #fff; font-size: 16px; font-weight: 600;
      box-shadow: 0 10px 24px rgba(64, 15, 38, .16);
      transition: transform .18s, opacity .18s, box-shadow .18s;
    }
    .submit-button:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 13px 28px rgba(64, 15, 38, .2); }
    .submit-button:disabled { cursor: wait; opacity: .58; }
    .checkout-button { background: var(--berry); margin-top: 16px; }
    .privacy-note { margin: -1px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; text-align: center; }
    .privacy-note a { color: var(--berry); text-underline-offset: 2px; }
    .form-error { min-height: 20px; margin: 0; color: var(--danger); font-size: 13px; line-height: 1.45; }
    .form-error:empty, .checkout-error:empty, #shipping-draft-status:empty { display: none; }
    .quote { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line); scroll-margin-top: 100px; }
    .quote-row { display: flex; justify-content: space-between; gap: 18px; margin: 0 0 11px; color: var(--muted); font-size: 14px; }
    .quote-row strong { color: var(--ink); font-weight: 500; }
    .quote-total { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; margin-top: 17px; padding-top: 17px; border-top: 1px solid var(--line); }
    .quote-total span { font-size: 14px; font-weight: 500; }
    .quote-total strong { font-family: 'Playfair Display', 'Wolkenworte Playfair Fallback', Georgia, serif; font-size: 29px; font-weight: 600; white-space: nowrap; }
    .quote-note { margin: 10px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
    .checkout-error { min-height: 18px; margin: 10px 2px 0; color: var(--danger); font-size: 13px; line-height: 1.45; }
    .delivery-information { margin-top: 20px; padding: 16px; border-radius: 16px; background: var(--surface-soft); font-size: 13px; line-height: 1.55; color: var(--muted); }
    .delivery-information p { margin: 0 0 8px; overflow-wrap: anywhere; }
    .delivery-information p:last-child { margin-bottom: 0; }
    .delivery-information .delivery-estimate { font-weight: 600; color: var(--ink); }
    .delivery-information .delivery-warning { color: var(--danger); }
    .fatal { margin-top: 20px; padding: 18px; border: 1px solid rgba(179, 58, 77, .24); border-radius: 16px; background: rgba(179, 58, 77, .07); color: var(--danger); line-height: 1.55; }
    .loading { padding: 80px 16px; text-align: center; color: var(--muted); }
    [hidden] { display: none !important; }
    @media (min-width: 840px) {
      main { padding-top: 50px; }
    }
    @media (max-width: 520px) {
      .topbar { width: min(100% - 32px, 560px); min-height: 72px; }
      .brand { font-size: 18px; }
      .brand-icon { width: 28px; height: 26px; }
      .back-link span:first-child { margin-right: 3px; }
      main {
        width: auto;
        max-width: 1120px;
        margin-left: max(10px, var(--ww-safe-left));
        margin-right: max(10px, var(--ww-safe-right));
        padding-top: 26px;
        padding-bottom: max(72px, calc(56px + var(--ww-safe-bottom)));
      }
      .intro-copy { font-size: 15px; }
      .steps .step-label { display: none; }
      .steps .step.active .step-label { display: inline; }
      .field-row { grid-template-columns: 1fr; }
      .shipment-card { padding: 15px; }
      .shipment-product { grid-template-columns: 44px minmax(0, 1fr); }
      .shipment-product .quantity-control { grid-column: 1 / -1; }
      .quantity-control { width: 100%; grid-template-columns: 44px minmax(0, 1fr) 44px; }
      .quantity-control input { width: 100%; }
    }
  </style>
  <link rel="stylesheet" href="<%= asset('/site-header.css') %>" />
  <link rel="stylesheet" href="<%= asset('/mobile-foundation.css') %>" />
  <script src="<%= asset('/js/site-header.js') %>" defer></script>
  <script src="<%= asset('/js/mobile-ui.js') %>" defer></script>
</head>
<body>
  <%- include('partials/site-header') %>

  <main>
    <div class="loading" id="loading">Euer Entwurf wird geladen&hellip;</div>
    <div id="page-content" hidden>
      <section class="intro">
        <p class="eyebrow">Fast geschafft</p>
        <h1 id="shipping-title">Wohin darf eure Erinnerung reisen?</h1>
        <p class="intro-copy" id="shipping-intro">Mit eurer Lieferadresse prüfen wir Produktpreise, Versandkosten und die voraussichtliche Lieferzeit.</p>
      </section>

      <div class="steps" aria-label="Bestellfortschritt">
        <div class="step done"><span class="step-dot">✓</span><span class="step-label">Design</span></div>
        <span class="step-line" aria-hidden="true"></span>
        <div class="step active"><span class="step-dot">2</span><span class="step-label">Lieferadresse</span></div>
        <span class="step-line" aria-hidden="true"></span>
        <div class="step"><span class="step-dot">3</span><span class="step-label">Bezahlen</span></div>
      </div>

      <section class="card address-card" aria-labelledby="address-title">
        <h2 class="card-title" id="address-title">Lieferadresse</h2>
        <p class="card-copy">Wählt die Mengen und gebt eure Lieferadresse ein. Nach dem Kauf könnt ihr dieselben Designs erneut an eine andere Adresse bestellen.</p>
        <form id="address-form" novalidate>
          <div class="shipment-list" id="shipment-list"></div>
          <button class="submit-button" id="submit-button" type="submit" disabled>Preise und Lieferung prüfen <span aria-hidden="true">→</span></button>
          <p class="privacy-note">Mehr zur Verarbeitung eurer Lieferdaten im <a href="/datenschutz">Datenschutz</a>.</p>
          <p class="form-error" id="form-error" role="alert" aria-live="polite"></p>
          <p id="shipping-draft-status" role="status" aria-live="polite"></p>
        </form>
        <div class="quote" id="quote-result" hidden aria-live="polite">
          <div class="quote-row"><span id="items-label" data-i18n-ignore>Produkte</span><strong id="items-price" data-i18n-ignore></strong></div>
          <div class="quote-row"><span>Versand</span><strong id="shipping-price" data-i18n-ignore></strong></div>
          <div class="quote-total"><span>Zwischensumme</span><strong id="subtotal-price" data-i18n-ignore></strong></div>
          <p class="quote-note">Zuzüglich Steuern. Den endgültigen Gesamtpreis seht ihr vor dem Kauf auf der Zahlungsseite.</p>
          <div class="delivery-information" id="delivery-information" aria-live="polite" hidden></div>
          <button class="submit-button checkout-button" id="checkout-button" type="button">Weiter zur Zahlung <span aria-hidden="true">→</span></button>
          <p class="checkout-error" id="checkout-error" role="alert" aria-live="polite"></p>
        </div>
      </section>
    </div>
    <div class="fatal" id="fatal-error" hidden></div>
  </main>

  <script src="<%= asset('/js/configurator-session.js') %>"></script>
  <script src="<%= asset('/js/site-journey.js') %>"></script>
  <script>
    'use strict';

    const pathParts = location.pathname.split('/').filter(Boolean);
    const slug = pathParts[1];
    const query = new URLSearchParams(location.search);
    const t = (source, params) => WolkenworteI18n.t(source, params);
    const setText = (element, source, params) => WolkenworteI18n.setText(element, source, params);
    const clearText = (element) => WolkenworteI18n.clearText(element);
    const setTranslatedAttribute = (element, name, source, params) =>
      WolkenworteI18n.setAttribute(element, name, source, params);
    const guestId = getOrCreateGuestId();
    const configurationId = query.get('configuration');
    const configurationIds = [
      ...(query.get('configurations') || '').split(','),
      configurationId || '',
    ].map((id) => id.trim()).filter((id, index, list) => id && list.indexOf(id) === index);
    const savedQuoteId = query.get('quote');
    const checkoutWasCancelled = query.get('checkout') === 'cancelled';
    const loading = document.getElementById('loading');
    const pageContent = document.getElementById('page-content');
    const fatalError = document.getElementById('fatal-error');
    const form = document.getElementById('address-form');
    const shipmentList = document.getElementById('shipment-list');
    const submitButton = document.getElementById('submit-button');
    const formError = document.getElementById('form-error');
    const quoteResult = document.getElementById('quote-result');
    const checkoutButton = document.getElementById('checkout-button');
    const checkoutError = document.getElementById('checkout-error');
    let countries = [];
    let configurations = [];
    let configuration = null;
    let currentQuote = null;
    let shippingRevision = 0;
    let activeShippingRequest = null;
    let countryDisplayNames = null;
    let shippingDraftReady = false;
    let shippingDraft = null;
    let shippingDraftUnstored = false;
    try { shippingDraft = WolkenworteConfiguratorSession.createShippingDraft(slug, sessionStorage); } catch {}
    const customerErrorSources = Object.freeze({
      shipping_unavailable: 'Für diese Produktauswahl ist an eure Adresse kein Standardversand verfügbar.',
      quote_shipping_changed: 'Die Lieferangaben haben sich geändert. Bitte prüft und bestätigt die aktualisierten Angaben.',
      single_address_required: 'Pro Bestellung ist eine Lieferadresse möglich. Bitte gebt eine einzelne Lieferadresse ein.',
      invalid_address: 'Bitte füllt alle benötigten Adressfelder vollständig aus.',
      pricing_not_configured: 'Preise und Lieferung konnten gerade nicht geprüft werden. Bitte versucht es gleich noch einmal.',
      selection_not_available: 'Für diese Produktauswahl konnte keine Lieferung bestätigt werden. Bitte prüft eure Adresse oder passt die Auswahl an.',
      pricing_unavailable: 'Preise und Lieferung konnten gerade nicht geprüft werden. Bitte versucht es gleich noch einmal.',
      pricing_currency_mismatch: 'Preise und Lieferung konnten gerade nicht geprüft werden. Bitte versucht es gleich noch einmal.',
      quote_not_found: 'Bitte prüft Preise und Lieferung erneut.',
      quote_expired: 'Bitte prüft Preise und Lieferung erneut.',
      quote_changed: 'Die Preise haben sich geändert. Bitte prüft und bestätigt die aktualisierten Angaben.',
      checkout_in_progress: 'Die Zahlungsseite wird bereits geöffnet. Bitte wartet einen Moment.',
      checkout_not_configured: 'Die Zahlung ist momentan nicht verfügbar. Bitte versucht es später erneut.',
      stripe_live_mode_blocked: 'Die Zahlung ist momentan nicht verfügbar. Bitte versucht es später erneut.',
      checkout_failed: 'Die Zahlungsseite konnte gerade nicht geöffnet werden. Bitte versucht es erneut.',
    });

    function customerErrorSource(result, fallback) {
      return customerErrorSources[result?.error] || fallback;
    }

    function customerError(source) {
      const error = new Error(source);
      error.customerSource = source;
      return error;
    }

    function setButtonLabel(button, source) {
      const label = document.createElement('span');
      label.className = 'button-label';
      setText(label, source);
      const arrow = document.createElement('span');
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '→';
      button.dataset.labelSource = source;
      button.replaceChildren(label, document.createTextNode(' '), arrow);
    }

    setButtonLabel(submitButton, 'Preise und Lieferung prüfen');
    setButtonLabel(checkoutButton, 'Weiter zur Zahlung');

    function getOrCreateGuestId() {
      const storageKey = `guest-session:${slug}`;
      try {
        const existing = sessionStorage.getItem(storageKey);
        if (/^[a-f0-9]{32}$/.test(existing || '')) return existing;
      } catch {}
      const bytes = new Uint8Array(16);
      crypto.getRandomValues(bytes);
      const created = [...bytes].map((byte) => byte.toString(16).padStart(2, '0')).join('');
      try { sessionStorage.setItem(storageKey, created); } catch {}
      return created;
    }

    function refreshCountryDisplayNames() {
      try {
        countryDisplayNames = new Intl.DisplayNames([WolkenworteI18n.getLocale()], { type: 'region' });
      } catch {
        countryDisplayNames = null;
      }
    }

    refreshCountryDisplayNames();

    const backLink = document.getElementById('back-link');
    const editingConfigurationId = configurationIds.includes(query.get('edit')) ? query.get('edit') : configurationIds[0];
    backLink.href = `/e/${encodeURIComponent(slug)}/configure${editingConfigurationId ? `?edit=${encodeURIComponent(editingConfigurationId)}` : ''}`;
    backLink.addEventListener('click', saveShippingDraft);

    function saveShippingDraft() {
      if (!shippingDraftReady) return;
      shippingDraftUnstored = !shippingDraft?.write(collectShipments({ validate: false }).shipments);
      const status = document.getElementById('shipping-draft-status');
      if (shippingDraftUnstored) setText(status, 'Eure Lieferangaben können in diesem Browser nicht zwischengespeichert werden.');
      else clearText(status);
    }

    window.addEventListener('beforeunload', (event) => {
      if (!shippingDraftUnstored) return;
      event.preventDefault();
      event.returnValue = '';
    });

    function shippingReturnIsStale(checkCart = false) {
      try {
        if (configurationIds.some((id) => WolkenworteConfiguratorSession.purchasedIds(slug, sessionStorage).includes(id))) return true;
        const cart = sessionStorage.getItem(`wolkenworte-order:${slug}`);
        if (checkCart && cart !== null) {
          const ids = WolkenworteConfiguratorSession.normalizeCart(JSON.parse(cart)).map((item) => item.id);
          return ids.length !== configurationIds.length || configurationIds.some((id) => !ids.includes(id));
        }
      } catch {}
      return false;
    }

    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      WolkenworteActions.setBusy(submitButton, false);
      WolkenworteActions.setBusy(checkoutButton, false);
      if (shippingReturnIsStale(true)) {
        currentQuote = null;
        backLink.href = `/e/${encodeURIComponent(slug)}/configure`;
        showFatal('Euer Warenkorb hat sich geändert oder wurde bereits bestellt. Bitte kehrt zum Design zurück.');
      }
    });

    window.addEventListener('pagehide', () => {
      cancelShippingRequest();
      saveShippingDraft();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') saveShippingDraft();
    });

    function showFatal(message) {
      loading.hidden = true;
      pageContent.hidden = true;
      setText(fatalError, message);
      fatalError.hidden = false;
    }

    function localizedCountryName(country) {
      try {
        return countryDisplayNames?.of(country.code) || country.name;
      } catch {
        return country.name;
      }
    }

    function defaultCountryCode() {
      return countries.some((country) => country.code === 'DE')
        ? 'DE'
        : countries[0]?.code || '';
    }

    function normalizeSearchText(value) {
      return String(value || '')
        .toLocaleLowerCase(WolkenworteI18n.getLocale())
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
    }

    function sortedCountries() {
      return [...countries].sort((a, b) => localizedCountryName(a).localeCompare(
        localizedCountryName(b),
        WolkenworteI18n.getLocale()
      ));
    }

    function countryOptionsForPicker() {
      const preferredCodes = ['DE', 'AT', 'CH'];
      const preferred = preferredCodes
        .map((code) => countries.find((country) => country.code === code))
        .filter(Boolean);
      const remaining = sortedCountries().filter((country) => !preferredCodes.includes(country.code));
      return [...preferred, ...remaining].map((country) => ({
        value: country.code,
        label: localizedCountryName(country),
        meta: country.code,
        searchText: country.name,
      }));
    }

    function stateOptionsForPicker(states) {
      return states.map((state) => ({
        value: state.code,
        label: state.name,
        meta: state.code,
      }));
    }

    function normalizePickerOptions(options) {
      return (Array.isArray(options) ? options : [])
        .map((option) => ({
          value: String(option.value || '').trim(),
          label: String(option.label || option.value || '').trim(),
          meta: String(option.meta || '').trim(),
          searchText: String(option.searchText || '').trim(),
        }))
        .filter((option) => option.value && option.label);
    }

    function pickerOptionsForSearch(options, query) {
      const normalizedQuery = normalizeSearchText(query);
      if (!normalizedQuery) return options;
      return options.filter((option) => normalizeSearchText(
        `${option.value} ${option.label} ${option.meta} ${option.searchText}`
      ).includes(normalizedQuery));
    }

    function closeSearchPicker(picker) {
      picker.classList.remove('is-open');
      picker.querySelector('.search-menu').hidden = true;
      picker.querySelector('.search-trigger').setAttribute('aria-expanded', 'false');
      picker.querySelector('.search-input')?.removeAttribute('aria-activedescendant');
    }

    function closeSearchPickers(except = null) {
      document.querySelectorAll('.search-picker.is-open').forEach((picker) => {
        if (picker !== except) closeSearchPicker(picker);
      });
    }

    let searchPickerCounter = 0;

    function createSearchPicker({
      fieldPath,
      options = [],
      selectedValue = '',
      placeholder = 'Auswählen',
      searchPlaceholder = 'Suchen',
      emptyText = 'Nichts gefunden',
      ariaLabel = 'Auswahl',
      required = false,
      onSelect = () => {},
    }) {
      const pickerId = `search-picker-${searchPickerCounter += 1}`;
      let pickerOptions = normalizePickerOptions(options);
      let resultOptions = [];
      let activeIndex = -1;

      const picker = document.createElement('div');
      picker.className = 'search-picker';
      picker.dataset.searchPicker = '';

      const valueInput = document.createElement('input');
      valueInput.type = 'hidden';
      valueInput.required = Boolean(required);
      valueInput.value = pickerOptions.some((option) => option.value === selectedValue) ? selectedValue : '';
      valueInput.dataset.fieldPath = fieldPath;

      const trigger = document.createElement('button');
      trigger.className = 'search-trigger';
      trigger.type = 'button';
      trigger.setAttribute('aria-haspopup', 'listbox');
      trigger.setAttribute('aria-expanded', 'false');

      const triggerText = document.createElement('span');
      triggerText.className = 'search-trigger-text';
      triggerText.setAttribute('data-i18n-ignore', '');
      const triggerMeta = document.createElement('small');
      triggerMeta.className = 'search-trigger-meta';
      triggerMeta.setAttribute('data-i18n-ignore', '');
      trigger.append(triggerText, triggerMeta);

      const menu = document.createElement('div');
      menu.className = 'search-menu';
      menu.hidden = true;

      const searchWrap = document.createElement('div');
      searchWrap.className = 'search-input-wrap';
      const searchIcon = document.createElement('span');
      searchIcon.className = 'search-input-icon';
      searchIcon.textContent = '⌕';
      searchIcon.setAttribute('aria-hidden', 'true');
      const search = document.createElement('input');
      search.className = 'search-input';
      search.type = 'search';
      setTranslatedAttribute(search, 'placeholder', searchPlaceholder);
      search.autocomplete = 'off';
      setTranslatedAttribute(search, 'aria-label', searchPlaceholder);
      search.setAttribute('aria-controls', `${pickerId}-results`);
      const clearSearch = document.createElement('button');
      clearSearch.className = 'search-input-clear';
      clearSearch.type = 'button';
      clearSearch.textContent = '×';
      setTranslatedAttribute(clearSearch, 'aria-label', 'Suche löschen');
      searchWrap.append(searchIcon, search, clearSearch);

      const results = document.createElement('div');
      results.className = 'search-results';
      results.id = `${pickerId}-results`;
      results.setAttribute('role', 'listbox');
      menu.append(searchWrap, results);

      function selectedOption() {
        return pickerOptions.find((option) => option.value === valueInput.value);
      }

      function renderTrigger() {
        const option = selectedOption();
        const label = option ? option.label : t(placeholder);
        triggerText.textContent = label;
        triggerMeta.textContent = option?.meta || '';
        trigger.setAttribute('aria-label', option
          ? t('{{field}}: {{value}}', { field: t(ariaLabel), value: label })
          : t(placeholder));
      }

      function setActiveOption(nextIndex) {
        const options = [...results.querySelectorAll('.search-option')];
        if (!options.length) {
          activeIndex = -1;
          search.removeAttribute('aria-activedescendant');
          return;
        }
        activeIndex = Math.max(0, Math.min(nextIndex, options.length - 1));
        options.forEach((option, optionIndex) => {
          const isActive = optionIndex === activeIndex;
          option.classList.toggle('is-active', isActive);
          if (isActive) {
            option.scrollIntoView({ block: 'nearest' });
            search.setAttribute('aria-activedescendant', option.id);
          }
        });
      }

      function renderOptions() {
        resultOptions = pickerOptionsForSearch(pickerOptions, search.value);
        results.replaceChildren();
        if (!resultOptions.length) {
          const empty = document.createElement('div');
          empty.className = 'search-empty';
          setText(empty, emptyText);
          results.append(empty);
          setActiveOption(-1);
          return;
        }
        const selectedIndex = resultOptions.findIndex((option) => option.value === valueInput.value);
        resultOptions.forEach((pickerOption, optionIndex) => {
          const option = document.createElement('button');
          option.className = 'search-option';
          option.type = 'button';
          option.id = `${pickerId}-option-${pickerOption.value}`;
          option.setAttribute('role', 'option');
          option.setAttribute('aria-selected', pickerOption.value === valueInput.value ? 'true' : 'false');
          const name = document.createElement('span');
          name.setAttribute('data-i18n-ignore', '');
          name.textContent = pickerOption.label;
          const meta = document.createElement('small');
          meta.setAttribute('data-i18n-ignore', '');
          meta.textContent = pickerOption.meta;
          option.append(name, meta);
          option.classList.toggle('is-selected', pickerOption.value === valueInput.value);
          option.addEventListener('click', () => selectOption(pickerOption));
          option.addEventListener('mouseenter', () => setActiveOption(optionIndex));
          results.append(option);
        });
        setActiveOption(selectedIndex >= 0 ? selectedIndex : 0);
      }

      function openPicker() {
        closeSearchPickers(picker);
        picker.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        menu.hidden = false;
        search.value = '';
        renderOptions();
        requestAnimationFrame(() => search.focus());
      }

      function selectOption(option) {
        const changed = valueInput.value !== option.value;
        valueInput.value = option.value;
        trigger.removeAttribute('aria-invalid');
        renderTrigger();
        closeSearchPicker(picker);
        trigger.focus();
        if (changed) onSelect(valueInput);
      }

      trigger.addEventListener('click', () => {
        if (picker.classList.contains('is-open')) {
          closeSearchPicker(picker);
          return;
        }
        openPicker();
      });
      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          openPicker();
        }
      });
      search.addEventListener('input', (event) => {
        event.stopPropagation();
        renderOptions();
      });
      search.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          event.stopPropagation();
          setActiveOption(activeIndex + 1);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          event.stopPropagation();
          setActiveOption(activeIndex - 1);
        } else if (event.key === 'Enter') {
          event.preventDefault();
          event.stopPropagation();
          if (activeIndex >= 0 && resultOptions[activeIndex]) selectOption(resultOptions[activeIndex]);
        } else if (event.key === 'Escape') {
          event.preventDefault();
          event.stopPropagation();
          closeSearchPicker(picker);
          trigger.focus();
        }
      });
      clearSearch.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        search.value = '';
        renderOptions();
        search.focus();
      });

      renderTrigger();
      picker.append(valueInput, trigger, menu);
      return {
        element: picker,
        input: valueInput,
        trigger,
        setOptions(nextOptions, nextSelectedValue = valueInput.value) {
          pickerOptions = normalizePickerOptions(nextOptions);
          valueInput.value = pickerOptions.some((option) => option.value === nextSelectedValue)
            ? nextSelectedValue
            : '';
          renderTrigger();
          if (picker.classList.contains('is-open')) renderOptions();
        },
        setRequired(nextRequired) {
          valueInput.required = Boolean(nextRequired);
        },
      };
    }

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target?.closest('.search-picker')) closeSearchPickers();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeSearchPickers();
    });

    function updateStates(countryInput, stateField, statePicker, selectedState = '') {
      const country = countries.find((entry) => entry.code === countryInput.value);
      const states = country?.states || [];
      if (!states.length) {
        stateField.hidden = true;
        statePicker.setRequired(false);
        statePicker.setOptions([], '');
        return;
      }
      stateField.hidden = false;
      statePicker.setRequired(true);
      statePicker.setOptions(stateOptionsForPicker(states), selectedState);
    }

    function configurationSizeText(itemConfiguration) {
      const size = itemConfiguration?.product?.size || {};
      const label = t(size.label || '');
      if (size.volumeMl) return `${label} · ${WolkenworteI18n.formatNumber(size.volumeMl)} ml`;
      if (size.detail) return `${label} · ${t(size.detail)}`;
      return label;
    }

    function totalUnitLabel(quantity) {
      if (configurations.length === 1 && configuration?.product?.unit) {
        return t(quantity === 1 ? configuration.product.unit.singular : configuration.product.unit.plural);
      }
      return t(quantity === 1 ? 'Produkt' : 'Produkte');
    }

    function totalProductLabel(quantity) {
      return `${WolkenworteI18n.formatNumber(quantity)} ${totalUnitLabel(quantity)}`;
    }

    function quantityLabel(quantity, itemConfiguration = configuration) {
      const unit = itemConfiguration?.product?.unit || { singular: 'Produkt', plural: 'Produkte' };
      return `${WolkenworteI18n.formatNumber(quantity)} ${t(quantity === 1 ? unit.singular : unit.plural)}`;
    }

    function defaultQuantityForConfiguration(itemConfiguration) {
      return Math.max(
        1,
        Math.min(
          itemConfiguration.product?.maxQuantity || 99,
          Number(itemConfiguration.quantity) || itemConfiguration.product?.defaultQuantity || 1
        )
      );
    }

    function defaultShipment({ emptyItems = false } = {}) {
      return {
        items: configurations.map((itemConfiguration) => ({
          configurationId: itemConfiguration.id,
          quantity: emptyItems ? 0 : defaultQuantityForConfiguration(itemConfiguration),
        })),
        recipient: { country_code: defaultCountryCode() },
      };
    }

    function shipmentFieldPath(index, field) {
      return `shipments.${index}.${field}`;
    }

    function makeInput(index, field, labelText, options = {}) {
      const label = document.createElement('label');
      const labelCopy = document.createElement('span');
      labelCopy.className = 'field-label';
      setText(labelCopy, labelText);
      if (options.optional) {
        const optional = document.createElement('span');
        optional.className = 'optional';
        setText(optional, '(optional)');
        labelCopy.append(optional);
      }
      label.append(labelCopy);
      const input = document.createElement('input');
      input.type = options.type || 'text';
      input.maxLength = options.maxLength || 120;
      input.required = Boolean(options.required);
      setTranslatedAttribute(input, 'placeholder', options.placeholder || '');
      input.autocomplete = options.autocomplete || '';
      if (options.inputMode) input.inputMode = options.inputMode;
      input.value = options.value || '';
      input.dataset.fieldPath = shipmentFieldPath(index, field);
      label.append(input);
      return label;
    }

    function findConfiguration(id) {
      return configurations.find((candidate) => candidate.id === id) || configuration;
    }

    function itemFieldPath(index, configurationId) {
      return `shipments.${index}.items.${configurationId}`;
    }

    function shipmentItemsById(shipment) {
      const items = new Map();
      if (Array.isArray(shipment?.items)) {
        shipment.items.forEach((item) => {
          const configurationId = String(item.configurationId || item.configuration_id || '').trim();
          if (!configurationId) return;
          items.set(configurationId, Math.max(0, Number(item.quantity) || 0));
        });
      } else if (configuration && Number(shipment?.quantity) > 0) {
        items.set(configuration.id, Number(shipment.quantity));
      }
      return items;
    }

    function shipmentTotalQuantity(shipment) {
      if (Array.isArray(shipment?.items)) {
        return shipment.items.reduce((sum, item) => sum + Math.max(0, Number(item.quantity) || 0), 0);
      }
      return Math.max(0, Number(shipment?.quantity) || 0);
    }

    function updateQuantityButtons(card) {
      card.querySelectorAll('[data-item-quantity]').forEach((input) => {
        const value = Number(input.value || 0);
        const itemConfiguration = findConfiguration(input.dataset.configurationId);
        const row = input.closest('.shipment-product');
        row.querySelector('[data-quantity-minus]').disabled = value <= 0;
        row.querySelector('[data-quantity-plus]').disabled = value >= itemConfiguration.product.maxQuantity;
        row.querySelector('[data-quantity-copy]').textContent = quantityLabel(Math.max(0, value || 0), itemConfiguration);
      });
    }

    function createShipmentProductRow(itemConfiguration, shipment, index) {
      const itemQuantities = shipmentItemsById(shipment);
      const row = document.createElement('div');
      row.className = 'shipment-product';

      const image = document.createElement('img');
      image.src = itemConfiguration.printFileUrl;
      image.alt = '';
      image.loading = 'lazy';

      const copy = document.createElement('div');
      copy.className = 'shipment-product-copy';
      const title = document.createElement('strong');
      const productName = t(itemConfiguration.product.displayName);
      setText(title, itemConfiguration.product.displayName);
      const size = document.createElement('span');
      size.setAttribute('data-i18n-ignore', '');
      size.textContent = configurationSizeText(itemConfiguration);
      const quantityCopy = document.createElement('span');
      quantityCopy.dataset.quantityCopy = '';
      quantityCopy.setAttribute('data-i18n-ignore', '');
      copy.append(title, size, quantityCopy);

      const control = document.createElement('div');
      control.className = 'quantity-control';
      setTranslatedAttribute(control, 'aria-label', '{{product}} für Lieferung {{count}}', {
        product: productName,
        count: index + 1,
      });

      const minus = document.createElement('button');
      minus.type = 'button';
      minus.dataset.quantityMinus = '';
      setTranslatedAttribute(minus, 'aria-label', '{{product}} einmal weniger', { product: productName });
      minus.textContent = '−';

      const input = document.createElement('input');
      input.dataset.itemQuantity = '';
      input.dataset.configurationId = itemConfiguration.id;
      input.dataset.fieldPath = itemFieldPath(index, itemConfiguration.id);
      input.type = 'number';
      input.min = '0';
      input.max = String(itemConfiguration.product.maxQuantity);
      input.inputMode = 'numeric';
      input.required = true;
      input.value = String(Math.min(
        itemConfiguration.product.maxQuantity,
        Math.max(0, itemQuantities.get(itemConfiguration.id) || 0)
      ));

      const plus = document.createElement('button');
      plus.type = 'button';
      plus.dataset.quantityPlus = '';
      setTranslatedAttribute(plus, 'aria-label', '{{product}} einmal mehr', { product: productName });
      plus.textContent = '+';

      minus.addEventListener('click', () => {
        input.value = String(Math.max(0, Number(input.value || 0) - 1));
        updateQuantityButtons(row);
        clearQuote();
      });
      plus.addEventListener('click', () => {
        input.value = String(Math.min(itemConfiguration.product.maxQuantity, Number(input.value || 0) + 1));
        updateQuantityButtons(row);
        clearQuote();
      });
      input.addEventListener('input', () => {
        updateQuantityButtons(row);
        clearQuote();
      });

      control.append(minus, input, plus);
      row.append(image, copy, control);
      updateQuantityButtons(row);
      return row;
    }

    function createShipmentCard(shipment, index) {
      const card = document.createElement('section');
      card.className = 'shipment-card';
      card.dataset.shipmentCard = String(index);

      const head = document.createElement('div');
      head.className = 'shipment-head';
      const title = document.createElement('h3');
      title.className = 'shipment-title';
      setText(title, 'Eure Lieferung');
      head.append(title);

      const productsBlock = document.createElement('div');
      productsBlock.className = 'shipment-products';
      const productsTitle = document.createElement('strong');
      productsTitle.className = 'shipment-products-title';
      setText(productsTitle, 'Produkte an diese Adresse');
      productsBlock.append(productsTitle);
      configurations.forEach((itemConfiguration) => {
        productsBlock.appendChild(createShipmentProductRow(itemConfiguration, shipment, index));
      });

      const recipient = shipment.recipient || {};
      const fields = document.createElement('div');
      fields.className = 'address-fields';
      fields.append(
        makeInput(index, 'name', 'Vollständiger Name', {
          required: true,
          maxLength: 100,
          placeholder: 'Lea Sommer',
          autocomplete: index === 0 ? 'shipping name' : '',
          value: recipient.name,
        }),
        makeInput(index, 'address1', 'Straße und Hausnummer', {
          required: true,
          placeholder: 'Blumenstraße 12',
          autocomplete: index === 0 ? 'shipping address-line1' : '',
          value: recipient.address1,
        }),
        makeInput(index, 'address2', 'Adresszusatz', {
          optional: true,
          placeholder: 'Wohnung, Etage oder c/o',
          autocomplete: index === 0 ? 'shipping address-line2' : '',
          value: recipient.address2,
        })
      );

      const row = document.createElement('div');
      row.className = 'field-row';
      row.append(
        makeInput(index, 'zip', 'Postleitzahl', {
          required: true,
          maxLength: 20,
          inputMode: 'text',
          placeholder: '10115',
          autocomplete: index === 0 ? 'shipping postal-code' : '',
          value: recipient.zip,
        }),
        makeInput(index, 'city', 'Ort', {
          required: true,
          maxLength: 100,
          placeholder: 'Berlin',
          autocomplete: index === 0 ? 'shipping address-level2' : '',
          value: recipient.city,
        })
      );
      fields.append(row);

      const countryField = document.createElement('div');
      countryField.className = 'field-control';
      const countryLabel = document.createElement('span');
      countryLabel.className = 'field-label';
      setText(countryLabel, 'Land');
      countryField.append(countryLabel);

      const stateField = document.createElement('div');
      stateField.className = 'field-control state-field';
      stateField.hidden = true;
      const stateLabel = document.createElement('span');
      stateLabel.className = 'field-label';
      setText(stateLabel, 'Bundesstaat oder Region');
      stateField.append(stateLabel);
      const statePicker = createSearchPicker({
        fieldPath: shipmentFieldPath(index, 'state_code'),
        options: [],
        selectedValue: String(recipient.state_code || '').toUpperCase(),
        placeholder: 'Region auswählen',
        searchPlaceholder: 'Region suchen…',
        emptyText: 'Keine passenden Regionen gefunden.',
        ariaLabel: 'Bundesstaat oder Region',
        onSelect: clearQuote,
      });
      stateField.append(statePicker.element);

      const countryPicker = createSearchPicker({
        fieldPath: shipmentFieldPath(index, 'country_code'),
        options: countryOptionsForPicker(),
        selectedValue: String(recipient.country_code || '').toUpperCase() || defaultCountryCode(),
        placeholder: 'Land auswählen',
        searchPlaceholder: 'Land suchen…',
        emptyText: 'Keine passenden Länder gefunden.',
        ariaLabel: 'Land',
        required: true,
        onSelect: (countryInput) => {
          updateStates(countryInput, stateField, statePicker);
          clearQuote();
        },
      });
      countryField.append(countryPicker.element);
      fields.append(countryField);
      fields.append(stateField);

      card.append(head, productsBlock, fields);
      updateStates(countryPicker.input, stateField, statePicker, String(recipient.state_code || '').toUpperCase());
      updateQuantityButtons(card);
      return card;
    }

    function renderShipments(shipments) {
      const shipment = Array.isArray(shipments) && shipments.length === 1 ? shipments[0] : defaultShipment();
      shipmentList.replaceChildren(createShipmentCard(shipment, 0));
    }

    function findShipmentField(card, field) {
      return [...card.querySelectorAll('[data-field-path]')]
        .find((input) => (input.dataset.fieldPath || '').split('.').pop() === field) || null;
    }

    function collectShipments({ validate = true } = {}) {
      const cards = [...shipmentList.querySelectorAll('.shipment-card')];
      const shipments = cards.map((card) => {
        const valueFor = (field) => findShipmentField(card, field)?.value || '';
        const items = configurations.map((itemConfiguration) => {
          const input = card.querySelector(`[data-item-quantity][data-configuration-id="${itemConfiguration.id}"]`);
          return {
            configurationId: itemConfiguration.id,
            quantity: Math.max(0, Math.round(Number(input?.value || 0))),
          };
        });
        return {
          quantity: items.reduce((sum, item) => sum + item.quantity, 0),
          items,
          recipient: {
            name: valueFor('name'),
            address1: valueFor('address1'),
            address2: valueFor('address2'),
            zip: valueFor('zip'),
            city: valueFor('city'),
            country_code: valueFor('country_code'),
            state_code: valueFor('state_code'),
          },
        };
      });
      const totalQuantity = shipments.reduce((sum, shipment) => sum + Math.max(0, Number(shipment.quantity) || 0), 0);
      const emptyShipmentIndex = shipments.findIndex((shipment) => shipment.quantity < 1);
      if (validate && emptyShipmentIndex >= 0) {
        setText(formError, 'Bitte wählt pro Lieferadresse mindestens ein Produkt.');
        shipmentList.querySelectorAll('.shipment-card')[emptyShipmentIndex]?.querySelector('[data-item-quantity]')?.focus();
        return { shipments, totalQuantity, quantityError: true };
      }
      if (validate && (totalQuantity < 1 || totalQuantity > 99)) {
        setText(formError, 'Bitte wählt insgesamt 1-99 Produkte.');
        shipmentList.querySelector('[data-item-quantity]')?.focus();
        return { shipments, totalQuantity, quantityError: true };
      }
      return { shipments, totalQuantity, quantityError: false };
    }

    function clearFieldErrors() {
      form.querySelectorAll('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));
      clearText(formError);
    }

    function clearQuote() {
      shippingRevision += 1;
      currentQuote = null;
      quoteResult.hidden = true;
      clearText(checkoutError);
      checkoutButton.disabled = true;
      setButtonLabel(checkoutButton, 'Weiter zur Zahlung');
      saveShippingDraft();
    }

    async function fetchShippingJson(url, options = {}, controller = new AbortController()) {
      // Covers both response headers and body. No automatic retry of writes:
      // a timed-out checkout is reconciled by the existing server idempotency.
      const timer = setTimeout(() => controller.abort(), 20000);
      try {
        const response = await fetch(url, { ...options, signal: controller.signal });
        return { response, result: await response.json() };
      } finally { clearTimeout(timer); }
    }

    function finishShippingRequest(request) {
      if (activeShippingRequest !== request) return;
      activeShippingRequest = null;
      form.inert = false;
      WolkenworteActions.setBusy(submitButton, false);
      WolkenworteActions.setBusy(checkoutButton, false);
      checkoutButton.disabled = !currentQuote?.id;
    }

    function cancelShippingRequest() {
      shippingRevision += 1;
      if (!activeShippingRequest) return;
      const request = activeShippingRequest;
      request.controller.abort();
      finishShippingRequest(request);
    }

    function formatMoney(cents, currency) {
      return WolkenworteI18n.formatCurrency(cents, currency);
    }

    function renderDeliveryInformation(details) {
      const container = document.getElementById('delivery-information');
      container.replaceChildren();
      container.hidden = false;
      const append = (source, params, className = '') => {
        const line = document.createElement('p');
        line.className = className;
        setText(line, source, params);
        container.appendChild(line);
      };
      const delivery = details?.delivery;
      const formatter = new Intl.DateTimeFormat(WolkenworteI18n.getLocale(), {
        day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
      });
      let dateRange = '', days = '';
      if (delivery?.minDate && delivery?.maxDate) {
        const from = new Date(delivery.minDate + 'T12:00:00Z');
        const to = new Date(delivery.maxDate + 'T12:00:00Z');
        dateRange = delivery.minDate === delivery.maxDate ? formatter.format(from) : formatter.formatRange(from, to);
      }
      if (Number.isInteger(delivery?.minDays) && Number.isInteger(delivery?.maxDays)) {
        const min = WolkenworteI18n.formatNumber(delivery.minDays);
        const max = WolkenworteI18n.formatNumber(delivery.maxDays);
        days = delivery.minDays === delivery.maxDays
          ? t(delivery.minDays === 1 ? '{{count}} Tag' : '{{count}} Tage', { count: min })
          : t('{{min}}–{{max}} Tage', { min, max });
      }
      if (days || dateRange) {
        append('Voraussichtliche Lieferung: {{delivery}}', {
          delivery: days && dateRange ? `${days} (${dateRange})` : days || dateRange,
        }, 'delivery-estimate');
      } else {
        append('Eine Lieferzeit ist für diese Auswahl derzeit nicht verfügbar.', {}, 'delivery-estimate');
      }
      append('Die Lieferzeit ist eine Schätzung und kann sich ändern.');
      const shipments = details?.shipments || [];
      if (shipments.length > 1) append('Eure Produkte kommen voraussichtlich in {{count}} Sendungen.', { count: shipments.length });
      for (const shipment of shipments) {
        if (shipment.customsFeesPossible === false) continue;
        const products = shipment.items.map((item) => {
          const configuration = configurations.find((entry) => entry.product.key === item.productKey);
          return `${item.quantity} × ${configuration ? t(configuration.product.displayName) : t('Produkt')}`;
        }).join(', ');
        if (shipment.customsFeesPossible === true) {
          append('{{products}}: Bei der Einfuhr können zusätzliche Zölle, Steuern oder Gebühren anfallen. Die Höhe ist noch nicht bekannt.', { products }, 'delivery-warning');
        } else {
          append('{{products}}: Mögliche Einfuhrgebühren konnten noch nicht ermittelt werden.', { products }, 'delivery-warning');
        }
      }
      if (!shipments.length) append('Mögliche Einfuhrgebühren sind derzeit nicht bekannt.', {}, 'delivery-warning');
    }

    function showQuote(quote, { scroll = true, resetAction = true } = {}) {
      if (!quote?.id || typeof quote.currency !== 'string' ||
          ![quote.itemsCents, quote.shippingCents, quote.itemsCents + quote.shippingCents]
            .every((amount) => Number.isSafeInteger(amount) && amount >= 0)) {
        throw customerError('Preise und Lieferung konnten gerade nicht geprüft werden. Bitte versucht es gleich noch einmal.');
      }
      currentQuote = quote;
      const productLabel = totalProductLabel(Number(quote.quantity || 0));
      document.getElementById('items-label').textContent = productLabel;
      document.getElementById('items-price').textContent = formatMoney(quote.itemsCents, quote.currency);
      document.getElementById('shipping-price').textContent = formatMoney(quote.shippingCents, quote.currency);
      document.getElementById('subtotal-price').textContent = formatMoney(quote.itemsCents + quote.shippingCents, quote.currency);
      renderDeliveryInformation(quote.shippingDetails);
      quoteResult.hidden = false;
      if (resetAction) clearText(checkoutError);
      if (!checkoutButton.classList.contains('ww-is-busy')) checkoutButton.disabled = false;
      if (resetAction) setButtonLabel(checkoutButton, 'Weiter zur Zahlung');
      if (scroll) quoteResult.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function refreshLocalizedShipping() {
      if (!countries.length || !configurations.length || !shipmentList.children.length) return;
      const shipments = collectShipments({ validate: false }).shipments;
      const submitSource = submitButton.dataset.labelSource || 'Preise und Lieferung prüfen';
      const checkoutSource = checkoutButton.dataset.labelSource || 'Weiter zur Zahlung';
      refreshCountryDisplayNames();
      renderShipments(shipments);
      if (currentQuote) {
        showQuote(currentQuote, { scroll: false, resetAction: false });
      }
      setButtonLabel(submitButton, submitSource);
      setButtonLabel(checkoutButton, checkoutSource);
    }

    window.addEventListener('wolkenworte:localechange', refreshLocalizedShipping);

    function markInvalidFields(fields) {
      const fieldIds = { country_code: 'country', state_code: 'state' };
      const resolve = (name) => {
        if (name === 'shipments.quantity') return shipmentList.querySelector('[data-item-quantity]');
        const itemMatch = /^shipments\.(\d+)\.items(?:\.([A-Za-z0-9_-]{16}))?$/.exec(name);
        if (itemMatch) {
          const card = shipmentList.querySelectorAll('.shipment-card')[Number(itemMatch[1])];
          if (!card) return null;
          if (itemMatch[2]) {
            return card.querySelector(`[data-field-path="${name}"]`) ||
              card.querySelector(`[data-item-quantity][data-configuration-id="${itemMatch[2]}"]`);
          }
          return card.querySelector('[data-item-quantity]');
        }
        const direct = [...shipmentList.querySelectorAll('[data-field-path]')]
          .find((field) => field.dataset.fieldPath === name);
        if (direct) {
          if (direct.type === 'hidden') {
            return direct.closest('.search-picker')?.querySelector('.search-trigger') || direct;
          }
          return direct;
        }
        return document.getElementById(fieldIds[name] || name);
      };
      const first = fields.map(resolve).find(Boolean);
      fields.forEach((name) => resolve(name)?.setAttribute('aria-invalid', 'true'));
      first?.focus();
    }

    function shippingSnapshot(shipments) {
      return JSON.stringify((shipments || []).map(shipment => ({
        recipient: ['name', 'address1', 'address2', 'zip', 'city', 'country_code', 'state_code']
          .map(key => String(shipment.recipient?.[key] || '').trim()),
        items: (shipment.items || []).filter(item => Number(item.quantity) > 0)
          .map(item => [item.configurationId, Number(item.quantity)])
          .sort((left, right) => left[0].localeCompare(right[0])),
      })));
    }

    async function restoreSavedQuote(savedShipping) {
      if (!savedQuoteId || !/^[A-Za-z0-9_-]{24}$/.test(savedQuoteId)) return;
      const { response, result: saved } = await fetchShippingJson(
        `/api/events/${encodeURIComponent(slug)}/cart/quotes/${encodeURIComponent(savedQuoteId)}` +
        `?ids=${encodeURIComponent(configurationIds.join(','))}`,
        { cache: 'no-store' }
      );
      if (!response.ok || saved.shipments?.length !== 1) {
        clearQuote();
        setText(formError, customerErrorSource(saved, 'Bitte prüft Preise und Lieferung erneut.'));
        return;
      }
      if (savedShipping?.length && shippingSnapshot(savedShipping) !== shippingSnapshot(saved.shipments)) {
        // The URL can still refer to an older, cancelled checkout after the
        // customer has edited the address/quantity. Keep the newer tab draft.
        clearQuote();
        setText(formError, 'Bitte prüft Preise und Lieferung erneut.');
        return;
      }
      renderShipments(Array.isArray(saved.shipments) && saved.shipments.length
        ? saved.shipments
        : [defaultShipment()]);
      showQuote(saved.quote);
      setButtonLabel(submitButton, 'Preise aktualisieren');
      if (checkoutWasCancelled) {
        setText(checkoutError, 'Zahlung abgebrochen. Eure Angaben sind weiterhin gespeichert.');
      }
    }

    async function loadPage() {
      if (shippingReturnIsStale(true)) {
        backLink.href = `/e/${encodeURIComponent(slug)}/configure`;
        showFatal('Euer Warenkorb hat sich geändert oder wurde bereits bestellt. Bitte kehrt zum Design zurück.');
        return;
      }
      if (!configurationIds.length || configurationIds.some((id) => !/^[A-Za-z0-9_-]{16}$/.test(id))) {
        showFatal('Dieser Entwurf ist nicht gültig. Bitte kehrt zum Konfigurator zurück und bestätigt euer Design erneut.');
        return;
      }
      try {
        const configurationUrl = configurationIds.length === 1
          ? `/api/events/${encodeURIComponent(slug)}/configurations/${encodeURIComponent(configurationIds[0])}`
          : `/api/events/${encodeURIComponent(slug)}/configurations?ids=${encodeURIComponent(configurationIds.join(','))}`;
        const [configurationRequest, countriesRequest, eventRequest] = await Promise.all([
          fetchShippingJson(configurationUrl),
          fetchShippingJson('/api/shipping/countries'),
          fetchShippingJson(`/api/events/${encodeURIComponent(slug)}`),
        ]);
        const { response: configurationResponse, result: configurationData } = configurationRequest;
        const { response: countriesResponse, result: countriesData } = countriesRequest;
        const { response: eventResponse, result: eventData } = eventRequest;
        if (!configurationResponse.ok) throw new Error('configuration');
        if (!countriesResponse.ok) throw new Error(countriesData.message || 'countries');
        if (!eventResponse.ok) throw new Error('configuration');
        await WolkenworteI18n.useEventLocale(eventData.locale);
        WolkenworteJourney.remember(slug, eventData.title, true);
        refreshCountryDisplayNames();
        configurations = Array.isArray(configurationData.configurations)
          ? configurationData.configurations
          : [configurationData];
        if (!configurations.length) throw new Error('configuration');
        configuration = configurations[0];
        countries = countriesData.countries || [];
        if (!countries.length) throw new Error('countries');

        const savedShipping = shippingDraft?.restore(configurationIds);
        if (savedShipping?.length) {
          const knownIds = new Set(savedShipping.flatMap((shipment) => shipment.items.map((item) => item.configurationId)));
          const addedItems = defaultShipment().items.filter((item) => !knownIds.has(item.configurationId));
          savedShipping[0].items.push(...addedItems);
        }
        renderShipments(savedShipping?.length ? savedShipping : [defaultShipment()]);
        try { await restoreSavedQuote(savedShipping); }
        catch {
          // An unavailable old price must not hide the editable address form.
          setText(formError, 'Bitte prüft Preise und Lieferung erneut.');
        }
        shippingDraftReady = true;
        saveShippingDraft();
        submitButton.disabled = false;
        loading.hidden = true;
        pageContent.hidden = false;
      } catch (error) {
        showFatal(error.message === 'configuration'
          ? 'Der gespeicherte Entwurf wurde nicht gefunden. Bitte bestätigt euer Design erneut.'
          : 'Die Lieferländer konnten gerade nicht geladen werden. Bitte versucht es gleich noch einmal.');
      }
    }

    form.addEventListener('input', clearQuote);
    form.addEventListener('change', clearQuote);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (activeShippingRequest) return;
      clearFieldErrors();
      if (!form.reportValidity()) return;
      const { shipments, totalQuantity, quantityError } = collectShipments();
      if (quantityError || totalQuantity < 1 || totalQuantity > 99) return;
      clearQuote();
      const request = { controller: new AbortController(), revision: shippingRevision };
      activeShippingRequest = request;
      WolkenworteActions.setBusy(submitButton, true);
      try {
        const { response, result } = await fetchShippingJson(
          `/api/events/${encodeURIComponent(slug)}/cart/estimate-costs`,
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Wolkenworte-Guest-Id': guestId,
            },
            body: JSON.stringify({ configurationIds, shipments }),
          }, request.controller
        );
        if (activeShippingRequest !== request || request.revision !== shippingRevision) return;
        if (!response.ok) {
          if (Array.isArray(result.fields)) markInvalidFields(result.fields);
          throw customerError(customerErrorSource(result, 'Preise und Lieferung konnten gerade nicht geprüft werden. Bitte versucht es gleich noch einmal.'));
        }
        showQuote(result.quote);
        setButtonLabel(submitButton, 'Preise aktualisieren');
      } catch (error) {
        if (activeShippingRequest !== request || request.revision !== shippingRevision) return;
        setText(formError,
          error.customerSource || 'Preise und Lieferung konnten gerade nicht geprüft werden. Bitte versucht es gleich noch einmal.');
        setButtonLabel(submitButton, 'Erneut versuchen');
      } finally {
        finishShippingRequest(request);
      }
    });

    checkoutButton.addEventListener('click', async () => {
      if (!currentQuote?.id || activeShippingRequest) return;
      const request = { controller: new AbortController(), revision: shippingRevision };
      activeShippingRequest = request;
      // Freeze the address being confirmed, but leave Home/Back available.
      form.inert = true;
      submitButton.disabled = true;
      WolkenworteActions.setBusy(checkoutButton, true);
      clearText(checkoutError);
      let navigating = false;
      try {
        const { response, result } = await fetchShippingJson(
          `/api/events/${encodeURIComponent(slug)}/cart/checkout`,
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Wolkenworte-Guest-Id': guestId,
            },
            body: JSON.stringify({
              configurationIds,
              quoteId: currentQuote.id,
              locale: WolkenworteI18n.getLocale(),
            }),
          }, request.controller
        );
        if (activeShippingRequest !== request || request.revision !== shippingRevision) return;
        if (result.quote) showQuote(result.quote);
        if (!response.ok) {
          if (['quote_expired', 'quote_not_found', 'invalid_address', 'shipping_unavailable',
            'selection_not_available', 'pricing_unavailable', 'pricing_currency_mismatch', 'pricing_not_configured'].includes(result.error)) {
            clearQuote();
            setButtonLabel(submitButton, 'Preise und Lieferung erneut prüfen');
            setText(formError, customerErrorSource(result, 'Bitte prüft Preise und Lieferung erneut.'));
            return;
          }
          if (result.error === 'quote_changed' || result.error === 'quote_shipping_changed') {
            setButtonLabel(checkoutButton, result.error === 'quote_shipping_changed'
              ? 'Aktualisierte Lieferung bestätigen' : 'Neue Preise bestätigen');
            setText(checkoutError,
              customerErrorSource(result, 'Die Preise haben sich geändert. Bitte prüft und bestätigt die aktualisierten Angaben.'));
            return;
          }
          throw customerError(customerErrorSource(result,
            'Die Zahlungsseite konnte gerade nicht geöffnet werden. Bitte versucht es erneut.'));
        }
        const destination = result.confirmationUrl || result.url;
        if (!destination) throw customerError(
          'Die Zahlungsseite konnte gerade nicht geöffnet werden. Bitte versucht es erneut.');
        location.assign(destination);
        navigating = true;
      } catch (error) {
        if (activeShippingRequest !== request || request.revision !== shippingRevision) return;
        setText(checkoutError,
          error.customerSource || 'Die Zahlungsseite konnte gerade nicht geöffnet werden. Bitte versucht es erneut.');
        setButtonLabel(checkoutButton, 'Weiter zur Zahlung');
      } finally {
        if (!navigating) finishShippingRequest(request);
      }
    });

    loadPage();
  </script>
</body>
</html>
