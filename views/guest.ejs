<!DOCTYPE html>
<html lang="<%= locale %>" data-theme="pastel">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/z_icons/icon.svg?v=20260829-1" />
  <link rel="stylesheet" href="/site-header.css?v=20260829-2" />
  <link rel="stylesheet" href="/i18n.css?v=20260829-2" />
  <link rel="stylesheet" href="/site-fonts.css?v=20260829-1" />
  <script src="/js/i18n.js?v=20260829-3"></script>
  <script src="/js/site-header.js" defer></script>
  <title data-i18n-source="Wortwolke"><%= t('Wortwolke') %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Pastel theme (default) — matches the landing/create palette ── */
    :root {
      --bg:       #fffdfa;
      --bg2:      #fffdfa;
      --primary:  #400f26;
      --primary2: #9c1c4c;
      --accent:   #9c1c4c;
      --accent2:  #d1607e;
      --text:     #400f26;
      --muted:    #8a7178;
      --border:   rgba(193,146,47,0.35);
      --shadow:   rgba(64,15,38,0.09);
      --tag-bg:   rgba(247,238,223,0.55);
      --tag-bd:   rgba(193,146,47,0.32);
      --tag-tx:   #9c1c4c;
      --ph:       #b99aa3;
      --input-bg: #fffefc;
      --header-bd:   rgba(64,15,38,0.1);
    }

    /* ── Neon theme ── */
    [data-theme="neon"] {
      --bg:       #000000;
      --bg2:      #000000;
      --primary:  #ff10f0;
      --primary2: #bf00ff;
      --accent:   #00fff2;
      --accent2:  #39ff14;
      --text:     #f5f0ff;
      --muted:    #b39ddb;
      --border:   rgba(255,16,240,0.40);
      --shadow:   rgba(255,16,240,0.35);
      --tag-bg:   rgba(255,16,240,0.14);
      --tag-bd:   rgba(255,16,240,0.40);
      --tag-tx:   #ff8cf5;
      --ph:       #7a6a99;
      --input-bg: #0d0611;
      --header-bd:   rgba(255,16,240,0.28);
    }

    html, body {
      min-height: 100%;
      background: linear-gradient(160deg, var(--bg) 0%, var(--bg2) 100%);
      color: var(--text);
      font-family: 'Jost', system-ui, -apple-system, sans-serif;
      font-weight: 400;
      transition: background 0.5s, color 0.5s;
    }

    body {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100dvh;
      padding: 0 0 30px;
      background:
        radial-gradient(circle at 50% 4%, color-mix(in srgb, var(--accent2) 5%, transparent), transparent 34%),
        linear-gradient(160deg, var(--bg) 0%, var(--bg2) 100%);
    }

    .event-intro {
      width: min(620px, calc(100% - 40px));
      text-align: center;
      padding: 46px 0 28px;
    }

    .event-intro .eyebrow {
      font-family: 'Jost', system-ui, sans-serif;
      font-weight: 500;
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 10px;
      transition: color 0.5s;
    }

    .event-intro h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(34px, 7vw, 48px);
      font-weight: 500;
      font-style: italic;
      color: var(--primary2);
      line-height: 1.2;
      transition: color 0.5s;
    }

    .creator-tools {
      width: 100%;
      padding: 23px 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      border-top: 1px solid var(--header-bd);
      border-bottom: 1px solid var(--header-bd);
    }

    .creator-status { min-width: 0; }
    .creator-copy strong { display: block; font-size: 14px; font-weight: 600; }
    .creator-copy span { display: block; margin-top: 3px; color: var(--muted); font-size: 11.5px; }
    .creator-actions { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }
    .creator-action {
      min-height: 40px;
      padding: 10px 15px;
      border: 1px solid var(--header-bd);
      border-radius: 12px;
      background: color-mix(in srgb, var(--input-bg) 64%, transparent);
      color: var(--text);
      font: 500 12px/1 'Jost', system-ui, sans-serif;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform .18s, border-color .18s, color .18s, background .18s;
    }
    .creator-action:hover { transform: translateY(-1px); border-color: var(--primary2); color: var(--primary2); }
    .creator-action.primary {
      border-color: color-mix(in srgb, var(--primary2) 24%, transparent);
      background: color-mix(in srgb, var(--primary2) 7%, var(--input-bg));
      color: var(--primary2);
    }
    .creator-action.primary:hover { color: var(--primary2); }
    .share-fallback {
      width: 100%;
      flex: 1 0 100%;
      padding-top: 14px;
      border-top: 1px solid var(--header-bd);
    }
    .share-fallback label { display: block; margin-bottom: 7px; color: var(--muted); font-size: 11px; font-weight: 600; }
    .share-fallback-row { display: flex; gap: 8px; }
    .share-fallback input {
      min-width: 0;
      height: 42px;
      padding: 0 12px;
      flex: 1;
      border: 1px solid var(--header-bd);
      border-radius: 11px;
      background: var(--input-bg);
      color: var(--text);
      font: inherit;
      font-size: 13px;
    }
    .share-fallback-status { min-height: 16px; margin: 6px 0 0; color: var(--muted); font-size: 11px; }

    .card {
      width: min(620px, calc(100% - 40px));
      padding: 30px 0 0;
      display: grid;
      gap: 30px;
    }

    .prompt {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(21px, 4vw, 25px);
      font-style: italic;
      font-weight: 500;
      color: var(--primary2);
      text-align: center;
      margin-bottom: 20px;
      line-height: 1.3;
      transition: color 0.5s;
    }

    .input-wrap {
      display: flex;
      align-items: center;
      background: var(--input-bg);
      min-height: 66px;
      border: 1px solid var(--border);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 12px 34px color-mix(in srgb, var(--shadow) 72%, transparent);
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-wrap:focus-within {
      border-color: var(--primary);
      box-shadow: 0 15px 38px var(--shadow);
    }

    #word-input {
      flex: 1;
      min-width: 0;
      border: none;
      outline: none;
      background: transparent;
      font-family: 'Jost', system-ui, sans-serif;
      font-size: 18px;
      color: var(--text);
      padding: 18px 16px 18px 20px;
      transition: color 0.5s;
    }

    #word-input::placeholder { color: var(--ph); font-style: italic; }

    #submit-btn {
      min-width: 108px;
      min-height: 50px;
      margin: 7px;
      padding: 12px 17px;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      font: 600 12.5px/1 'Jost', system-ui, sans-serif;
      transition: transform 0.15s, opacity 0.15s, background 0.5s;
      line-height: 1;
    }
    #submit-btn .heart-icon { width: 16px; height: auto; }

    #submit-btn:active { transform: scale(0.94); }
    #submit-btn:disabled { opacity: 0.40; cursor: default; }

    .form-meta {
      min-height: 27px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 16px;
    }

    .char-counter {
      font-size: 11px;
      color: var(--muted);
      margin-top: 8px;
      padding-right: 3px;
      transition: color 0.5s;
    }

    .guest-actions {
      margin-top: 15px;
      display: flex;
      justify-content: center;
    }
    .preview-trigger {
      width: 100%;
      min-height: 68px;
      padding: 10px 16px 10px 11px;
      display: grid;
      grid-template-columns: 42px minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      border: 1px solid var(--header-bd);
      border-radius: 16px;
      background: color-mix(in srgb, var(--input-bg) 72%, transparent);
      color: var(--text);
      text-align: left;
      font-family: 'Jost', system-ui, sans-serif;
      box-shadow: none;
      cursor: pointer;
      transition: transform .18s, background .18s, border-color .18s, box-shadow .18s;
    }
    .preview-trigger:hover {
      transform: translateY(-2px);
      border-color: color-mix(in srgb, var(--primary2) 38%, transparent);
      background: var(--input-bg);
      box-shadow: 0 10px 28px color-mix(in srgb, var(--shadow) 68%, transparent);
    }
    .preview-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      border: 0;
      background: color-mix(in srgb, var(--tag-bg) 82%, var(--input-bg));
      transition: background .5s, border-color .5s;
    }
    .preview-icon img {
      width: 28px;
      height: 26px;
      display: block;
      object-fit: contain;
    }
    .preview-copy { min-width: 0; }
    .preview-copy strong {
      display: block;
      color: var(--primary2);
      font-size: 13px;
      font-weight: 600;
      line-height: 1.2;
    }
    .preview-count {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: 10.5px;
      font-weight: 400;
      line-height: 1.2;
    }
    .preview-chevron {
      color: var(--muted);
      font-size: 21px;
      font-weight: 300;
      line-height: 1;
      transition: transform .18s, color .18s;
    }
    .preview-trigger:hover .preview-chevron {
      color: var(--primary2);
      transform: translateX(2px);
    }

    .flash {
      min-height: 18px;
      margin-top: 7px;
      font-size: 12px;
      color: var(--primary2);
      opacity: 0;
      transition: opacity 0.3s, color 0.5s;
    }
    .flash.show { opacity: 1; }

    .submitted-section {
      padding-top: 24px;
      border-top: 1px solid var(--header-bd);
    }

    .submitted-label {
      font-size: 11px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 16px;
      transition: color 0.5s;
    }

    .memory-cta {
      padding: 2px 0 4px;
    }
    .memory-cta-head {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      align-items: center;
      gap: 13px;
    }
    .memory-cta-icon {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border: 1px solid var(--tag-bd);
      border-radius: 14px;
      background: color-mix(in srgb, var(--tag-bg) 84%, var(--input-bg));
    }
    .memory-cta-icon img { width: 29px; height: 27px; object-fit: contain; }
    .memory-cta-eyebrow {
      margin: 0 0 3px;
      color: var(--accent);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .memory-cta h2 {
      margin: 0;
      color: var(--primary2);
      font: italic 500 20px/1.2 'Playfair Display', Georgia, serif;
    }
    .memory-cta-copy {
      margin: 15px 0 18px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.55;
    }
    .memory-cta-link {
      min-height: 48px;
      padding: 13px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      border-radius: 14px;
      background: var(--primary);
      color: #fff;
      font-size: 12.5px;
      font-weight: 600;
      text-decoration: none;
      transition: transform .18s, box-shadow .18s, background .5s;
    }
    .memory-cta-link:hover { transform: translateY(-1px); box-shadow: 0 10px 24px var(--shadow); }
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: var(--tag-bg);
      border: 1px solid var(--tag-bd);
      color: var(--tag-tx);
      padding: 8px 8px 8px 15px;
      border-radius: 13px;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 15px;
      animation: tagIn 0.35s ease both;
      transition: background 0.5s, border-color 0.5s, color 0.5s, opacity .18s, transform .18s;
    }

    .tag-remove {
      position: static;
      width: 25px;
      height: 25px;
      display: grid;
      place-items: center;
      padding: 0 0 1px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: var(--tag-tx);
      font: 400 16px/1 'Jost', system-ui, sans-serif;
      cursor: pointer;
      transition: transform .16s, border-color .16s, background .5s, color .5s, opacity .16s;
    }
    .tag-remove:hover {
      background: color-mix(in srgb, var(--primary2) 8%, transparent);
      color: var(--primary2);
      transform: none;
    }
    .tag-remove:active { transform: scale(.94); }
    .tag-remove:disabled { cursor: wait; opacity: .55; transform: rotate(45deg); }
    .tag.remove-pending { opacity: .58; transform: scale(.97); }
    .tag.removed {
      pointer-events: none;
      animation: tagOut .18s ease forwards;
    }

    @keyframes tagIn {
      from { opacity: 0; transform: scale(0.8) translateY(6px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }
    @keyframes tagOut {
      to { opacity: 0; transform: scale(.82) translateY(-4px); }
    }

    .guest-footer {
      margin-top: 58px;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: var(--muted);
      font-size: 10.5px;
      line-height: 1;
    }
    .guest-footer a {
      color: inherit;
      text-decoration: none;
      transition: color .18s;
    }
    .guest-footer a:hover { color: var(--primary2); }

    .error-state {
      text-align: center;
      margin-top: 60px;
      font-family: 'Playfair Display', Georgia, serif;
      font-style: italic;
      color: var(--muted);
    }

    .cloud-preview {
      position: fixed;
      inset: 0;
      z-index: 200;
      padding: 24px;
      display: grid;
      place-items: center;
    }
    .cloud-preview-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(35, 10, 22, .46);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    .cloud-preview-dialog {
      position: relative;
      width: min(860px, 100%);
      height: min(760px, calc(100dvh - 48px));
      max-height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 1px solid var(--header-bd);
      border-radius: 28px;
      background: var(--bg);
      color: var(--text);
      box-shadow: 0 36px 100px rgba(35, 10, 22, .24);
      transform: translateY(14px) scale(.985);
      opacity: 0;
      transition: transform .24s ease, opacity .24s ease, background .5s, color .5s;
    }
    .cloud-preview.open .cloud-preview-dialog { transform: translateY(0) scale(1); opacity: 1; }
    .cloud-preview-head {
      min-height: 88px;
      padding: 20px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      border-bottom: 1px solid var(--header-bd);
    }
    .cloud-preview-eyebrow {
      margin: 0 0 5px;
      color: var(--accent);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: .2em;
      text-transform: uppercase;
    }
    .cloud-preview-title {
      margin: 0;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(24px, 4vw, 34px);
      font-style: italic;
      font-weight: 500;
      color: var(--primary2);
    }
    .cloud-preview-meta { display: flex; align-items: center; gap: 13px; }
    .cloud-preview-total { color: var(--muted); font-size: 12px; white-space: nowrap; }
    .cloud-preview-total strong {
      margin-right: 4px;
      color: var(--primary2);
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px;
      font-weight: 500;
    }
    .cloud-preview-close {
      width: 40px;
      height: 40px;
      border: 1px solid var(--header-bd);
      border-radius: 50%;
      background: transparent;
      color: var(--text);
      font: 300 25px/1 'Jost', system-ui, sans-serif;
      cursor: pointer;
      transition: border-color .18s, color .18s, transform .18s;
    }
    .cloud-preview-close:hover { border-color: var(--primary2); color: var(--primary2); transform: rotate(4deg); }
    .cloud-preview-stage {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      padding: 22px;
      display: grid;
      place-items: center;
      overflow: hidden;
    }
    .preview-memory-cta {
      position: absolute;
      top: 22px;
      right: 22px;
      z-index: 2;
      padding: 12px 20px;
      border-radius: 999px;
      background: var(--primary);
      box-shadow: 0 6px 20px var(--border);
      color: #fff;
      font: 500 14px/1 'Playfair Display', Georgia, serif;
      text-decoration: none;
      white-space: nowrap;
      transition: transform .15s, background .5s;
    }
    .preview-memory-cta:hover { transform: translateY(-1px); }
    #preview-canvas { display: block; max-width: 100%; max-height: 100%; opacity: 0; transition: opacity .25s; }
    #preview-canvas.visible { opacity: 1; }
    .cloud-preview-empty { text-align: center; color: var(--muted); }
    .cloud-preview-empty .heart-icon { width: 35px; height: auto; color: var(--accent2); }
    .cloud-preview-empty strong {
      display: block;
      margin-top: 14px;
      color: var(--primary2);
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px;
      font-style: italic;
      font-weight: 500;
    }
    .cloud-preview-empty span { display: block; margin-top: 7px; font-size: 12px; }
    .cloud-preview-foot {
      min-height: 78px;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      border-top: 1px solid var(--header-bd);
      color: var(--muted);
      font-size: 11px;
    }
    .preview-display-link { color: var(--primary2); font-weight: 500; text-decoration: none; white-space: nowrap; }
    .preview-display-link:hover { text-decoration: underline; text-underline-offset: 3px; }
    .preview-foot-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 18px;
      min-width: 0;
    }
    .preview-qr-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .preview-qr-label { text-align: right; min-width: 0; }
    .preview-qr-label .line1 {
      color: var(--muted);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: .15em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .preview-qr-label .line2 {
      margin-top: 2px;
      max-width: 190px;
      overflow: hidden;
      color: var(--primary2);
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 12px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .preview-qr-code {
      width: 58px;
      height: 58px;
      flex: 0 0 auto;
      padding: 3px;
      border: 1px solid var(--tag-bd);
      border-radius: 10px;
      background: var(--bg);
      object-fit: contain;
    }
    body.preview-open { overflow: hidden; }

    .setup-toast {
      position: fixed;
      left: 50%;
      bottom: 24px;
      z-index: 260;
      width: min(430px, calc(100% - 32px));
      padding: 15px 15px 15px 17px;
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1px solid var(--header-bd);
      border-radius: 18px;
      background: color-mix(in srgb, var(--input-bg) 96%, transparent);
      box-shadow: 0 22px 60px rgba(35, 10, 22, .18);
      animation: setupToastIn .3s ease both;
    }
    .setup-toast-mark {
      width: 30px;
      height: 30px;
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--primary);
      color: #fff;
      font-size: 14px;
    }
    .setup-toast-copy { min-width: 0; flex: 1; }
    .setup-toast-copy strong { display: block; font-size: 13px; }
    .setup-toast-copy span { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; }
    .setup-toast-close { border: 0; background: none; color: var(--muted); font-size: 20px; cursor: pointer; }
    @keyframes setupToastIn { from { opacity: 0; transform: translate(-50%, 12px); } to { opacity: 1; transform: translate(-50%, 0); } }

    [hidden] { display: none !important; }

    button:focus-visible,
    a:focus-visible,
    input:focus-visible {
      outline: 2px solid var(--primary2);
      outline-offset: 3px;
    }

    @media (max-width: 620px) {
      body { padding-bottom: 24px; }
      .event-intro { width: calc(100% - 32px); padding: 34px 0 22px; }
      .event-intro h1 { font-size: clamp(34px, 11vw, 43px); }
      .card { width: calc(100% - 32px); padding-top: 24px; gap: 26px; }
      .prompt { margin-bottom: 17px; font-size: 21px; }
      .input-wrap { min-height: 62px; }
      #word-input { padding: 16px 10px 16px 16px; font-size: 16px; }
      #submit-btn { min-width: 96px; min-height: 48px; margin: 6px; padding: 11px 14px; }
      .creator-tools { align-items: stretch; flex-direction: column; padding: 21px 0; gap: 14px; }
      .creator-actions { width: 100%; }
      .creator-action { flex: 1; }
      .memory-cta { padding: 0 0 3px; }
      .memory-cta h2 { font-size: 19px; }
      .guest-footer { margin-top: 46px; }
      .cloud-preview { padding: 0; }
      .cloud-preview-dialog { width: 100%; height: 100dvh; max-height: none; border: 0; border-radius: 0; }
      .cloud-preview-head { min-height: 78px; padding: 16px; }
      .cloud-preview-meta { gap: 9px; }
      .cloud-preview-total span { display: none; }
      .cloud-preview-stage { padding: 14px; }
      .preview-memory-cta { top: 14px; right: 14px; padding: 11px 16px; font-size: 13px; }
      .cloud-preview-foot { min-height: 76px; padding: 10px 16px; gap: 10px; }
      #preview-live-copy { display: none; }
      .preview-foot-actions { flex: 1; gap: 12px; justify-content: space-between; }
      .preview-qr-label .line2 { display: none; }
      .preview-qr-code { width: 52px; height: 52px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .cloud-preview-dialog, .setup-toast { animation: none; transition: none; }
    }
  </style>
</head>
<body>

<%- include('partials/site-header') %>

<section class="event-intro" aria-labelledby="couple-name">
  <p class="eyebrow">Herzlich willkommen</p>
  <h1 id="couple-name" data-i18n-ignore>♡</h1>
</section>

<section class="creator-tools" id="draft-details" hidden>
  <div class="creator-status"><div class="creator-copy"><strong>Diese Wortwolke gehört euch.</strong><span>Ihr könnt Namen und Admin-PIN auch später festlegen.</span></div></div>
  <form id="draft-details-form" class="creator-actions">
    <input id="draft-couple-name" type="text" maxlength="80" placeholder="Namen hinzufügen" aria-label="Namen" />
    <input id="draft-pin" type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="PIN" aria-label="Admin-PIN" />
    <button class="creator-action primary" type="submit">Speichern</button>
  </form>
</section>

<main class="card">
  <section class="contribution" aria-labelledby="contribution-title">
    <h2 class="prompt" id="contribution-title">Teilt ein Wort für das Brautpaar.</h2>

    <div class="input-wrap">
      <input
        id="word-input"
        type="text"
        inputmode="text"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        maxlength="30"
        placeholder="Liebe, Glück, Freude, Vertrauen…"
        aria-label="Ein Wort eingeben"
      />
      <button id="submit-btn" type="button" aria-label="Wort teilen"><span class="submit-label">Teilen</span><svg class="heart-icon" viewBox="0 0 80 70" aria-hidden="true"><path d="M40 62C18 48 7 36 8 21c1-12 17-15 25-3C39 6 56 9 58 21c2 15-10 27-18 41Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 16c3-4 8-5 12-3" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></button>
    </div>
    <div class="form-meta">
      <div class="flash" id="flash" role="status" aria-live="polite"></div>
      <div class="char-counter"><span id="char-count">0</span> / 30</div>
    </div>

    <div class="guest-actions">
      <button class="preview-trigger" id="preview-trigger" type="button" aria-controls="cloud-preview" aria-expanded="false">
        <span class="preview-icon" aria-hidden="true">
          <img src="/z_icons/icon.svg?v=20260829-1" alt="" />
        </span>
        <span class="preview-copy">
          <strong>Wortwolke ansehen</strong>
          <span class="preview-count" id="preview-count">Noch keine Wörter</span>
        </span>
        <span class="preview-chevron" aria-hidden="true">›</span>
      </button>
    </div>
  </section>

  <section class="submitted-section" id="submitted-section" hidden>
    <p class="submitted-label">Deine Wörter</p>
    <div class="tags" id="tags"></div>
  </section>

  <section class="creator-tools" id="creator-tools" aria-label="Wortwolke teilen und Anzeige öffnen">
    <div class="creator-status">
      <div class="creator-copy">
        <strong>Wortwolke weitergeben</strong>
        <span>Teilt den Link oder öffnet die große Anzeige.</span>
      </div>
    </div>
    <div class="creator-actions">
      <button class="creator-action" id="share-link" type="button"><span id="share-label">Link teilen</span></button>
      <a class="creator-action primary" id="display-link" href="#" target="_blank" rel="noopener">Anzeige öffnen&nbsp;↗</a>
    </div>
    <div class="share-fallback" id="share-fallback" hidden>
      <label for="share-fallback-url">Link zur Wortwolke</label>
      <div class="share-fallback-row">
        <input id="share-fallback-url" type="text" readonly />
        <button class="creator-action" id="share-fallback-copy" type="button">Link kopieren</button>
      </div>
      <p class="share-fallback-status" id="share-fallback-status" role="status" aria-live="polite"></p>
    </div>
  </section>

  <section class="memory-cta" aria-labelledby="memory-cta-title">
    <div class="memory-cta-head">
      <span class="memory-cta-icon" aria-hidden="true"><img src="/z_icons/icon.svg?v=20260829-1" alt="" /></span>
      <div>
        <p class="memory-cta-eyebrow">Euer Moment. Eure Erinnerung.</p>
        <h2 id="memory-cta-title">Haltet euren Moment fest.</h2>
      </div>
    </div>
    <p class="memory-cta-copy">Gestaltet euer persönliches Erinnerungsstück – mit eigenen Fotos, Namen und Worten. Ganz unabhängig von der Hochzeits-Wortwolke.</p>
    <a class="memory-cta-link" id="memory-cta-link" href="#"><span>Persönliche Erinnerung gestalten</span><span aria-hidden="true">→</span></a>
  </section>

</main>

<footer class="guest-footer" aria-label="Rechtliche Hinweise">
  <a href="/datenschutz">Datenschutz</a>
  <span aria-hidden="true">·</span>
  <a href="/impressum">Impressum</a>
</footer>

<div class="cloud-preview" id="cloud-preview" hidden>
  <div class="cloud-preview-backdrop" data-preview-close></div>
  <section class="cloud-preview-dialog" role="dialog" aria-modal="true" aria-labelledby="cloud-preview-title">
    <header class="cloud-preview-head">
      <div>
        <p class="cloud-preview-eyebrow">Live-Vorschau</p>
        <h2 class="cloud-preview-title" id="cloud-preview-title">Eure Wortwolke</h2>
      </div>
      <div class="cloud-preview-meta">
        <p class="cloud-preview-total"><strong id="preview-total">0</strong><span>Wörter geteilt</span></p>
        <button class="cloud-preview-close" id="preview-close" type="button" aria-label="Vorschau schließen">×</button>
      </div>
    </header>
    <div class="cloud-preview-stage" id="preview-stage">
      <a class="preview-memory-cta" id="preview-memory-cta" href="#" hidden>Wortwolke verewigen</a>
      <canvas id="preview-canvas" aria-label="Live-Wortwolke"></canvas>
      <div class="cloud-preview-empty" id="preview-empty">
        <svg class="heart-icon" viewBox="0 0 80 70" aria-hidden="true"><path d="M40 62C18 48 7 36 8 21c1-12 17-15 25-3C39 6 56 9 58 21c2 15-10 27-18 41Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 16c3-4 8-5 12-3" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
        <strong>Noch ist die Wolke ganz leicht.</strong>
        <span>Teilt das erste Wort – sie wächst sofort live mit.</span>
      </div>
    </div>
    <footer class="cloud-preview-foot">
      <span id="preview-live-copy">Noch keine Wörter geteilt</span>
      <div class="preview-foot-actions">
        <a class="preview-display-link" id="preview-display-link" href="#" target="_blank" rel="noopener">Auf der Anzeige öffnen&nbsp;↗</a>
        <div class="preview-qr-wrap" id="preview-qr" hidden>
          <div class="preview-qr-label">
            <div class="line1">Scannen &amp; mitmachen</div>
            <div class="line2" id="preview-qr-url"></div>
          </div>
          <img class="preview-qr-code" id="preview-qr-img" src="" alt="QR-Code zum Mitmachen" />
        </div>
      </div>
    </footer>
  </section>
</div>

<div class="setup-toast" id="setup-toast" role="status" hidden>
  <span class="setup-toast-mark" aria-hidden="true">✓</span>
  <div class="setup-toast-copy">
    <strong>Eure Wortwolke ist live.</strong>
    <span>Bitte bewahrt euren Admin-PIN sicher auf.</span>
  </div>
  <button class="setup-toast-close" id="setup-toast-close" type="button" aria-label="Hinweis schließen">×</button>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/wordcloud-core.js?v=20260819-2"></script>
<script>
  // Slug comes from the URL: /e/<slug>
  const slug = location.pathname.split('/').filter(Boolean)[1];
  const urlTheme = new URLSearchParams(location.search).get('theme');
  const displayUrl = `/e/${encodeURIComponent(slug)}/display`;
  const guestUrl = `${location.origin}/e/${encodeURIComponent(slug)}`;
  const guestId = getOrCreateGuestId();
  const socket = io({
    query: { slug, guestId },
    transports: ['websocket', 'polling'],
    tryAllTransports: true,
    timeout: 7000,
  });
  let socketHasConnected = false;
  socket.on('connect_error', () => {
    if (!socketHasConnected) socket.io.opts.transports = ['polling', 'websocket'];
  });
  socket.on('connect', () => {
    socketHasConnected = true;
    socket.io.opts.transports = ['websocket', 'polling'];
  });
  const input   = document.getElementById('word-input');
  const btn     = document.getElementById('submit-btn');
  const flash   = document.getElementById('flash');
  const tags    = document.getElementById('tags');
  const section = document.getElementById('submitted-section');
  const charCount = document.getElementById('char-count');
  const shareButton = document.getElementById('share-link');
  const shareLabel = document.getElementById('share-label');
  const shareFallback = document.getElementById('share-fallback');
  const shareFallbackUrl = document.getElementById('share-fallback-url');
  const shareFallbackCopy = document.getElementById('share-fallback-copy');
  const shareFallbackStatus = document.getElementById('share-fallback-status');
  const displayLink = document.getElementById('display-link');
  const previewTrigger = document.getElementById('preview-trigger');
  const previewCount = document.getElementById('preview-count');
  const preview = document.getElementById('cloud-preview');
  const previewDialog = preview.querySelector('.cloud-preview-dialog');
  const previewClose = document.getElementById('preview-close');
  const previewStage = document.getElementById('preview-stage');
  const previewCanvas = document.getElementById('preview-canvas');
  const previewEmpty = document.getElementById('preview-empty');
  const previewTotal = document.getElementById('preview-total');
  const previewLiveCopy = document.getElementById('preview-live-copy');
  const previewMemoryCta = document.getElementById('preview-memory-cta');
  const previewDisplayLink = document.getElementById('preview-display-link');
  const previewQr = document.getElementById('preview-qr');
  const previewQrImg = document.getElementById('preview-qr-img');
  const previewQrUrl = document.getElementById('preview-qr-url');
  const setupToast = document.getElementById('setup-toast');
  const setupToastClose = document.getElementById('setup-toast-close');
  const memoryCtaLink = document.getElementById('memory-cta-link');
  const previewContext = previewCanvas.getContext('2d');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const t = (source, params) => WolkenworteI18n.t(source, params);
  const setText = (element, source, params) => WolkenworteI18n.setText(element, source, params);

  let currentWords = [];
  let previewOpen = false;
  let previewRenderTimer = null;
  let previewCloseTimer = null;
  let previewReturnFocus = null;
  let shareResetTimer = null;
  let flashTimer = null;
  let currentTheme = urlTheme === 'neon' || urlTheme === 'pastel' ? urlTheme : 'pastel';
  let previewWordColor = WordCloudCore.makeColorAssigner(currentTheme);
  const ownTags = new Map();

  function getOrCreateGuestId() {
    const storageKey = `guest-session:${slug}`;
    try {
      const existing = sessionStorage.getItem(storageKey);
      if (/^[a-f0-9]{32}$/.test(existing || '')) return existing;
    } catch {}

    const bytes = new Uint8Array(16);
    if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
      window.crypto.getRandomValues(bytes);
    } else {
      for (let index = 0; index < bytes.length; index += 1) {
        bytes[index] = Math.floor(Math.random() * 256);
      }
    }
    const created = [...bytes].map((byte) => byte.toString(16).padStart(2, '0')).join('');
    try { sessionStorage.setItem(storageKey, created); } catch {}
    return created;
  }

  function readSession(key) {
    try { return sessionStorage.getItem(key); } catch { return null; }
  }

  function removeSession(key) {
    try { sessionStorage.removeItem(key); } catch {}
  }

  function applyTheme(theme) {
    if (theme !== 'neon' && theme !== 'pastel') return;
    currentTheme = theme;
    document.documentElement.dataset.theme = theme;
    previewWordColor = WordCloudCore.makeColorAssigner(theme);
    schedulePreviewRender();
  }

  applyTheme(currentTheme);

  memoryCtaLink.href = `/e/${encodeURIComponent(slug)}/configure?mode=personal`;
  previewMemoryCta.href = `/e/${encodeURIComponent(slug)}/configure`;
  displayLink.href = displayUrl;
  previewDisplayLink.href = displayUrl;

  fetch(`/api/events/${encodeURIComponent(slug)}/qr`)
    .then(r => r.ok ? r.json() : Promise.reject())
    .then(({ dataUrl, url }) => {
      previewQrImg.src = dataUrl;
      previewQrUrl.textContent = String(url || '').replace('http://', '').replace('https://', '');
      previewQr.hidden = false;
    })
    .catch(() => {});

  if (readSession(`creation-notice:${slug}`) === '1') {
    removeSession(`creation-notice:${slug}`);
    setupToast.hidden = false;
    window.setTimeout(hideSetupToast, 8000);
  }

  function hideSetupToast() {
    setupToast.hidden = true;
  }

  setupToastClose.addEventListener('click', hideSetupToast);

  shareButton.addEventListener('click', async () => {
    try {
      if (navigator.share) {
        await navigator.share({
          title: document.title,
          text: t('Teile ein Wort für unsere Wortwolke:'),
          url: guestUrl,
        });
        showShareConfirmation(t('Geteilt ✓'));
        return;
      }

      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(guestUrl);
      } else if (!copyWithTemporaryInput(guestUrl)) {
        showShareFallback();
        return;
      }
      showShareConfirmation(t('Link kopiert ✓'));
    } catch (error) {
      if (error && error.name === 'AbortError') return;
      showShareFallback();
    }
  });

  function showShareFallback() {
    shareFallbackUrl.value = guestUrl;
    shareFallback.hidden = false;
    shareFallbackStatus.textContent = '';
    shareFallbackUrl.focus();
    shareFallbackUrl.select();
  }

  shareFallbackCopy.addEventListener('click', async () => {
    let copied = false;
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(guestUrl);
        copied = true;
      } else {
        copied = copyWithTemporaryInput(guestUrl);
      }
    } catch {}
    shareFallbackStatus.textContent = copied
      ? t('Link kopiert ✓')
      : t('Der Link ist bereit zum Kopieren.');
    if (!copied) {
      shareFallbackUrl.focus();
      shareFallbackUrl.select();
    }
  });

  function copyWithTemporaryInput(value) {
    const temporaryInput = document.createElement('textarea');
    temporaryInput.value = value;
    temporaryInput.setAttribute('readonly', '');
    temporaryInput.style.position = 'fixed';
    temporaryInput.style.opacity = '0';
    document.body.appendChild(temporaryInput);
    temporaryInput.select();
    let copied = false;
    try { copied = document.execCommand('copy'); } catch {}
    temporaryInput.remove();
    return copied;
  }

  function showShareConfirmation(message) {
    clearTimeout(shareResetTimer);
    shareLabel.textContent = message;
    shareResetTimer = setTimeout(() => { setText(shareLabel, 'Link teilen'); }, 1800);
  }

  function updatePreview(words) {
    currentWords = Array.isArray(words) ? words : [];
    const total = currentWords.reduce((sum, [, count]) => sum + Number(count || 0), 0);
    previewTotal.textContent = String(total);
    previewCount.textContent = total === 0
      ? t('Noch keine Wörter')
      : t(total === 1 ? '{{count}} Wort live' : '{{count}} Wörter live', { count: total });
    previewLiveCopy.textContent = total === 0
      ? t('Noch keine Wörter geteilt')
      : t(total === 1 ? '{{count}} Wort live geteilt' : '{{count}} Wörter live geteilt', { count: total });
    previewEmpty.hidden = currentWords.length > 0;
    previewCanvas.hidden = currentWords.length === 0;
    previewMemoryCta.hidden = currentWords.length === 0;
    if (!currentWords.length) previewCanvas.classList.remove('visible');
    schedulePreviewRender();
  }

  function schedulePreviewRender() {
    if (!previewOpen || !currentWords.length) return;
    clearTimeout(previewRenderTimer);
    previewRenderTimer = setTimeout(renderPreview, 70);
  }

  function renderPreview() {
    if (!previewOpen || !currentWords.length) return;
    const bounds = previewStage.getBoundingClientRect();
    const side = Math.floor(Math.max(220, Math.min(bounds.width - 40, bounds.height - 40)));
    const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

    previewCanvas.width = Math.round(side * pixelRatio);
    previewCanvas.height = Math.round(side * pixelRatio);
    previewCanvas.style.width = `${side}px`;
    previewCanvas.style.height = `${side}px`;
    previewContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    previewContext.clearRect(0, 0, side, side);

    const placed = WordCloudCore.layoutWords(currentWords, side, previewContext, previewWordColor);
    previewContext.textAlign = 'center';
    previewContext.textBaseline = 'alphabetic';

    for (const item of placed) {
      previewContext.font = `${item.fontPx}px ${WordCloudCore.FONT_FAMILY}`;
      previewContext.fillStyle = item.color;
      if (item.rotated) {
        previewContext.save();
        previewContext.translate(item.x, item.y);
        previewContext.rotate(-Math.PI / 2);
        previewContext.fillText(item.word, 0, item.fontPx * .34);
        previewContext.restore();
      } else {
        previewContext.fillText(item.word, item.x, item.y + item.fontPx * .34);
      }
    }

    previewCanvas.classList.add('visible');
  }

  function openPreview() {
    clearTimeout(previewCloseTimer);
    previewReturnFocus = document.activeElement;
    preview.hidden = false;
    previewOpen = true;
    previewTrigger.setAttribute('aria-expanded', 'true');
    document.body.classList.add('preview-open');
    requestAnimationFrame(() => {
      preview.classList.add('open');
      previewClose.focus();
      schedulePreviewRender();
    });
  }

  function closePreview() {
    if (!previewOpen) return;
    previewOpen = false;
    previewTrigger.setAttribute('aria-expanded', 'false');
    preview.classList.remove('open');
    document.body.classList.remove('preview-open');
    clearTimeout(previewRenderTimer);
    const finish = () => {
      preview.hidden = true;
      if (previewReturnFocus && typeof previewReturnFocus.focus === 'function') {
        previewReturnFocus.focus();
      }
    };
    if (reducedMotion.matches) finish();
    else previewCloseTimer = setTimeout(finish, 180);
  }

  previewTrigger.addEventListener('click', openPreview);
  previewClose.addEventListener('click', closePreview);
  preview.addEventListener('click', (event) => {
    if (event.target.hasAttribute('data-preview-close')) closePreview();
  });
  previewDialog.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      event.preventDefault();
      closePreview();
      return;
    }
    if (event.key !== 'Tab') return;
    const focusable = [...previewDialog.querySelectorAll('button:not([hidden]), a[href]:not([hidden])')];
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  window.addEventListener('resize', schedulePreviewRender);
  window.addEventListener('wolkenworte:localechange', () => updatePreview(currentWords));

  fetch(`/api/events/${encodeURIComponent(slug)}`)
    .then(r => r.json())
    .then(async ({ coupleName, theme, locale, isDraft, isDraftOwner }) => {
      await WolkenworteI18n.useEventLocale(locale);
      document.getElementById('couple-name').textContent = coupleName;
      setText(document.querySelector('title'), '{{name}} – Wortwolke', { name: coupleName });
      if (!urlTheme && (theme === 'neon' || theme === 'pastel')) {
        applyTheme(theme);
      }
      if (isDraft && isDraftOwner) {
        document.getElementById('draft-details').hidden = false;
        document.getElementById('contribution-title').textContent = 'Startet mit eurem ersten Wort.';
        input.focus();
      }
    })
    .catch(() => {});

  input.addEventListener('input', () => { charCount.textContent = input.value.length; });
  document.getElementById('draft-details-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const coupleName = document.getElementById('draft-couple-name').value.trim();
    const pin = document.getElementById('draft-pin').value.trim();
    if (!coupleName || !/^\d{4,6}$/.test(pin)) return showFlash('Bitte Namen und einen PIN mit 4–6 Ziffern eingeben.');
    const response = await fetch(`/api/events/${encodeURIComponent(slug)}/claim-draft`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ coupleName, pin }) });
    if (!response.ok) return showFlash('Die Angaben konnten nicht gespeichert werden.');
    document.getElementById('couple-name').textContent = coupleName;
    document.getElementById('draft-details').hidden = true;
  });
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.isComposing) submitWord(); });
  btn.addEventListener('click', submitWord);

  function submitWord() {
    const word = input.value.trim();
    if (!word) return;
    btn.disabled = true;
    socket.emit('submit-word', word);
    input.value = '';
    charCount.textContent = '0';
  }

  function showFlash(message) {
    clearTimeout(flashTimer);
    flash.textContent = message;
    flash.classList.add('show');
    flashTimer = setTimeout(() => flash.classList.remove('show'), 2200);
  }

  function addOwnWord(word, receipt) {
    if (typeof word !== 'string' || !word || typeof receipt !== 'string' || !receipt) return;
    if (ownTags.has(receipt)) return;

    section.hidden = false;
    const tag = document.createElement('span');
    tag.className = 'tag';
    tag.dataset.receipt = receipt;

    const label = document.createElement('span');
    label.className = 'tag-word';
    label.setAttribute('data-i18n-ignore', '');
    label.textContent = word;

    const removeButton = document.createElement('button');
    removeButton.className = 'tag-remove';
    removeButton.type = 'button';
    const removeLabel = t('„{{word}}“ entfernen', { word });
    removeButton.setAttribute('aria-label', removeLabel);
    removeButton.title = removeLabel;
    removeButton.textContent = '×';
    removeButton.addEventListener('click', () => removeOwnWord(receipt));

    tag.append(label, removeButton);
    tags.prepend(tag);
    ownTags.set(receipt, { word, tag, removeButton });
  }

  function renderOwnWords(contributions) {
    ownTags.clear();
    tags.replaceChildren();
    const safeContributions = Array.isArray(contributions) ? contributions : [];
    for (const contribution of safeContributions) {
      addOwnWord(contribution && contribution.word, contribution && contribution.receipt);
    }
    section.hidden = ownTags.size === 0;
  }

  function finishTagRemoval(receipt) {
    const entry = ownTags.get(receipt);
    if (!entry) return;
    entry.tag.classList.remove('remove-pending');
    entry.tag.classList.add('removed');
    ownTags.delete(receipt);
    setTimeout(() => {
      entry.tag.remove();
      section.hidden = ownTags.size === 0;
    }, 180);
    clearTimeout(flashTimer);
    flash.classList.remove('show');
  }

  function removeOwnWord(receipt) {
    const entry = ownTags.get(receipt);
    if (!entry || entry.tag.classList.contains('remove-pending')) return;
    entry.tag.classList.add('remove-pending');
    entry.removeButton.disabled = true;

    let settled = false;
    const timeout = setTimeout(() => finish({ ok: false, error: 'timeout' }), 4000);
    const finish = (result) => {
      if (settled) return;
      settled = true;
      clearTimeout(timeout);
      if (result && result.ok) {
        finishTagRemoval(receipt);
        return;
      }
      if (result && result.error === 'not_found') {
        finishTagRemoval(receipt);
        return;
      }
      entry.tag.classList.remove('remove-pending');
      entry.removeButton.disabled = false;
      showFlash(t('Das Wort konnte nicht entfernt werden. Bitte erneut versuchen.'));
    };

    socket.emit('remove-word', { receipt }, finish);
  }

  function setRemoveControlsDisabled(disabled) {
    for (const { tag, removeButton } of ownTags.values()) {
      if (!tag.classList.contains('remove-pending')) removeButton.disabled = disabled;
    }
  }

  socket.on('own-word-update', renderOwnWords);

  socket.on('word-accepted', (word, receipt) => {
    btn.disabled = false;
    input.focus();
    showFlash(t('„{{word}}“ wurde hinzugefügt!', { word }));
    addOwnWord(word, receipt);
  });

  socket.on('word-error', () => {
    btn.disabled = false;
    showFlash(t('Das Wort konnte nicht gespeichert werden. Bitte erneut versuchen.'));
  });

  socket.on('theme-change', (t) => {
    applyTheme(t);
  });

  socket.on('word-update', updatePreview);

  socket.on('round-reset', () => {
    renderOwnWords([]);
    showFlash(t('Eine neue Runde hat begonnen.'));
  });

  socket.on('fatal-error', (msg) => {
    const errorState = document.createElement('p');
    errorState.className = 'error-state';
    setText(errorState, 'Diese Wortwolke wurde nicht gefunden.');
    document.querySelector('main').replaceChildren(errorState);
  });

  socket.on('disconnect', () => {
    btn.disabled = true;
    setRemoveControlsDisabled(true);
    if (previewOpen) setText(previewLiveCopy, 'Verbindung wird wiederhergestellt…');
  });
  socket.on('connect', () => {
    btn.disabled = false;
    setRemoveControlsDisabled(false);
    updatePreview(currentWords);
  });
</script>
</body>
</html>
