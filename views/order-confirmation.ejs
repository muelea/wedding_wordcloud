<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/z_icons/icon.svg?v=20260829-1" />
  <link rel="stylesheet" href="/i18n.css?v=20260829-2" />
  <link rel="stylesheet" href="/site-fonts.css?v=20260829-1" />
  <link rel="stylesheet" href="/action-state.css?v=20260829-1" />
  <script src="/js/i18n.js?v=20260829-2"></script>
  <title data-i18n-source="Bestellung bestätigt – Wolkenworte"><%= t('Bestellung bestätigt – Wolkenworte') %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    :root {
      --bg: #fffdfa; --surface: #fffefc; --ink: #400f26; --berry: #9c1c4c;
      --muted: #8a7178; --line: rgba(64, 15, 38, .1); --success: #287a64;
    }
    html { min-height: 100%; background: var(--bg); color: var(--ink); font-family: 'Jost', system-ui, sans-serif; }
    body {
      min-height: 100vh; margin: 0; display: grid; grid-template-rows: auto 1fr;
      background: var(--bg);
    }
    .topbar {
      width: min(1120px, calc(100% - 48px)); min-height: 84px; margin: 0 auto; padding: 0; display: flex; align-items: center;
      border-bottom: 1px solid var(--line); background: rgba(255, 253, 250, .88); backdrop-filter: blur(14px);
    }
    .brand { display: inline-flex; align-items: center; gap: 9px; color: var(--ink); text-decoration: none; font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 600; }
    .brand-icon { width: 32px; height: 30px; object-fit: contain; }
    main { width: min(620px, calc(100% - 28px)); margin: auto; padding: 42px 0 70px; }
    .card {
      padding: clamp(28px, 7vw, 54px); text-align: center; background: rgba(255, 254, 253, .96);
      border: 1px solid var(--line); border-radius: 28px; box-shadow: 0 24px 70px rgba(64, 15, 38, .1);
    }
    .status-icon {
      width: 76px; height: 76px; margin: 0 auto 24px; border-radius: 50%; display: grid; place-items: center;
      background: rgba(40, 122, 100, .1); color: var(--success); font-size: 36px; font-weight: 600;
    }
    .status-icon.pending { color: var(--berry); background: rgba(164, 14, 76, .08); font-size: 25px; }
    .eyebrow { margin: 0 0 10px; color: var(--berry); font-size: 11px; font-weight: 600; letter-spacing: .17em; text-transform: uppercase; }
    h1 { margin: 0; font-family: 'Playfair Display', Georgia, serif; font-size: clamp(34px, 8vw, 49px); font-weight: 500; line-height: 1.08; }
    .copy { margin: 16px auto 0; max-width: 450px; color: var(--muted); font-size: 16px; line-height: 1.65; }
    .summary { margin: 28px 0 0; padding: 18px 20px; border-radius: 16px; background: #fbf2e7; text-align: left; }
    .summary-row { display: flex; justify-content: space-between; gap: 16px; margin: 7px 0; color: var(--muted); font-size: 14px; }
    .summary-row strong { color: var(--ink); font-weight: 600; }
    .home-link {
      display: inline-flex; margin-top: 28px; min-height: 48px; padding: 12px 24px; align-items: center; justify-content: center;
      border-radius: 999px; background: var(--ink); color: #fff; text-decoration: none; font-weight: 600;
    }
    .error { color: #b33a4d; }
    [hidden] { display: none !important; }
    @media (max-width: 620px) {
      .topbar { width: min(100% - 32px, 560px); min-height: 72px; }
      .brand { font-size: 18px; }
      .brand-icon { width: 28px; height: 26px; }
    }
  </style>
  <link rel="stylesheet" href="/site-header.css?v=20260829-2" />
  <script src="/js/site-header.js" defer></script>
</head>
<body>
  <%- include('partials/site-header') %>
  <main>
    <section class="card" aria-live="polite">
      <div class="status-icon pending" id="status-icon" aria-hidden="true"><span class="ww-loading-spinner"></span></div>
      <p class="eyebrow">Bestellbestätigung</p>
      <h1 id="title">Zahlung wird bestätigt</h1>
      <p class="copy" id="copy">Einen Moment bitte. Wir bestätigen eure Zahlung.</p>
      <div class="summary" id="summary" hidden>
        <div class="summary-row"><span>Bestellung</span><strong id="quantity"></strong></div>
        <div class="summary-row"><span>Gesamtbetrag</span><strong id="total"></strong></div>
      </div>
      <a class="home-link" id="home-link" href="/">Zurück zur Wortwolke</a>
    </section>
  </main>
  <script>
    'use strict';
    const parts = location.pathname.split('/').filter(Boolean);
    const slug = parts[1];
    const t = (source, params) => WolkenworteI18n.t(source, params);
    const sessionId = new URLSearchParams(location.search).get('session_id') || '';
    const icon = document.getElementById('status-icon');
    const title = document.getElementById('title');
    const copy = document.getElementById('copy');
    const summary = document.getElementById('summary');
    const homeLink = document.getElementById('home-link');
    homeLink.href = `/e/${encodeURIComponent(slug)}/display`;

    function money(cents, currency) {
      return WolkenworteI18n.formatCurrency(cents, currency);
    }

    function showError(message) {
      icon.textContent = '!';
      icon.classList.remove('pending');
      icon.classList.add('error');
      title.textContent = t('Bestätigung nicht gefunden');
      copy.textContent = t(message);
    }

    async function checkStatus(attempt = 0) {
      if (!/^cs_[A-Za-z0-9_]+$/.test(sessionId)) {
        showError('Der Zahlungslink ist unvollständig. Bitte kehrt zur Zahlungsseite zurück.');
        return;
      }
      try {
        const response = await fetch(
          `/api/events/${encodeURIComponent(slug)}/orders/status?session_id=${encodeURIComponent(sessionId)}`,
          { cache: 'no-store' }
        );
        const order = await response.json();
        if (!response.ok) throw new Error('Die Bestellung konnte nicht geladen werden.');
        if (order.configurationType === 'personal_memory') {
          homeLink.href = `/e/${encodeURIComponent(slug)}`;
          homeLink.textContent = t('Zurück zur Gäste-Seite');
        }
        if (order.paymentConfirmed) {
          icon.textContent = '✓';
          icon.classList.remove('pending');
          title.textContent = t('Vielen Dank für eure Bestellung.');
          copy.textContent = t('Eure Zahlung wurde bestätigt und eure Bestellung ist bei uns eingegangen.');
          const unit = order.product?.unit || { singular: 'Produkt', plural: 'Produkte' };
          const productLabel = `${WolkenworteI18n.formatNumber(order.quantity)} ${t(
            order.quantity === 1 ? unit.singular : unit.plural
          )}`;
          const shipmentCount = Number(order.shipmentCount || 1);
          document.getElementById('quantity').textContent = shipmentCount > 1
            ? t('{{quantity}} an {{count}} Lieferadressen', {
              quantity: productLabel,
              count: WolkenworteI18n.formatNumber(shipmentCount),
            })
            : productLabel;
          document.getElementById('total').textContent = money(order.totalCents, order.currency);
          summary.hidden = false;
          return;
        }
        if (attempt < 20) {
          setTimeout(() => checkStatus(attempt + 1), 1000);
          return;
        }
        title.textContent = t('Zahlung wird noch verarbeitet');
        copy.textContent = t('Die Bestätigung dauert länger als erwartet. Bitte ladet diese Seite in einem Moment erneut.');
      } catch (error) {
        if (attempt < 4) {
          setTimeout(() => checkStatus(attempt + 1), 1000);
          return;
        }
        showError(error.message || 'Die Zahlungsbestätigung ist gerade nicht erreichbar.');
      }
    }

    async function start() {
      try {
        const response = await fetch(`/api/events/${encodeURIComponent(slug)}`);
        if (response.ok) {
          const event = await response.json();
          await WolkenworteI18n.useEventLocale(event.locale);
        }
      } catch {}
      checkStatus();
    }

    start();
  </script>
</body>
</html>
